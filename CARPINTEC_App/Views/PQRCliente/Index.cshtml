@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Gestión de PQR - Carpintec</title>

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
            tailwind.config = {
                theme: {
                    extend: {
                        colors: {
                            carpintecPrimary: '#8B5A2B',    /* Marrón madera */
                            carpintecSecondary: '#2F4F4F',  /* Azulado / Oscuro */
                            carpintecAccent: '#F7F7B5',     /* Beige claro de acento */
                            carpintecBackground: '#FFFFFF', /* Fondo blanco */
                            carpintecSurface: '#FAF3E0',    /* Fondo secundario / tarjetas */
                            carpintecText: '#333333',       /* Gris oscuro para texto */
                            carpintecTitle: '#5A3E1B'       /* Marrón oscuro para títulos */
                        }
                    }
                }
            }
    </script>

    <!-- Google Fonts: Montserrat y Open Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700&family=Open+Sans:wght@400;600&display=swap" rel="stylesheet">

    <!-- Material Symbols -->
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" />

    <style>
            body {
                font-family: 'Open Sans', sans-serif;
                background-color: #FAF3E0;
                color: #333333;
                margin: 0;
                padding: 0;
            }

            h1, h2, h3, h4, h5, h6, button, label, th {
                font-family: 'Montserrat', sans-serif;
            }
    </style>
</head>
<body class="antialiased min-h-screen py-10 px-4 md:px-8">

    <!-- CONTENEDOR PRINCIPAL DE LA VISTA PQR -->
    <div class="max-w-5xl mx-auto space-y-8">

        <!-- Cabecera -->
        <div class="bg-carpintecBackground p-6 md:p-8 rounded-xl border border-[#8B5A2B]/20 shadow-sm flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
            <div>
                <h1 class="text-2xl md:text-3xl font-bold text-carpintecTitle flex items-center gap-3">
                    <span class="material-symbols-outlined text-carpintecPrimary text-3xl">support_agent</span>
                    Peticiones, Quejas y Reclamos (PQR)
                </h1>
                <p class="text-sm text-carpintecText/80 mt-1">
                    Estamos aquí para escucharte. Radica una solicitud sobre tus productos de carpintería o consulta el estado de casos anteriores.
                </p>
            </div>
            <a asp-action="Index" class="px-4 py-2 border border-carpintecPrimary/40 rounded-lg text-sm font-semibold text-carpintecTitle hover:bg-carpintecSurface transition-colors flex items-center gap-2">
                <span class="material-symbols-outlined text-sm">arrow_back</span> Volver al Inicio
            </a>
        </div>

        <!-- Sección de Formulario: Crear Nueva PQR -->
        <div class="bg-carpintecBackground rounded-xl border border-[#8B5A2B]/20 shadow-sm p-6 md:p-8">
            <h2 class="text-lg font-bold text-carpintecTitle mb-4 flex items-center gap-2 pb-3 border-b border-[#8B5A2B]/20">
                <span class="material-symbols-outlined text-carpintecPrimary">edit_note</span> Radicar Nueva Solicitud
            </h2>

            <form asp-action="CreatePQR" method="post" class="space-y-5">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                    <div>
                        <label class="block text-xs font-bold text-carpintecTitle uppercase tracking-wider mb-2">Tipo de Solicitud (PQR)</label>
                        <select name="TipoPQR" class="w-full px-4 py-3 rounded-lg border border-[#8B5A2B]/30 bg-carpintecSurface/40 text-carpintecText focus:outline-none focus:border-carpintecPrimary text-sm font-medium" required>
                            <option value="">Seleccione una opción...</option>
                            <option value="Peticion">Petición</option>
                            <option value="Queja">Queja</option>
                            <option value="Reclamo">Reclamo</option>
                            <option value="Sugerencia">Sugerencia</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-carpintecTitle uppercase tracking-wider mb-2">Asociado a Cotización / Pedido (Opcional)</label>
                        <input name="ReferenciaPedido" class="w-full px-4 py-3 rounded-lg border border-[#8B5A2B]/30 bg-carpintecSurface/40 text-carpintecText focus:outline-none focus:border-carpintecPrimary text-sm font-medium" placeholder="Ej: COT-2026-001" />
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-bold text-carpintecTitle uppercase tracking-wider mb-2">Asunto</label>
                    <input name="Asunto" class="w-full px-4 py-3 rounded-lg border border-[#8B5A2B]/30 bg-carpintecSurface/40 text-carpintecText focus:outline-none focus:border-carpintecPrimary text-sm font-medium" placeholder="Breve resumen de su solicitud" required />
                </div>

                <div>
                    <label class="block text-xs font-bold text-carpintecTitle uppercase tracking-wider mb-2">Descripción Detallada</label>
                    <textarea name="Descripcion" rows="4" class="w-full px-4 py-3 rounded-lg border border-[#8B5A2B]/30 bg-carpintecSurface/40 text-carpintecText focus:outline-none focus:border-carpintecPrimary text-sm font-medium resize-none" placeholder="Explíquenos detalladamente su petición, queja o reclamo..." required></textarea>
                </div>

                <div class="flex justify-end gap-3 pt-3">
                    <button type="submit" class="px-6 py-3 bg-carpintecPrimary text-white text-sm font-bold rounded-lg shadow-md hover:bg-[#734A23] transition-colors flex items-center gap-2">
                        <span class="material-symbols-outlined text-sm">send</span> Enviar Solicitud
                    </button>
                </div>
            </form>
        </div>

        <!-- Sección: Historial de PQR del Cliente -->
        <div class="bg-carpintecBackground rounded-xl border border-[#8B5A2B]/20 shadow-sm overflow-hidden">
            <div class="p-6 border-b border-[#8B5A2B]/20">
                <h2 class="text-lg font-bold text-carpintecTitle flex items-center gap-2">
                    <span class="material-symbols-outlined text-carpintecPrimary">history</span> Mis Solicitudes Radicadas
                </h2>
            </div>

            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="bg-carpintecSurface/60 text-carpintecTitle text-xs uppercase tracking-wider border-b border-[#8B5A2B]/20">
                            <th class="py-3 px-4 font-bold">Radicado</th>
                            <th class="py-3 px-4 font-bold">Tipo</th>
                            <th class="py-3 px-4 font-bold">Asunto</th>
                            <th class="py-3 px-4 font-bold">Fecha</th>
                            <th class="py-3 px-4 font-bold">Estado</th>
                            <th class="py-3 px-4 text-center font-bold">Acciones</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-[#8B5A2B]/10 text-sm text-carpintecText">

                        <!-- Fila de Ejemplo -->
                        <tr class="hover:bg-carpintecSurface/30 transition-colors">
                            <td class="py-4 px-4 font-semibold text-carpintecPrimary">PQR-2026-001</td>
                            <td class="py-4 px-4 font-medium">Reclamo</td>
                            <td class="py-4 px-4">Demora en entrega de closet a medida</td>
                            <td class="py-4 px-4 text-xs">2026-06-08</td>
                            <td class="py-4 px-4">
                                <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-semibold bg-[#f2e605]/20 text-yellow-800">
                                    <span class="material-symbols-outlined text-xs">schedule</span> En Proceso
                                </span>
                            </td>
                            <td class="py-4 px-4 text-center">
                                <button class="p-1.5 hover:bg-carpintecSurface rounded-lg text-carpintecPrimary transition-colors" title="Ver Seguimiento">
                                    <span class="material-symbols-outlined text-base">visibility</span>
                                </button>
                            </td>
                        </tr>

                    </tbody>
                </table>
            </div>
        </div>

    </div>

</body>
</html>