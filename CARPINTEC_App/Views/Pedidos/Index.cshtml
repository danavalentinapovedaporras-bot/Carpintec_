
@{

    ViewData["Title"] = "Gestión de Pedidos";
}
@model IEnumerable<CARPINTEC_App.Models.Pedido>
<!DOCTYPE html>
<html class="light" lang="es">
<head>
    <meta charset="utf-8">
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <title>Carpintec - Gestión de Pedidos</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Work+Sans:wght@400;500;600;700;800;900&amp;display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet">
    
    <!-- INICIO: Estilos de tipografía Work Sans en negrita y corrección de colores -->
    <style>
            @@import url('https://fonts.googleapis.com/css2?family=Work+Sans:wght@400;500;600;700;800;900&display=swap');

            button[onclick="history.back()"],
            main,
            main *:not(.material-symbols-outlined):not([class*="fa-"]):not(i),
            #modalNuevoPedido,
            #modalNuevoPedido *:not(.material-symbols-outlined):not([class*="fa-"]):not(i) {
                font-family: 'Work Sans', sans-serif !important;
                font-weight: 700 !important;
            }

            .material-symbols-outlined {
                font-family: 'Material Symbols Outlined' !important;
                font-weight: normal !important;
                font-variation-settings: 'FILL' 0, 'wght' 300, 'GRAD' 0, 'opsz' 24;
                display: inline-block;
                line-height: 1;
                text-transform: none;
                letter-spacing: normal;
                word-wrap: normal;
                white-space: nowrap;
                direction: ltr;
            }

            body {
                background-color: #fbf9f4;
                font-family: 'Work Sans', sans-serif !important;
                font-weight: 700 !important;
                color: #000000;
            }

            /* Corrección de azul de Bootstrap a beige (#D2B48C) y negro */
            .bg-primary {
                background-color: #D2B48C !important;
            }

            .text-primary {
                color: #000000 !important;
            }

            .border-primary {
                border-color: #D2B48C !important;
            }

            .custom-scrollbar::-webkit-scrollbar {
                width: 6px;
            }

            .custom-scrollbar::-webkit-scrollbar-track {
                background: transparent;
            }

            .custom-scrollbar::-webkit-scrollbar-thumb {
                background: #d1c5b8;
                border-radius: 10px;
            }

            /* Level 1 Shadow: Soft Wood */
            .shadow-soft-wood {
                box-shadow: 0 4px 12px -2px rgba(75, 54, 33, 0.08);
            }

            /* Artisanal Precision - Subtle Texture */
            .wood-texture-overlay {
                background-image: url("https://www.transparenttextures.com/patterns/wood-pattern-with-holes.png");
                opacity: 0.03;
                pointer-events: none !important; /* Asegura que la textura no bloquee clics */
            }
    </style>
    <!-- FIN: Estilos de tipografía Work Sans en negrita y corrección de colores -->
    <script id="tailwind-config">
            tailwind.config = {
                darkMode: "class",
                theme: {
                    extend: {
                        "colors": {
                            "inverse-primary": "#e1c299",
                            "on-primary-fixed-variant": "#584324",
                            "surface-container-highest": "#e4e2dd",
                            "on-tertiary-fixed": "#0e1c2f",
                            "on-background": "#000000",
                            "on-tertiary-container": "#3d495f",
                            "outline-variant": "#d1c5b8",
                            "secondary": "#5f5e5e",
                            "tertiary-fixed-dim": "#bac7e1",
                            "secondary-fixed-dim": "#c8c6c5",
                            "tertiary-fixed": "#d6e3fe",
                            "error": "#ba1a1a",
                            "primary-fixed": "#feddb3",
                            "on-primary-container": "#000000",
                            "on-secondary-fixed-variant": "#474747",
                            "on-secondary": "#ffffff",
                            "surface-container-lowest": "#ffffff",
                            "inverse-on-surface": "#f2f1ec",
                            "surface-dim": "#dbdad5",
                            "surface-container": "#f0eee9",
                            "error-container": "#ffdad6",
                            "on-secondary-fixed": "#1b1c1c",
                            "on-error": "#ffffff",
                            "on-error-container": "#93000a",
                            "surface-container-high": "#eae8e3",
                            "inverse-surface": "#30312e",
                            "on-tertiary-fixed-variant": "#3b475d",
                            "on-primary-fixed": "#000000",
                            "secondary-fixed": "#e4e2e1",
                            "surface": "#fbf9f4",
                            "primary-fixed-dim": "#e1c299",
                            "primary": "#D2B48C",
                            "on-secondary-container": "#656464",
                            "on-surface-variant": "#4d453c",
                            "background": "#fbf9f4",
                            "surface-tint": "#D2B48C",
                            "surface-bright": "#fbf9f4",
                            "on-surface": "#000000",
                            "tertiary": "#525f76",
                            "on-primary": "#000000",
                            "surface-container-low": "#f5f3ee",
                            "secondary-container": "#e4e2e1",
                            "outline": "#7f766a",
                            "surface-variant": "#e4e2dd",
                            "tertiary-container": "#acb9d3",
                            "primary-container": "#D2B48C",
                            "on-tertiary": "#ffffff"
                        },
                        "borderRadius": {
                            "DEFAULT": "0.25rem",
                            "lg": "0.5rem",
                            "xl": "0.75rem",
                            "full": "9999px"
                        },
                        "spacing": {
                            "sidebar-width": "280px",
                            "card-padding": "24px",
                            "table-cell-padding": "12px 16px",
                            "margin-mobile": "16px",
                            "base": "8px",
                            "margin-desktop": "40px",
                            "gutter": "24px"
                        },
                        /* INICIO: Configuración Work Sans en Tailwind */
                        "fontFamily": {
                            "title-md": ["Work Sans", "sans-serif"],
                            "body-md": ["Work Sans", "sans-serif"],
                            "headline-lg": ["Work Sans", "sans-serif"],
                            "body-lg": ["Work Sans", "sans-serif"],
                            "display-lg": ["Work Sans", "sans-serif"],
                            "headline-lg-mobile": ["Work Sans", "sans-serif"],
                            "headline-md": ["Work Sans", "sans-serif"],
                            "label-md": ["Work Sans", "sans-serif"],
                            "data-table": ["Work Sans", "sans-serif"]
                        },
                        /* FIN: Configuración Work Sans en Tailwind */
                        "fontSize": {
                            "title-md": ["18px", { "lineHeight": "24px", "fontWeight": "600" }],
                            "body-md": ["16px", { "lineHeight": "24px", "fontWeight": "400" }],
                            "headline-lg": ["32px", { "lineHeight": "40px", "fontWeight": "600" }],
                            "body-lg": ["16px", { "lineHeight": "24px", "fontWeight": "400" }],
                            "display-lg": ["48px", { "lineHeight": "56px", "letterSpacing": "-0.02em", "fontWeight": "700" }],
                            "headline-lg-mobile": ["28px", { "lineHeight": "36px", "fontWeight": "600" }],
                            "headline-md": ["24px", { "lineHeight": "32px", "fontWeight": "600" }],
                            "label-md": ["12px", { "lineHeight": "16px", "letterSpacing": "0.05em", "fontWeight": "600" }],
                            "data-table": ["14px", { "lineHeight": "20px", "fontWeight": "400" }]
                        }
                    },
                },
            }
    </script>
</head>
<body class="bg-background text-on-background font-body-md text-body-md min-h-screen">

    <!-- Main Content Area -->
    <main class="pt-4 min-h-screen bg-background relative z-0">
        <!-- Content Canvas -->
        <div class="p-margin-desktop space-y-gutter relative z-10">

            <!-- Page Header -->
            <button onclick="history.back()" class="flex items-center gap-2 text-black hover:bg-black/5 px-2 py-1 rounded-lg transition-colors mb-4 group cursor-pointer">
                <span class="material-symbols-outlined text-[20px] transition-transform group-hover:-translate-x-1">arrow_back</span>
                <span class="font-label-md text-label-md font-bold uppercase tracking-wider">Volver</span>
            </button>

            <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
                <div>
                    <h2 class="font-headline-md text-headline-md text-on-surface font-bold">Gestión de Pedidos</h2>
                    <p class="text-on-surface/70 font-body-md">Supervisa el flujo de producción artesanal y entregas.</p>
                </div>

       
                    <!-- INICIO: Botón Nuevo Pedido en color beige (#D2B48C) -->
                    <button type="button"
                            onclick="abrirNuevoPedido()"
                            class="bg-[#D2B48C] hover:brightness-95 text-black px-6 py-3 rounded-xl font-title-md text-title-md flex items-center gap-2 shadow-soft-wood hover:scale-[1.02] active:scale-[0.98] transition-all font-bold cursor-pointer relative z-30"
                            style="background-color: #D2B48C; color: #000000;">
                        <span class="material-symbols-outlined text-black">add</span>
                        Nuevo Pedido
                    </button>
                    <!-- FIN: Botón Nuevo Pedido en color beige (#D2B48C) -->
                
            </div>

            <!-- Stats Grid -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-gutter w-full mb-8">

                <!-- Stat Card 1: Pedidos Activos -->
                <div class="bg-surface-container-lowest p-card-padding rounded-xl border border-surface-container-highest shadow-soft-wood group hover:border-primary/20 transition-all">
                    <div class="flex justify-between items-start mb-4">
                        <div class="p-3 bg-primary/20 rounded-lg text-on-surface">
                            <span class="material-symbols-outlined text-[28px]">assignment</span>
                        </div>
                        <span class="text-on-surface/60 text-[12px] font-bold">+12% vs mes ant.</span>
                    </div>
                    <p class="font-label-md text-label-md text-on-surface/70">Pedidos Activos</p>
                    <h3 class="font-display-lg text-[32px] text-on-surface font-bold">@ViewBag.TotalActivos</h3>
                </div>

                <!-- Stat Card 2: En Producción -->
                <div class="bg-surface-container-lowest p-card-padding rounded-xl border border-surface-container-highest shadow-soft-wood group hover:border-primary/20 transition-all">
                    <div class="flex justify-between items-start mb-4">
                        <div class="p-3 bg-primary/20 rounded-lg text-on-surface">
                            <span class="material-symbols-outlined text-[28px]">precision_manufacturing</span>
                        </div>
                        <span class="text-on-surface/60 text-[12px] font-bold">87% capacidad</span>
                    </div>
                    <p class="font-label-md text-label-md text-on-surface/70">En Producción</p>
                    <h3 class="font-display-lg text-[32px] text-on-surface font-bold">@ViewBag.EnProduccionCount</h3>
                </div>

                <!-- Stat Card 3: Pendientes Entrega -->
                <div class="bg-surface-container-lowest p-card-padding rounded-xl border border-surface-container-highest shadow-soft-wood group hover:border-primary/20 transition-all">
                    <div class="flex justify-between items-start mb-4">
                        <div class="p-3 bg-primary/20 rounded-lg text-on-surface">
                            <span class="material-symbols-outlined text-[28px]">local_shipping</span>
                        </div>
                        <span class="text-error text-[12px] font-bold">Urgentes</span>
                    </div>
                    <p class="font-label-md text-label-md text-on-surface/70">Pendientes Entrega</p>
                    <h3 class="font-display-lg text-[32px] text-on-surface font-bold">@ViewBag.PendientesEntregaCount</h3>
                </div>

                <!-- INICIO: Stat Card 4: Valor Total en Curso (fondo blanco y letras en negro) -->
                <div class="bg-white p-card-padding rounded-xl border border-surface-container-highest shadow-soft-wood group relative overflow-hidden hover:border-primary/20 transition-all" style="background-color: #ffffff;">
                    <div class="relative z-10">
                        <div class="flex justify-between items-start mb-4">
                            <div class="p-3 bg-primary/20 rounded-lg text-black">
                                <span class="material-symbols-outlined text-[28px] text-black">payments</span>
                            </div>
                        </div>
                        <p class="font-label-md text-label-md text-black/70 font-bold">Valor Total en Curso</p>
                        <h3 class="font-display-lg text-[28px] text-black font-bold">$@ViewBag.ValorEnCursoFormatted</h3>
                    </div>
                    <div class="absolute -right-4 -bottom-4 opacity-10">
                        <span class="material-symbols-outlined text-[120px] text-black">paid</span>
                    </div>
                </div>
                <!-- FIN: Stat Card 4: Valor Total en Curso (fondo blanco y letras en negro) -->

            </div>
            <!-- Main Table Section -->
            <div class="bg-surface-container-lowest rounded-xl border border-surface-container-highest shadow-soft-wood overflow-hidden">
                <!-- Table Filters -->
                <div class="p-6 border-b border-outline-variant flex flex-wrap items-center justify-between gap-4">
                    <div class="flex items-center gap-3">
                        <span class="font-label-md text-label-md text-on-surface/70 uppercase tracking-wider">Filtrar por:</span>
                        <!-- INICIO: Filtros con fondo blanco y texto en negro -->
                        <div class="flex gap-2">
                            <!-- Botón Todos -->
                            <a href="@Url.Action("Index", new { estado = "Todas" })"
                               class="px-4 py-1.5 rounded-full text-[12px] transition-all cursor-pointer @(ViewBag.EstadoActual == "Todas" ? "bg-white text-black font-bold border border-outline-variant shadow-sm" : "bg-surface-container-high text-on-surface font-medium hover:bg-primary/20")" @(ViewBag.EstadoActual == "Todas" ? "style=\"background-color: #ffffff; color: #000000;\"" : "")>
                                Todos
                            </a>

                            <!-- Botón Diseño -->
                            <a href="@Url.Action("Index", new { estado = "Diseño" })"
                               class="px-4 py-1.5 rounded-full text-[12px] transition-all cursor-pointer @(ViewBag.EstadoActual == "Diseño" ? "bg-white text-black font-bold border border-outline-variant shadow-sm" : "bg-surface-container-high text-on-surface font-medium hover:bg-primary/20")" @(ViewBag.EstadoActual == "Diseño" ? "style=\"background-color: #ffffff; color: #000000;\"" : "")>
                                Diseño
                            </a>

                            <!-- Botón Corte -->
                            <a href="@Url.Action("Index", new { estado = "Corte" })"
                               class="px-4 py-1.5 rounded-full text-[12px] transition-all cursor-pointer @(ViewBag.EstadoActual == "Corte" ? "bg-white text-black font-bold border border-outline-variant shadow-sm" : "bg-surface-container-high text-on-surface font-medium hover:bg-primary/20")" @(ViewBag.EstadoActual == "Corte" ? "style=\"background-color: #ffffff; color: #000000;\"" : "")>
                                Corte
                            </a>

                            <!-- Botón Producción -->
                            <a href="@Url.Action("Index", new { estado = "En Producción" })"
                               class="px-4 py-1.5 rounded-full text-[12px] transition-all cursor-pointer @(ViewBag.EstadoActual == "En Producción" ? "bg-white text-black font-bold border border-outline-variant shadow-sm" : "bg-surface-container-high text-on-surface font-medium hover:bg-primary/20")" @(ViewBag.EstadoActual == "En Producción" ? "style=\"background-color: #ffffff; color: #000000;\"" : "")>
                                Producción
                            </a>
                        </div>
                        <!-- FIN: Filtros con fondo blanco y texto en negro -->
                    </div>
                    <div class="flex items-center gap-2">
                        <button type="button" class="flex items-center gap-2 px-4 py-2 border border-outline-variant rounded-lg text-on-surface hover:bg-surface-container-low transition-all cursor-pointer">
                            <span class="material-symbols-outlined text-[20px]">filter_list</span>
                            <span class="font-label-md">Más filtros</span>
                        </button>
                    </div>
                </div>
                        <a asp-controller="Pedidos"
                           asp-action="ExportarExcel"
                           class="flex items-center gap-2 px-4 py-2 border border-outline-variant rounded-lg text-on-surface hover:bg-surface-container-low transition-all cursor-pointer">
                            <span class="material-symbols-outlined text-[20px]">download</span>
                            <span class="font-label-md">Exportar</span>
                        </a>
                    </div>
                </div>

                <!-- Responsive Table Wrapper -->
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse font-data-table">
                        <thead>
                            <tr class="bg-surface-container-low border-b border-outline-variant">
                                <th class="p-table-cell-padding font-label-md text-on-surface uppercase tracking-widest text-[11px] font-bold">ID Pedido</th>
                                <th class="p-table-cell-padding font-label-md text-on-surface uppercase tracking-widest text-[11px] font-bold">Cliente</th>
                                <th class="p-table-cell-padding font-label-md text-on-surface uppercase tracking-widest text-[11px] font-bold">Producto</th>
                                <th class="p-table-cell-padding font-label-md text-on-surface uppercase tracking-widest text-[11px] font-bold">Registro</th>
                                <th class="p-table-cell-padding font-label-md text-on-surface uppercase tracking-widest text-[11px] font-bold">Compromiso</th>
                                <th class="p-table-cell-padding font-label-md text-on-surface uppercase tracking-widest text-[11px] font-bold">Estado</th>
                                <th class="p-table-cell-padding font-label-md text-on-surface uppercase tracking-widest text-[11px] font-bold text-right">Valor</th>
                                <th class="p-table-cell-padding"></th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-outline-variant/30">
                            @if (Model != null && Model.Any())
                            {
                                @foreach (var item in Model)
                                {
                                    <tr class="hover:bg-surface-bright transition-colors group text-on-surface cursor-pointer">

                                        <!-- ID Pedido -->
                                        <td class="p-table-cell-padding font-bold text-black">@item.CodigoPedido</td>

                                        <!-- Cliente con Iniciales Dinámicas -->
                                        <td class="p-table-cell-padding">
                                            <div class="flex items-center gap-3">
                                                <div class="w-8 h-8 rounded-full bg-primary/30 flex items-center justify-center text-on-surface font-bold text-[12px]">
                                                    @{
                                                        string iniciales = "NC";
                                                        if (item.IdClienteNavigation?.Nombre != null)
                                                        {
                                                            string nombre = item.IdClienteNavigation.Nombre.Trim();
                                                            string apellido = item.IdClienteNavigation.Apellido?.Trim() ?? "";
                                                            iniciales = $"{nombre[0]}".ToUpper();
                                                            if (!string.IsNullOrEmpty(apellido))
                                                            {
                                                                iniciales += $"{apellido[0]}".ToUpper();
                                                            }
                                                        }
                                                    }
                                                    @iniciales
                                                </div>
                                                <span>
                                                    @(item.IdClienteNavigation != null ? $"{item.IdClienteNavigation.Nombre} {item.IdClienteNavigation.Apellido}" : "Sin cliente")
                                                </span>
                                            </div>
                                        </td>

                                <!-- Producto correcto -->
                                <td class="p-table-cell-padding">@item.Producto</td>

                                        <!-- Fecha de Registro -->
                                        <td class="p-table-cell-padding text-on-surface/70">@item.FechaSolicitud.ToString("dd MMM yyyy")</td>

                                        <!-- Fecha de Compromiso -->
                                        <td class="p-table-cell-padding text-on-surface/70">@item.FechaEntrega.ToString("dd MMM yyyy")</td>

                                        <!-- Estado con Insignias Condicionales -->
                                        <td class="p-table-cell-padding">
                                            @if (item.Estado == "En Diseño" || item.Estado == "Diseño")
                                            {
                                                <!-- INICIO: Estado En Diseño con texto en negro -->
                                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[12px] font-bold bg-blue-100 text-black border border-blue-200">En Diseño</span>
                                                <!-- FIN: Estado En Diseño con texto en negro -->
                                            }
                                            else if (item.Estado == "Corte")
                                            {
                                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[12px] font-medium bg-orange-100 text-orange-800 border border-orange-200">Corte</span>
                                            }
                                            else if (item.Estado == "Ensamble")
                                            {
                                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[12px] font-medium bg-purple-100 text-purple-800 border border-purple-200">Ensamble</span>
                                            }
                                            else if (item.Estado == "Pintura")
                                            {
                                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[12px] font-medium bg-yellow-100 text-yellow-800 border border-yellow-200">Pintura</span>
                                            }
                                            else if (item.Estado == "Completado")
                                            {
                                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[12px] font-medium bg-green-100 text-green-800 border border-green-200">Completado</span>
                                            }
                                            else
                                            {
                                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[12px] font-medium bg-gray-100 text-gray-800 border border-gray-200">@item.Estado</span>
                                            }
                                        </td>

                                        <!-- Valor Monetario -->
                                        <td class="p-table-cell-padding text-right font-bold text-black">$@item.ValorTotal.ToString("N2")</td>

                                        <!-- Botón de Menú de Acciones -->
                                        <td class="p-table-cell-padding text-right">
                                            <button type="button" class="p-2 hover:bg-surface-container-high rounded-full text-on-surface cursor-pointer">
                                                <span class="material-symbols-outlined">more_vert</span>
                                            </button>
                                        </td>

                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="8" class="text-center py-8 text-on-surface/50 font-medium">
                                        No hay pedidos guardados en la base de datos.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <!-- Fin de la sección de la Tabla o Contenido Principal -->
            
        </main>

        <!-- MODAL NUEVO PEDIDO -->
        <div id="modalNuevoPedido" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50 backdrop-blur-sm p-4">
            <div class="bg-white w-full max-w-4xl max-h-[90vh] overflow-y-auto rounded-2xl shadow-2xl relative z-50">

                <!-- Encabezado -->
                <div class="flex items-center justify-between px-6 py-5 border-b border-gray-200 sticky top-0 bg-white z-10">
                    <div>
                        <h2 class="text-2xl font-bold text-gray-900">Nuevo Pedido</h2>
                        <p class="text-sm text-gray-500 mt-1">Registra un nuevo pedido directamente en el sistema.</p>
                    </div>
                    <button type="button"
                            onclick="cerrarNuevoPedido()"
                            class="w-10 h-10 flex items-center justify-center rounded-full hover:bg-gray-100 transition cursor-pointer">
                        <span class="material-symbols-outlined">close</span>
                    </button>
                </div>

                <!-- Contenido del Formulario -->
                <form asp-controller="Pedidos" asp-action="GuardarPedido" method="post" id="formNuevoPedido" class="p-6">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">

                        <!-- Cliente (Cargado dinámicamente desde la BD) -->
                        <div class="mb-4">
                            <label class="block text-sm font-bold text-black mb-1">Cliente</label>
                            <select name="IdCliente" class="w-full bg-surface-container-lowest p-3 rounded-xl border border-outline-variant" required>
                                <option value="">Seleccionar cliente...</option>
                                @if (ViewBag.ListaClientes != null)
                                {
                                    foreach (var cliente in ViewBag.ListaClientes)
                                    {
                                        <option value="@cliente.IdCliente">@cliente.Nombre @cliente.Apellido</option>
                                    }
                                }
                            </select>
                        </div>

                        <!-- Campo para el Producto dentro del formulario del Modal -->
                        <div class="mb-4">
                            <label class="block text-sm font-bold text-on-surface mb-2">Producto / Descripción</label>
                            <input type="text" name="Producto" required
                                   class="w-full px-4 py-2 rounded-xl border border-outline-variant bg-surface-container-low text-on-surface focus:outline-none focus:border-primary"
                                   placeholder="Ej. Cocina Integral Roble">
                        </div>

                        <!-- Código del pedido -->
                    
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-2">Código del pedido</label>
                            <input type="text"
                                   name="CodigoPedido"
                                   placeholder="Ej: P-2026-007"
                                   required
                                   class="w-full rounded-xl border border-gray-300 px-4 py-3 text-gray-800">
                        </div>
                        <!-- Fecha solicitud -->
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-2">Fecha de solicitud</label>
                            <input type="date"
                                   name="FechaSolicitud"
                                   required
                                   class="w-full rounded-xl border border-gray-300 px-4 py-3 focus:ring-2 focus:ring-primary">
                        </div>

                        <!-- Fecha entrega -->
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-2">Fecha de entrega</label>
                            <input type="date"
                                   name="FechaEntrega"
                                   required
                                   class="w-full rounded-xl border border-gray-300 px-4 py-3 focus:ring-2 focus:ring-primary">
                        </div>

                        <!-- Estado -->
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-2">Estado</label>
                            <select name="Estado" class="w-full rounded-xl border border-gray-300 px-4 py-3 focus:ring-2 focus:ring-primary">
                                <option value="Pendiente">Pendiente</option>
                                <option value="En Diseño">En Diseño</option>
                                <option value="Corte">Corte</option>
                                <option value="Ensamble">Ensamble</option>
                                <option value="Pintura">Pintura</option>
                                <option value="Completado">Completado</option>
                            </select>
                        </div>

                        <!-- Valor total -->
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-2">Valor total ($)</label>
                            <input type="number"
                                   step="0.01"
                                   name="ValorTotal"
                                   placeholder="0.00"
                                   required
                                   class="w-full rounded-xl border border-gray-300 px-4 py-3 focus:ring-2 focus:ring-primary">
                        </div>

                        <!-- Observaciones (Opcional según tu BD) -->
                        <div class="md:col-span-2">
                            <label class="block text-sm font-semibold text-gray-700 mb-2">Observaciones</label>
                            <textarea name="Observaciones" rows="2" placeholder="Detalles o especificaciones del pedido..." class="w-full rounded-xl border border-gray-300 px-4 py-3 focus:ring-2 focus:ring-primary"></textarea>
                        </div>
                    </div>

                    <!-- Botones de Acción del Modal -->
                    <div class="flex items-center justify-end gap-3 mt-8 pt-4 border-t border-gray-200">
                        <button type="button"
                                onclick="cerrarNuevoPedido()"
                                class="px-5 py-2.5 rounded-xl border border-gray-300 text-gray-700 font-semibold hover:bg-gray-50 transition cursor-pointer">
                            Cancelar
                        </button>
                        <!-- INICIO: Botón Guardar Pedido en color beige (#D2B48C) -->
                        <button type="submit"
                                class="px-6 py-2.5 rounded-xl bg-[#D2B48C] hover:brightness-95 text-black font-bold shadow-soft-wood hover:scale-[1.02] active:scale-[0.98] transition cursor-pointer"
                                style="background-color: #D2B48C; color: #000000;">
                            Guardar Pedido
                        </button>
                        <!-- FIN: Botón Guardar Pedido en color beige (#D2B48C) -->
                    </div>
                </form>
            </div>
        </div>

    <script>

function abrirNuevoPedido(){

    const modal = document.getElementById("modalNuevoPedido");

    console.log("Botón nuevo pedido funcionando");

    if(modal){
        modal.classList.remove("hidden");
        modal.classList.add("flex");
    }

}


function cerrarNuevoPedido(){

    const modal = document.getElementById("modalNuevoPedido");

    if(modal){
        modal.classList.add("hidden");
        modal.classList.remove("flex");
    }

}

</script>
</body>
</html>