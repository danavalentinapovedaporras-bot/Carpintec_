@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8">
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <title>Carpintec - Catálogo</title>
    <!-- Fonts: Google Fonts (Montserrat & Work Sans) & Material Symbols -->
    <link href="https://fonts.googleapis.com" rel="preconnect" />
    <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400&amp;family=Work+Sans:wght@400;500;600&amp;display=swap" rel="stylesheet">
    
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA==" crossorigin="anonymous" referrerpolicy="no-referrer" />

    <!-- Tailwind CSS with Forms & Container Plugins -->
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "outline-variant": "#dac2b6",
                        "on-tertiary-fixed": "#251a01",
                        "on-tertiary-container": "#e2cca2",
                        "tertiary-container": "#665635",
                        "secondary-fixed-dim": "#ffb68d",
                        "on-tertiary-fixed-variant": "#544525",
                        "tertiary-fixed": "#f7e0b5",
                        "secondary": "#9a4600",
                        "inverse-surface": "#362f2c",
                        "outline": "#877369",
                        "on-primary": "#ffffff",
                        "surface-container-highest": "#ede0dc",
                        "on-tertiary": "#ffffff",
                        "primary": "#6c2f00",
                        "on-secondary-container": "#672c00",
                        "secondary-container": "#fd8a3e",
                        "on-surface": "#201a18",
                        "on-secondary-fixed": "#321200",
                        "on-secondary": "#ffffff",
                        "primary-container": "#8b4513",
                        "tertiary-fixed-dim": "#dac49b",
                        "on-error": "#ffffff",
                        "error-container": "#ffdad6",
                        "on-primary-container": "#ffc29f",
                        "on-primary-fixed-variant": "#753401",
                        "surface-variant": "#ede0dc",
                        "on-primary-fixed": "#321200",
                        "error": "#ba1a1a",
                        "on-background": "#201a18",
                        "tertiary": "#4d3f20",
                        "surface": "#fff8f6",
                        "surface-dim": "#e4d7d4",
                        "on-secondary-fixed-variant": "#763400",
                        "inverse-on-surface": "#fbeeea",
                        "background": "#fff8f6",
                        "surface-container-high": "#f3e5e1",
                        "surface-container": "#f9ebe7",
                        "surface-bright": "#fff8f6",
                        "on-error-container": "#93000a",
                        "surface-container-lowest": "#ffffff",
                        "surface-container-low": "#fef1ed",
                        "surface-tint": "#934b19",
                        "secondary-fixed": "#ffdbc9",
                        "primary-fixed-dim": "#ffb68c",
                        "primary-fixed": "#ffdbc9",
                        "on-surface-variant": "#54433a",
                        "inverse-primary": "#ffb68c",
                        timber: {
                            50: '#FAF6F0',
                            100: '#F4ECE1',
                            200: '#E6D7C3',
                            300: '#D5BEA2',
                            400: '#BA9B7B',
                            500: '#9C7A59',
                            600: '#7E5F43',
                            700: '#644A34',
                            800: '#4D3827',
                            900: '#34261B',
                            950: '#231810'
                        },
                        wood: {
                            light: '#f5ebe6',
                            accent: '#8b4513',
                            dark: '#5c2c16',
                            surface: '#FFFBF7',
                            border: '#E8DDD5'
                        }
                    },
                    borderRadius: {
                        "DEFAULT": "0.125rem",
                        "lg": "0.25rem",
                        "xl": "0.5rem",
                        "full": "0.75rem"
                    },
                    spacing: {
                        "margin-mobile": "16px",
                        "gutter": "24px",
                        "base": "8px",
                        "container-max": "1280px",
                        "margin-desktop": "64px"
                    },
                    fontFamily: {
                        "title-md": ["Montserrat"],
                        "headline-lg": ["Montserrat"],
                        "body-lg": ["Work Sans"],
                        "body-md": ["Work Sans"],
                        "headline-lg-mobile": ["Montserrat"],
                        "label-md": ["Work Sans"],
                        "display-lg": ["Montserrat"]
                    },
                    fontSize: {
                        "title-md": ["20px", { "lineHeight": "28px", "fontWeight": "600" }],
                        "headline-lg": ["32px", { "lineHeight": "40px", "fontWeight": "700" }],
                        "body-lg": ["18px", { "lineHeight": "28px", "fontWeight": "400" }],
                        "body-md": ["16px", { "lineHeight": "24px", "fontWeight": "400" }],
                        "headline-lg-mobile": ["24px", { "lineHeight": "32px", "fontWeight": "700" }],
                        "label-md": ["14px", { "lineHeight": "20px", "letterSpacing": "0.05em", "fontWeight": "500" }],
                        "display-lg": ["48px", { "lineHeight": "56px", "letterSpacing": "-0.02em", "fontWeight": "700" }]
                    }
                }
            }
        }
    </script>
    <style>
        /* Ocultar botones spin de inputs numéricos */
        input[type=number]::-webkit-inner-spin-button,
        input[type=number]::-webkit-outer-spin-button {
            -webkit-appearance: none;
            margin: 0;
        }

        /* Scrollbar estilizada */
        ::-webkit-scrollbar {
            width: 7px;
            height: 7px;
        }

        ::-webkit-scrollbar-track {
            background: #F4ECE1;
        }

        ::-webkit-scrollbar-thumb {
            background: #D5BEA2;
            border-radius: 4px;
        }

        ::-webkit-scrollbar-thumb:hover {
            background: #8B4513;
        }
    </style>
</head>
<body class="bg-surface text-on-surface font-body-md antialiased pb-24 md:pb-0">
    <!-- Top Navigation Container -->
    <header class="w-full top-0 sticky z-40">
        <!-- TopAppBar -->
        <div class="bg-[#8B5A2B] flex items-center justify-between px-margin-mobile h-16 w-full border-b-4 border-[#734A23] shadow-sm">
            <div class="flex items-center gap-3">
                    <img alt="Carpintec Logo"
                     class="h-8 w-8 object-contain mr-2"
                     src="~/images/logo.png">
                <a href="javascript:history.back()"
                   class="flex items-center gap-2 text-on-primary hover:opacity-80 transition-opacity">
                    <span class="material-symbols-outlined">arrow_back</span>
                </a>
                <span class="font-headline-lg-mobile text-headline-lg-mobile text-on-primary uppercase tracking-wider">Carpintec</span>
            </div>
            <!-- Desktop Navigation Links (Hidden on Mobile) -->
            <nav class="hidden md:flex gap-6 items-center">
                <a class="text-on-primary/80 hover:bg-secondary-container transition-colors px-3 py-2 rounded-md cursor-pointer active:scale-95"
                   asp-controller="DashboardCliente"
                   asp-action="Index">
                    Inicio
                </a>             
                <a class="text-on-primary font-bold border-b-2 border-on-primary pb-1 hover:text-secondary-fixed hover:transition-colors font-label-md text-label-md active scale-95 transition-transform duration-200"
                   asp-controller="MisProductos"
                   asp-action="Index">
                    Catálogo
                </a>             
                <a class="text-on-primary/80 hover:bg-secondary-container transition-colors px-3 py-2 rounded-md cursor-pointer active:scale-95"
                   asp-controller="MiCotizacion"
                   asp-action="Index">
                    Mis Cotizaciones
                </a>         
                <a class="text-on-primary/80 hover:bg-secondary-container transition-colors px-3 py-2 rounded-md cursor-pointer active:scale-95"
                   asp-controller="Mi_Pedido"
                   asp-action="Index">
                    Pedidos
                </a>         
                <a class="text-on-primary/80 hover:bg-secondary-container transition-colors px-3 py-2 rounded-md cursor-pointer active:scale-95"
                   asp-controller="Miperfil"
                   asp-action="Index">
                    Perfil
                </a>
            </nav>
            <div class="flex items-center gap-2">
                @await Html.PartialAsync("_ClientUserMenu")
            </div>
        </div>
    </header>

    <!-- Main Content Canvas -->
    <main class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop py-8 md:py-12 flex flex-col md:flex-row gap-gutter">
        <!-- Product Catalog Area -->
        <section class="flex-1">
            <!-- Search & Filters -->
            <div class="mb-8 p-6 bg-surface-container rounded-xl border border-outline-variant shadow-sm flex flex-col gap-4">
                <div class="relative w-full">
                    <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-outline">search</span>
                    <input class="w-full bg-surface-container-lowest border border-outline rounded-lg py-3 pl-12 pr-4 font-body-md text-on-surface focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-shadow" placeholder="Buscar productos..." type="text">
                </div>
                <div class="flex overflow-x-auto pb-2 gap-3 scrollbar-hide">
                    <button class="whitespace-nowrap px-4 py-2 bg-primary text-on-primary rounded-full font-label-md text-label-md">Todos</button>
                    <button class="whitespace-nowrap px-4 py-2 bg-surface border border-outline text-on-surface-variant hover:bg-surface-container-high transition-colors rounded-full font-label-md text-label-md">Cocinas</button>
                    <button class="whitespace-nowrap px-4 py-2 bg-surface border border-outline text-on-surface-variant hover:bg-surface-container-high transition-colors rounded-full font-label-md text-label-md">Mesas</button>
                    <button class="whitespace-nowrap px-4 py-2 bg-surface border border-outline text-on-surface-variant hover:bg-surface-container-high transition-colors rounded-full font-label-md text-label-md">Dormitorio</button>
                    <button class="whitespace-nowrap px-4 py-2 bg-surface border border-outline text-on-surface-variant hover:bg-surface-container-high transition-colors rounded-full font-label-md text-label-md">Sala</button>
                    <button class="whitespace-nowrap px-4 py-2 bg-surface border border-outline text-on-surface-variant hover:bg-surface-container-high transition-colors rounded-full font-label-md text-label-md">Organizadores</button>
                </div>
            </div>
            <!-- Header -->
            <div class="mb-6 flex flex-wrap items-center justify-between gap-3 border-b-2 border-primary pb-3">
                <div>
                    <h1 class="font-headline-lg-mobile md:font-headline-lg text-primary">Nuestro Catálogo</h1>
                    <span class="font-label-md text-outline">12 Productos Destacados</span>
                </div>
                <button type="button" onclick="abrirModalCotizarProducto('Mueble Personalizado', 'pino', 80, 120, 60)" class="bg-[#8B4513] hover:bg-[#72370D] text-white font-bold py-2.5 px-5 rounded-xl shadow-sm hover:shadow transition-all active:scale-95 flex items-center gap-2 text-sm tracking-wide">
                    <span class="material-symbols-outlined text-base">calculate</span>
                    <span>Nueva Cotización</span>
                </button>
            </div>

            <!-- Products Grid -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
                
                <!-- Product 1 -->
                <article class="bg-surface-container-lowest border border-outline-variant rounded-lg overflow-hidden flex flex-col group hover:shadow-lg transition-shadow duration-300">
                    <div class="relative h-48 w-full overflow-hidden bg-surface-container">
                        <img alt="Cocina Moderna Roble"
                             class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                             src="~/images/cocina.jpeg">
                    </div>
                    <div class="p-4 flex flex-col flex-grow">
                        <h2 class="font-title-md text-title-md text-primary mb-1">Cocina Moderna Roble</h2>
                        <p class="font-label-md text-label-md text-on-surface-variant mb-2">Cocinas</p>
                        <div class="mb-2">
                            <span class="bg-tertiary-container text-on-tertiary-container text-xs px-2 py-0.5 rounded font-label-md">Madera: Roble Macizo</span>
                        </div>
                        <p class="font-body-md text-sm text-on-surface mb-4 flex-grow line-clamp-3">
                            Gabinetería en roble macizo con acabado natural mate. Herrajes de cierre lento y diseño minimalista para espacios contemporáneos.
                        </p>
                        <div class="bg-surface-container-high p-2 rounded mb-4 flex flex-col gap-1">
                            <span class="font-label-md text-xs text-on-surface-variant flex items-center gap-1">
                                <span class="material-symbols-outlined text-[14px]">straighten</span> A Medida
                            </span>
                        </div>
                        <div class="flex gap-2 mt-auto">
                            <button type="button" onclick="abrirModalCotizarProducto('Cocina Moderna Roble', 'roble', 85, 240, 60)" class="flex-1 bg-primary hover:bg-secondary text-on-primary font-title-md text-[14px] font-bold py-2 px-2 rounded transition-all active:scale-95 flex items-center justify-center gap-1">
                                <span class="material-symbols-outlined text-[18px]">calculate</span> Cotizar
                            </button>
                            <a asp-controller="Instructivos" asp-action="Index" class="flex-1 border border-primary text-primary hover:bg-primary-container hover:text-on-primary-container font-title-md text-[14px] font-bold py-2 px-2 rounded transition-colors flex items-center justify-center gap-1">
                                <span class="material-symbols-outlined text-[18px]">menu_book</span> Instructivo
                            </a>
                        </div>
                    </div>
                </article>

                <!-- Product 2 -->
                <article class="bg-surface-container-lowest border border-outline-variant rounded-lg overflow-hidden flex flex-col group hover:shadow-lg transition-shadow duration-300">
                    <div class="relative h-48 w-full overflow-hidden bg-surface-container">
                        <img class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" data-alt="Cocina Rústica Pino" src="https://lh3.googleusercontent.com/aida-public/AB6AXuAjbFbxAHnKorOYBZQk2lYkCg0WxtQC30h5hIFVHAvoMLtO0B2KvpSTOMB3PFqha4RM_ZwRAUMX-GgWC9JZq59GYoIoTwzvFoJxJzQVysbopHgohOrNBkVGj8LUazCchXp69bLAbOVBja_wgW3f5pX13T444Hth2WYeAbEcdHyAZgeqVEUVlOzEsDkOpG6EUdRbY0msC-bI0VGkq7V_96r0vUwlB8vxDvoDTpElxn8GViuog3BDFDqmuQ">
                    </div>
                    <div class="p-4 flex flex-col flex-grow">
                        <h2 class="font-title-md text-title-md text-primary mb-1">Cocina Rústica Pino</h2>
                        <p class="font-label-md text-label-md text-on-surface-variant mb-2">Cocinas</p>
                        <div class="mb-2">
                            <span class="bg-tertiary-container text-on-tertiary-container text-xs px-2 py-0.5 rounded font-label-md">Madera: Pino Seleccionado</span>
                        </div>
                        <p class="font-body-md text-sm text-on-surface mb-4 flex-grow line-clamp-3">
                            Estilo campestre en pino seleccionado. Acabado rústico artesanal que resalta la veta natural de la madera, ideal para casas de campo.
                        </p>
                        <div class="bg-surface-container-high p-2 rounded mb-4 flex flex-col gap-1">
                            <span class="font-label-md text-xs text-on-surface-variant flex items-center gap-1">
                                <span class="material-symbols-outlined text-[14px]">straighten</span> A Medida
                            </span>
                        </div>
                        <div class="flex gap-2 mt-auto">
                            <button type="button" onclick="abrirModalCotizarProducto('Cocina Rústica Pino', 'pino', 85, 220, 60)" class="flex-1 bg-primary hover:bg-secondary text-on-primary font-title-md text-[14px] font-bold py-2 px-2 rounded transition-all active:scale-95 flex items-center justify-center gap-1">
                                <span class="material-symbols-outlined text-[18px]">calculate</span> Cotizar
                            </button>
                            <a asp-controller="Instructivos" asp-action="Index" class="flex-1 border border-primary text-primary hover:bg-primary-container hover:text-on-primary-container font-title-md text-[14px] font-bold py-2 px-2 rounded transition-colors flex items-center justify-center gap-1">
                                <span class="material-symbols-outlined text-[18px]">menu_book</span> Instructivo
                            </a>
                        </div>
                    </div>
                </article>

                <!-- Product 3 -->
                <article class="bg-surface-container-lowest border border-outline-variant rounded-lg overflow-hidden flex flex-col group hover:shadow-lg transition-shadow duration-300">
                    <div class="relative h-48 w-full overflow-hidden bg-surface-container">
                        <img class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" data-alt="Cocina Clásica Cerezo" src="https://lh3.googleusercontent.com/aida-public/AB6AXuBZ9bKQA4DpYQ_8jEfBnddX5L3pF-plyX8hXsppOSHSihlYJj4DBZ91wR8UjsPi63QNciPO7yTdgaivQ7ZEkcuS1PAV2tDB176Dg-hoJ8Mex2_CfTVAimtXj5YNGigZPdmjyQ9OcRMBV7GGNeL339IKNPUubfv0wV2h1TR6mYn94YI_olm_SYec1exqGFpjHMw6Y2WvI1_3wl1XHRdimM3sTE6sgQIgEsALw0h_j78tOf8dieTiZ7wXsA">
                    </div>
                    <div class="p-4 flex flex-col flex-grow">
                        <h2 class="font-title-md text-title-md text-primary mb-1">Cocina Clásica Cerezo</h2>
                        <p class="font-label-md text-label-md text-on-surface-variant mb-2">Cocinas</p>
                        <div class="mb-2">
                            <span class="bg-tertiary-container text-on-tertiary-container text-xs px-2 py-0.5 rounded font-label-md">Madera: Cedro / Cerezo</span>
                        </div>
                        <p class="font-body-md text-sm text-on-surface mb-4 flex-grow line-clamp-3">
                            Elegancia atemporal en madera noble con molduras clásicas detalladas a mano. Barniz de alta resistencia y brillo sedoso.
                        </p>
                        <div class="bg-surface-container-high p-2 rounded mb-4 flex flex-col gap-1">
                            <span class="font-label-md text-xs text-on-surface-variant flex items-center gap-1">
                                <span class="material-symbols-outlined text-[14px]">straighten</span> A Medida
                            </span>
                        </div>
                        <div class="flex gap-2 mt-auto">
                            <button type="button" onclick="abrirModalCotizarProducto('Cocina Clásica Cerezo', 'cedro', 85, 250, 60)" class="flex-1 bg-primary hover:bg-secondary text-on-primary font-title-md text-[14px] font-bold py-2 px-2 rounded transition-all active:scale-95 flex items-center justify-center gap-1">
                                <span class="material-symbols-outlined text-[18px]">calculate</span> Cotizar
                            </button>
                            <a asp-controller="Instructivos" asp-action="Index" class="flex-1 border border-primary text-primary hover:bg-primary-container hover:text-on-primary-container font-title-md text-[14px] font-bold py-2 px-2 rounded transition-colors flex items-center justify-center gap-1">
                                <span class="material-symbols-outlined text-[18px]">menu_book</span> Instructivo
                            </a>
                        </div>
                    </div>
                </article>

                <!-- Product 4 -->
                <article class="bg-surface-container-lowest border border-outline-variant rounded-lg overflow-hidden flex flex-col group hover:shadow-lg transition-shadow duration-300">
                    <div class="relative h-48 w-full overflow-hidden bg-surface-container">
                        <img class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" data-alt="Cocina Minimalista Nogal" src="https://lh3.googleusercontent.com/aida-public/AB6AXuC-JwPKXmLhGqpHmlWsxnM9Hh8qm6CZpU2pW9ESjixkjOmtCVzXfiuv1x04znYtC9PyNJfOsRwWrFJ3Us6eFHCwvUz5wW25SD0Z8zzBRc8xrGCkjkFZDMVfzYrDqP8ufqUXQI2yfAFcDR9rnnY-X9TlPrrtfbBeNH86wtkA5etjOSLn1HjM7gg0t_AUfTDbjZBnm8OQJ9YEvSaISbgBuFdeXvT25JidlUKXge8728t0_irxuwfbHGfiqg">
                    </div>
                    <div class="p-4 flex flex-col flex-grow">
                        <h2 class="font-title-md text-title-md text-primary mb-1">Cocina Minimalista Nogal</h2>
                        <p class="font-label-md text-label-md text-on-surface-variant mb-2">Cocinas</p>
                        <div class="mb-2">
                            <span class="bg-tertiary-container text-on-tertiary-container text-xs px-2 py-0.5 rounded font-label-md">Madera: Nogal Premium</span>
                        </div>
                        <p class="font-body-md text-sm text-on-surface mb-4 flex-grow line-clamp-3">
                            Líneas puras en nogal premium. Frentes lisos sin tiradores visibles, maximizando el protagonismo de la textura natural.
                        </p>
                        <div class="bg-surface-container-high p-2 rounded mb-4 flex flex-col gap-1">
                            <span class="font-label-md text-xs text-on-surface-variant flex items-center gap-1">
                                <span class="material-symbols-outlined text-[14px]">straighten</span> A Medida
                            </span>
                        </div>
                        <div class="flex gap-2 mt-auto">
                            <button type="button" onclick="abrirModalCotizarProducto('Cocina Minimalista Nogal', 'nogal', 85, 260, 60)" class="flex-1 bg-primary hover:bg-secondary text-on-primary font-title-md text-[14px] font-bold py-2 px-2 rounded transition-all active:scale-95 flex items-center justify-center gap-1">
                                <span class="material-symbols-outlined text-[18px]">calculate</span> Cotizar
                            </button>
                            <a asp-controller="Instructivos" asp-action="Index" class="flex-1 border border-primary text-primary hover:bg-primary-container hover:text-on-primary-container font-title-md text-[14px] font-bold py-2 px-2 rounded transition-colors flex items-center justify-center gap-1">
                                <span class="material-symbols-outlined text-[18px]">menu_book</span> Instructivo
                            </a>
                        </div>
                    </div>
                </article>

                <!-- Product 5 -->
                <article class="bg-surface-container-lowest border border-outline-variant rounded-lg overflow-hidden flex flex-col group hover:shadow-lg transition-shadow duration-300">
                    <div class="relative h-48 w-full overflow-hidden bg-surface-container">
                        <img alt="Comedor Roble Macizo"
                             class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                             src="~/images/comedor.jpeg">
                    </div>
                    <div class="p-4 flex flex-col flex-grow">
                        <h2 class="font-title-md text-title-md text-primary mb-1">Comedor Roble Macizo</h2>
                        <p class="font-label-md text-label-md text-on-surface-variant mb-2">Mesas</p>
                        <p class="font-body-md text-sm text-on-surface mb-4 flex-grow line-clamp-3">
