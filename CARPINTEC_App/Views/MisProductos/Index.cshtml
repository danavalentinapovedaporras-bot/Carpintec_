    <!-- ========================================================================= -->
    <!-- JAVASCRIPT: CONTROL DE LA VENTANA EMERGENTE Y CÁLCULOS DINÁMICOS          -->
    <!-- ========================================================================= -->
    <script>
        // 1. Abrir Modal precargando la información del producto clickeado
        function abrirModalCotizarProducto(nombreProducto, madera, alto, ancho, prof) {
            const modal = document.getElementById('modalNuevaCotizacion');
            
            // Pre-llenar campo de producto
            const inputProducto = document.getElementById('modal-product-name');
            if (inputProducto) inputProducto.value = nombreProducto || "Mueble a Medida";

            // Pre-seleccionar madera si coincide
            const selectMadera = document.getElementById('modal-wood-select');
            if (selectMadera && madera) {
                const maderaLower = madera.toLowerCase();
                if (maderaLower.includes('roble')) selectMadera.value = 'roble';
                else if (maderaLower.includes('pino')) selectMadera.value = 'pino';
                else if (maderaLower.includes('cedro') || maderaLower.includes('cerezo') || maderaLower.includes('caoba')) selectMadera.value = 'cedro';
                else if (maderaLower.includes('nogal') || maderaLower.includes('ébano') || maderaLower.includes('ebano')) selectMadera.value = 'nogal';
            }

            // Pre-llenar medidas
            if (document.getElementById('modal-alto')) document.getElementById('modal-alto').value = alto || 80;
            if (document.getElementById('modal-ancho')) document.getElementById('modal-ancho').value = ancho || 120;
            if (document.getElementById('modal-profundidad')) document.getElementById('modal-profundidad').value = prof || 60;

            // Cantidad a 1
            if (document.getElementById('modal-cantidad')) document.getElementById('modal-cantidad').value = 1;

            // Actualizar gráficos y cálculos
            actualizarGraficoSvg();
            recalcularTotalCotizacionModal();

            // Mostrar modal
            modal.classList.remove('hidden');
            document.body.style.overflow = 'hidden';
        }

        // 2. Cerrar Modal
        function cerrarModalCotizacion() {
            const modal = document.getElementById('modalNuevaCotizacion');
            modal.classList.add('hidden');
            document.body.style.overflow = 'auto';
        }

        // Cerrar al hacer clic en el backdrop oscuro
        document.getElementById('modalNuevaCotizacion')?.addEventListener('click', function(e) {
            if (e.target === this) cerrarModalCotizacion();
        });

        // 3. Sugerencias rápidas de producto
        function seleccionarSugerencia(texto) {
            const input = document.getElementById('modal-product-name');
            if (input) input.value = texto;
        }

        // 4. Cambiar Cantidad (+ y -)
        function cambiarCantidadModal(delta) {
            const input = document.getElementById('modal-cantidad');
            let val = parseInt(input.value) || 1;
            val += delta;
            if (val < 1) val = 1;
            input.value = val;
            recalcularTotalCotizacionModal();
        }

        // 5. Actualizar cotas en el Esquema 3D SVG
        function actualizarGraficoSvg() {
            const alto = document.getElementById('modal-alto')?.value || 80;
            const ancho = document.getElementById('modal-ancho')?.value || 120;
            const prof = document.getElementById('modal-profundidad')?.value || 60;

            const textAlto = document.getElementById('svgTextAlto');
            const textAncho = document.getElementById('svgTextAncho');
            const textProf = document.getElementById('svgTextProfundidad');
            const textFull = document.getElementById('svgTextDimensionesFull');

            if (textAlto) textAlto.textContent = `${alto} cm`;
            if (textAncho) textAncho.textContent = `${ancho} cm`;
            if (textProf) textProf.textContent = `${prof} cm`;
            if (textFull) textFull.textContent = `Cotas: ${alto}cm (alto) × ${ancho}cm (ancho) × ${prof}cm (prof.)`;
        }

        // 6. Vista previa de la foto del espacio
        function mostrarVistaPreviaFotoModal(event) {
            const file = event.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    const img = document.getElementById('modalFotoPreview');
                    const ph = document.getElementById('modalFotoPlaceholder');
                    if (img && ph) {
                        img.src = e.target.result;
                        img.classList.remove('hidden');
                        ph.classList.add('hidden');
                    }
                }
                reader.readAsDataURL(file);
            }
        }

        // 7. Cálculo dinámico de totales y desglose
        function recalcularTotalCotizacionModal() {
            const maderaSelect = document.getElementById('modal-wood-select');
            const cantidadInput = document.getElementById('modal-cantidad');
            if (!maderaSelect || !cantidadInput) return;

            const madera = maderaSelect.value;
            const cantidad = parseInt(cantidadInput.value) || 1;

            let precioBaseMadera = 320000;
            let nombreMadera = "Pino Macizo";

            if (madera === 'roble') {
                precioBaseMadera = 500000;
                nombreMadera = "Roble Europeo";
            } else if (madera === 'cedro') {
                precioBaseMadera = 460000;
                nombreMadera = "Cedro Rojo Tradicional";
            } else if (madera === 'nogal') {
                precioBaseMadera = 580000;
                nombreMadera = "Nogal Americano Prémium";
            }

            // Actualizar badge de precio base
            const badge = document.getElementById('modalWoodBasePriceBadge');
            if (badge) badge.innerText = `Precio Base: $${precioBaseMadera.toLocaleString('es-CO')} COP`;

            const subtotalMadera = precioBaseMadera * cantidad;
            const manoObra = 120000 * cantidad;
            const subtotalBruto = subtotalMadera + manoObra;

            // Verificar si seleccionó transferencia (-5%)
            const radioTransferencia = document.querySelector('input[name="payment_method"][value="transferencia"]');
            let descuento = 0;
            if (radioTransferencia && radioTransferencia.checked) {
                descuento = Math.round(subtotalBruto * 0.05);
            }

            const totalFinal = subtotalBruto - descuento;

            // Actualizar desglose en pantalla
            const txtMadera = document.getElementById('modalSummaryMaderaText');
            if (txtMadera) txtMadera.innerText = `Madera (${nombreMadera} × ${cantidad}):`;

            const valMadera = document.getElementById('modalSummaryMaderaVal');
            if (valMadera) valMadera.innerText = `$${subtotalMadera.toLocaleString('es-CO')}`;

            const valManoObra = document.getElementById('modalSummaryManoObraVal');
            if (valManoObra) valManoObra.innerText = `$${manoObra.toLocaleString('es-CO')}`;

            const rowDescuento = document.getElementById('modalRowDescuento');
            const badgeDescuento = document.getElementById('modalDiscountBadge');
            const valDescuento = document.getElementById('modalSummaryDescuentoVal');

            if (descuento > 0) {
                if (rowDescuento) rowDescuento.classList.remove('hidden');
                if (badgeDescuento) badgeDescuento.classList.remove('hidden');
                if (valDescuento) valDescuento.innerText = `-$${descuento.toLocaleString('es-CO')}`;
            } else {
                if (rowDescuento) rowDescuento.classList.add('hidden');
                if (badgeDescuento) badgeDescuento.classList.add('hidden');
            }

            const totalGrande = document.getElementById('modalTotalGrande');
            if (totalGrande) {
                totalGrande.innerText = `$${totalFinal.toLocaleString('es-CO')}`;
            }
        }

        // 8. Enviar la cotización generada al servidor
        async function enviarCotizacionDesdeCatalogo() {
            const producto = document.getElementById('modal-product-name')?.value?.trim();
            const cliente = document.getElementById('modal-client-name')?.value?.trim();
            const telefono = document.getElementById('modal-client-phone')?.value?.trim();
            const email = document.getElementById('modal-client-email')?.value?.trim();
            const maderaSelect = document.getElementById('modal-wood-select');
            const maderaTexto = maderaSelect?.options[maderaSelect.selectedIndex]?.text?.split('-')[0]?.trim() || "Pino Macizo";
            const cantidad = parseInt(document.getElementById('modal-cantidad')?.value) || 1;
            const alto = parseFloat(document.getElementById('modal-alto')?.value) || 80;
            const ancho = parseFloat(document.getElementById('modal-ancho')?.value) || 120;
            const profundidad = parseFloat(document.getElementById('modal-profundidad')?.value) || 60;
            const observaciones = document.getElementById('modal-observaciones')?.value?.trim() || "";

            if (!producto) {
                alert('Por favor especifica el nombre del producto.');
                document.getElementById('modal-product-name')?.focus();
                return;
            }

            if (!cliente) {
                alert('Por favor ingresa tu nombre de cliente.');
                document.getElementById('modal-client-name')?.focus();
                return;
            }

            // Extraer total numérico limpio
            let totalVal = 418000;
            const totalElement = document.getElementById('modalTotalGrande');
            if (totalElement) {
                const soloNums = totalElement.innerText.replace(/[^0-9]/g, '');
                if (soloNums) totalVal = parseFloat(soloNums);
            }

            const btn = document.getElementById('btnGenerarCotizacionModal');
            const htmlOriginal = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = `<i class="fa-solid fa-spinner fa-spin"></i> <span>Enviando proforma al taller...</span>`;

            try {
                const formData = new FormData();
                formData.append('nombreCliente', cliente);
                formData.append('telefono', telefono);
                formData.append('correo', email);
                formData.append('producto', producto);
                formData.append('madera', maderaTexto);
                formData.append('cantidad', cantidad);
                formData.append('alto', alto);
                formData.append('ancho', ancho);
                formData.append('profundidad', profundidad);
                formData.append('observaciones', observaciones);
                formData.append('total', totalVal);

                const fileInput = document.getElementById('modal-foto-input');
                if (fileInput && fileInput.files.length > 0) {
                    formData.append('fotoLugar', fileInput.files[0]);
                }

                // Intentar enviar a /MisProductos/GuardarCotizacion o a /MiCotizacion/GuardarCotizacion
                let response = await fetch('/MisProductos/GuardarCotizacion', {
                    method: 'POST',
                    body: formData
                });

                if (!response.ok) {
                    response = await fetch('/MiCotizacion/GuardarCotizacion', {
                        method: 'POST',
                        body: formData
                    });
                }

                const data = await response.json();

                if (data.success) {
                    cerrarModalCotizacion();
                    const msg = (data.message || '¡Cotización y Pedido registrados exitosamente!') + 
                                '\n\n• Pulsa ACEPTAR para ver el avance de tu orden en "Mis Pedidos".' + 
                                '\n• Pulsa CANCELAR para consultar tu proforma técnica en "Mis Cotizaciones".';
                    if (confirm(msg)) {
                        window.location.href = '/Mi_Pedido';
                    } else {
                        window.location.href = '/MiCotizacion';
                    }
                } else {
                    alert('Error: ' + data.message);
                }
            } catch (err) {
                console.error('Error al enviar cotización:', err);
                alert('Ocurrió un error al conectar con el servidor. Por favor intenta de nuevo.');
            } finally {
                btn.disabled = false;
                btn.innerHTML = htmlOriginal;
            }
        }
    </script>
</body>
</html>