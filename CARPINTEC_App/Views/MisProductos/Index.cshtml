                                <h4 class="text-xs font-bold uppercase tracking-wider text-[#4A3222]">Resumen Total</h4>
                                <span id="modalDiscountBadge" class="text-[10px] font-semibold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded border border-emerald-200">
                                    Descuento Aplicado
                                </span>
                            </div>
                            <div class="space-y-2.5 text-xs">
                                <div class="flex justify-between text-[#685444]">
                                    <span id="modalSummaryMaderaText">Madera (Roble Europeo):</span>
                                    <span id="modalSummaryMaderaVal" class="font-medium text-[#2E1F14]">$500.000</span>
                                </div>
                                <div class="flex justify-between text-[#685444]">
                                    <span>Mano de obra artesanal y ensamble:</span>
                                    <span id="modalSummaryManoObraVal" class="font-medium text-[#2E1F14]">$120.000</span>
                                </div>
                                <div class="flex justify-between text-[#685444]">
                                    <span>Acabado poliuretano resistente:</span>
                                    <span class="font-medium text-emerald-700">Incluido</span>
                                </div>
                                <div id="modalRowDescuento" class="flex justify-between text-emerald-700 font-medium">
                                    <span>Descuento Transferencia (-5%):</span>
                                    <span id="modalSummaryDescuentoVal">-$31.000</span>
                                </div>
                                <div class="pt-3 border-t border-[#EAE0D4] mt-3">
                                    <div class="flex items-baseline justify-between">
                                        <div>
                                            <span class="text-xs font-bold uppercase tracking-wide text-[#3F2B1C] block">Total Estimado:</span>
                                            <span class="text-[10px] text-[#8C7665]">*IVA incluido (COP)</span>
                                        </div>
                                        <div class="text-right">
                                            <span id="modalTotalGrande" class="text-2xl font-black text-[#8B4513] tracking-tight">$589.000</span>
                                            <span class="text-[11px] font-bold text-[#8B4513] block">COP</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <!-- Validity Notice -->
                            <div class="mt-4 pt-3 border-t border-dashed border-[#E5DACD] flex items-center justify-between text-[10px] text-[#8C7665]">
                                <span>Vigencia: 15 días calendario</span>
                                <span class="font-semibold text-[#5B3920]">Garantía: 2 Años</span>
                            </div>
                        </div>

                        <!-- CARD 4: Wood Palette Reference Guide -->
                        <div class="bg-[#FFFDFB] rounded-2xl border border-[#E7DCCE] p-5 shadow-sm">
                            <h4 class="text-[11px] font-bold uppercase tracking-wider text-[#4A3222] mb-3">Guía Rápida de Maderas</h4>
                            <div class="grid grid-cols-2 gap-2 text-xs">
                                <div class="flex items-center gap-2 p-1.5 rounded-lg bg-[#FAF6F0] border border-[#EADBCC]">
                                    <span class="w-3.5 h-3.5 rounded-full bg-[#D4A373] shadow-inner"></span>
                                    <div>
                                        <span class="font-bold text-[11px] text-[#3E291B] block">Pino Macizo</span>
                                        <span class="text-[9px] text-[#86705F]">Cálido y versátil</span>
                                    </div>
                                </div>
                                <div class="flex items-center gap-2 p-1.5 rounded-lg bg-[#FAF6F0] border border-[#EADBCC]">
                                    <span class="w-3.5 h-3.5 rounded-full bg-[#936639] shadow-inner"></span>
                                    <div>
                                        <span class="font-bold text-[11px] text-[#3E291B] block">Roble Natural</span>
                                        <span class="text-[9px] text-[#86705F]">Vetas marcadas</span>
                                    </div>
                                </div>
                                <div class="flex items-center gap-2 p-1.5 rounded-lg bg-[#FAF6F0] border border-[#EADBCC]">
                                    <span class="w-3.5 h-3.5 rounded-full bg-[#A65B32] shadow-inner"></span>
                                    <div>
                                        <span class="font-bold text-[11px] text-[#3E291B] block">Cedro</span>
                                        <span class="text-[9px] text-[#86705F]">Aromático &amp; fino</span>
                                    </div>
                                </div>
                                <div class="flex items-center gap-2 p-1.5 rounded-lg bg-[#FAF6F0] border border-[#EADBCC]">
                                    <span class="w-3.5 h-3.5 rounded-full bg-[#58311F] shadow-inner"></span>
                                    <div>
                                        <span class="font-bold text-[11px] text-[#3E291B] block">Nogal</span>
                                        <span class="text-[9px] text-[#86705F]">Oscuro elegante</span>
                                    </div>
                                </div>
