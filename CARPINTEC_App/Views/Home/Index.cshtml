@{
    Layout = null;
}
<!DOCTYPE html>
<html class="light" lang="es">
<head>
    <meta charset="utf-8">
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <title>CARPINTEC</title>
    <!-- Material Symbols -->
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet">
    <!-- Google Fonts: Montserrat & Work Sans -->
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&amp;family=Work+Sans:wght@400;500&amp;display=swap" rel="stylesheet">
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    "colors": {
                        "primary-fixed": "#ffdbc9",
                        "secondary-container": "#fd8a3e",
                        "on-surface-variant": "#54433a",
                        "on-tertiary": "#ffffff",
                        "outline": "#877369",
                        "secondary-fixed-dim": "#ffb68d",
                        "surface-container-low": "#fef1ed",
                        "on-secondary-container": "#672c00",
                        "surface-dim": "#e4d7d4",
                        "surface": "#fff8f6",
                        "surface-container-highest": "#ede0dc",
                        "primary-container": "#8b4513",
                        "surface-tint": "#934b19",
                        "tertiary-fixed": "#f7e0b5",
                        "tertiary-container": "#665635",
                        "on-primary-fixed": "#321200",
                        "on-background": "#201a18",
                        "secondary": "#9a4600",
                        "secondary-fixed": "#ffdbc9",
                        "error": "#ba1a1a",
                        "surface-variant": "#ede0dc",
                        "outline-variant": "#dac2b6",
                        "on-secondary": "#ffffff",
                        "on-secondary-fixed-variant": "#763400",
                        "surface-container": "#f9ebe7",
                        "inverse-surface": "#362f2c",
                        "on-tertiary-fixed": "#251a01",
                        "on-primary-container": "#ffc29f",
                        "on-primary": "#ffffff",
                        "tertiary-fixed-dim": "#dac49b",
                        "inverse-primary": "#ffb68c",
                        "tertiary": "#4d3f20",
                        "error-container": "#ffdad6",
                        "on-surface": "#201a18",
                        "surface-container-lowest": "#ffffff",
                        "inverse-on-surface": "#fbeeea",
                        "on-error-container": "#93000a",
                        "on-secondary-fixed": "#321200",
                        "background": "#fff8f6",
                        "on-primary-fixed-variant": "#753401",
                        "primary": "#6c2f00",
                        "surface-bright": "#fff8f6",
                        "on-error": "#ffffff",
                        "on-tertiary-container": "#e2cca2",
                        "surface-container-high": "#f3e5e1",
                        "primary-fixed-dim": "#ffb68c",
                        "on-tertiary-fixed-variant": "#544525"
                    },
                    "borderRadius": {
                        "DEFAULT": "0.125rem",
                        "lg": "0.25rem",
                        "xl": "0.5rem",
                        "full": "0.75rem"
                    },
                    "spacing": {
                        "margin-desktop": "64px",
                        "container-max": "1280px",
                        "gutter": "24px",
                        "base": "8px",
                        "margin-mobile": "16px"
                    },
                    "fontFamily": {
                        "headline-lg-mobile": ["Montserrat"],
                        "label-md": ["Work Sans"],
                        "title-md": ["Montserrat"],
                        "headline-lg": ["Montserrat"],
                        "display-lg": ["Montserrat"],
                        "body-lg": ["Work Sans"],
                        "body-md": ["Work Sans"]
                    },
                    "fontSize": {
                        "headline-lg-mobile": ["24px", {"lineHeight": "32px", "fontWeight": "700"}],
                        "label-md": ["14px", {"lineHeight": "20px", "letterSpacing": "0.05em", "fontWeight": "500"}],
                        "title-md": ["20px", {"lineHeight": "28px", "fontWeight": "600"}],
                        "headline-lg": ["32px", {"lineHeight": "40px", "fontWeight": "700"}],
                        "display-lg": ["48px", {"lineHeight": "56px", "letterSpacing": "-0.02em", "fontWeight": "700"}],
                        "body-lg": ["18px", {"lineHeight": "28px", "fontWeight": "400"}],
                        "body-md": ["16px", {"lineHeight": "24px", "fontWeight": "400"}]
                    }
                },
            },
        }
    </script>
    <style>
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
            display: inline-block;
            vertical-align: middle;
        }

        .hero-overlay {
            background: linear-gradient(rgba(0,0,0,0.3), rgba(0,0,0,0.3));
        }

        .section-frame {
            border-bottom: 4px solid #6c2f00;
        }

        .mobile-nav-active {
            color: #ffdbc9;
            font-weight: 700;
        }

        body {
            min-height: max(884px, 100dvh);
        }
    </style>
</head>
<body class="bg-background text-on-background font-body-md">
    <!-- TopAppBar -->
    <header class="bg-primary dark:bg-primary-container shadow-md fixed top-0 w-full z-50 border-b-4 border-primary dark:border-primary-fixed">
        <div class="flex justify-between items-center px-margin-mobile md:px-margin-desktop py-4 w-full max-w-container-max mx-auto">
            <div class="flex items-center gap-2">
                <img alt="Carpintec Logo"
                     class="h-8 w-8 object-contain mr-2"
                     src="~/images/logo.png">

                <span class="font-headline-lg-mobile md:font-headline-lg text-headline-lg-mobile md:text-headline-lg font-bold text-on-primary dark:text-on-primary-container tracking-tight">
                    CARPINTEC
                </span>
            </div>
            <!-- Mobile Menu Toggle -->
            <button class="md:hidden text-on-primary" id="mobile-menu-btn" type="button">
                <span class="material-symbols-outlined text-4xl">menu</span>
            </button>
            <!-- Desktop Nav -->
            <nav class="hidden md:flex items-center space-x-8">
                <a class="text-on-primary font-bold border-b-2 border-on-primary pb-1 font-label-md text-label-md" href="#inicio">Inicio</a>
                <a class="text-on-primary/80 font-medium hover:text-secondary-fixed transition-colors font-label-md text-label-md" href="#acerca-de">Acerca de</a>
                <a asp-controller="Login"
                   asp-action="Index"
                   class="bg-primary-fixed text-on-primary-fixed px-6 py-2 rounded-full font-bold hover:bg-secondary-fixed transition-colors flex items-center justify-center font-label-md text-label-md">
                    Iniciar sesión
                </a>

                <a class="bg-primary-fixed text-on-primary-fixed px-6 py-2 rounded-full font-bold hover:bg-secondary-fixed transition-colors flex items-center justify-center" href="#contacto-form">Contacto</a>
            </nav>
        </div>
        <!-- Mobile Dropdown Menu -->
        <div class="hidden absolute top-full left-0 w-full bg-primary border-t border-on-primary/10 flex-col p-6 space-y-4 shadow-xl" id="mobile-menu">
            <a class="mobile-nav-active font-label-md text-label-md" href="#inicio">Inicio</a>
            <a class="text-on-primary/80 font-label-md text-label-md" href="#acerca-de">Acerca de</a>
            <a class="text-on-primary/80 font-label-md text-label-md" href="#servicios">Servicios</a>
            <a class="text-on-primary/80 font-label-md text-label-md" href="#trabajos">Trabajos</a>
            <hr class="border-on-primary/20">
            <a class="bg-primary-fixed text-on-primary-fixed px-6 py-3 rounded-full font-bold text-center" href="#contacto-form">Contacto</a>
        </div>
    </header>

    <main class="mt-16">
        <!-- Hero Section -->
        <section class="relative min-h-[600px] flex items-center justify-center bg-cover bg-center" id="inicio" style="background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuBIRI0zzQd6UKFQGDFcHlHhktv2loHmc-9CSBZq5t8E-5kVrgRgQtzAlvG5ih-eT1ZykFCypW9CooXTBwgTNR6am3ArTkLSpioPLADeUl5w5ZH7xinNNvWjJ1pINpFrz4a_E-jzNsO2M4oEY1JdZZtSDQ_3Mj7bEYsmzUGqBVPD2jobDC7xdE2ovb0u_D3KDx1IYyVXu1yocowQmJG3kcpBHOYPXpzlmL_MEioZJShFdlwyk5AULwv_MPPgKuavUfTt2NSR7XtEsncAJ2o');">
            <div class="absolute inset-0 hero-overlay"></div>
            <div class="relative z-20 flex flex-col items-center justify-center text-center px-4">
                <h1 class="font-display-lg text-display-lg text-white drop-shadow-lg mb-4">
                    Pequeños detalles, grandes resultados
                </h1>
                <div class="w-24 h-1 bg-primary-fixed rounded-full shadow-sm"></div>
            </div>
        </section>

        <!-- Acerca de Section -->
        <section class="py-16 md:py-24 bg-surface section-frame" id="acerca-de">
            <div class="px-margin-mobile md:px-margin-desktop max-w-container-max mx-auto flex flex-col md:flex-row items-center gap-12">
                <div class="md:w-1/2 order-2 md:order-1">
                    <h2 class="font-headline-lg-mobile md:font-headline-lg text-headline-lg-mobile md:text-headline-lg text-primary mb-6 relative">
                        Acerca de
                        <span class="block w-16 h-1 bg-secondary mt-2"></span>
                    </h2>
                    <p class="font-body-lg text-body-lg text-on-surface-variant leading-relaxed">
                        Carpintec es un proyecto dedicado al diseño y fabricación de muebles en madera, ofreciendo soluciones personalizadas con calidad, innovación y cumplimiento, apoyado en un sistema que optimiza la gestión de clientes, cotizaciones y pedidos.
                    </p>
                </div>
                <div class="md:w-1/2 order-1 md:order-2">
                    <div class="relative p-2 border-4 border-primary">
                        <img alt="Artesana trabajando" class="w-full h-[400px] object-cover" src="https://lh3.googleusercontent.com/aida-public/AB6AXuC6W4-QZ06te5tSfP0ssLG7MS-A66MpUZLQJT74tjKeYPIa9jNhSpX3i00u3jTV6PG12_8QselkfHf4t_WlCl6C_k2WyyyPpo_rN0VtERK7y6bL7lo2DqbSUr-Pnb-W2TWz9ukAIQAyXbUIEpC7vE-HDqE4-sF2puoxcNcKbpt-rvZw8VbIwU_5niQbmn2wKMy_TN50DMpGtjvyyxBK-yYK1642IVCLS1f8BsLr0Pxp5-zCCpthRsyrepXVNHHFEjVM4TVTaTmE9HB4">
                    </div>
                </div>
            </div>
        </section>

        <!-- Nuestros Servicios Section -->
        <section class="py-16 md:py-24 bg-surface-container section-frame" id="servicios">
            <div class="px-margin-mobile md:px-margin-desktop max-w-container-max mx-auto">
                <div class="text-center mb-16">
                    <h2 class="font-headline-lg-mobile md:font-headline-lg text-headline-lg-mobile md:text-headline-lg text-primary mb-4">Nuestros Servicios</h2>
                    <p class="font-body-md text-on-surface-variant max-w-2xl mx-auto">Transformamos tus ideas en muebles únicos y funcionales para cada rincón de tu hogar.</p>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-gutter">
                    <!-- Service Card 1 -->
                    <div class="bg-white p-8 border-t-4 border-primary shadow-sm hover:shadow-md transition-shadow flex flex-col items-center text-center">
                        <span class="material-symbols-outlined text-primary text-5xl mb-6">countertops</span>
                        <h3 class="font-title-md text-title-md text-primary mb-4">Cocinas Integrales</h3>
                        <p class="font-body-md text-on-surface-variant mb-8">Diseño y fabricación de cocinas personalizadas que maximizan la funcionalidad.</p>
                        <button type="button"
        onclick="abrirCatalogoCocinas()"
        class="bg-[#442a22] text-white px-6 py-3 rounded-lg hover:bg-[#5a382d] transition">
    Ver catálogo de cocinas
</button>
                    </div>

                    <!-- Service Card 2 -->
                    <div class="bg-white p-8 border-t-4 border-primary shadow-sm hover:shadow-md transition-shadow flex flex-col items-center text-center">
                        <span class="material-symbols-outlined text-primary text-5xl mb-6">door_sliding</span>
                        <h3 class="font-title-md text-title-md text-primary mb-4">Closets y Armarios</h3>
                        <p class="font-body-md text-on-surface-variant mb-8">Armarios a medida que aprovechan cada centímetro de espacio en tu habitación.</p>
                        <button onclick="abrirCatalogoClosets()" class="mt-auto bg-[#442a22] text-white px-6 py-2.5 rounded-lg flex items-center gap-2 hover:bg-[#5a382d] transition-colors font-medium text-sm" type="button">
                            Ver catálogo de closets <span class="material-symbols-outlined text-sm">chevron_right</span>
                        </button>
                    </div>
                   <!-- Service Card 3 -->
            <div class="bg-white p-8 border-t-4 border-primary shadow-sm hover:shadow-md transition-shadow flex flex-col items-center text-center">
                  <span class="material-symbols-outlined text-primary text-5xl mb-6">handyman</span>
                <h3 class="font-title-md text-title-md text-primary mb-4">Muebles a Medida</h3>
                  <p class="font-body-md text-on-surface-variant mb-8">Mobiliario personalizado para el hogar y oficina con materiales de alta gama.</p>
                <button onclick="abrirCatalogoMuebles()" class="mt-auto bg-[#442a22] text-white px-6 py-2.5 rounded-lg flex items-center gap-2 hover:bg-[#5a382d] transition-colors font-medium text-sm" type="button">
                       Ver catálogo de muebles <span class="material-symbols-outlined text-sm">chevron_right</span>
                </button>

                    </div>
                </div>
            </div>
        </section>
        <!-- Modal de Catálogo Completo -->
        <dialog id="modalCatalogoCocinas" class="backdrop:bg-black/60 backdrop:backdrop-blur-sm p-0 rounded-2xl border border-[#e8dcd0] shadow-2xl max-w-5xl w-[92%] max-h-[90vh] bg-[#faf6f0] overflow-hidden">
            <div class="flex flex-col h-full max-h-[90vh]">

                <!-- Header -->
                <div class="flex items-center justify-between px-6 py-4 border-b border-[#e8dcd0] bg-white sticky top-0 z-10">
                    <div>
                        <h3 class="text-xl font-bold text-[#442a22]">Catálogo de Cocinas Integrales</h3>
                        <p class="text-xs text-gray-500">Explora todos nuestros diseños, materiales y acabados</p>
                    </div>
                    <button type="button" onclick="cerrarCatalogoCocinas()" class="text-2xl text-gray-400 hover:text-[#442a22] transition leading-none">&times;</button>
                </div>

                <!-- Contenido con scroll y más modelos -->
                <div class="p-6 overflow-y-auto">

                    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-5">

                        <!-- Tarjeta 1 -->
                        <div class="bg-white rounded-xl border border-[#e8dcd0] overflow-hidden flex flex-col shadow-sm hover:shadow-md transition">
                            <img src="https://images.unsplash.com/photo-1556911220-e15b29be8c8f?w=500" alt="Cocina Roble Minimalista" class="w-full h-44 object-cover">
                            <div class="p-4 flex flex-col flex-grow justify-between gap-3">
                                <div>
                                    <h4 class="font-bold text-[#442a22] text-sm">Cocina Roble Minimalista</h4>
                                    <p class="text-xs text-gray-600 mt-1">Gabinetes lisos con apertura gola (sin tiradores) y mesón en cuarzo blanco resistente.</p>
                                </div>
                                <a href="https://wa.me/TUNUMERO?text=Hola,%20me%20interesa%20la%20Cocina%20Roble%20Minimalista" target="_blank" class="w-full text-center text-xs font-semibold bg-[#442a22] hover:bg-[#5a382d] text-white py-2.5 rounded-lg transition">
                                    Cotizar este diseño
                                </a>
                            </div>
                        </div>

                        <!-- Tarjeta 2 -->
                        <div class="bg-white rounded-xl border border-[#e8dcd0] overflow-hidden flex flex-col shadow-sm hover:shadow-md transition">
                            <img src="https://images.unsplash.com/photo-1507089947368-19c1da9775ae?w=500" alt="Cocina Clásica Campestre" class="w-full h-44 object-cover">
                            <div class="p-4 flex flex-col flex-grow justify-between gap-3">
                                <div>
                                    <h4 class="font-bold text-[#442a22] text-sm">Cocina Clásica Campestre</h4>
                                    <p class="text-xs text-gray-600 mt-1">Estructura en madera sólida tratada con alacenas de vidrio y amplia isla central.</p>
                                </div>
                                <a href="https://wa.me/TUNUMERO?text=Hola,%20me%20interesa%20la%20Cocina%20Clásica%20Campestre" target="_blank" class="w-full text-center text-xs font-semibold bg-[#442a22] hover:bg-[#5a382d] text-white py-2.5 rounded-lg transition">
                                    Cotizar este diseño
                                </a>
                            </div>
                        </div>

                        <!-- Tarjeta 3 -->
                        <div class="bg-white rounded-xl border border-[#e8dcd0] overflow-hidden flex flex-col shadow-sm hover:shadow-md transition">
                            <img src="https://images.unsplash.com/photo-1512917774080-9991f1c4c750?w=500" alt="Cocina Premium con Barra" class="w-full h-44 object-cover">
                            <div class="p-4 flex flex-col flex-grow justify-between gap-3">
                                <div>
                                    <h4 class="font-bold text-[#442a22] text-sm">Cocina Premium con Barra</h4>
                                    <p class="text-xs text-gray-600 mt-1">Iluminación LED integrada, torre de hornos empotrada y barra desayunadora.</p>
                                </div>
                                <a href="https://wa.me/TUNUMERO?text=Hola,%20me%20interesa%20la%20Cocina%20Premium%20con%20Barra" target="_blank" class="w-full text-center text-xs font-semibold bg-[#442a22] hover:bg-[#5a382d] text-white py-2.5 rounded-lg transition">
                                    Cotizar este diseño
                                </a>
                            </div>
                        </div>

                        <!-- Tarjeta 4 -->
                        <div class="bg-white rounded-xl border border-[#e8dcd0] overflow-hidden flex flex-col shadow-sm hover:shadow-md transition">
                            <img src="https://images.unsplash.com/photo-1556912172-45b7abe8b7e1?w=500" alt="Cocina Industrial Grafito" class="w-full h-44 object-cover">
                            <div class="p-4 flex flex-col flex-grow justify-between gap-3">
                                <div>
                                    <h4 class="font-bold text-[#442a22] text-sm">Cocina Industrial Grafito</h4>
                                    <p class="text-xs text-gray-600 mt-1">Combinación de acabados mate oscuros, detalles metálicos y repisas flotantes.</p>
                                </div>
                                <a href="https://wa.me/TUNUMERO?text=Hola,%20me%20interesa%20la%20Cocina%20Industrial%20Grafito" target="_blank" class="w-full text-center text-xs font-semibold bg-[#442a22] hover:bg-[#5a382d] text-white py-2.5 rounded-lg transition">
                                    Cotizar este diseño
                                </a>
                            </div>
                        </div>

                        <!-- Tarjeta 5 -->
                        <div class="bg-white rounded-xl border border-[#e8dcd0] overflow-hidden flex flex-col shadow-sm hover:shadow-md transition">
                            <img src="https://images.unsplash.com/photo-1484154218962-a197022b5858?w=500" alt="Cocina Nórdica Escandinava" class="w-full h-44 object-cover">
                            <div class="p-4 flex flex-col flex-grow justify-between gap-3">
                                <div>
                                    <h4 class="font-bold text-[#442a22] text-sm">Cocina Nórdica Escandinava</h4>
                                    <p class="text-xs text-gray-600 mt-1">Tonos claros que maximizan la luz natural, ideal para apartamentos o espacios compactos.</p>
                                </div>
                                <a href="https://wa.me/TUNUMERO?text=Hola,%20me%20interesa%20la%20Cocina%20Nórdica%20Escandinava" target="_blank" class="w-full text-center text-xs font-semibold bg-[#442a22] hover:bg-[#5a382d] text-white py-2.5 rounded-lg transition">
                                    Cotizar este diseño
                                </a>
                            </div>
                        </div>

                        <!-- Tarjeta 6 -->
                        <div class="bg-white rounded-xl border border-[#e8dcd0] overflow-hidden flex flex-col shadow-sm hover:shadow-md transition">
                            <img src="https://images.unsplash.com/photo-1600585154340-be6161a56a0c?w=500" alt="Cocina Integral Tipo Loft" class="w-full h-44 object-cover">
                            <div class="p-4 flex flex-col flex-grow justify-between gap-3">
                                <div>
                                    <h4 class="font-bold text-[#442a22] text-sm">Cocina Abierta Tipo Loft</h4>
                                    <p class="text-xs text-gray-600 mt-1">Integración fluida con el área social y muebles altos de gran capacidad.</p>
                                </div>
                                <a href="https://wa.me/TUNUMERO?text=Hola,%20me%20interesa%20la%20Cocina%20Abierta%20Tipo%20Loft" target="_blank" class="w-full text-center text-xs font-semibold bg-[#442a22] hover:bg-[#5a382d] text-white py-2.5 rounded-lg transition">
                                    Cotizar este diseño
                                </a>
                            </div>
                        </div>

                    </div>

                </div>
            </div>
        </dialog>
        <!-- Modal de Catálogo de Closets y Armarios -->
        <dialog id="modalCatalogoClosets" class="backdrop:bg-black/60 backdrop:backdrop-blur-sm p-0 rounded-2xl border border-[#e8dcd0] shadow-2xl max-w-5xl w-[92%] max-h-[90vh] bg-[#faf6f0] overflow-hidden">
            <div class="flex flex-col h-full max-h-[90vh]">

                <!-- Header -->
                <div class="flex items-center justify-between px-6 py-4 border-b border-[#e8dcd0] bg-white sticky top-0 z-10">
                    <div>
                        <h3 class="text-xl font-bold text-[#442a22]">Catálogo de Closets y Armarios</h3>
                        <p class="text-xs text-gray-500">Diseños funcionales y optimizados a la medida de tu espacio</p>
                    </div>
                    <button type="button" onclick="cerrarCatalogoClosets()" class="text-2xl text-gray-400 hover:text-[#442a22] transition leading-none">&times;</button>
                </div>

                <!-- Contenido con scroll y modelos de closets -->
                <div class="p-6 overflow-y-auto">

                    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-5">

                        <!-- Modelo 1 -->
                        <div class="bg-white rounded-xl border border-[#e8dcd0] overflow-hidden flex flex-col shadow-sm hover:shadow-md transition">
                            <img src="https://images.unsplash.com/photo-1558997519-83ea9252def8?w=500" alt="Walk-in Closet Moderno" class="w-full h-44 object-cover">
                            <div class="p-4 flex flex-col flex-grow justify-between gap-3">
                                <div>
                                    <h4 class="font-bold text-[#442a22] text-sm">Walk-in Closet Premium</h4>
                                    <p class="text-xs text-gray-600 mt-1">Vestidor abierto con iluminación LED en repisas, zapateros inclinados e isla central para accesorios.</p>
                                </div>
                                <a href="https://wa.me/TUNUMERO?text=Hola,%20me%20interesa%20el%20Walk-in%20Closet%20Premium" target="_blank" class="w-full text-center text-xs font-semibold bg-[#442a22] hover:bg-[#5a382d] text-white py-2.5 rounded-lg transition">
                                    Cotizar este diseño
                                </a>
                            </div>
                        </div>

                        <!-- Modelo 2 -->
                        <div class="bg-white rounded-xl border border-[#e8dcd0] overflow-hidden flex flex-col shadow-sm hover:shadow-md transition">
                            <img src="https://images.unsplash.com/photo-1595428774223-ef52624120d2?w=500" alt="Closet Puertas Corredizas" class="w-full h-44 object-cover">
