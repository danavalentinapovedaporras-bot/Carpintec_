    <script>
            const modalCocinas = document.getElementById('modalCatalogoCocinas');

            function abrirCatalogoCocinas() {
                modalCocinas.showModal();
            }

            function cerrarCatalogoCocinas() {
                modalCocinas.close();
            }

            // Cerrar haciendo clic afuera del contenido
            modalCocinas.addEventListener('click', (e) => {
                const rect = modalCocinas.getBoundingClientRect();
                const dentro = (
                    rect.top <= e.clientY &&
                    e.clientY <= rect.top + rect.height &&
                    rect.left <= e.clientX &&
                    e.clientX <= rect.left + rect.width
                );
                if (!dentro) {
                    modalCocinas.close();
                }
            });
            //Catalogo de closets
            const modalClosets = document.getElementById('modalCatalogoClosets');

            function abrirCatalogoClosets() {
                modalClosets.showModal();
            }

            function cerrarCatalogoClosets() {
                modalClosets.close();
            }

            // Cerrar haciendo clic afuera del recuadro
            modalClosets.addEventListener('click', (e) => {
                const rect = modalClosets.getBoundingClientRect();
                const dentro = (
                    rect.top <= e.clientY &&
                    e.clientY <= rect.top + rect.height &&
                    rect.left <= e.clientX &&
                    e.clientX <= rect.left + rect.width
                );
                if (!dentro) {
                    modalClosets.close();
                }
            });
            //catalogo de muebles
            const modalMuebles = document.getElementById('modalCatalogoMuebles');

            function abrirCatalogoMuebles() {
                modalMuebles.showModal();
            }

            function cerrarCatalogoMuebles() {
                modalMuebles.close();
            }

            modalMuebles.addEventListener('click', (e) => {
                const r = modalMuebles.getBoundingClientRect();
                const fuera = (
                    e.clientY < r.top ||
                    e.clientY > r.bottom ||
                    e.clientX < r.left ||
                    e.clientX > r.right
                );
                if (fuera) {
                    modalMuebles.close();
                }
            });
    </script>
    <!-- CHATBOT CARPINTEC -->
    <div id="chatbot-container"
         class="fixed bottom-6 right-6 z-50">

        <!-- Botón abrir chatbot -->
        <button onclick="abrirChatbot()"
                class="bg-primary text-white w-16 h-16 rounded-full shadow-lg flex items-center justify-center hover:scale-110 transition">

            <span class="material-symbols-outlined text-4xl">
                robot_2
            </span>

        </button>


        <!-- Ventana chatbot -->
