<!-- Card 6: Comunicaciones -->
<article class="bg-white rounded-[24px] p-7 shadow-[0_4px_24px_rgba(78,42,24,0.06)] hover:shadow-[0_8px_30px_rgba(78,42,24,0.1)] transition-all duration-200 relative overflow-hidden flex flex-col justify-between min-h-[260px] border border-[#F0E6DE]/60 group cursor-pointer">
  <div class="absolute -top-6 -right-6 w-24 h-24 bg-[#EADCCF]/65 rounded-full pointer-events-none transition-transform group-hover:scale-105"></div>
  
  <div>
    <div class="w-12 h-12 rounded-2xl bg-[#F4ECE4] text-[#4E2A18] flex items-center justify-center shadow-sm relative z-10">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path d="M8.625 12a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H8.25m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H12m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0h-.375M21 12c0 4.556-4.03 8.25-9 8.25a9.764 9.764 0 01-2.555-.337A5.972 5.972 0 015.41 20.97a.75.75 0 01-.845-.968c.287-.96.48-1.99.568-3.033C3.766 15.65 3 13.914 3 12c0-4.556 4.03-8.25 9-8.25s9 3.694 9 8.25z" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
    </div>
    <div class="mt-5 relative z-10">
      <h2 class="text-[18px] font-bold text-[#382114] tracking-tight group-hover:text-[#4E2A18] transition-colors">
        Comunicaciones
      </h2>
      <p class="text-[13.5px] text-[#7A695E] font-normal mt-1.5 leading-snug">
