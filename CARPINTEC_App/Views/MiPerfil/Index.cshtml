@{
    Layout = null;
}
<!DOCTYPE html><html lang="es" style=""><head>
<meta charset="utf-8">
<meta content="width=device-width, initial-scale=1.0" name="viewport">
<title>Carpintec - Portal Cliente | Mi Perfil</title>
<!-- Google Fonts -->
<link href="https://fonts.googleapis.com" rel="preconnect">
<link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect">
<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&amp;family=Plus+Jakarta+Sans:wght@400;500;600&amp;display=swap" rel="stylesheet">
<!-- Tailwind CSS v3 with plugins -->
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<!-- Custom Configuration for Theme Colors -->
<script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            wood: {
              50: '#fbf7f4',
              100: '#f5eee6',
              200: '#eddccf',
              700: '#6b361a',
              800: '#532813',
              900: '#3d1c0b',
              coffee: '#442211',
              darkCoffee: '#34190c',
              gold: '#c99658',
              alert: '#d85822'
            }
          },
          fontFamily: {
            sans: ['Montserrat', 'Plus Jakarta Sans', 'sans-serif'],
          }
        }
      }
    }
  </script>
<!-- BEGIN: Custom Styles -->
<style data-purpose="custom-enhancements">
    body {
      font-family: 'Montserrat', sans-serif;
    }
    .card-profile {
      box-shadow: 0 10px 25px -4px rgba(105, 53, 20, 0.08), 0 2px 6px -1px rgba(139, 69, 19, 0.06);
      transition: all 0.28s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .card-profile:hover {
      transform: translateY(-4px);
      box-shadow: 0 16px 32px -6px rgba(105, 53, 20, 0.16), 0 0 0 1px rgba(139, 69, 19, 0.25);
    }
  </style>
<!-- END: Custom Styles -->
</head>
<body class="bg-[#FAF7F4] min-h-screen text-[#382114] flex flex-col antialiased selection:bg-[#c99658] selection:text-white">
<!-- BEGIN: MainHeader -->
<!-- Header with rich artisan warm brown / coffee color (#3e1e0e) background -->
<header class="bg-[#F5EBE1] border-b border-[#DCC7B0] shadow-sm sticky top-0 z-40" data-purpose="top-navigation-bar">
<div class="max-w-[1440px] mx-auto px-6 lg:px-12 h-20 flex items-center justify-between">
<!-- Carpintec Brand / Logo -->
<div class="flex items-center gap-3.5">
<a aria-label="Ir a página de inicio de Carpintec" class="flex items-center gap-3 group focus:outline-none" href="#">
<!-- Stylized Woodcraft Logo Badge -->
<div class="w-11 h-11 rounded-lg bg-gradient-to-br from-[#c99658] to-[#8d4f24] p-[1.5px] shadow-sm">
<div class="w-full h-full bg-[#3e1e0e] rounded-[7px] flex items-center justify-center">
<svg class="w-6 h-6 text-[#e8ba80]" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" viewBox="0 0 24 24">
<path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
<polyline points="9 22 9 12 15 12 15 22"></polyline>
</svg>
</div>
</div>
<!-- Logo Text -->
<div class="flex flex-col">
<span class="text-xl font-extrabold tracking-wider text-[#382114] uppercase font-sans">Carpintec</span>
<span class="text-[11px] font-semibold tracking-widest text-[#7A695E] uppercase -mt-1">Portal Cliente</span>
</div>
</a>
</div>
<!-- Navigation Links -->
<nav class="hidden md:flex items-center gap-8 text-[14.5px] font-medium" data-purpose="header-links">
<a class="text-[#54433a] hover:text-[#382114] transition-colors duration-150 py-1" href="#">Inicio</a>
<a class="text-[#54433a] hover:text-[#382114] transition-colors duration-150 py-1" href="#">Catálogo</a>
<a class="text-[#54433a] hover:text-[#382114] transition-colors duration-150 py-1" href="#">Mis Pedidos</a>
<a class="text-[#54433a] hover:text-[#382114] transition-colors duration-150 py-1" href="#">Cotizaciones</a>
<!-- Active 'Mi Perfil' Pill Button -->
<a aria-current="page" class="inline-flex items-center gap-2 bg-[#4E2A18] hover:bg-[#3D1E10] text-[#f7ede3] px-4 py-2 rounded-lg border border-[#3e1e0e] text-[14px] font-semibold transition-all shadow-sm" href="#">
<svg class="w-4 h-4 text-[#e2a866]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
<path d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" stroke-linecap="round" stroke-linejoin="round"></path>
</svg>
<span class="">Mi Perfil</span>
</a>
</nav>
<!-- User Profile Badge -->
<div class="flex items-center gap-3 pl-4" data-purpose="user-profile-badge">
<div class="w-10 h-10 rounded-full bg-[#4E2A18] text-[#FAF7F4] flex items-center justify-center font-bold text-sm shadow-sm ring-2 ring-[#c99658]">
          CA
        </div>
<div class="hidden sm:flex flex-col text-left">
<span class="text-sm font-bold text-[#382114] leading-tight">Carlos</span>
<span class="text-xs font-medium text-[#7A695E] leading-tight">Arango</span>
</div>
</div>
</div>
</header>
<!-- END: MainHeader -->
<!-- BEGIN: MainContent -->
<main class="flex-grow py-12 px-6 lg:px-12 max-w-[1360px] mx-auto w-full flex flex-col justify-center">
<!-- BEGIN: GridOfOptions -->
<!-- 3-Column Profile Cards Grid with stylized beige and wood-coffee frames -->
<section aria-label="Opciones del Portal de Cliente" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-7"><!-- Card 1: Información de tu perfil -->
<article class="bg-white rounded-[24px] p-7 shadow-[0_4px_24px_rgba(78,42,24,0.06)] hover:shadow-[0_8px_30px_rgba(78,42,24,0.1)] transition-all duration-200 relative overflow-hidden flex flex-col justify-between min-h-[260px] border border-[#F0E6DE]/60 group cursor-pointer">
  <!-- Esquina decorativa orgánica suave -->
  <div class="absolute -top-6 -right-6 w-24 h-24 bg-[#EADCCF]/65 rounded-full pointer-events-none transition-transform group-hover:scale-105"></div>
  
  <div>
    <!-- Icono en pastilla redondeada beige -->
    <div class="w-12 h-12 rounded-2xl bg-[#F4ECE4] text-[#4E2A18] flex items-center justify-center shadow-sm relative z-10">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path d="M15 9h3.75M15 12h3.75M15 15h3.75M4.5 19.5h15a2.25 2.25 0 002.25-2.25V6.75A2.25 2.25 0 0019.5 4.5h-15A2.25 2.25 0 002.25 6.75v10.5A2.25 2.25 0 004.5 19.5zm6-10.125a1.875 1.875 0 11-3.75 0 1.875 1.875 0 013.75 0zm1.294 6.336a6.721 6.721 0 01-3.17.789 6.721 6.721 0 01-3.168-.789 3.376 3.376 0 016.338 0z" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
    </div>
    <!-- Título y descripción -->
    <div class="mt-5 relative z-10">
      <h2 class="text-[18px] font-bold text-[#382114] tracking-tight group-hover:text-[#4E2A18] transition-colors">
        Información de tu perfil
      </h2>
      <p class="text-[13.5px] text-[#7A695E] font-normal mt-1.5 leading-snug">
        Datos personales, documento y de tu cuenta.
      </p>
    </div>
  </div>
  
  <!-- Botón tipo cápsula café madera profundo con flecha -->
  <div class="mt-6 relative z-10">
    <button type="button" class="w-full py-2.5 px-5 rounded-xl bg-[#4E2A18] hover:bg-[#3D1E10] text-white text-[13.5px] font-semibold flex items-center justify-center gap-2 transition-colors duration-150 shadow-sm">
      <span class="">Ver perfil</span>
      <span class="text-xs font-bold">›</span>
    </button>
  </div>
</article>

<!-- Card 2: Seguridad -->
<article class="bg-white rounded-[24px] p-7 shadow-[0_4px_24px_rgba(78,42,24,0.06)] hover:shadow-[0_8px_30px_rgba(78,42,24,0.1)] transition-all duration-200 relative overflow-hidden flex flex-col justify-between min-h-[260px] border border-[#F0E6DE]/60 group cursor-pointer">
