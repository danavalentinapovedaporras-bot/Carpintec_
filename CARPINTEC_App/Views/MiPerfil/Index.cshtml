                </div>
                <h3 class="text-white font-bold text-lg">Comunicaciones</h3>
            </div>
            <button onclick="cerrarModal('modalComunicaciones')" class="w-8 h-8 bg-white/15 hover:bg-white/25 rounded-full flex items-center justify-center text-white text-lg font-bold transition-colors">×</button>
        </div>
        <div class="px-7 py-6">
            <p class="text-[#7A695E] text-sm font-medium mb-5">Elige qué notificaciones y mensajes quieres recibir de Carpintec.</p>
            <div class="space-y-3">
                <div class="flex items-center justify-between bg-[#FAF7F4] border border-[#EDE0D6] rounded-xl px-4 py-3">
                    <div class="flex items-center gap-3">
                        <span class="text-2xl">📦</span>
                        <div>
                            <p class="font-bold text-[#382114] text-sm">Estado de pedidos</p>
                            <p class="text-[#7A695E] text-xs font-medium">Actualizaciones por correo y WhatsApp</p>
                        </div>
                    </div>
                    <label class="toggle-switch"><input type="checkbox" checked id="commPedidos"><span class="toggle-slider"></span></label>
                </div>
                <div class="flex items-center justify-between bg-[#FAF7F4] border border-[#EDE0D6] rounded-xl px-4 py-3">
                    <div class="flex items-center gap-3">
                        <span class="text-2xl">💼</span>
                        <div>
                            <p class="font-bold text-[#382114] text-sm">Cotizaciones y ofertas</p>
                            <p class="text-[#7A695E] text-xs font-medium">Respuestas y actualizaciones de cotizaciones</p>
                        </div>
                    </div>
                    <label class="toggle-switch"><input type="checkbox" checked id="commCotizaciones"><span class="toggle-slider"></span></label>
                </div>
                <div class="flex items-center justify-between bg-[#FAF7F4] border border-[#EDE0D6] rounded-xl px-4 py-3">
                    <div class="flex items-center gap-3">
                        <span class="text-2xl">🛎️</span>
                        <div>
                            <p class="font-bold text-[#382114] text-sm">Novedades de stock</p>
                            <p class="text-[#7A695E] text-xs font-medium">Productos disponibles y reposición</p>
                        </div>
                    </div>
                    <label class="toggle-switch"><input type="checkbox" id="commStock"><span class="toggle-slider"></span></label>
                </div>
                <div class="flex items-center justify-between bg-[#FAF7F4] border border-[#EDE0D6] rounded-xl px-4 py-3">
                    <div class="flex items-center gap-3">
                        <span class="text-2xl">🎁</span>
                        <div>
                            <p class="font-bold text-[#382114] text-sm">Promociones y descuentos</p>
                            <p class="text-[#7A695E] text-xs font-medium">Ofertas exclusivas para clientes</p>
                        </div>
                    </div>
                    <label class="toggle-switch"><input type="checkbox" id="commPromos"><span class="toggle-slider"></span></label>
                </div>
                <div class="flex items-center justify-between bg-[#FAF7F4] border border-[#EDE0D6] rounded-xl px-4 py-3">
                    <div class="flex items-center gap-3">
                        <span class="text-2xl">📋</span>
                        <div>
                            <p class="font-bold text-[#382114] text-sm">Boletín mensual</p>
                            <p class="text-[#7A695E] text-xs font-medium">Noticias y tips de carpintería y diseño</p>
                        </div>
                    </div>
                    <label class="toggle-switch"><input type="checkbox" id="commBoletin"><span class="toggle-slider"></span></label>
                </div>
            </div>
            <div class="flex gap-3 mt-6 justify-end">
                <button onclick="cerrarModal('modalComunicaciones')" class="px-5 py-2.5 rounded-xl border border-[#DCC7B0] text-[#4E2A18] font-semibold text-sm hover:bg-[#F4ECE4] transition-colors">Cancelar</button>
                <button onclick="guardarComunicaciones()" class="px-6 py-2.5 rounded-xl bg-[#4E2A18] hover:bg-[#3D1E10] text-white font-semibold text-sm transition-colors shadow-sm">Guardar preferencias</button>
            </div>
        </div>
    </div>
</div>

<!-- ==================== SCRIPTS ==================== -->
<script>
    // ---- Modal helpers ----
    function abrirModal(id) {
        document.getElementById(id).classList.add('active');
        document.body.style.overflow = 'hidden';
    }
    function cerrarModal(id) {
        document.getElementById(id).classList.remove('active');
        document.body.style.overflow = '';
    }
    function cerrarModalFuera(event, id) {
        if (event.target === document.getElementById(id)) cerrarModal(id);
    }
    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
            document.querySelectorAll('.modal-overlay.active').forEach(m => {
                m.classList.remove('active');
            });
            document.body.style.overflow = '';
        }
    });

    // ---- Tab perfil ----
    function switchTab(tab) {
        const panelVer = document.getElementById('panelVer');
        const panelEditar = document.getElementById('panelEditar');
        const tabVer = document.getElementById('tabVerPerfil');
        const tabEditar = document.getElementById('tabEditarPerfil');
        if (tab === 'ver') {
            panelVer.style.display = 'block';
            panelEditar.style.display = 'none';
            tabVer.className = 'px-4 py-2 rounded-lg text-[13px] font-semibold bg-[#4E2A18] text-white transition-colors';
            tabEditar.className = 'px-4 py-2 rounded-lg text-[13px] font-semibold bg-[#F4ECE4] text-[#4E2A18] hover:bg-[#EDE0D6] transition-colors';
        } else {
            panelVer.style.display = 'none';
            panelEditar.style.display = 'block';
            tabEditar.className = 'px-4 py-2 rounded-lg text-[13px] font-semibold bg-[#4E2A18] text-white transition-colors';
            tabVer.className = 'px-4 py-2 rounded-lg text-[13px] font-semibold bg-[#F4ECE4] text-[#4E2A18] hover:bg-[#EDE0D6] transition-colors';
        }
    }

    // ---- Mostrar mensaje ----
    function mostrarAlerta(id, msg, tipo) {
        const el = document.getElementById(id);
        el.textContent = msg;
        el.className = 'alert-msg mb-4 ' + (tipo === 'success' ? 'alert-success' : 'alert-error');
        el.style.display = 'block';
        setTimeout(() => { el.style.display = 'none'; }, 4500);
    }

    // ---- Guardar perfil ----
    function guardarPerfil(e) {
        e.preventDefault();
        const btn = document.getElementById('btnGuardarPerfil');
        btn.disabled = true; btn.textContent = 'Guardando...';
        const form = document.getElementById('formPerfil');
        const token = form.querySelector('input[name="__RequestVerificationToken"]').value;
        const data = new URLSearchParams({
            nombre: document.getElementById('editNombre').value,
            apellido: document.getElementById('editApellido').value,
            telefono: document.getElementById('editTelefono').value,
            direccion: document.getElementById('editDireccion').value,
            ciudad: document.getElementById('editCiudad').value,
            documento: document.getElementById('editDocumento').value,
            __RequestVerificationToken: token
        });
        fetch('/MiPerfil/ActualizarPerfil', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: data.toString()
        })
        .then(r => r.json())
        .then(res => {
            mostrarAlerta('alertPerfil', res.message, res.success ? 'success' : 'error');
            if (res.success) {
                switchTab('ver');
                setTimeout(() => location.reload(), 1500);
            }
        })
        .catch(() => mostrarAlerta('alertPerfil', 'Error de conexión.', 'error'))
        .finally(() => { btn.disabled = false; btn.textContent = 'Guardar cambios'; });
    }

    // ---- Cambiar contraseña ----
    function cambiarContrasena(e) {
        e.preventDefault();
        const form = document.getElementById('formSeguridad');
        const token = form.querySelector('input[name="__RequestVerificationToken"]').value;
        const data = new URLSearchParams({
            contrasenaActual: document.getElementById('contrasenaActual').value,
            nuevaContrasena: document.getElementById('nuevaContrasena').value,
            confirmarContrasena: document.getElementById('confirmarContrasena').value,
            __RequestVerificationToken: token
        });
        fetch('/MiPerfil/CambiarContrasena', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: data.toString()
        })
        .then(r => r.json())
        .then(res => {
            mostrarAlerta('alertSeguridad', res.message, res.success ? 'success' : 'error');
            if (res.success) form.reset();
        })
        .catch(() => mostrarAlerta('alertSeguridad', 'Error de conexión.', 'error'));
    }

    // ---- Guardar dirección ----
    function guardarDireccion(e) {
        e.preventDefault();
        const form = document.getElementById('formDirecciones');
        const token = form.querySelector('input[name="__RequestVerificationToken"]').value;
        const data = new URLSearchParams({
            direccion: document.getElementById('nuevaDireccion').value,
            ciudad: document.getElementById('nuevaCiudad').value,
            __RequestVerificationToken: token
        });
        fetch('/MiPerfil/ActualizarDireccion', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: data.toString()
        })
        .then(r => r.json())
        .then(res => {
            mostrarAlerta('alertDirecciones', res.message, res.success ? 'success' : 'error');
            if (res.success) setTimeout(() => location.reload(), 1500);
        })
        .catch(() => mostrarAlerta('alertDirecciones', 'Error de conexión.', 'error'));
    }

    // ---- Guardar comunicaciones (local) ----
    function guardarComunicaciones() {
        const prefs = {
            pedidos: document.getElementById('commPedidos').checked,
            cotizaciones: document.getElementById('commCotizaciones').checked,
            stock: document.getElementById('commStock').checked,
            promos: document.getElementById('commPromos').checked,
            boletin: document.getElementById('commBoletin').checked
        };
        localStorage.setItem('carpintec_comunicaciones', JSON.stringify(prefs));
        cerrarModal('modalComunicaciones');
        // Feedback visual
        const div = document.createElement('div');
        div.className = 'fixed bottom-6 right-6 bg-[#4E2A18] text-white px-5 py-3 rounded-xl shadow-xl text-sm font-semibold z-[99999] flex items-center gap-2';
        div.innerHTML = '✅ Preferencias de comunicación guardadas';
        document.body.appendChild(div);
        setTimeout(() => div.remove(), 3500);
    }

    // Restaurar preferencias comunicaciones al cargar
    (function() {
        const saved = localStorage.getItem('carpintec_comunicaciones');
        if (saved) {
            const prefs = JSON.parse(saved);
            if (prefs.pedidos !== undefined) document.getElementById('commPedidos').checked = prefs.pedidos;
            if (prefs.cotizaciones !== undefined) document.getElementById('commCotizaciones').checked = prefs.cotizaciones;
            if (prefs.stock !== undefined) document.getElementById('commStock').checked = prefs.stock;
            if (prefs.promos !== undefined) document.getElementById('commPromos').checked = prefs.promos;
            if (prefs.boletin !== undefined) document.getElementById('commBoletin').checked = prefs.boletin;
        }
    })();
</script>
</body>
</html>