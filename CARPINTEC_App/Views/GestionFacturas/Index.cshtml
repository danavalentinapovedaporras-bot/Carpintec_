@{
    Layout = null;
    var cotizaciones = (ViewBag.Cotizaciones as IEnumerable<CARPINTEC_App.Models.Cotizacion>) ?? new List<CARPINTEC_App.Models.Cotizacion>();
    string nombreCompleto = ViewBag.NombreCompleto ?? "Cliente";
    string primerNombre = ViewBag.PrimerNombre ?? "Cliente";
    string iniciales = ViewBag.Iniciales ?? "CL";
    string correo = ViewBag.Correo ?? "";
    decimal totalFacturado = (decimal)(ViewBag.TotalFacturado ?? 0m);
    int totalCotizaciones = (int)(ViewBag.TotalCotizaciones ?? 0);
    int pendientes = (int)(ViewBag.Pendientes ?? 0);
    int pagadas = (int)(ViewBag.Pagadas ?? 0);
    decimal montoPendiente = (decimal)(ViewBag.MontoPendiente ?? 0m);
}
<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta content="width=device-width, initial-scale=1.0" name="viewport">
<title>Carpintec – Gestión de Facturas</title>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600&display=swap" rel="stylesheet">
<script src="https://cdn.tailwindcss.com"></script>
<!-- jsPDF para generación de PDF en el navegador -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<style>
    body { font-family: 'Montserrat', sans-serif; }
    ::-webkit-scrollbar { display: none; }
    .invoice-card { transition: all 0.2s ease; }
    .invoice-card:hover { transform: translateY(-2px); }
    .modal-overlay { position:fixed; inset:0; background:rgba(30,12,5,0.5); backdrop-filter:blur(4px); z-index:9998; display:none; align-items:center; justify-content:center; }
    .modal-overlay.active { display:flex; }
    .modal-box { background:#fff; border-radius:20px; box-shadow:0 24px 64px rgba(78,42,24,0.2); width:100%; max-width:560px; margin:16px; max-height:90vh; overflow-y:auto; animation:modalIn 0.26s cubic-bezier(0.16,1,0.3,1); }
    @@keyframes modalIn { from{opacity:0;transform:scale(0.93) translateY(16px)} to{opacity:1;transform:scale(1) translateY(0)} }
    .badge { display:inline-flex; align-items:center; gap:4px; font-size:10px; font-weight:700; padding:3px 9px; border-radius:999px; white-space:nowrap; }
    .badge-pendiente { background:#FFF3E0; color:#E65100; border:1px solid #FFCC80; }
    .badge-aprobada, .badge-pagada, .badge-finalizada { background:#E8F5E9; color:#2E7D32; border:1px solid #A5D6A7; }
    .badge-revision { background:#E3F2FD; color:#1565C0; border:1px solid #90CAF9; }
    .badge-cancelada { background:#FFEBEE; color:#C62828; border:1px solid #EF9A9A; }
    .badge-enviada { background:#F3E5F5; color:#6A1B9A; border:1px solid #CE93D8; }
    .filter-pill { transition:all .15s; white-space:nowrap; }
    .filter-pill.active { background:#8C5E3C; color:#fff; }
    .filter-pill:not(.active) { background:#fff; color:#7D6A5D; border:1px solid #E7DDD3; }
    .filter-pill:not(.active):hover { background:#F2ECE4; }
    table.pdf-table { width:100%; border-collapse:collapse; font-size:12px; }
    table.pdf-table th { background:#F4ECE4; color:#4E2A18; padding:6px 10px; text-align:left; border-bottom:2px solid #DCC7B0; }
    table.pdf-table td { padding:6px 10px; border-bottom:1px solid #EDE0D6; color:#382114; }
    .progress-bar { height:4px; border-radius:2px; background:#E7DDD3; overflow:hidden; }
    .progress-fill { height:100%; border-radius:2px; }
</style>
</head>
<body class="bg-[#FAF7F4] text-[#3E2723] min-h-screen flex flex-col antialiased">

<!-- HEADER -->
<header class="fixed top-0 w-full z-50 bg-[#FAF7F4]/95 backdrop-blur-md border-b border-[#E7DDD3] shadow-sm">
    <div class="h-16 px-4 flex items-center justify-between gap-3 max-w-6xl mx-auto md:px-8">
        <div class="flex items-center gap-2.5">
            <button onclick="history.back()" class="w-9 h-9 flex items-center justify-center text-[#5A3E2B] hover:bg-[#F2ECE4] rounded-full transition-colors">
                <span class="material-symbols-outlined text-[22px]">arrow_back</span>
            </button>
            <div>
                <span class="text-[10px] font-bold text-[#8C5E3C] uppercase tracking-wider block">Carpintec</span>
                <h1 class="text-[16px] font-bold text-[#3E2723] leading-none">Gestión de Facturas</h1>
            </div>
        </div>
        <div class="flex items-center gap-2">
            <button onclick="descargarTodoPDF()" title="Descargar resumen" class="w-8 h-8 rounded-full bg-white border border-[#E7DDD3] flex items-center justify-center text-[#7D6A5D] hover:border-[#8C5E3C] hover:text-[#3E2723] transition-colors shadow-sm">
                <span class="material-symbols-outlined text-[17px]">download</span>
            </button>
            <div class="w-8 h-8 rounded-full bg-[#8C5E3C] text-white flex items-center justify-center font-bold text-[13px] shadow-sm">@iniciales</div>
        </div>
    </div>
</header>

<main class="flex-1 pt-16 pb-8">
    <div class="w-full max-w-6xl mx-auto px-4 md:px-8">

        @if (ViewBag.Error != null)
        {
            <div class="mt-4 bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-xl text-sm font-semibold">
                ⚠️ @ViewBag.Error
            </div>
        }

        <!-- Banner cliente -->
        <div class="mt-4 px-4 py-3 bg-[#F4EFEA] border border-[#E7DDD3] rounded-2xl flex items-center justify-between">
            <div class="flex items-center gap-2">
                <div class="w-6 h-6 rounded-md bg-[#8C5E3C]/15 text-[#8C5E3C] flex items-center justify-center">
                    <span class="material-symbols-outlined text-[15px]">verified</span>
                </div>
                <div>
                    <span class="text-[10px] uppercase font-bold tracking-wider text-[#7D6A5D]">Portal Cliente</span>
                    <p class="text-[13px] font-bold text-[#3E2723] leading-none">@nombreCompleto</p>
                </div>
            </div>
            <span class="text-[11px] font-medium text-[#7D6A5D] truncate max-w-[160px]">@correo</span>
        </div>

        <!-- Métricas -->
        <div class="mt-3 grid grid-cols-3 gap-2.5">
            <div class="bg-[#8C5E3C] text-white rounded-xl p-3 flex flex-col justify-between shadow-sm">
                <span class="text-[10px] font-medium text-white/80 uppercase tracking-wider block">Total</span>
                <span class="text-[15px] font-bold text-white tracking-tight mt-1">
                    $@(totalFacturado >= 1_000_000 ? $"{totalFacturado/1_000_000:0.#}M" : $"{totalFacturado:#,##0}")
                </span>
                <span class="text-[10px] text-white/70 block mt-0.5">@totalCotizaciones cotizaciones</span>
            </div>
            <div class="bg-white border border-[#E7DDD3] rounded-xl p-3 flex flex-col justify-between shadow-sm">
                <span class="text-[10px] font-medium text-[#7D6A5D] uppercase tracking-wider block">Pendiente</span>
                <span class="text-[15px] font-bold text-[#A06D44] tracking-tight mt-1">
                    @if (montoPendiente > 0)
                    {
                        <span>$@(montoPendiente >= 1_000_000 ? $"{montoPendiente/1_000_000:0.#}M" : $"{montoPendiente:#,##0}")</span>
                    }
                    else
                    {
                        <span class="text-[#3B6E47]">$0</span>
                    }
                </span>
                <span class="text-[10px] text-[#A06D44] font-medium block mt-0.5">@pendientes activos</span>
            </div>
            <div class="bg-white border border-[#E7DDD3] rounded-xl p-3 flex flex-col justify-between shadow-sm">
                <span class="text-[10px] font-medium text-[#7D6A5D] uppercase tracking-wider block">Al Día</span>
                <span class="text-[15px] font-bold text-[#3E2723] tracking-tight mt-1">@pagadas</span>
                <span class="text-[10px] text-[#7D6A5D] block mt-0.5">Aprobadas/Pagadas</span>
            </div>
        </div>

        <!-- Búsqueda + Filtros -->
        <div class="mt-3 flex flex-col gap-2">
            <div class="relative">
                <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-[#A49488] text-[18px]">search</span>
                <input id="searchInput" onkeyup="aplicarFiltros()" type="text" placeholder="Buscar por folio, producto, estado..."
                    class="w-full pl-10 pr-4 py-2.5 bg-white text-[#3E2723] text-[13px] rounded-xl border border-[#E7DDD3] focus:outline-none focus:border-[#8C5E3C] placeholder:text-[#A49488] shadow-sm transition-all">
            </div>
            <div class="flex items-center gap-2 overflow-x-auto pb-1">
                <button id="pill-todos" class="filter-pill active px-3.5 py-1.5 rounded-full text-[12px] font-semibold" onclick="setFiltro('todos', this)">
                    Todas (@totalCotizaciones)
                </button>
                <button id="pill-pendiente" class="filter-pill px-3.5 py-1.5 rounded-full text-[12px] font-semibold" onclick="setFiltro('pendiente', this)">
                    Pendientes (@pendientes)
                </button>
                <button id="pill-pagada" class="filter-pill px-3.5 py-1.5 rounded-full text-[12px] font-semibold" onclick="setFiltro('pagada', this)">
                    Pagadas/Aprobadas (@pagadas)
                </button>
            </div>
        </div>

        <!-- Grid de cotizaciones -->
        <div id="invoicesContainer" class="mt-3 grid grid-cols-2 gap-2.5 md:grid-cols-3 lg:grid-cols-4">

            @if (!cotizaciones.Any())
            {
                <div class="col-span-2 md:col-span-3 lg:col-span-4 flex flex-col items-center justify-center py-16 px-4 text-center bg-white border border-[#E7DDD3] rounded-2xl shadow-sm">
                    <div class="w-14 h-14 rounded-full bg-[#FAF7F4] text-[#A49488] flex items-center justify-center mb-3">
                        <span class="material-symbols-outlined text-[28px]">receipt_long</span>
                    </div>
                    <p class="text-[14px] font-bold text-[#3E2723]">Sin cotizaciones registradas</p>
                    <p class="text-[12px] text-[#7D6A5D] mt-1">Aún no tienes cotizaciones asociadas a tu cuenta.</p>
                    <a asp-controller="MisProductos" asp-action="Index" class="mt-4 px-5 py-2 bg-[#8C5E3C] text-white rounded-xl text-[12px] font-bold hover:bg-[#784E30] transition-colors">
                        Ver catálogo
                    </a>
                </div>
            }

            @foreach (var cot in cotizaciones)
            {
                string estadoLower = cot.Estado?.ToLower() ?? "";
                bool esPendiente = estadoLower is "pendiente" or "en revisión" or "enviada";
                bool esPagada = estadoLower is "pagada" or "aprobada" or "finalizada";
                string badgeClass = estadoLower switch {
                    "pendiente" => "badge-pendiente",
                    "en revisión" or "en revision" => "badge-revision",
                    "aprobada" or "pagada" or "finalizada" => "badge-aprobada",
                    "cancelada" => "badge-cancelada",
                    "enviada" => "badge-enviada",
                    _ => "badge-pendiente"
                };
                string categoriaFiltro = esPagada ? "pagada" : (esPendiente ? "pendiente" : "otro");
                string descripcionProducto = cot.DetalleProducto ?? cot.DetalleCotizacions.FirstOrDefault()?.IdProductoNavigation?.Nombre ?? "Cotización";
                string busqueda = $"{cot.Folio} {descripcionProducto} {cot.Estado} {cot.NombreCliente} {cot.TipoMadera}".ToLower();
                int numProductos = cot.DetalleCotizacions.Count;

                // Serializar datos para JS
                var detallesJson = System.Text.Json.JsonSerializer.Serialize(
                    cot.DetalleCotizacions.Select(d => new {
                        producto = d.IdProductoNavigation?.Nombre ?? "Producto",
                        cantidad = d.Cantidad,
                        medidas = d.Medidas ?? "-",
                        precioUnitario = d.PrecioUnitario,
                        subtotal = d.Subtotal
                    })
                );

                <div class="invoice-card bg-white border border-[#E7DDD3] rounded-2xl p-3.5 shadow-sm flex flex-col justify-between hover:border-[#D6C7B7]"
                     data-categoria="@categoriaFiltro"
                     data-busqueda="@busqueda">

                    <div class="flex items-center justify-between gap-1 mb-2">
                        <span class="text-[11px] font-bold text-[#8C5E3C] tracking-wide">@cot.Folio</span>
                        <span class="badge @badgeClass">
                            @if (esPagada) { <span class="material-symbols-outlined text-[11px]" style="font-variation-settings:'FILL' 1">check_circle</span> }
                            @cot.Estado
                        </span>
                    </div>

                    <div class="flex items-start gap-2 mb-2.5">
                        <div class="w-9 h-9 rounded-xl @(esPagada ? "bg-[#F7F3EE] text-[#8C5E3C]" : "bg-[#FFF3E0] text-[#E65100]") border border-[#E7DDD3] flex items-center justify-center shrink-0">
                            <span class="material-symbols-outlined text-[19px]">@(esPagada ? "receipt_long" : "pending_actions")</span>
                        </div>
                        <div class="min-w-0 flex-1">
                            <h2 class="text-[13px] font-bold text-[#3E2723] leading-tight line-clamp-2">@descripcionProducto</h2>
                            <span class="text-[11px] text-[#7D6A5D] block mt-0.5">@cot.Fecha.ToString("dd MMM yyyy")</span>
                            @if (cot.TipoMadera != null)
                            {
                                <span class="text-[10px] text-[#8C5E3C] font-semibold">@cot.TipoMadera</span>
                            }
                        </div>
                    </div>

                    <div class="bg-[#FAF7F4] border border-[#EFE8DF] rounded-xl p-2.5 mb-2.5">
                        <div class="flex items-center justify-between text-[11px] mb-1">
                            <span class="text-[#7D6A5D]">Total:</span>
                            <span class="font-bold text-[#3E2723]">$@cot.Total.ToString("N0")</span>
                        </div>
                        @if (numProductos > 0)
                        {
                            <div class="text-[10px] text-[#7D6A5D] flex items-center justify-between">
                                <span>@numProductos producto(s)</span>
                                @if (cot.Cantidad.HasValue)
                                {
                                    <span>Cant: @cot.Cantidad</span>
                                }
                            </div>
                        }
                        @if (cot.TiempoEntrega != null)
                        {
                            <div class="text-[10px] text-[#8C5E3C] font-semibold mt-0.5 flex items-center gap-1">
                                <span class="material-symbols-outlined text-[11px]">schedule</span>
                                @cot.TiempoEntrega
                            </div>
                        }
                    </div>

                    <div class="flex items-center gap-1.5">
                        <button onclick="verDetalle(@cot.IdCotizacion, '@cot.Folio', '@cot.Estado', '@cot.Fecha.ToString("dd/MM/yyyy")', '@cot.Total.ToString("N0")', '@(cot.NombreCliente ?? nombreCompleto)', '@(cot.DetalleProducto ?? descripcionProducto)', '@(cot.TipoMadera ?? "")', '@(cot.Medidas ?? "")', '@(cot.TiempoEntrega ?? "")', '@(cot.ObservacionesAdicionales ?? "")', @detallesJson)"
                            class="flex-1 @(esPagada ? "bg-[#F4EFEA] hover:bg-[#EDE5DC] text-[#3E2723] border border-[#E7DDD3]" : "bg-[#8C5E3C] hover:bg-[#784E30] text-white") py-1.5 px-2 rounded-lg text-[11px] font-semibold flex items-center justify-center gap-1 transition-colors shadow-sm">
                            <span class="material-symbols-outlined text-[14px] @(esPagada ? "text-[#8C5E3C]" : "")">visibility</span>
                            <span>Ver</span>
                        </button>
                        <button onclick="descargarPDF(@cot.IdCotizacion, '@cot.Folio', '@cot.Estado', '@cot.Fecha.ToString("dd/MM/yyyy")', '@cot.Total.ToString("N0")', '@(cot.NombreCliente ?? nombreCompleto)', '@correo', '@(cot.DetalleProducto ?? descripcionProducto)', '@(cot.TipoMadera ?? "")', '@(cot.TiempoEntrega ?? "")', '@(cot.ObservacionesAdicionales ?? "")', @detallesJson)"
                            title="Descargar PDF"
                            class="w-7 h-7 bg-[#FAF7F4] border border-[#E7DDD3] text-[#7D6A5D] hover:text-[#3E2723] hover:border-[#8C5E3C] rounded-lg flex items-center justify-center transition-colors shrink-0">
                            <span class="material-symbols-outlined text-[15px]">download</span>
                        </button>
                    </div>
                </div>
            }

            <!-- Estado vacío cuando no hay resultados de búsqueda -->
            <div id="emptySearch" class="hidden col-span-2 md:col-span-3 lg:col-span-4 flex-col items-center justify-center py-10 px-4 text-center bg-white border border-[#E7DDD3] rounded-2xl shadow-sm">
                <span class="material-symbols-outlined text-[28px] text-[#A49488] mb-2">search_off</span>
                <p class="text-[13px] font-bold text-[#3E2723]">Sin resultados</p>
                <p class="text-[11px] text-[#7D6A5D] mt-0.5">Prueba con otro término o filtro</p>
            </div>
        </div>

        <!-- Soporte -->
        <div class="mt-4 bg-white border border-[#E7DDD3] rounded-2xl p-3.5 flex items-center justify-between gap-3 shadow-sm">
            <div class="flex items-center gap-3 min-w-0">
                <div class="w-9 h-9 rounded-xl bg-[#FAF1E4] border border-[#E8D6BD] flex items-center justify-center text-[#8C5E3C] shrink-0">
                    <span class="material-symbols-outlined text-[18px]">support_agent</span>
                </div>
                <div class="min-w-0">
                    <span class="text-[12px] font-bold text-[#3E2723] block">Soporte sobre Facturación</span>
                    <span class="text-[11px] text-[#7D6A5D] block">Asesoría de pagos, garantías y certificados</span>
                </div>
            </div>
            <a href="https://wa.me/573000000000?text=Hola, necesito ayuda con mis facturas en Carpintec" target="_blank"
               class="inline-flex items-center gap-1.5 bg-[#8C5E3C]/10 hover:bg-[#8C5E3C]/20 text-[#8C5E3C] px-3 py-1.5 rounded-lg text-[11px] font-bold transition-colors shrink-0">
                <span class="material-symbols-outlined text-[15px]">chat</span>
                <span>WhatsApp</span>
            </a>
        </div>
    </div>
</main>

<!-- MODAL DETALLE -->
<div id="modalDetalle" class="modal-overlay" onclick="if(event.target===this) cerrarModal()">
    <div class="modal-box">
        <div class="bg-gradient-to-br from-[#4E2A18] to-[#7A3E25] px-6 py-4 rounded-t-[20px] flex items-center justify-between">
            <div class="flex items-center gap-3">
                <span class="material-symbols-outlined text-[#e8ba80] text-[20px]">receipt_long</span>
                <div>
                    <h3 id="modalFolio" class="text-white font-bold text-[15px]">Cotización</h3>
                    <span id="modalFecha" class="text-[#e8ba80] text-[11px]"></span>
                </div>
            </div>
            <div class="flex items-center gap-2">
                <button id="btnDescargarModal" onclick="descargarDesdeModal()" class="w-8 h-8 bg-white/15 hover:bg-white/25 rounded-full flex items-center justify-center text-white transition-colors" title="Descargar PDF">
                    <span class="material-symbols-outlined text-[16px]">download</span>
                </button>
                <button onclick="cerrarModal()" class="w-8 h-8 bg-white/15 hover:bg-white/25 rounded-full flex items-center justify-center text-white text-lg font-bold transition-colors">×</button>
            </div>
        </div>
        <div class="px-6 py-5">
            <!-- Estado y cliente -->
            <div class="flex items-center justify-between mb-4">
                <div>
                    <p class="text-[11px] font-semibold text-[#7D6A5D] uppercase tracking-wider">Cliente</p>
                    <p id="modalCliente" class="font-bold text-[#382114] text-[14px]"></p>
                </div>
                <span id="modalEstadoBadge" class="badge"></span>
            </div>
            <!-- Descripción -->
            <div class="bg-[#FAF7F4] border border-[#EDE0D6] rounded-xl p-3.5 mb-4">
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <p class="text-[10px] font-bold text-[#7D6A5D] uppercase mb-1">Producto / Detalle</p>
                        <p id="modalProducto" class="text-[13px] font-semibold text-[#382114]"></p>
                    </div>
                    <div>
                        <p class="text-[10px] font-bold text-[#7D6A5D] uppercase mb-1">Tipo de madera</p>
                        <p id="modalMadera" class="text-[13px] font-semibold text-[#382114]">-</p>
                    </div>
                    <div>
                        <p class="text-[10px] font-bold text-[#7D6A5D] uppercase mb-1">Medidas</p>
                        <p id="modalMedidas" class="text-[13px] font-semibold text-[#382114]">-</p>
                    </div>
                    <div>
                        <p class="text-[10px] font-bold text-[#7D6A5D] uppercase mb-1">Tiempo de entrega</p>
                        <p id="modalEntrega" class="text-[13px] font-semibold text-[#382114]">-</p>
                    </div>
                </div>
            </div>
            <!-- Tabla de productos si hay detalles -->
            <div id="tablaDetalles" class="mb-4" style="display:none">
                <p class="text-[11px] font-bold text-[#7D6A5D] uppercase mb-2">Detalle de productos</p>
                <div class="overflow-x-auto rounded-xl border border-[#EDE0D6]">
                    <table class="pdf-table">
                        <thead>
                            <tr>
                                <th>Producto</th>
                                <th>Cant.</th>
                                <th>Medidas</th>
                                <th>Precio Unit.</th>
                                <th>Subtotal</th>
                            </tr>
                        </thead>
                        <tbody id="modalTablaBody"></tbody>
                    </table>
                </div>
            </div>
            <!-- Observaciones -->
            <div id="modalObsContainer" class="mb-4" style="display:none">
                <p class="text-[10px] font-bold text-[#7D6A5D] uppercase mb-1">Observaciones</p>
                <p id="modalObs" class="text-[12px] text-[#54433a] bg-[#FAF7F4] border border-[#EDE0D6] rounded-xl p-3"></p>
            </div>
            <!-- Total -->
            <div class="bg-gradient-to-br from-[#4E2A18] to-[#7A3E25] rounded-xl px-4 py-3 flex items-center justify-between">
                <span class="text-white/80 text-[13px] font-semibold">Total cotización</span>
                <span id="modalTotal" class="text-white font-black text-[18px]"></span>
            </div>
        </div>
    </div>
</div>

<script>
    // ---- Estado global ----
    let filtroActual = 'todos';
    let modalData = {};

    // ---- Filtros ----
    function setFiltro(cat, btn) {
        filtroActual = cat;
        document.querySelectorAll('.filter-pill').forEach(p => {
            p.classList.remove('active');
        });
        btn.classList.add('active');
        aplicarFiltros();
    }

    function aplicarFiltros() {
        const term = (document.getElementById('searchInput')?.value || '').toLowerCase().trim();
        const cards = document.querySelectorAll('.invoice-card');
        let visibles = 0;
        cards.forEach(card => {
            const cat = card.getAttribute('data-categoria') || '';
            const busq = card.getAttribute('data-busqueda') || '';
            const matchCat = filtroActual === 'todos' || cat === filtroActual;
            const matchSearch = !term || busq.includes(term);
            if (matchCat && matchSearch) {
                card.style.display = 'flex';
                card.style.flexDirection = 'column';
                visibles++;
            } else {
                card.style.display = 'none';
            }
        });
        const empty = document.getElementById('emptySearch');
        if (empty) {
            if (visibles === 0 && cards.length > 0) {
                empty.style.display = 'flex';
                empty.style.flexDirection = 'column';
            } else {
                empty.style.display = 'none';
            }
        }
    }

    // ---- Modal detalle ----
    function verDetalle(id, folio, estado, fecha, total, cliente, producto, madera, medidas, entrega, obs, detalles) {
        modalData = { id, folio, estado, fecha, total, cliente, producto, madera, medidas, entrega, obs, detalles };

        document.getElementById('modalFolio').textContent = 'Cotización ' + folio;
        document.getElementById('modalFecha').textContent = fecha;
        document.getElementById('modalCliente').textContent = cliente || 'Cliente';
        document.getElementById('modalProducto').textContent = producto || '-';
        document.getElementById('modalMadera').textContent = madera || '-';
        document.getElementById('modalMedidas').textContent = medidas || '-';
        document.getElementById('modalEntrega').textContent = entrega || '-';
        document.getElementById('modalTotal').textContent = '$' + total;

        // Badge estado
        const badge = document.getElementById('modalEstadoBadge');
        const estadoL = (estado || '').toLowerCase();
        badge.textContent = estado;
        badge.className = 'badge ';
        if (estadoL === 'pendiente') badge.classList.add('badge-pendiente');
        else if (['aprobada','pagada','finalizada'].includes(estadoL)) badge.classList.add('badge-aprobada');
        else if (estadoL === 'cancelada') badge.classList.add('badge-cancelada');
        else if (estadoL === 'en revisión' || estadoL === 'en revision') badge.classList.add('badge-revision');
        else badge.classList.add('badge-pendiente');

        // Tabla de detalles
        const tbody = document.getElementById('modalTablaBody');
        tbody.innerHTML = '';
        const tablaContainer = document.getElementById('tablaDetalles');
        if (detalles && detalles.length > 0) {
            tablaContainer.style.display = 'block';
            detalles.forEach(d => {
                const tr = document.createElement('tr');
                tr.innerHTML = `<td>${d.producto}</td><td>${d.cantidad}</td><td>${d.medidas}</td>
                    <td>$${Number(d.precioUnitario).toLocaleString('es-CO')}</td>
                    <td>$${Number(d.subtotal).toLocaleString('es-CO')}</td>`;
                tbody.appendChild(tr);
            });
        } else {
            tablaContainer.style.display = 'none';
        }

        // Observaciones
        const obsContainer = document.getElementById('modalObsContainer');
        if (obs && obs.trim()) {
            obsContainer.style.display = 'block';
            document.getElementById('modalObs').textContent = obs;
        } else {
            obsContainer.style.display = 'none';
        }

        document.getElementById('modalDetalle').classList.add('active');
        document.body.style.overflow = 'hidden';
    }

    function cerrarModal() {
        document.getElementById('modalDetalle').classList.remove('active');
        document.body.style.overflow = '';
    }

    function descargarDesdeModal() {
        const d = modalData;
        descargarPDF(d.id, d.folio, d.estado, d.fecha, d.total, d.cliente, '', d.producto, d.madera, d.entrega, d.obs, d.detalles);
    }

    // ---- Generación PDF con jsPDF ----
    function descargarPDF(id, folio, estado, fecha, total, clienteNombre, clienteCorreo, producto, madera, entrega, obs, detalles) {
        const { jsPDF } = window.jspdf;
        const doc = new jsPDF({ orientation: 'portrait', unit: 'mm', format: 'a4' });

        const margen = 18;
        const ancho = 210;
        let y = 0;

        // Encabezado marrón
        doc.setFillColor(78, 42, 24);
        doc.rect(0, 0, ancho, 38, 'F');

        // Logo texto
        doc.setFontSize(22);
        doc.setTextColor(201, 150, 88);
        doc.setFont('helvetica', 'bold');
        doc.text('CARPINTEC', margen, 18);

        doc.setFontSize(8);
        doc.setTextColor(255, 255, 255);
        doc.setFont('helvetica', 'normal');
        doc.text('Portal de Clientes | Facturación y Cotizaciones', margen, 25);

        // Folio y estado (derecha)
        doc.setFontSize(13);
        doc.setTextColor(255, 255, 255);
        doc.setFont('helvetica', 'bold');
        doc.text(folio, ancho - margen, 17, { align: 'right' });
        doc.setFontSize(9);
        doc.setTextColor(201, 150, 88);
        doc.text(estado.toUpperCase(), ancho - margen, 24, { align: 'right' });
        doc.setFontSize(8);
        doc.setTextColor(200, 200, 200);
        doc.text('Fecha: ' + fecha, ancho - margen, 30, { align: 'right' });

        y = 48;

        // Línea separadora dorada
        doc.setDrawColor(201, 150, 88);
        doc.setLineWidth(0.5);
        doc.line(margen, y - 4, ancho - margen, y - 4);

        // Datos del cliente
        doc.setFontSize(9);
        doc.setTextColor(100, 70, 40);
        doc.setFont('helvetica', 'bold');
        doc.text('DATOS DEL CLIENTE', margen, y);
        y += 6;

        doc.setFontSize(10);
        doc.setTextColor(30, 20, 10);
        doc.setFont('helvetica', 'normal');
        doc.text('Cliente: ' + (clienteNombre || '-'), margen, y); y += 5;
        if (clienteCorreo) { doc.text('Correo: ' + clienteCorreo, margen, y); y += 5; }

        y += 4;
        doc.setDrawColor(220, 200, 180);
        doc.setLineWidth(0.3);
        doc.line(margen, y, ancho - margen, y);
        y += 6;

        // Detalle del pedido
        doc.setFontSize(9);
        doc.setTextColor(100, 70, 40);
        doc.setFont('helvetica', 'bold');
        doc.text('DETALLE DEL PEDIDO', margen, y);
        y += 6;

        doc.setFontSize(10);
        doc.setTextColor(30, 20, 10);
        doc.setFont('helvetica', 'normal');
        if (producto) { doc.text('Producto/Descripción: ' + producto, margen, y); y += 5; }
        if (madera) { doc.text('Tipo de madera: ' + madera, margen, y); y += 5; }
        if (entrega) { doc.text('Tiempo de entrega: ' + entrega, margen, y); y += 5; }

        // Tabla de detalles si existen
        if (detalles && detalles.length > 0) {
            y += 4;
            doc.setDrawColor(220, 200, 180);
            doc.line(margen, y, ancho - margen, y);
            y += 6;

            doc.setFontSize(9);
            doc.setTextColor(100, 70, 40);
            doc.setFont('helvetica', 'bold');
            doc.text('PRODUCTOS', margen, y);
            y += 5;

            // Cabecera tabla
            const cols = [margen, 75, 95, 120, 155];
            const headers = ['Producto', 'Cant.', 'Medidas', 'Precio Unit.', 'Subtotal'];
            doc.setFillColor(244, 236, 228);
            doc.rect(margen, y - 4, ancho - margen * 2, 7, 'F');
            doc.setFontSize(8);
            doc.setTextColor(78, 42, 24);
            doc.setFont('helvetica', 'bold');
            headers.forEach((h, i) => doc.text(h, cols[i], y));
            y += 5;

            doc.setFont('helvetica', 'normal');
            doc.setTextColor(30, 20, 10);
            detalles.forEach((d, idx) => {
                if (idx % 2 === 0) {
                    doc.setFillColor(252, 249, 246);
                    doc.rect(margen, y - 3.5, ancho - margen * 2, 6, 'F');
                }
                doc.setFontSize(8);
                doc.text(String(d.producto || '-').substring(0, 22), cols[0], y);
                doc.text(String(d.cantidad || '-'), cols[1], y);
                doc.text(String(d.medidas || '-').substring(0, 10), cols[2], y);
                doc.text('$' + Number(d.precioUnitario || 0).toLocaleString('es-CO'), cols[3], y);
                doc.text('$' + Number(d.subtotal || 0).toLocaleString('es-CO'), cols[4], y);
                y += 6;
            });
        }

        // Observaciones
        if (obs && obs.trim()) {
            y += 4;
            doc.setDrawColor(220, 200, 180);
            doc.line(margen, y, ancho - margen, y);
            y += 6;
            doc.setFontSize(9);
            doc.setTextColor(100, 70, 40);
            doc.setFont('helvetica', 'bold');
            doc.text('OBSERVACIONES', margen, y);
            y += 5;
            doc.setFont('helvetica', 'normal');
            doc.setFontSize(9);
            doc.setTextColor(60, 40, 20);
            const obsLines = doc.splitTextToSize(obs, ancho - margen * 2);
            doc.text(obsLines, margen, y);
            y += obsLines.length * 5 + 2;
        }

        // Total
        y += 6;
        doc.setFillColor(78, 42, 24);
        doc.rect(margen, y - 5, ancho - margen * 2, 12, 'F');
        doc.setFontSize(11);
        doc.setTextColor(255, 255, 255);
        doc.setFont('helvetica', 'bold');
        doc.text('TOTAL COTIZACIÓN', margen + 4, y + 3);
        doc.setTextColor(201, 150, 88);
        doc.text('$' + total, ancho - margen - 4, y + 3, { align: 'right' });

        // Pie de página
        y = 280;
        doc.setDrawColor(201, 150, 88);
        doc.setLineWidth(0.4);
        doc.line(margen, y, ancho - margen, y);
        y += 5;
        doc.setFontSize(7);
        doc.setTextColor(120, 100, 80);
        doc.setFont('helvetica', 'normal');
        doc.text('CARPINTEC — Muebles con Alma | portal.carpintec.com | Generado el ' + new Date().toLocaleDateString('es-CO'), ancho / 2, y, { align: 'center' });

        doc.save('Cotizacion-' + folio + '.pdf');
    }

    // ---- Descargar resumen de todas ----
    function descargarTodoPDF() {
        const { jsPDF } = window.jspdf;
        const doc = new jsPDF({ orientation: 'portrait', unit: 'mm', format: 'a4' });
        const margen = 18;
        const ancho = 210;
        let y = 0;

        doc.setFillColor(78, 42, 24);
        doc.rect(0, 0, ancho, 34, 'F');
        doc.setFontSize(20); doc.setTextColor(201, 150, 88); doc.setFont('helvetica', 'bold');
        doc.text('CARPINTEC', margen, 16);
        doc.setFontSize(8); doc.setTextColor(255, 255, 255); doc.setFont('helvetica', 'normal');
        doc.text('Resumen de Cotizaciones — ' + new Date().toLocaleDateString('es-CO'), margen, 23);

        y = 44;
        doc.setFontSize(9); doc.setTextColor(100, 70, 40); doc.setFont('helvetica', 'bold');
        doc.text('TODAS LAS COTIZACIONES', margen, y); y += 6;

        const cols = [margen, 60, 100, 140, 165];
        const headers = ['Folio', 'Producto', 'Fecha', 'Estado', 'Total'];
        doc.setFillColor(244, 236, 228);
        doc.rect(margen, y - 4, ancho - margen * 2, 7, 'F');
        doc.setFontSize(8); doc.setTextColor(78, 42, 24); doc.setFont('helvetica', 'bold');
        headers.forEach((h, i) => doc.text(h, cols[i], y)); y += 5;

        const cards = document.querySelectorAll('.invoice-card');
        doc.setFont('helvetica', 'normal'); doc.setTextColor(30, 20, 10);
        let idx = 0;
        cards.forEach(card => {
            const busq = card.getAttribute('data-busqueda') || '';
            const parts = busq.split(' ');
            if (idx % 2 === 0) { doc.setFillColor(252, 249, 246); doc.rect(margen, y - 3.5, ancho - margen * 2, 6, 'F'); }
            doc.setFontSize(8);
            const folio = card.querySelector('.text-\\[11px\\].font-bold.text-\\[\\#8C5E3C\\]')?.textContent?.trim() || '';
            const titulo = card.querySelector('h2')?.textContent?.trim() || '';
            const fecha = card.querySelectorAll('.text-\\[11px\\]')[1]?.textContent?.trim() || '';
            const est = card.querySelector('.badge')?.textContent?.trim() || '';
            const tot = card.querySelector('.font-bold.text-\\[\\#3E2723\\]')?.textContent?.trim() || '';
            doc.text(folio.substring(0, 10), cols[0], y);
            doc.text(titulo.substring(0, 18), cols[1], y);
            doc.text(fecha.substring(0, 12), cols[2], y);
            doc.text(est.substring(0, 12), cols[3], y);
            doc.text(tot.substring(0, 12), cols[4], y);
            y += 6; idx++;
            if (y > 270) { doc.addPage(); y = 20; }
        });

        doc.save('Carpintec-Resumen-Cotizaciones.pdf');
    }

    document.addEventListener('keydown', e => { if (e.key === 'Escape') cerrarModal(); });
</script>
