@model CARPINTEC_App.Models.ViewModels.ReportesViewModel

<!DOCTYPE html>
<html class="light" lang="es">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>Carpintec - Reportes y Estadísticas</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <!-- INICIO: Fuentes de Google - Work Sans -->
    <link href="https://fonts.googleapis.com/css2?family=Work+Sans:wght@400;500;600;700;800;900&amp;display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet" />
    <!-- FIN: Fuentes de Google - Work Sans -->
    <!-- Tailwind Theme Config -->
    <script id="tailwind-config">
            tailwind.config = {
                darkMode: "class",
                theme: {
                    extend: {
                        "colors": {
                            "inverse-primary": "#e1c299",
                            "on-primary-fixed-variant": "#584324",
                            "surface-container-highest": "#e4e2dd",
                            "on-tertiary-fixed": "#0e1c2f",
                            "on-background": "#000000",
                            "on-tertiary-container": "#3d495f",
                            "outline-variant": "#d1c5b8",
                            "secondary": "#5f5e5e",
                            "tertiary-fixed-dim": "#bac7e1",
                            "secondary-fixed-dim": "#c8c6c5",
                            "tertiary-fixed": "#d6e3fe",
                            "error": "#ba1a1a",
                            "primary-fixed": "#feddb3",
                            "on-primary-container": "#000000",
                            "on-secondary-fixed-variant": "#474747",
                            "on-secondary": "#ffffff",
                            "surface-container-lowest": "#ffffff",
                            "inverse-on-surface": "#f2f1ec",
                            "surface-dim": "#dbdad5",
                            "surface-container": "#f0eee9",
                            "error-container": "#ffdad6",
                            "on-secondary-fixed": "#1b1c1c",
                            "on-error": "#ffffff",
                            "on-error-container": "#93000a",
                            "surface-container-high": "#eae8e3",
                            "inverse-surface": "#30312e",
                            "on-tertiary-fixed-variant": "#3b475d",
                            "on-primary-fixed": "#000000",
                            "secondary-fixed": "#e4e2e1",
                            "surface": "#fbf9f4",
                            "primary-fixed-dim": "#e1c299",
                            "primary": "#D2B48C",
                            "on-secondary-container": "#656464",
                            "on-surface-variant": "#000000",
                            "background": "#fbf9f4",
                            "surface-tint": "#D2B48C",
                            "surface-bright": "#fbf9f4",
                            "on-surface": "#000000",
                            "tertiary": "#525f76",
                            "on-primary": "#000000",
                            "surface-container-low": "#f5f3ee",
                            "secondary-container": "#e4e2e1",
                            "outline": "#7f766a",
                            "surface-variant": "#e4e2dd",
                            "tertiary-container": "#acb9d3",
                            "primary-container": "#D2B48C",
                            "on-tertiary": "#ffffff"
                        },
                        "borderRadius": {
                            "DEFAULT": "0.25rem",
                            "lg": "0.5rem",
                            "xl": "0.75rem",
                            "full": "9999px"
                        },
                        "spacing": {
                            "margin-mobile": "16px",
                            "base": "8px",
                            "sidebar-width": "280px",
                            "gutter": "24px",
                            "card-padding": "24px",
                            "margin-desktop": "40px"
                        },
                        /* INICIO: Configuración Work Sans en Tailwind */
                        "fontFamily": {
                            "body-lg": ["Work Sans", "sans-serif"],
                            "headline-md": ["Work Sans", "sans-serif"],
                            "headline-lg": ["Work Sans", "sans-serif"],
                            "title-md": ["Work Sans", "sans-serif"],
                            "label-md": ["Work Sans", "sans-serif"],
                            "data-table": ["Work Sans", "sans-serif"],
                            "body-md": ["Work Sans", "sans-serif"],
                            "display-lg": ["Work Sans", "sans-serif"]
                        }
                        /* FIN: Configuración Work Sans en Tailwind */
                    },
                },
            }
    </script>
    <!-- INICIO: Estilos de tipografía Work Sans en negrita y corrección de colores -->
    <style>
            @@import url('https://fonts.googleapis.com/css2?family=Work+Sans:wght@400;500;600;700;800;900&display=swap');

            body,
            main,
            #main-content,
            #main-content *:not(.material-symbols-outlined):not([class*="fa-"]):not(i) {
                font-family: 'Work Sans', sans-serif !important;
                font-weight: 700 !important;
            }

            .material-symbols-outlined {
                font-family: 'Material Symbols Outlined' !important;
                font-weight: normal !important;
                font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
                vertical-align: middle;
            }

            body {
                background-color: #fbf9f4;
                font-family: 'Work Sans', sans-serif !important;
                font-weight: 700 !important;
                color: #000000;
            }

            /* Corrección de azul de Bootstrap a beige (#D2B48C) y negro */
            .bg-primary {
                background-color: #D2B48C !important;
            }

            .text-primary {
                color: #000000 !important;
            }

            .border-primary {
                border-color: #D2B48C !important;
            }

            .card-shadow {
                box-shadow: 0 4px 12px rgba(210, 180, 140, 0.12);
            }

            .custom-scrollbar::-webkit-scrollbar {
                width: 4px;
            }

            .custom-scrollbar::-webkit-scrollbar-track {
                background: #f0eee9;
            }

            .custom-scrollbar::-webkit-scrollbar-thumb {
                background: #d1c5b8;
                border-radius: 10px;
            }

            /* Estilos de impresión para PDF */
            @@media print {
                .no-print, header, button, select, .controls-section {
                    display: none !important;
                }
                body, #main-content {
                    background: #ffffff !important;
                    padding: 0 !important;
                }
                .card-shadow {
                    box-shadow: none !important;
                    border: 1px solid #ccc !important;
                }
            }
    </style>
    <!-- FIN: Estilos de tipografía Work Sans en negrita y corrección de colores -->
</head>
<body class="bg-background text-on-background">
    <!-- MAIN CONTENT AREA -->
    <div class="w-full p-4 md:p-8 max-w-[1440px] mx-auto" id="main-content">
        <!-- TOP APP BAR / RETROCESO -->
        <div class="flex items-center gap-2 mb-4 no-print">
            <a href="/Dashboard/Index"
               class="flex items-center gap-2 text-black font-bold hover:underline" style="color: #000000;">
                <span class="material-symbols-outlined text-black">arrow_back</span>
                Volver al Dashboard
            </a>
        </div>

        <h2 class="text-4xl font-bold text-black mb-2" style="color: #000000;">
            Reportes y Estadísticas
        </h2>

        <p class="text-black/80 font-bold mb-6">
            Consulta métricas dinámicas en tiempo real y exporta los reportes actualizados de Carpintec.
        </p>

        <!-- DASHBOARD CANVAS -->
        <div class="space-y-gutter flex-1">
            <!-- CONTROLS & EXPORT -->
            <section class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 controls-section no-print">
                <div class="flex flex-wrap items-center gap-3">
                    <!-- Selector de período dinámico conectado al controlador -->
                    <div class="flex bg-surface-container-low p-1 rounded-xl border border-outline-variant shadow-sm">
                        <a href="@Url.Action("Index", "Reportes", new { periodo = "mes", anio = Model.AnioSeleccionado })"
                           class="px-6 py-2 rounded-lg font-bold font-title-md text-title-md transition-all @(Model.PeriodoSeleccionado == "mes" ? "bg-primary text-black" : "text-black hover:bg-surface-container-high")">
                            Mes
                        </a>
                        <a href="@Url.Action("Index", "Reportes", new { periodo = "trimestre", anio = Model.AnioSeleccionado })"
                           class="px-6 py-2 rounded-lg font-bold font-title-md text-title-md transition-all @(Model.PeriodoSeleccionado == "trimestre" ? "bg-primary text-black" : "text-black hover:bg-surface-container-high")">
                            Trimestre
                        </a>
                        <a href="@Url.Action("Index", "Reportes", new { periodo = "anio", anio = Model.AnioSeleccionado })"
                           class="px-6 py-2 rounded-lg font-bold font-title-md text-title-md transition-all @(Model.PeriodoSeleccionado == "anio" ? "bg-primary text-black" : "text-black hover:bg-surface-container-high")">
                            Año
                        </a>
                    </div>

                    <!-- Selector de Año (solo a partir de 2025 y siguientes) -->
                    <div class="flex items-center gap-2 bg-surface-container-low px-3 py-1.5 rounded-xl border border-outline-variant shadow-sm">
                        <span class="material-symbols-outlined text-sm text-black">calendar_month</span>
                        <label for="selectAnioTop" class="text-xs font-bold text-black uppercase tracking-wider">Año:</label>
                        <select id="selectAnioTop"
                                onchange="window.location.href='@Url.Action("Index", "Reportes")?periodo=@Model.PeriodoSeleccionado&anio=' + this.value"
                                class="bg-surface-container-lowest border border-outline-variant/60 rounded-lg px-3 py-1 font-bold text-sm text-black cursor-pointer focus:border-[#D2B48C] focus:ring-1 focus:ring-[#D2B48C] outline-none">
                            @foreach (var a in Model.AniosDisponibles)
                            {
                                <option value="@a" selected="@(a == Model.AnioSeleccionado)">@a</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="flex gap-3 w-full md:w-auto">
                    <!-- Botones de exportación funcionales -->
                    <a href="@Url.Action("ExportarExcel", "Reportes", new { periodo = Model.PeriodoSeleccionado, anio = Model.AnioSeleccionado })"
                       class="flex-1 md:flex-none flex items-center justify-center gap-2 px-6 py-2 bg-surface-container-lowest border-2 border-[#D2B48C] text-black font-bold rounded-xl font-title-md text-title-md hover:bg-[#D2B48C]/10 transition-all shadow-sm"
                       style="border-color: #D2B48C !important; color: #000000 !important;">
                        <span class="material-symbols-outlined text-black" data-icon="download">download</span>
                        Exportar Excel
                    </a>

                    <button type="button"
                            onclick="window.print()"
                            class="flex-1 md:flex-none flex items-center justify-center gap-2 px-6 py-2 bg-[#D2B48C] text-black font-bold rounded-xl font-title-md text-title-md hover:brightness-95 transition-all shadow-md"
                            style="background-color: #D2B48C !important; color: #000000 !important;">
                        <span class="material-symbols-outlined text-black" data-icon="picture_as_pdf">picture_as_pdf</span>
                        Exportar PDF
                    </button>
                </div>
            </section>

            <!-- KPI GRID (MÉTRICAS EN TIEMPO REAL DESDE LA BASE DE DATOS) -->
            <section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
                <!-- KPI 1: Ventas Totales -->
                <div class="bg-surface-container-lowest p-card-padding rounded-xl border border-outline-variant card-shadow flex flex-col justify-between group hover:-translate-y-1 transition-transform">
                    <div class="flex justify-between items-start">
                        <div class="p-3 bg-primary/20 rounded-lg">
                            <span class="material-symbols-outlined text-black" data-icon="payments">payments</span>
                        </div>
                        <span class="font-label-md text-label-md flex items-center gap-1 @(Model.VariacionVentasPositiva ? "text-emerald-600" : "text-rose-600") font-bold">
                            <span class="material-symbols-outlined text-sm font-bold">
                                @(Model.VariacionVentasPositiva ? "trending_up" : "trending_down")
                            </span>
                            @Model.VariacionVentas
                        </span>
                    </div>
                    <div class="mt-4">
                        <p class="font-label-md text-label-md text-black uppercase tracking-wider opacity-70">Ventas Totales</p>
                        <h3 class="font-headline-md text-headline-md font-bold mt-1 text-black">
                            @Model.VentasTotales.ToString("C0", System.Globalization.CultureInfo.CreateSpecificCulture("es-CO"))
                        </h3>
                    </div>
                </div>

                <!-- KPI 2: Ganancias Netas -->
                <div class="bg-surface-container-lowest p-card-padding rounded-xl border border-outline-variant card-shadow flex flex-col justify-between group hover:-translate-y-1 transition-transform">
                    <div class="flex justify-between items-start">
                        <div class="p-3 bg-primary/20 rounded-lg">
                            <span class="material-symbols-outlined text-black" data-icon="account_balance_wallet">account_balance_wallet</span>
                        </div>
                        <span class="font-label-md text-label-md flex items-center gap-1 text-emerald-600 font-bold">
                            <span class="material-symbols-outlined text-sm font-bold" data-icon="trending_up">trending_up</span>
                            @Model.VariacionGanancias
                        </span>
                    </div>
                    <div class="mt-4">
                        <p class="font-label-md text-label-md text-black uppercase tracking-wider opacity-70">Ganancias Netas</p>
                        <h3 class="font-headline-md text-headline-md font-bold mt-1 text-black">
                            @Model.GananciasNetas.ToString("C0", System.Globalization.CultureInfo.CreateSpecificCulture("es-CO"))
                        </h3>
                    </div>
                </div>

                <!-- KPI 3: Pedidos Completados -->
                <div class="bg-surface-container-lowest p-card-padding rounded-xl border border-outline-variant card-shadow flex flex-col justify-between group hover:-translate-y-1 transition-transform">
                    <div class="flex justify-between items-start">
                        <div class="p-3 bg-primary/20 rounded-lg">
                            <span class="material-symbols-outlined text-black" data-icon="task_alt">task_alt</span>
                        </div>
                        <span class="font-label-md text-label-md text-black opacity-70 capitalize">@Model.PeriodoSeleccionado actual</span>
                    </div>
                    <div class="mt-4">
                        <p class="font-label-md text-label-md text-black uppercase tracking-wider opacity-70">Pedidos Completados</p>
                        <h3 class="font-headline-md text-headline-md font-bold mt-1 text-black">
                            @Model.PedidosCompletados
                        </h3>
                    </div>
                </div>

                <!-- KPI 4: Cotizaciones Pendientes -->
                <div class="bg-surface-container-lowest p-card-padding rounded-xl border border-outline-variant card-shadow flex flex-col justify-between group hover:-translate-y-1 transition-transform">
                    <div class="flex justify-between items-start">
                        <div class="p-3 bg-error-container/30 rounded-lg">
                            <span class="material-symbols-outlined text-error" data-icon="pending_actions">pending_actions</span>
                        </div>
                        <span class="font-label-md text-label-md text-error font-bold flex items-center gap-1">
                            <span class="material-symbols-outlined text-sm" data-icon="priority_high">priority_high</span>
                            Por atender
                        </span>
                    </div>
                    <div class="mt-4">
                        <p class="font-label-md text-label-md text-black uppercase tracking-wider opacity-70">Cotizaciones Pendientes</p>
                        <h3 class="font-headline-md text-headline-md font-bold mt-1 text-black">
                            @Model.CotizacionesPendientes
                        </h3>
                    </div>
                </div>
            </section>

            <!-- ANALYTICS BENTO GRID -->
            <section class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                <!-- Gráfica 1: Ventas por Mes con Colores (Datos reales de la BD) -->
                <div class="lg:col-span-2 bg-surface-container-lowest p-card-padding rounded-xl border border-outline-variant card-shadow flex flex-col justify-between">
                    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-2 mb-4">
                        <div>
                            <div class="flex items-center gap-2">
                                <span class="material-symbols-outlined text-[#D2B48C]">bar_chart</span>
                                <h4 class="font-title-md text-title-md text-black font-bold">Ventas por Mes</h4>
                            </div>
                            <p class="font-label-md text-label-md text-black opacity-70">Facturación mensual (@Model.AnioSeleccionado) con gráfico de barras multicolor</p>
                        </div>
                        <div class="flex items-center gap-2">
                            <span class="text-xs font-bold text-black/60">Año:</span>
                            <select onchange="window.location.href='@Url.Action("Index", "Reportes")?periodo=@Model.PeriodoSeleccionado&anio=' + this.value"
                                    class="bg-surface-container-low border border-outline-variant rounded-lg px-3 py-1 font-label-md text-label-md text-black font-bold cursor-pointer focus:ring-1 focus:ring-[#D2B48C]">
                                @foreach (var anio in Model.AniosDisponibles)
                                {
                                    <option value="@anio" selected="@(anio == Model.AnioSeleccionado)">@anio</option>
                                }
                            </select>
                        </div>
                    </div>

                    <!-- Mensaje si no hay ventas en el año seleccionado -->
                    @if (Model.VentasPorMes.All(m => m.Total == 0))
                    {
                        <div class="flex items-center gap-2 p-2.5 bg-surface-container-low/80 border border-outline-variant/30 rounded-lg text-xs font-bold text-black mb-2">
                            <span class="material-symbols-outlined text-base text-[#D2B48C]">info</span>
                            <span>No se registran movimientos de ventas en el año @Model.AnioSeleccionado.</span>
                        </div>
                    }

                    <!-- Canvas del Gráfico de Barras con Chart.js -->
                    <div class="relative w-full h-64 md:h-72 my-2">
                        <canvas id="chartVentasMensuales"></canvas>
                    </div>

                    <!-- Leyenda de colores por cada mes -->
                    <div class="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-6 gap-2 mt-3 pt-3 border-t border-outline-variant/30">
                        @if (Model.VentasPorMes != null && Model.VentasPorMes.Any())
                        {
                            foreach (var item in Model.VentasPorMes)
                            {
                                <div class="flex items-center gap-2 p-1.5 rounded-lg bg-surface-container-low/40 border border-outline-variant/20 hover:scale-105 transition-transform cursor-default"
                                     title="@item.MesCompleto: @item.Total.ToString("C0", System.Globalization.CultureInfo.CreateSpecificCulture("es-CO"))">
                                    <span class="w-3 h-3 rounded-full shrink-0 shadow-sm" style="background-color: @item.ColorHex;"></span>
                                    <div class="truncate leading-tight">
                                        <span class="font-bold text-xs text-black block">@item.Mes</span>
                                        <span class="text-[10px] text-black/70 font-semibold block">$@((item.Total / 1000000m).ToString("0.0"))M</span>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </div>

                <!-- Gráfica 2: Pedidos por Estado (Datos reales de la BD) -->
                <div class="bg-surface-container-lowest p-card-padding rounded-xl border border-outline-variant card-shadow flex flex-col">
                    <h4 class="font-title-md text-title-md text-black font-bold mb-6">Pedidos por Estado</h4>
                    <div class="relative flex-1 flex flex-col items-center justify-center">
                        <svg class="w-48 h-48 -rotate-90 transform" viewBox="0 0 100 100">
                            <!-- Círculo base de fondo -->
                            <circle cx="50" cy="50" fill="transparent" r="40" stroke="#f0dfd6" stroke-width="12"></circle>
                            
                            <!-- Segmento 1: Producción -->
                            <circle class="transition-all duration-1000" cx="50" cy="50" fill="transparent" r="40"
                                    stroke="#D2B48C" stroke-width="12"
                                    stroke-dasharray="@((Model.PorcentajeProduccion * 2.512).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)) 251.2"
                                    stroke-dashoffset="0"></circle>

                            <!-- Segmento 2: Entregados -->
                            <circle class="transition-all duration-1000" cx="50" cy="50" fill="transparent" r="40"
                                    stroke="#000000" stroke-width="12"
                                    stroke-dasharray="@((Model.PorcentajeEntregados * 2.512).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)) 251.2"
                                    stroke-dashoffset="-@((Model.PorcentajeProduccion * 2.512).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))"></circle>
                        </svg>

                        <div class="absolute text-center">
                            <span class="font-display-lg text-black text-3xl font-bold">@Model.TotalPedidos</span>
                            <p class="font-label-md text-label-md text-black opacity-70">Totales</p>
                        </div>
                    </div>

                    <div class="grid grid-cols-2 gap-4 mt-6">
                        <div class="flex items-center gap-2">
                            <div class="w-3 h-3 rounded-full bg-[#D2B48C]"></div>
                            <span class="font-label-md text-label-md text-black">Producción (@Model.PorcentajeProduccion%)</span>
                        </div>
                        <div class="flex items-center gap-2">
                            <div class="w-3 h-3 rounded-full bg-black"></div>
                            <span class="font-label-md text-label-md text-black">Entregados (@Model.PorcentajeEntregados%)</span>
                        </div>
                        <div class="flex items-center gap-2">
                            <div class="w-3 h-3 rounded-full bg-surface-variant"></div>
                            <span class="font-label-md text-label-md text-black">En espera (@Model.PorcentajeEnEspera%)</span>
                        </div>
                        <div class="flex items-center gap-2">
                            <div class="w-3 h-3 rounded-full bg-red-600"></div>
                            <span class="font-label-md text-label-md text-black">Cancelado (@Model.PorcentajeCancelados%)</span>
                        </div>
                    </div>
                </div>

                <!-- Sección 3: Top de Productos más Solicitados (Datos reales de la BD) -->
                <div class="lg:col-span-3 bg-surface-container-lowest p-card-padding rounded-xl border border-outline-variant card-shadow">
                    <div class="flex justify-between items-center mb-6">
                        <h4 class="font-title-md text-title-md text-black font-bold">Top de Productos más Solicitados</h4>
                        <a href="@Url.Action("Index", "Productos")" class="text-black font-bold font-label-md text-label-md flex items-center gap-1 hover:underline">
                            Ver catálogo completo
                            <span class="material-symbols-outlined text-sm" data-icon="arrow_forward">arrow_forward</span>
                        </a>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
                        @if (Model.TopProductos != null && Model.TopProductos.Any())
                        {
                            foreach (var prod in Model.TopProductos)
                            {
                                var imgProd = !string.IsNullOrEmpty(prod.Imagen)
                                    ? prod.Imagen
                                    : CARPINTEC_App.Controllers.ProductosController.ObtenerImagenPorDefecto("", prod.Nombre);
                                var fallbackImg = CARPINTEC_App.Controllers.ProductosController.ObtenerImagenPorDefecto("", prod.Nombre);

                                <div class="group cursor-pointer bg-surface p-3 rounded-xl border border-outline-variant/20 hover:border-[#D2B48C] transition-all shadow-sm">
                                    <div class="relative overflow-hidden rounded-xl mb-3 aspect-video bg-surface-container">
                                        <img alt="@prod.Nombre" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" src="@imgProd" onerror="this.onerror=null; this.src='@fallbackImg';" />
                                        <div class="absolute top-2 right-2 bg-black text-white font-bold font-label-md text-xs px-2 py-1 rounded shadow">
                                            #@prod.Ranking TOP
                                        </div>
                                    </div>
                                    <h5 class="font-title-md text-base text-black font-bold truncate" title="@prod.Nombre">@prod.Nombre</h5>
                                    <div class="flex justify-between items-center mt-1">
                                        <p class="font-label-md text-xs text-black opacity-70">@prod.TotalPedidos pedidos</p>
                                        <span class="font-body-md text-sm font-bold text-black">
                                            @prod.PrecioPromedio.ToString("C0", System.Globalization.CultureInfo.CreateSpecificCulture("es-CO"))
                                        </span>
                                    </div>
                                    <div class="w-full bg-surface-container-highest h-2 rounded-full mt-3 overflow-hidden">
                                        <div class="bg-[#D2B48C] h-full rounded-full transition-all duration-700" style="width: @(prod.PorcentajeBarra)%;"></div>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </div>
            </section>
        </div>

        <!-- FOOTER INFO -->
        <footer class="mt-12 p-4 flex flex-col sm:flex-row justify-between items-center text-black border-t border-outline-variant bg-surface-container-lowest rounded-xl no-print">
            <p class="font-label-md text-label-md opacity-60">© @DateTime.Now.Year Carpintec. Todos los derechos reservados.</p>
            <div class="flex gap-6 mt-2 sm:mt-0">
                <span class="font-label-md text-label-md opacity-60">Reportes Generados con Datos Oficiales de Base de Datos</span>
            </div>
        </footer>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const canvasElem = document.getElementById('chartVentasMensuales');
            if (!canvasElem) return;

            const ctx = canvasElem.getContext('2d');
            const labels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.VentasPorMes.Select(m => m.Mes)));
            const labelsCompletos = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.VentasPorMes.Select(m => m.MesCompleto)));
            const dataValores = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.VentasPorMes.Select(m => m.Total)));
            const colores = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.VentasPorMes.Select(m => m.ColorHex)));

            new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Ventas (@Model.AnioSeleccionado)',
                        data: dataValores,
                        backgroundColor: colores,
                        borderColor: colores,
                        borderWidth: 1.5,
                        borderRadius: 8,
                        borderSkipped: false,
                        hoverBackgroundColor: colores,
                        hoverBorderWidth: 2.5,
                        hoverBorderColor: '#000000'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    animation: {
                        duration: 1000,
                        easing: 'easeOutQuart'
                    },
                    plugins: {
                        legend: {
                            display: false
                        },
                        tooltip: {
                            backgroundColor: '#1b1c1c',
                            titleColor: '#ffffff',
                            bodyColor: '#ffffff',
                            titleFont: { family: 'Work Sans', size: 13, weight: 'bold' },
                            bodyFont: { family: 'Work Sans', size: 12, weight: 'bold' },
                            padding: 12,
                            cornerRadius: 8,
                            displayColors: true,
                            callbacks: {
                                title: function(items) {
                                    const idx = items[0].dataIndex;
                                    return (labelsCompletos[idx] || labels[idx]) + ' ' + @Model.AnioSeleccionado;
                                },
                                label: function(item) {
                                    const valor = item.raw;
                                    return ' Facturación: ' + new Intl.NumberFormat('es-CO', { style: 'currency', currency: 'COP', maximumFractionDigits: 0 }).format(valor);
                                }
                            }
                        }
                    },
                    scales: {
                        x: {
                            grid: { display: false },
                            ticks: {
                                font: { family: 'Work Sans', weight: 'bold', size: 12 },
                                color: '#000000'
                            }
                        },
                        y: {
                            beginAtZero: true,
                            suggestedMax: 1000000,
                            grid: {
                                color: 'rgba(0, 0, 0, 0.06)',
                                drawBorder: false
                            },
                            ticks: {
                                font: { family: 'Work Sans', weight: 'bold', size: 11 },
                                color: '#000000',
                                callback: function(value) {
                                    if (value >= 1000000) return '$' + (value / 1000000).toFixed(1) + 'M';
                                    if (value >= 1000) return '$' + (value / 1000).toFixed(0) + 'k';
                                    return '$' + value;
                                }
                            }
                        }
                    }
                }
            });
        });
    </script>
</body>
</html>