                <a class="font-label-md text-label-md opacity-60 hover:text-black hover:opacity-100 transition-colors" href="#">Términos</a>
                <a class="font-label-md text-label-md opacity-60 hover:text-black hover:opacity-100 transition-colors" href="#">Privacidad</a>
            </div>
        </footer>
    </div>
    <script>
            document.addEventListener('DOMContentLoaded', () => {
                const bars = document.querySelectorAll('.bg-surface-container-highest');
                bars.forEach((bar, index) => {
                    const targetHeight = bar.style.height;
                    bar.style.height = '0%';
                    setTimeout(() => {
                        bar.style.height = targetHeight;
                    }, 200 + (index * 100));
                });

                const buttons = document.querySelectorAll('button');
                buttons.forEach(btn => {
                    btn.addEventListener('mousedown', () => {
                        btn.classList.add('scale-[0.98]');
                    });
                    btn.addEventListener('mouseup', () => {
                        btn.classList.remove('scale-[0.98]');
                    });
                });
            });
    </script>
</body></html>