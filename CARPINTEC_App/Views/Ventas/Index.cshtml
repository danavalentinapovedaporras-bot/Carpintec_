<!-- Pagos Pendientes List -->
<div>
<h4 class="text-label-md font-label-md text-on-surface-variant mb-4 uppercase tracking-wider">Pagos Pendientes</h4>
<div class="overflow-x-auto">
    <table class="w-full text-left border-collapse">
        <thead>
            <tr class="text-label-md font-label-md text-on-surface-variant border-b border-outline-variant/30">
                <th class="py-2 px-2 font-semibold">Cliente</th>
                <th class="py-2 px-2 font-semibold">Factura</th>
                <th class="py-2 px-2 font-semibold">Total</th>
                <th class="py-2 px-2 font-semibold">Vencimiento</th>
                <th class="py-2 px-2 font-semibold">Estado</th>
            </tr>
        </thead>
        <tbody class="text-body-sm font-body-sm">
            <!-- INICIO: Listado de Facturas pendientes con códigos en negro -->
            <tr class="border-b border-outline-variant/10 hover:bg-surface-container-low/30 transition-colors">
                <td class="py-3 px-2 font-semibold text-on-surface">María Gómez</td>
                <td class="py-3 px-2 font-bold text-black" style="color: #000000 !important;">FAC-2026-003</td>
                <td class="py-3 px-2 font-semibold">$1.200.000</td>
                <td class="py-3 px-2 text-on-surface-variant">21/08/2026</td>
                <td class="py-3 px-2">
                    <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold bg-error-container/50 text-error">Vencido</span>
                </td>
            </tr>
            <tr class="border-b border-outline-variant/10 hover:bg-surface-container-low/30 transition-colors">
                <td class="py-3 px-2 font-semibold text-on-surface">Carlos Pérez</td>
                <td class="py-3 px-2 font-bold text-black" style="color: #000000 !important;">FAC-2026-004</td>
                <td class="py-3 px-2 font-semibold">$850.000</td>
                <td class="py-3 px-2 text-on-surface-variant">27/08/2026</td>
                <td class="py-3 px-2">
                    <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold bg-secondary-fixed text-on-secondary-fixed-variant">Pendiente</span>
                </td>
