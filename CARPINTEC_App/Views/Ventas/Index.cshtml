<div class="w-12 h-12 rounded-full bg-secondary-container/50 text-secondary-fixed flex items-center justify-center shrink-0">
<span class="material-symbols-outlined" data-icon="payments">payments</span>
</div>
<div>
<div class="text-label-md font-label-md text-on-surface-variant">Ventas del mes</div>
<div class="text-headline-md font-headline-md text-on-surface mt-1">$12.450.000</div>
<div class="text-body-sm font-body-sm text-tertiary-container flex items-center mt-1 gap-1">
<span class="material-symbols-outlined text-[16px]" data-icon="trending_up">trending_up</span>
                                12.5% este mes
                            </div>
</div>
</div>
</div>
<!-- KPI 2 -->
<div class="bg-surface-container-lowest rounded-xl p-md border border-outline-variant/30 shadow-[0_4px_12px_rgba(68,42,34,0.03)] hover:-translate-y-0.5 transition-transform duration-300">
<div class="flex items-start gap-4">
<div class="w-12 h-12 rounded-full bg-surface-variant text-on-surface-variant flex items-center justify-center shrink-0">
<span class="material-symbols-outlined" data-icon="receipt">receipt</span>
</div>
<div>
<div class="text-label-md font-label-md text-on-surface-variant">Facturas emitidas</div>
<div class="text-headline-md font-headline-md text-on-surface mt-1">48</div>
<div class="text-body-sm font-body-sm text-on-surface-variant mt-1">Este mes</div>
</div>
</div>
</div>
<!-- KPI 3 -->
<div class="bg-surface-container-lowest rounded-xl p-md border border-outline-variant/30 shadow-[0_4px_12px_rgba(68,42,34,0.03)] hover:-translate-y-0.5 transition-transform duration-300">
<div class="flex items-start gap-4">
<div class="w-12 h-12 rounded-full bg-error-container/50 text-on-error-container flex items-center justify-center shrink-0">
<span class="material-symbols-outlined" data-icon="schedule">schedule</span>
</div>
<div>
<div class="text-label-md font-label-md text-on-surface-variant">Pagos pendientes</div>
<div class="text-headline-md font-headline-md text-on-surface mt-1">$3.250.000</div>
<div class="text-body-sm font-body-sm text-error mt-1 font-semibold">12 facturas pendientes</div>
</div>
</div>
</div>
<!-- KPI 4 -->
<div class="bg-surface-container-lowest rounded-xl p-md border border-outline-variant/30 shadow-[0_4px_12px_rgba(68,42,34,0.03)] hover:-translate-y-0.5 transition-transform duration-300">
<div class="flex items-start gap-4">
<div class="w-12 h-12 rounded-full bg-tertiary-fixed text-on-tertiary-fixed flex items-center justify-center shrink-0">
<span class="material-symbols-outlined" data-icon="check_circle">check_circle</span>
</div>
<div>
<div class="text-label-md font-label-md text-on-surface-variant">Facturas pagadas</div>
<div class="text-headline-md font-headline-md text-on-surface mt-1">35</div>
<div class="text-body-sm font-body-sm text-tertiary-container mt-1">73% del total</div>
</div>
</div>
</div>
</div>
<!-- Invoices List & Details Layout -->
<div class="grid grid-cols-1 xl:grid-cols-3 gap-lg">
<!-- Main List Area -->
<div class="xl:col-span-2 flex flex-col gap-md">
<!-- Filters Conectados a la Base de Datos -->
<form method="get" asp-action="Index" class="bg-surface-container-lowest rounded-xl p-sm border border-outline-variant/30 shadow-sm flex flex-col md:flex-row gap-sm items-center">
<div class="flex-1 w-full md:w-auto relative">
<span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant" data-icon="search">search</span>
<input name="search" value="@ViewBag.Search" class="w-full pl-10 pr-4 py-2 bg-surface-bright border border-outline-variant/50 rounded-lg text-body-sm text-black font-bold focus:border-primary focus:ring-1 focus:ring-primary/20 transition-all outline-none" placeholder="Buscar por número, cliente o pedido..." type="text">
</div>
<div class="flex flex-wrap md:flex-nowrap w-full md:w-auto gap-sm items-center">
<select name="estado" onchange="this.form.submit()" class="flex-1 md:w-36 bg-surface-bright border border-outline-variant/50 rounded-lg px-3 py-2 text-body-sm text-black font-bold focus:border-primary focus:ring-1 focus:ring-primary/20 outline-none cursor-pointer">
    <option value="" selected="@(string.IsNullOrEmpty((string?)ViewBag.Estado))">Estado: Todos</option>
    <option value="Pendiente" selected="@((string?)ViewBag.Estado == "Pendiente")">Pendiente</option>
    <option value="Pagada" selected="@((string?)ViewBag.Estado == "Pagada")">Pagada</option>
    <option value="Anulada" selected="@((string?)ViewBag.Estado == "Anulada")">Anulada</option>
</select>
<button type="submit" class="bg-[#D2B48C] text-black font-bold px-4 py-2 rounded-lg text-sm hover:brightness-95 transition-all shadow-sm" style="background-color: #D2B48C !important; color: #000000 !important;">
    Buscar
</button>
@if (!string.IsNullOrEmpty((string?)ViewBag.Search) || !string.IsNullOrEmpty((string?)ViewBag.Estado))
{
    <a href="/Ventas/Index" class="bg-surface-container hover:bg-surface-variant text-on-surface px-4 py-2 rounded-lg text-label-md font-label-md transition-colors flex items-center justify-center gap-2 border border-outline-variant/30 shrink-0" title="Limpiar filtros">
        <span class="material-symbols-outlined text-[18px]" data-icon="filter_alt_off">filter_alt_off</span>
        Limpiar
    </a>
}
</div>
</form>


<!-- Table Card -->
<div class="bg-surface-container-lowest rounded-xl border border-outline-variant/30 shadow-[0_4px_12px_rgba(68,42,34,0.03)] overflow-hidden flex flex-col">
    
    <div class="p-md border-b border-outline-variant/30 flex items-center gap-2">
        <span class="material-symbols-outlined text-primary" data-icon="receipt_long">receipt_long</span>
        <h3 class="text-body-lg font-body-lg font-semibold text-on-surface">Listado de facturas</h3>
    </div>
    
    <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse min-w-[800px]">
            <thead>
                <tr class="bg-surface-container-low/50 text-label-md font-label-md text-on-surface-variant border-b border-outline-variant/30">
                    <th class="py-3 px-4 font-semibold">Factura</th>
                    <th class="py-3 px-4 font-semibold">Cliente</th>
                    <th class="py-3 px-4 font-semibold">Fecha</th>
                    <th class="py-3 px-4 font-semibold">Total</th>
                    <th class="py-3 px-4 font-semibold">Estado</th>
                    <th class="py-3 px-4 font-semibold text-center">Acciones</th>
                </tr>
            </thead>
            <tbody class="text-body-sm font-body-sm">
                
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <tr class="border-b border-outline-variant/10 hover:bg-surface-container-lowest transition-colors bg-surface-container-low/20">
                            <!-- INICIO: Número de Factura dinámico en color negro -->
                            <td class="py-3 px-4 font-bold text-black" style="color: #000000 !important;">@item.NumeroFactura</td>
                            <!-- FIN: Número de Factura dinámico en color negro -->
                            
                            <!-- Nombre del Cliente desde la base de datos -->
                            <td class="py-3 px-4">@item.IdClienteNavigation?.Nombre</td>
                            
                            <!-- Fecha de Venta dinámica -->
                            <td class="py-3 px-4 text-on-surface-variant">@item.FechaVenta.ToString("dd/MM/yyyy")</td>
                            
                            <!-- Total dinámico -->
                            <td class="py-3 px-4 font-semibold">$@item.Total.ToString("N2")</td>
                            
                            <!-- Estado dinámico -->
                            <td class="py-3 px-4">
                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold 
                                    @(item.Estado == "Pagada" ? "bg-tertiary-fixed text-on-tertiary-fixed-variant" : 
                                      item.Estado == "Pendiente" ? "bg-secondary-fixed text-on-secondary-fixed-variant" : 
                                      "bg-error-container text-on-error-container")">
                                    @item.Estado
                                </span>
                            </td>
                            
                            <!-- Botones de Acción -->
                            <td class="py-3 px-4 text-center">
                                <div class="flex items-center justify-center gap-2 text-on-surface-variant">
                                                        <button type="button" onclick="cargarDetalle(@item.IdVenta)" class="p-1 hover:text-primary hover:bg-surface-container-low rounded" title="Ver detalle">
                                                            <span class="material-symbols-outlined text-[18px]" data-icon="visibility">visibility</span>
                                                        </button>
                                    <button class="p-1 hover:text-primary hover:bg-surface-container-low rounded" title="Descargar">
                                        <span class="material-symbols-outlined text-[18px]" data-icon="download">download</span>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="py-6 text-center text-on-surface-variant">
                            No hay facturas registradas en la base de datos.
                        </td>
                    </tr>
                }

            </tbody>
        </table>
    </div>

    <!-- Paginación inferior Conectada a la Base de Datos -->
    <div class="p-4 border-t border-outline-variant/30 flex flex-col sm:flex-row items-center justify-between gap-3 text-body-sm text-on-surface-variant bg-surface-container-lowest rounded-b-xl">
        <span class="font-bold text-black/70">Mostrando @(ViewBag.RegistroInicio ?? 0) a @(ViewBag.RegistroFin ?? 0) de @(ViewBag.TotalRegistros ?? 0) facturas</span>
        <div class="flex gap-1 items-center">
            @if ((ViewBag.PaginaActual ?? 1) > 1)
            {
                <a href="@Url.Action("Index", new { pagina = ViewBag.PaginaActual - 1, search = ViewBag.Search, estado = ViewBag.Estado })" class="px-3 py-1 border border-outline-variant/50 rounded font-bold text-black hover:bg-surface-container-low transition-colors text-xs">Anterior</a>
            }
            else
            {
                <button class="px-3 py-1 border border-outline-variant/30 rounded text-black/40 text-xs cursor-not-allowed" disabled>Anterior</button>
            }

            @for (int p = 1; p <= (ViewBag.TotalPaginas ?? 1); p++)
            {
                if (p == ViewBag.PaginaActual)
                {
                    <button class="w-7 h-7 bg-[#D2B48C] text-black rounded font-bold text-xs" style="background-color: #D2B48C; color: #000000;">@p</button>
                }
                else
                {
                    <a href="@Url.Action("Index", new { pagina = p, search = ViewBag.Search, estado = ViewBag.Estado })" class="w-7 h-7 flex items-center justify-center rounded border border-outline-variant/50 text-black hover:bg-surface-container font-bold text-xs">@p</a>
                }
            }

            @if ((ViewBag.PaginaActual ?? 1) < (ViewBag.TotalPaginas ?? 1))
            {
                <a href="@Url.Action("Index", new { pagina = ViewBag.PaginaActual + 1, search = ViewBag.Search, estado = ViewBag.Estado })" class="px-3 py-1 border border-outline-variant/50 rounded font-bold text-black hover:bg-surface-container-low transition-colors text-xs">Siguiente</a>
            }
            else
            {
                <button class="px-3 py-1 border border-outline-variant/30 rounded text-black/40 text-xs cursor-not-allowed" disabled>Siguiente</button>
            }
        </div>
    </div>

</div>
                    <!--cuadros <actualizados></actualizados>-->
<div class="bg-surface-container-lowest rounded-xl border border-outline-variant/30 shadow-[0_4px_12px_rgba(68,42,34,0.03)] overflow-hidden">
<div class="p-md border-b border-outline-variant/30 flex items-center gap-2">
<span class="material-symbols-outlined text-primary" data-icon="analytics">analytics</span>
<h3 class="text-body-lg font-body-lg font-semibold text-on-surface">Resumen de Ventas y Pendientes</h3>
</div>
<div class="p-md grid grid-cols-1 md:grid-cols-2 gap-lg">
