    <!-- MODAL DE NUEVA FACTURA -->
    <div id="modal-nueva-factura" class="fixed inset-0 z-50 flex items-center justify-center bg-black/50 backdrop-blur-sm hidden">
        <div class="bg-surface-container-lowest rounded-xl border border-outline-variant/30 shadow-2xl w-full max-w-2xl max-h-[90vh] overflow-y-auto p-6 m-4">

            <!-- Cabecera del Modal -->
            <div class="flex justify-between items-center pb-4 border-b border-outline-variant/30 mb-4">
                <h3 class="text-lg font-bold text-on-surface flex items-center gap-2">
                    <span class="material-symbols-outlined text-[#D2B48C]">add_circle</span> Crear Nueva Factura
                </h3>
                <button type="button" onclick="cerrarModalFactura()" class="p-1 hover:bg-surface-container-low rounded-lg text-on-surface-variant">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </div>

            <!-- Formulario (Se conecta al método Create del controlador) -->
            <form asp-action="Create" method="post" class="space-y-4">

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-semibold text-on-surface-variant uppercase tracking-wider mb-1">Número de Factura</label>
                        <input name="NumeroFactura" class="w-full px-3 py-2 rounded-lg border border-outline-variant/50 bg-surface-container-low/30 text-on-surface focus:outline-none focus:border-primary text-sm" placeholder="Ej: FAC-2026-002" required />
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-on-surface-variant uppercase tracking-wider mb-1">Fecha de Emisión</label>
                        <input name="FechaVenta" type="date" class="w-full px-3 py-2 rounded-lg border border-outline-variant/50 bg-surface-container-low/30 text-on-surface focus:outline-none focus:border-primary text-sm" value="@DateTime.Now.ToString("yyyy-MM-dd")" required />
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-on-surface-variant uppercase tracking-wider mb-1">Cliente</label>
                        <select name="IdCliente" class="w-full px-3 py-2 rounded-lg border border-outline-variant/50 bg-surface-container-low/30 text-on-surface focus:outline-none focus:border-primary text-sm" asp-items="ViewBag.IdCliente" required>
                            <option value="">Seleccione un cliente...</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-on-surface-variant uppercase tracking-wider mb-1">Pedido Asociado</label>
                        <select name="IdPedido" class="w-full px-3 py-2 rounded-lg border border-outline-variant/50 bg-surface-container-low/30 text-on-surface focus:outline-none focus:border-primary text-sm" asp-items="ViewBag.IdPedido">
                            <option value="">Seleccione un pedido...</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-on-surface-variant uppercase tracking-wider mb-1">Método de Pago</label>
                        <select name="MetodoPago" class="w-full px-3 py-2 rounded-lg border border-outline-variant/50 bg-surface-container-low/30 text-on-surface focus:outline-none focus:border-primary text-sm">
                            <option value="Transferencia">Transferencia</option>
                            <option value="Efectivo">Efectivo</option>
                            <option value="Tarjeta">Tarjeta</option>
                            <option value="Crédito">Crédito</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-on-surface-variant uppercase tracking-wider mb-1">Estado</label>
                        <select name="Estado" class="w-full px-3 py-2 rounded-lg border border-outline-variant/50 bg-surface-container-low/30 text-on-surface focus:outline-none focus:border-primary text-sm">
                            <option value="Pendiente">Pendiente</option>
                            <option value="Pagada">Pagada</option>
                            <option value="Anulada">Anulada</option>
                        </select>
                    </div>
                </div>

                <hr class="border-outline-variant/30 my-2" />

                <!-- Totales -->
                <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
                    <div>
                        <label class="block text-xs font-semibold text-on-surface-variant uppercase tracking-wider mb-1">Subtotal ($)</label>
                        <input name="Subtotal" type="number" step="0.01" class="w-full px-3 py-2 rounded-lg border border-outline-variant/50 bg-surface-container-low/30 text-on-surface focus:outline-none focus:border-primary text-sm" placeholder="0.00" required />
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-on-surface-variant uppercase tracking-wider mb-1">IVA 19% ($)</label>
                        <input name="IVA" type="number" step="0.01" class="w-full px-3 py-2 rounded-lg border border-outline-variant/50 bg-surface-container-low/30 text-on-surface focus:outline-none focus:border-primary text-sm" placeholder="0.00" required />
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-on-surface-variant uppercase tracking-wider mb-1">Total ($)</label>
                        <input name="Total" type="number" step="0.01" class="w-full px-3 py-2 rounded-lg border border-outline-variant/50 bg-surface-container-low/30 text-on-surface font-bold text-primary focus:outline-none focus:border-primary text-sm" placeholder="0.00" required />
                    </div>
                </div>

                <!-- Botones de Acción del Modal -->
                <div class="flex justify-end gap-3 pt-4 border-t border-outline-variant/30">
                    <button type="button" onclick="cerrarModalFactura()" class="px-4 py-2 border border-outline-variant/50 rounded-lg text-sm font-medium text-on-surface hover:bg-surface-container-low transition-colors">
                        Cancelar
                    </button>
                    <!-- INICIO: Botón Guardar Factura en color beige (#D2B48C) -->
                    <button type="submit" class="px-5 py-2 bg-[#D2B48C] hover:brightness-95 text-black text-sm font-bold rounded-lg shadow-sm transition-all" style="background-color: #D2B48C; color: #000000;">
                        Guardar Factura
                    </button>
                    <!-- FIN: Botón Guardar Factura en color beige (#D2B48C) -->
                </div>

            </form>
        </div>
    </div>
    <!-- SCRIPT DE AJAX -->
    <script>
            function cargarDetalle(idVenta) {
                console.log("Cargando factura ID: ", idVenta); // Esto sirve para probar en la consola (F12)

                const panel = document.getElementById('panel-detalle-factura');
                if (!panel) {
                    console.error("No se encontró el elemento 'panel-detalle-factura'");
                    return;
                }

                panel.innerHTML = '<div class="bg-surface-container-lowest rounded-xl border p-8 flex justify-center items-center h-full min-h-[400px]"><span class="material-symbols-outlined animate-spin text-primary">sync</span><span class="ml-2">Cargando detalles...</span></div>';

                fetch(`@Url.Action("DetalleFacturaCard", "Ventas")?id=${idVenta}`)
                    .then(response => {
                        if (!response.ok) throw new Error('Error al cargar la factura');
                        return response.text();
                    })
                    .then(html => {
                        panel.innerHTML = html;
                    })
                    .catch(error => {
                        console.error(error);
                        panel.innerHTML = '<div class="bg-surface-container-lowest rounded-xl border p-8 text-center text-error h-full"><p>Ocurrió un error al cargar la factura.</p></div>';
                    });
            }

            function abrirModalFactura() {
                document.getElementById('modal-nueva-factura').classList.remove('hidden');
            }

            function cerrarModalFactura() {
                document.getElementById('modal-nueva-factura').classList.add('hidden');
            }
    </script>

