    <!-- INICIO: Estilos de tipografía Work Sans en negrita y corrección de colores -->
    <style>
            @@import url('https://fonts.googleapis.com/css2?family=Work+Sans:wght@400;500;600;700;800;900&display=swap');

            button[onclick="history.back()"],
            main,
            main *:not(.material-symbols-outlined):not([class*="fa-"]):not(i),
            #modal-nueva-factura,
            #modal-nueva-factura *:not(.material-symbols-outlined):not([class*="fa-"]):not(i) {
                font-family: 'Work Sans', sans-serif !important;
                font-weight: 700 !important;
            }

            .material-symbols-outlined {
                font-family: 'Material Symbols Outlined' !important;
                font-weight: normal !important;
                font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
            }

            .icon-fill {
                font-variation-settings: 'FILL' 1;
            }

            body {
                background-color: #fcf9f8;
                font-family: 'Work Sans', sans-serif !important;
                font-weight: 700 !important;
                color: #000000;
            }

            /* Corrección de azul de Bootstrap a beige (#D2B48C) y negro */
            .bg-primary {
                background-color: #D2B48C !important;
            }

            .text-primary {
                color: #000000 !important;
            }

            .border-primary {
                border-color: #D2B48C !important;
            }
    </style>
    <!-- FIN: Estilos de tipografía Work Sans en negrita y corrección de colores -->
</head>
<body class="bg-surface text-on-surface font-body-md min-h-screen">
<!-- Top App Bar -->

<!-- Main Content Canvas -->
<main class="pt-20 pb-24 lg:pb-8 min-h-screen">
<div class="px-gutter lg:px-margin max-w-7xl mx-auto">
<!-- Page Header Section -->
<div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-md">
<div>
<h2 class="text-headline-lg-mobile md:text-headline-lg font-headline-lg-mobile md:font-headline-lg text-on-surface">Ventas y Facturación</h2>
<p class="text-body-sm font-body-sm text-on-surface-variant mt-1">Gestiona las ventas, facturas y pagos de CARPINTEC desde un solo lugar.</p>
</div>
                <!-- INICIO: Botón Nueva Factura en color beige (#D2B48C) -->
                <button type="button" onclick="abrirModalFactura()" class="inline-flex items-center gap-2 px-4 py-2 bg-[#D2B48C] hover:brightness-95 text-black font-bold rounded-lg shadow-sm transition-all" style="background-color: #D2B48C; color: #000000;">
                    <span class="material-symbols-outlined text-[18px] text-black">add</span> Nueva Factura
                </button>
                <!-- FIN: Botón Nueva Factura en color beige (#D2B48C) -->
</div>
<!-- KPI Cards Grid -->
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-md mb-lg">
<!-- KPI 1 -->
