@model CARPINTEC_App.Models.PasarelaPagoViewModel

@{
    ViewData["Title"] = "Simulador de Pasarela de Pago";
}

<div class="max-w-2xl mx-auto bg-white p-8 rounded-xl shadow-lg border border-gray-100 mt-6">
    <div class="flex justify-between items-center border-b pb-4 mb-6">
        <h2 class="text-2xl font-bold text-gray-800">Pasarela de Pagos Carpintec</h2>
        <span class="bg-blue-100 text-blue-800 text-xs font-semibold px-3 py-1 rounded-full">Modo Simulación</span>
    </div>

    <!-- Resumen del Total -->
    <div class="bg-gray-50 p-4 rounded-lg mb-6 flex justify-between items-center">
        <div>
            <p class="text-sm text-gray-500">Total a Pagar / Contrato:</p>
            <p class="text-2xl font-black text-gray-900">$ @Model.Total.ToString("N2")</p>
        </div>
        <div class="text-right">
            <span class="text-xs text-gray-400">Venta ID: #@Model.IdVenta</span>
        </div>
    </div>

    <form asp-action="ProcesarPagoSimulado" method="post" class="space-y-6">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="IdVenta" />
        <input type="hidden" asp-for="Total" />

        <!-- Selección de Método de Pago / Simulación -->
        <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">Selecciona el método de simulación:</label>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">

                <!-- Opción Contado -->
                <label class="border rounded-lg p-4 flex items-center cursor-pointer hover:border-indigo-500 transition">
                    <input type="radio" name="TipoPagoSeleccionado" value="Contado" class="text-indigo-600 focus:ring-indigo-500" checked onchange="toggleCuotas(false)" />
                    <div class="ml-3">
                        <span class="block text-sm font-bold text-gray-800">Pago de Contado (Simulado)</span>
                        <span class="block text-xs text-gray-500">Pago inmediato con tarjeta simulada.</span>
                    </div>
                </label>

                <!-- Opción a Cuotas -->
                <label class="border rounded-lg p-4 flex items-center cursor-pointer hover:border-indigo-500 transition">
                    <input type="radio" name="TipoPagoSeleccionado" value="Cuotas" class="text-indigo-600 focus:ring-indigo-500" onchange="toggleCuotas(true)" />
                    <div class="ml-3">
                        <span class="block text-sm font-bold text-gray-800">Venta a Cuotas / Crédito</span>
                        <span class="block text-xs text-gray-500">Requiere aprobación previa del supervisor.</span>
                    </div>
                </label>

            </div>
        </div>

        <!-- Sección Oculta para elegir cuotas si selecciona Crédito -->
        <div id="seccionCuotas" class="hidden bg-yellow-50 border border-yellow-200 p-4 rounded-lg space-y-3">
            <label class="block text-sm font-medium text-yellow-800">Número de Cuotas:</label>
            <select asp-for="NumeroCuotas" class="w-full border-gray-300 rounded-lg shadow-sm focus:border-indigo-500 focus:ring-indigo-500">
                <option value="3">3 Cuotas mensuales</option>
                <option value="6">6 Cuotas mensuales</option>
                <option value="12">12 Cuotas mensuales</option>
            </select>
            <p class="text-xs text-yellow-700">⚠️ Nota: Al elegir a cuotas, el sistema generará el contrato pero quedará en estado <strong>Pendiente</strong> para validación del supervisor.</p>
        </div>

        <!-- Simulación de datos de tarjeta (Estético) -->
        <div class="border-t pt-4 space-y-4">
            <h3 class="text-sm font-medium text-gray-700">Datos de la Tarjeta (Simulador)</h3>
            <div>
                <label class="block text-xs text-gray-500 mb-1">Número de tarjeta ficticio</label>
                <input type="text" value="4242 •••• •••• 4242" disabled class="w-full bg-gray-100 border-gray-200 rounded-lg text-sm text-gray-500 cursor-not-allowed px-3 py-2" />
            </div>
        </div>

        <!-- Botón de Acción -->
        <button type="submit" class="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-medium py-3 rounded-lg transition shadow-md">
            Simular Transacción / Enviar Solicitud
        </button>
    </form>
</div>

@section Scripts {
    <script>
        function toggleCuotas(mostrar) {
            const seccion = document.getElementById('seccionCuotas');
            if (mostrar) {
                seccion.classList.remove('hidden');
            } else {
                seccion.classList.add('hidden');
            }
        }
    </script>
}