                    </div>

                    <div>
                        <label class="block font-label-md text-xs text-black font-bold uppercase mb-1">Estado *</label>
                        <select id="editEstado" name="Estado" required class="w-full px-3 py-2 bg-surface border border-outline-variant rounded-lg font-bold text-black focus:outline-none focus:border-[#D2B48C]">
