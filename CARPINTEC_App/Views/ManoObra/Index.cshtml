                                }
                            }
                        </select>
                    </div>

                    <div>
                        <label class="block font-label-md text-xs text-black font-bold uppercase mb-1">Actividad / Proceso *</label>
                        <input type="text" id="editProceso" name="Proceso" required class="w-full px-3 py-2 bg-surface border border-outline-variant rounded-lg font-bold text-black focus:outline-none focus:border-[#D2B48C]" />
                    </div>

                    <div>
                        <label class="block font-label-md text-xs text-black font-bold uppercase mb-1">Horas Estimadas *</label>
                        <input type="number" step="0.5" min="0" id="editHorasEstimadas" name="HorasEstimadas" required class="w-full px-3 py-2 bg-surface border border-outline-variant rounded-lg font-bold text-black focus:outline-none focus:border-[#D2B48C]" />
                    </div>

                    <div>
                        <label class="block font-label-md text-xs text-black font-bold uppercase mb-1">Horas Reales (Ejecutadas)</label>
                        <input type="number" step="0.5" min="0" id="editHorasReales" name="HorasReales" class="w-full px-3 py-2 bg-surface border border-outline-variant rounded-lg font-bold text-black focus:outline-none focus:border-[#D2B48C]" />
                    </div>

                    <div>
                        <label class="block font-label-md text-xs text-black font-bold uppercase mb-1">Costo por Hora (COP) *</label>
                        <input type="number" step="100" min="0" id="editCostoHora" name="CostoHora" required class="w-full px-3 py-2 bg-surface border border-outline-variant rounded-lg font-bold text-black focus:outline-none focus:border-[#D2B48C]" />
                    </div>

                    <div>
                        <label class="block font-label-md text-xs text-black font-bold uppercase mb-1">Fecha Inicio</label>
                        <input type="date" id="editFechaInicio" name="FechaInicio" class="w-full px-3 py-2 bg-surface border border-outline-variant rounded-lg font-bold text-black focus:outline-none focus:border-[#D2B48C]" />
                    </div>

                    <div>
                        <label class="block font-label-md text-xs text-black font-bold uppercase mb-1">Fecha Fin</label>
                        <input type="date" id="editFechaFin" name="FechaFin" class="w-full px-3 py-2 bg-surface border border-outline-variant rounded-lg font-bold text-black focus:outline-none focus:border-[#D2B48C]" />
                    </div>
                </div>

                <div>
                    <label class="block font-label-md text-xs text-black font-bold uppercase mb-1">Observaciones</label>
                    <textarea id="editObservaciones" name="Observaciones" rows="2" class="w-full px-3 py-2 bg-surface border border-outline-variant rounded-lg font-bold text-black focus:outline-none focus:border-[#D2B48C]"></textarea>
                </div>

                <div class="flex justify-end gap-3 pt-3 border-t border-outline-variant/30">
                    <button type="button" onclick="cerrarModalEditar()" class="px-5 py-2 rounded-lg border border-outline-variant font-bold text-black hover:bg-surface-container transition-colors">
                        Cancelar
                    </button>
                    <button type="submit" class="px-6 py-2 rounded-lg bg-[#D2B48C] text-black font-bold hover:brightness-95 transition-all shadow-sm">
                        Actualizar Asignación
                    </button>
                </div>
            </form>
        </div>
    </div>

    @* ==========================================================================
       CAMBIO REALIZADO: MODAL 4 - CONFIRMAR ELIMINACIÓN
       Ejecuta petición POST al controlador para eliminar el registro de la base de datos.
       ========================================================================== *@
    <div id="modalEliminar" class="fixed inset-0 bg-black/60 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
        <div class="bg-surface-container-lowest w-full max-w-md rounded-2xl shadow-2xl border border-outline-variant/30 overflow-hidden animate-fadeIn">
            <div class="p-6 text-center space-y-4">
                <div class="w-16 h-16 rounded-full bg-error-container text-error flex items-center justify-center mx-auto">
                    <span class="material-symbols-outlined text-3xl">delete_forever</span>
                </div>
                <h3 class="font-headline-md text-xl text-black font-bold">¿Eliminar Asignación?</h3>
                <p class="text-sm font-bold text-black/70">
                    ¿Estás seguro de que deseas eliminar permanentemente la asignación <span id="delCodigoOrden" class="text-black font-bold"></span> de la base de datos? Esta acción no se puede deshacer.
                </p>

                <form method="post" asp-action="Eliminar">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="delIdManoObra" name="id" />

                    <div class="flex justify-center gap-3 pt-4">
                        <button type="button" onclick="cerrarModalEliminar()" class="px-5 py-2 rounded-lg border border-outline-variant font-bold text-black hover:bg-surface-container transition-colors">
                            Cancelar
                        </button>
                        <button type="submit" class="px-6 py-2 rounded-lg bg-red-600 text-white font-bold hover:bg-red-700 transition-colors shadow-sm">
                            Sí, Eliminar
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    @* ==========================================================================
       CAMBIO REALIZADO: Funciones JavaScript para apertura, cierre y llamadas AJAX
       hacia las rutas del ManoObraController conectadas a la base de datos.
       ========================================================================== *@
    <script>
        // Funciones Modal Crear
        function abrirModalCrear() {
            document.getElementById('modalNuevaAsignacion').classList.remove('hidden');
        }
        function cerrarModalCrear() {
            document.getElementById('modalNuevaAsignacion').classList.add('hidden');
        }

        // Funciones Modal Ver Detalle (AJAX hacia ObtenerManoObra)
        async function abrirModalVer(id) {
            try {
                const response = await fetch(`/ManoObra/ObtenerManoObra?id=${id}`);
                if (!response.ok) throw new Error('No se pudo cargar la información');
                const data = await response.json();

                document.getElementById('verCodigoOrden').textContent = '#' + (data.codigoOrden || 'MO-' + data.idManoObra);
                document.getElementById('verEstado').textContent = data.estado;
                document.getElementById('verHoras').textContent = (data.horasReales ? data.horasReales + 'h real' : data.horasEstimadas + 'h est.');
                document.getElementById('verCostoTotal').textContent = data.costoTotal;
                document.getElementById('verEmpleado').textContent = data.empleadoNombre;
                document.getElementById('verCargo').textContent = data.empleadoCargo;
                document.getElementById('verProducto').textContent = data.productoNombre;
                document.getElementById('verPedido').textContent = data.pedidoCodigo;
                document.getElementById('verProceso').textContent = data.proceso;
                document.getElementById('verCostoHora').textContent = '$' + Number(data.costoHora).toLocaleString('es-CO') + ' / hora';
                document.getElementById('verFechaInicio').textContent = data.fechaInicio || 'No asignada';
                document.getElementById('verFechaFin').textContent = data.fechaFin || 'No asignada';
                document.getElementById('verObservaciones').textContent = data.observaciones || 'Sin observaciones adicionales.';

                document.getElementById('modalVerDetalle').classList.remove('hidden');
            } catch (err) {
                alert('Error al consultar el detalle: ' + err.message);
            }
        }
        function cerrarModalVer() {
            document.getElementById('modalVerDetalle').classList.add('hidden');
        }

        // Funciones Modal Editar (AJAX hacia ObtenerManoObra)
        async function abrirModalEditar(id) {
            try {
                const response = await fetch(`/ManoObra/ObtenerManoObra?id=${id}`);
                if (!response.ok) throw new Error('No se pudo cargar la información');
                const data = await response.json();

                document.getElementById('editIdManoObra').value = data.idManoObra;
                document.getElementById('editCodigoOrden').value = data.codigoOrden || '';
                document.getElementById('editEstado').value = data.estado;
                document.getElementById('editIdPedido').value = data.idPedido;
                document.getElementById('editIdProducto').value = data.idProducto;
                document.getElementById('editIdEmpleado').value = data.idEmpleado;
                document.getElementById('editProceso').value = data.proceso;
                document.getElementById('editHorasEstimadas').value = data.horasEstimadas;
                document.getElementById('editHorasReales').value = data.horasReales !== null ? data.horasReales : '';
                document.getElementById('editCostoHora').value = data.costoHora;
                document.getElementById('editFechaInicio').value = data.fechaInicio || '';
                document.getElementById('editFechaFin').value = data.fechaFin || '';
                document.getElementById('editObservaciones').value = data.observaciones || '';

                document.getElementById('modalEditarAsignacion').classList.remove('hidden');
            } catch (err) {
                alert('Error al abrir la edición: ' + err.message);
            }
        }
        function cerrarModalEditar() {
            document.getElementById('modalEditarAsignacion').classList.add('hidden');
        }

        // Funciones Modal Eliminar
        function abrirModalEliminar(id, codigo) {
            document.getElementById('delIdManoObra').value = id;
            document.getElementById('delCodigoOrden').textContent = codigo ? ('#' + codigo) : ('ID #' + id);
            document.getElementById('modalEliminar').classList.remove('hidden');
        }
        function cerrarModalEliminar() {
            document.getElementById('modalEliminar').classList.add('hidden');
        }

        // Cierre con tecla Escape
        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') {
                cerrarModalCrear();
                cerrarModalVer();
                cerrarModalEditar();
                cerrarModalEliminar();
            }
        });
    </script>
</body>
</html>