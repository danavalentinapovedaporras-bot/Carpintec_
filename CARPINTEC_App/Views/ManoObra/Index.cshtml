                            <option value="Diseño">Diseño</option>
                            <option value="Corte">Corte</option>
                            <option value="Ensamblaje">Ensamblaje</option>
                            <option value="Lijado">Lijado</option>
                            <option value="Pintura">Pintura</option>
                            <option value="Instalación">Instalación</option>
                            <option value="Tapizado">Tapizado</option>
                            <option value="Control de Calidad">Control de Calidad</option>
                            <option value="Otro">Otro</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-gray-700 mb-1">Estado</label>
                        <select name="Estado" class="w-full text-xs border border-gray-200 rounded-lg p-2.5 bg-gray-50 focus:bg-white focus:ring-2 focus:ring-[#D2B48C] outline-none">
                            <option value="Pendiente">Pendiente</option>
                            <option value="En proceso">En proceso</option>
                            <option value="Completada">Completada</option>
                        </select>
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-bold text-gray-700 mb-1">Fecha de Inicio</label>
                        <input type="date" name="FechaInicio" value="@DateTime.Now.ToString("yyyy-MM-dd")" class="w-full text-xs border border-gray-200 rounded-lg p-2.5 bg-gray-50 focus:bg-white focus:ring-2 focus:ring-[#D2B48C] outline-none" />
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-gray-700 mb-1">Fecha de Finalización</label>
                        <input type="date" name="FechaFin" class="w-full text-xs border border-gray-200 rounded-lg p-2.5 bg-gray-50 focus:bg-white focus:ring-2 focus:ring-[#D2B48C] outline-none" />
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <div>
                        <label class="block text-xs font-bold text-gray-700 mb-1">Horas Trabajadas / Estimadas *</label>
                        <input type="number" id="inputHoras" name="HorasReales" step="0.5" min="0" placeholder="Ej. 8" oninput="calcularTotal()" required class="w-full text-xs border border-gray-200 rounded-lg p-2.5 bg-gray-50 focus:bg-white focus:ring-2 focus:ring-[#D2B48C] outline-none" />
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-gray-700 mb-1">Costo por Hora ($) *</label>
                        <input type="number" id="inputCostoHora" name="CostoHora" step="0.01" min="0" placeholder="Ej. 15000" oninput="calcularTotal()" required class="w-full text-xs border border-gray-200 rounded-lg p-2.5 bg-gray-50 focus:bg-white focus:ring-2 focus:ring-[#D2B48C] outline-none" />
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-gray-700 mb-1">Costo Total ($)</label>
                        <input type="text" id="inputCostoTotal" readonly placeholder="$0.00" class="w-full text-xs border border-gray-200 rounded-lg p-2.5 bg-gray-100 font-bold text-black outline-none cursor-not-allowed" />
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-bold text-gray-700 mb-1">Observaciones</label>
                    <textarea name="Observaciones" rows="2" placeholder="Detalles adicionales sobre la labor realizada..." class="w-full text-xs border border-gray-200 rounded-lg p-2.5 bg-gray-50 focus:bg-white focus:ring-2 focus:ring-[#D2B48C] outline-none"></textarea>
                </div>

                <div class="flex items-center justify-end gap-3 pt-4 border-t border-gray-100">
                    <button type="button" onclick="cerrarModalAsignacion()" class="px-4 py-2 text-xs font-bold text-gray-600 bg-gray-100 rounded-lg hover:bg-gray-200 transition">
                        Cancelar
                    </button>
                    <button type="submit" class="px-5 py-2 text-xs font-bold text-black bg-[#D2B48C] rounded-lg hover:brightness-95 transition shadow" style="background-color: #D2B48C !important; color: #000000 !important;">
                        Guardar actividad
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- 2. MODAL: Ver Detalles de Mano de Obra -->
    <div id="modalDetalleManoObra" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/50 p-4 overflow-y-auto">
        <div class="bg-white rounded-2xl shadow-2xl w-full max-w-2xl p-6 space-y-6 relative max-h-[90vh] overflow-y-auto">
            <div class="flex items-center justify-between border-b border-gray-100 pb-4">
                <div class="flex items-center gap-3">
                    <div class="p-2.5 bg-[#D2B48C]/30 rounded-xl text-black">
                        <span class="material-symbols-outlined text-[24px]">visibility</span>
                    </div>
                    <div>
                        <h3 class="text-lg font-bold text-black flex items-center gap-2">
