                    <div>
                        <span class="text-xs text-gray-500 uppercase font-bold tracking-wider block">Orden de Trabajo</span>
                        <span class="text-xl font-bold text-black" id="detCodigoOrden">-</span>
                    </div>
                    <div id="detEstadoBadge">
                        <!-- Badge inyectado dinámicamente -->
                    </div>
                </div>

                <!-- Grilla de Información -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div class="p-3 bg-gray-50 rounded-lg border border-gray-100">
                        <span class="text-xs text-gray-500 font-bold block mb-1">Empleado Responsable</span>
                        <div class="flex items-center gap-2">
                            <span class="material-symbols-outlined text-sm text-[#D2B48C]">person</span>
                            <span class="text-sm font-bold text-black" id="detEmpleado">-</span>
                        </div>
                        <span class="text-xs text-gray-500 block mt-1" id="detEmpleadoSub">Cargo: - | Doc: -</span>
                    </div>

                    <div class="p-3 bg-gray-50 rounded-lg border border-gray-100">
                        <span class="text-xs text-gray-500 font-bold block mb-1">Pedido y Proyecto</span>
                        <div class="flex items-center gap-2">
                            <span class="material-symbols-outlined text-sm text-[#D2B48C]">shopping_bag</span>
                            <span class="text-sm font-bold text-black" id="detPedido">-</span>
                        </div>
                        <span class="text-xs text-gray-600 block mt-1 font-semibold" id="detProducto">-</span>
                    </div>

                    <div class="p-3 bg-gray-50 rounded-lg border border-gray-100">
                        <span class="text-xs text-gray-500 font-bold block mb-1">Actividad / Proceso</span>
                        <div class="flex items-center gap-2">
                            <span class="material-symbols-outlined text-sm text-[#D2B48C]">handyman</span>
                            <span class="text-sm font-bold text-black" id="detProceso">-</span>
                        </div>
                    </div>

                    <div class="p-3 bg-gray-50 rounded-lg border border-gray-100">
                        <span class="text-xs text-gray-500 font-bold block mb-1">Fechas del Proceso</span>
                        <div class="flex items-center gap-2 text-xs text-gray-700">
                            <span class="material-symbols-outlined text-sm text-gray-400">calendar_today</span>
                            <span>Inicio: <strong id="detFechaInicio">-</strong> | Fin: <strong id="detFechaFin">-</strong></span>
                        </div>
                    </div>
                </div>

                <!-- Resumen de Costos y Horas -->
                <div class="bg-gray-50 p-4 rounded-xl border border-gray-100 grid grid-cols-3 gap-3 text-center">
                    <div>
                        <span class="text-xs text-gray-500 font-bold block">Horas Totales</span>
                        <span class="text-lg font-bold text-black mt-1 block" id="detHoras">-</span>
                    </div>
                    <div>
                        <span class="text-xs text-gray-500 font-bold block">Costo / Hora</span>
                        <span class="text-lg font-bold text-black mt-1 block" id="detCostoHora">-</span>
                    </div>
                    <div class="border-l border-gray-200">
                        <span class="text-xs text-gray-500 font-bold block">Costo Total</span>
                        <span class="text-lg font-bold text-black mt-1 block" id="detCostoTotal">-</span>
                    </div>
                </div>

                <!-- Observaciones -->
                <div class="p-3 bg-gray-50 rounded-lg border border-gray-100">
                    <span class="text-xs text-gray-500 font-bold block mb-1">Observaciones / Notas</span>
                    <p class="text-xs text-gray-700 italic" id="detObservaciones">Sin observaciones registradas.</p>
                </div>
            </div>

            <!-- Footer -->
            <div class="flex items-center justify-end gap-3 pt-4 border-t border-gray-100">
                <button type="button" onclick="cerrarModalDetalle()" class="px-4 py-2 text-xs font-bold text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200 transition">
                    Cerrar
                </button>
