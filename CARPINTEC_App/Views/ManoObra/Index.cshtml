                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <div>
                        <label class="block text-xs font-bold text-gray-700 mb-1">Horas Trabajadas *</label>
                        <input type="number" id="editHorasReales" name="HorasReales" step="0.5" min="0" placeholder="Ej. 8" oninput="calcularTotalEditar()" required class="w-full text-xs border border-gray-200 rounded-lg p-2.5 bg-gray-50 focus:bg-white focus:ring-2 focus:ring-[#D2B48C] outline-none" />
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-gray-700 mb-1">Costo por Hora ($) *</label>
                        <input type="number" id="editCostoHora" name="CostoHora" step="0.01" min="0" placeholder="Ej. 15000" oninput="calcularTotalEditar()" required class="w-full text-xs border border-gray-200 rounded-lg p-2.5 bg-gray-50 focus:bg-white focus:ring-2 focus:ring-[#D2B48C] outline-none" />
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-gray-700 mb-1">Costo Total ($)</label>
                        <input type="text" id="editCostoTotal" readonly placeholder="$0.00" class="w-full text-xs border border-gray-200 rounded-lg p-2.5 bg-gray-100 font-bold text-black outline-none cursor-not-allowed" />
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-bold text-gray-700 mb-1">Observaciones</label>
                    <textarea id="editObservaciones" name="Observaciones" rows="2" placeholder="Detalles adicionales..." class="w-full text-xs border border-gray-200 rounded-lg p-2.5 bg-gray-50 focus:bg-white focus:ring-2 focus:ring-[#D2B48C] outline-none"></textarea>
                </div>

                <div class="flex items-center justify-end gap-3 pt-4 border-t border-gray-100">
                    <button type="button" onclick="cerrarModalEditar()" class="px-4 py-2 text-xs font-bold text-gray-600 bg-gray-100 rounded-lg hover:bg-gray-200 transition">
                        Cancelar
                    </button>
                    <button type="submit" class="px-5 py-2 text-xs font-bold text-black bg-[#D2B48C] rounded-lg hover:brightness-95 transition shadow" style="background-color: #D2B48C !important; color: #000000 !important;">
                        Guardar cambios
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- 4. MODAL: Confirmar Eliminación -->
    <div id="modalEliminarManoObra" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/50 p-4">
        <div class="bg-white rounded-2xl shadow-2xl w-full max-w-md p-6 space-y-5 relative">
            <div class="flex items-start gap-4">
                <div class="w-12 h-12 rounded-full bg-red-100 text-red-600 flex items-center justify-center shrink-0">
                    <span class="material-symbols-outlined text-[28px]">delete_forever</span>
                </div>
                <div>
                    <h3 class="text-lg font-bold text-black">Eliminar Asignación</h3>
                    <p class="text-xs text-gray-500 mt-1">¿Estás seguro de que deseas eliminar permanentemente esta actividad de mano de obra?</p>
                </div>
            </div>

            <div class="p-3 bg-red-50 rounded-xl border border-red-200 text-xs text-red-800 font-medium">
                <p>Orden: <strong id="eliminarCodigoTexto">-</strong></p>
                <p class="mt-1">Empleado: <strong id="eliminarEmpleadoTexto">-</strong></p>
                <p class="mt-1 text-[11px] text-red-600 italic">Esta acción no se puede deshacer.</p>
            </div>

            <form asp-controller="ManoObra" asp-action="Eliminar" method="post" class="flex items-center justify-end gap-3 pt-2">
                @Html.AntiForgeryToken()
                <input type="hidden" id="eliminarIdManoObra" name="id" value="" />
                <button type="button" onclick="cerrarModalEliminar()" class="px-4 py-2 text-xs font-bold text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200 transition">
                    Cancelar
                </button>
                <button type="submit" class="px-5 py-2 text-xs font-bold text-white bg-red-600 rounded-lg hover:bg-red-700 transition shadow">
                    Sí, eliminar
                </button>
            </form>
        </div>
    </div>

    <script>
        // Modal Nueva Asignación
        function abrirModalAsignacion() {
            document.getElementById('modalNuevaAsignacion').classList.remove('hidden');
        }
        function cerrarModalAsignacion() {
            document.getElementById('modalNuevaAsignacion').classList.add('hidden');
        }
        function calcularTotal() {
            let horas = parseFloat(document.getElementById('inputHoras').value) || 0;
            let costoHora = parseFloat(document.getElementById('inputCostoHora').value) || 0;
            let total = horas * costoHora;
            document.getElementById('inputCostoTotal').value = "$" + total.toLocaleString('es-CO', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        }

        // Modal Detalle
        function verDetalleManoObra(id) {
            const modal = document.getElementById('modalDetalleManoObra');
            const loading = document.getElementById('detLoading');
            const content = document.getElementById('detContent');

            modal.classList.remove('hidden');
            loading.classList.remove('hidden');
            content.classList.add('hidden');

            fetch(`@Url.Action("ObtenerManoObra", "ManoObra")?id=${id}`)
                .then(r => {
                    if (!r.ok) throw new Error("Error al obtener datos");
                    return r.json();
                })
                .then(data => {
                    document.getElementById('detCodigoOrdenSub').innerText = data.codigoOrden;
                    document.getElementById('detCodigoOrden').innerText = data.codigoOrden;
                    document.getElementById('detEmpleado').innerText = data.empleadoNombre;
                    document.getElementById('detEmpleadoSub').innerText = `Cargo: ${data.empleadoCargo} | Doc: ${data.empleadoDocumento}`;
                    document.getElementById('detPedido').innerText = data.pedidoCodigo;
                    document.getElementById('detProducto').innerText = data.productoNombre;
                    document.getElementById('detProceso').innerText = data.proceso;
                    document.getElementById('detFechaInicio').innerText = data.fechaInicio || 'No definida';
                    document.getElementById('detFechaFin').innerText = data.fechaFin || 'No definida';

                    const horasTotales = (data.horasReales !== null ? data.horasReales : data.horasEstimadas);
                    document.getElementById('detHoras').innerText = `${horasTotales} hrs`;
                    document.getElementById('detCostoHora').innerText = `$${Number(data.costoHora).toLocaleString('es-CO', { minimumFractionDigits: 2 })}`;
                    document.getElementById('detCostoTotal').innerText = data.costoTotalFormatted;
                    document.getElementById('detObservaciones').innerText = data.observaciones || 'Sin observaciones registradas.';

                    // Badge de Estado
                    let badgeColor = 'bg-rose-50 text-rose-700 border-rose-200';
                    let dotColor = 'bg-rose-500';
                    if (data.estado === 'Completada' || data.estado === 'Finalizado') {
                        badgeColor = 'bg-emerald-50 text-emerald-700 border-emerald-200';
                        dotColor = 'bg-emerald-500';
                    } else if (data.estado === 'En proceso' || data.estado === 'En Proceso') {
                        badgeColor = 'bg-amber-50 text-amber-700 border-amber-200';
                        dotColor = 'bg-amber-500';
                    }
                    document.getElementById('detEstadoBadge').innerHTML = `
                        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold border ${badgeColor}">
                            <span class="w-1.5 h-1.5 rounded-full ${dotColor}"></span> ${data.estado}
                        </span>
                    `;

                    // Botón Editar desde detalle
                    document.getElementById('btnEditarDesdeDetalle').onclick = function() {
                        cerrarModalDetalle();
                        abrirModalEditar(data.idManoObra);
                    };

                    loading.classList.add('hidden');
                    content.classList.remove('hidden');
                })
                .catch(err => {
                    console.error(err);
                    alert("No se pudo cargar los detalles de la mano de obra.");
                    cerrarModalDetalle();
                });
        }
        function cerrarModalDetalle() {
            document.getElementById('modalDetalleManoObra').classList.add('hidden');
        }

        // Modal Editar
        function abrirModalEditar(id) {
            fetch(`@Url.Action("ObtenerManoObra", "ManoObra")?id=${id}`)
                .then(r => {
                    if (!r.ok) throw new Error("Error al obtener datos");
                    return r.json();
                })
                .then(data => {
                    document.getElementById('editIdManoObra').value = data.idManoObra;
                    document.getElementById('editCodigoOrden').value = data.codigoOrden;
                    document.getElementById('editIdPedido').value = data.idPedido;
                    document.getElementById('editIdEmpleado').value = data.idEmpleado;
                    document.getElementById('editIdProducto').value = data.idProducto;
                    document.getElementById('editProceso').value = data.proceso;
                    document.getElementById('editEstado').value = data.estado;
                    document.getElementById('editFechaInicio').value = data.fechaInicio || '';
                    document.getElementById('editFechaFin').value = data.fechaFin || '';
                    document.getElementById('editHorasReales').value = data.horasReales !== null ? data.horasReales : data.horasEstimadas;
                    document.getElementById('editCostoHora').value = data.costoHora;
                    document.getElementById('editObservaciones').value = data.observaciones || '';

                    calcularTotalEditar();
                    document.getElementById('modalEditarManoObra').classList.remove('hidden');
                })
                .catch(err => {
                    console.error(err);
                    alert("No se pudo cargar la información para editar.");
                });
        }
        function cerrarModalEditar() {
            document.getElementById('modalEditarManoObra').classList.add('hidden');
        }
        function calcularTotalEditar() {
            let horas = parseFloat(document.getElementById('editHorasReales').value) || 0;
            let costoHora = parseFloat(document.getElementById('editCostoHora').value) || 0;
            let total = horas * costoHora;
            document.getElementById('editCostoTotal').value = "$" + total.toLocaleString('es-CO', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        }

        // Modal Eliminar
        function confirmarEliminar(id, codigo, empleado) {
            document.getElementById('eliminarIdManoObra').value = id;
            document.getElementById('eliminarCodigoTexto').innerText = codigo;
            document.getElementById('eliminarEmpleadoTexto').innerText = empleado;
            document.getElementById('modalEliminarManoObra').classList.remove('hidden');
        }
        function cerrarModalEliminar() {
            document.getElementById('modalEliminarManoObra').classList.add('hidden');
        }
    </script>
</body></html>
