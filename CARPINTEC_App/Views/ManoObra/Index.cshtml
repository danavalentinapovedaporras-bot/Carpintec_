@model IEnumerable<CARPINTEC_App.Models.ManoObra>

<!DOCTYPE html>

<html class="h-full" lang="es">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title> Mano de Obra - Carpintec</title>
    <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;600&amp;family=Manrope:wght@600;700&amp;display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet" />
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script id="tailwind-config">
            tailwind.config = {
                darkMode: "class",
                theme: {
                    extend: {
                        "colors": {
                            "on-tertiary": "#ffffff",
                            "surface-container-high": "#eae7e7",
                            "on-primary-container": "#d4ada1",
                            "background": "#fcf9f8",
                            "tertiary": "#1c3433",
                            "error": "#ba1a1a",
                            "on-tertiary-container": "#a0bab7",
                            "surface-container-lowest": "#ffffff",
                            "on-secondary-fixed-variant": "#474836",
                            "on-primary": "#ffffff",
                            "on-primary-fixed-variant": "#5d4037",
                            "on-primary-fixed": "#2c160e",
                            "inverse-primary": "#e7bdb1",
                            "surface-container": "#f0eded",
                            "secondary-fixed-dim": "#c8c8b0",
                            "secondary-container": "#e1e1c9",
                            "secondary": "#5e604d",
                            "on-secondary": "#ffffff",
                            "primary-container": "#5d4037",
                            "surface-container-highest": "#e5e2e1",
                            "on-error": "#ffffff",
                            "surface": "#fcf9f8",
                            "secondary-fixed": "#e4e4cc",
                            "outline-variant": "#d4c3be",
                            "outline": "#827470",
                            "on-tertiary-fixed-variant": "#334b49",
                            "inverse-on-surface": "#f3f0ef",
                            "primary-fixed-dim": "#e7bdb1",
                            "surface-tint": "#77574d",
                            "on-surface": "#1b1c1c",
                            "surface-dim": "#dcd9d9",
                            "inverse-surface": "#303030",
                            "tertiary-container": "#334b49",
                            "on-background": "#1b1c1c",
                            "tertiary-fixed-dim": "#b1ccc9",
                            "on-surface-variant": "#504441",
                            "surface-bright": "#fcf9f8",
                            "on-tertiary-fixed": "#061f1e",
                            "error-container": "#ffdad6",
                            "surface-container-low": "#f6f3f2",
                            "surface-variant": "#e5e2e1",
                            "on-secondary-fixed": "#1b1d0e",
                            "tertiary-fixed": "#cde8e5",
                            "primary-fixed": "#ffdbd0",
                            "primary": "#442a22",
                            "on-secondary-container": "#636451",
                            "on-error-container": "#93000a"
                        },
                        "borderRadius": {
                            "DEFAULT": "0.25rem",
                            "lg": "0.5rem",
                            "xl": "0.75rem",
                            "full": "9999px"
                        },
                        "spacing": {
                            "margin": "32px",
                            "gutter": "24px",
                            "xs": "4px",
                            "md": "24px",
                            "xl": "64px",
                            "base": "8px",
                            "sm": "12px",
                            "lg": "40px"
                        },
                        "fontFamily": {
                            "headline-xl": ["Manrope"],
                            "headline-md": ["Manrope"],
                            "headline-lg-mobile": ["Manrope"],
                            "body-lg": ["Hanken Grotesk"],
                            "label-md": ["Hanken Grotesk"],
                            "body-md": ["Hanken Grotesk"],
                            "headline-lg": ["Manrope"],
                            "body-sm": ["Hanken Grotesk"]
                        },
                        "fontSize": {
                            "headline-xl": ["40px", { "lineHeight": "48px", "letterSpacing": "-0.02em", "fontWeight": "700" }],
                            "headline-md": ["24px", { "lineHeight": "32px", "fontWeight": "600" }],
                            "headline-lg-mobile": ["28px", { "lineHeight": "36px", "fontWeight": "600" }],
                            "body-lg": ["18px", { "lineHeight": "28px", "fontWeight": "400" }],
                            "label-md": ["14px", { "lineHeight": "16px", "letterSpacing": "0.05em", "fontWeight": "600" }],
                            "body-md": ["16px", { "lineHeight": "24px", "fontWeight": "400" }],
                            "headline-lg": ["32px", { "lineHeight": "40px", "letterSpacing": "-0.01em", "fontWeight": "600" }],
                            "body-sm": ["14px", { "lineHeight": "20px", "fontWeight": "400" }]
                        }
                    }
                }
            }
    </script>
    <style>
            .material-symbols-outlined {
                font-family: 'Material Symbols Outlined';
            }
            /* Tonal layering & Ambient shadows */
            .card-shadow {
                box-shadow: 0 4px 12px rgba(93, 64, 55, 0.05);
            }

            .card-hover:hover {
                transform: translateY(-2px);
                box-shadow: 0 8px 16px rgba(93, 64, 55, 0.1);
            }
    </style>
</head>
<body class="bg-background text-on-surface h-full font-body-md antialiased">
    <!-- Main Layout -->
    <div class="flex flex-col h-full min-h-screen">
        <!-- TopAppBar -->
        <header class="w-full top-0 sticky shadow-sm bg-surface dark:bg-surface-container-low flex justify-between items-center px-margin h-20 w-full z-40">
            <div class="flex items-center gap-4">
                <button class="text-primary dark:text-primary-fixed hover:bg-secondary-container/50 transition-colors p-2 rounded-full md:hidden">
                    <span class="material-symbols-outlined" data-icon="menu">menu</span>
                </button>
                <div class="font-headline-lg text-headline-lg font-bold text-primary dark:text-primary-fixed">Carpintec</div>
            </div>
            <div class="flex items-center gap-4">
                <div class="w-10 h-10 rounded-full overflow-hidden border-2 border-outline-variant cursor-pointer scale-95 active:opacity-80 transition-all">
                    <img alt="Profile picture of the administrator" class="w-full h-full object-cover" data-alt="A professional headshot of a carpentry workshop manager in a brightly lit office setting, warm natural lighting emphasizing reliability and craftsmanship, subtle depth of field." src="https://lh3.googleusercontent.com/aida-public/AB6AXuBEI7Y1OzFUJOm_9SlmHUwD3EThBny2Tbzt16lW7tKB5dxYrPxrETIb1cCPGdlW-qi303NCc97NPM9I1K65fsV4E1OMyG_qrIpCrCYF4B_lzKpjXJ1a5W9W3et7wlV5yEkzQLIXSm7bhmF6nyA-5_HPZuFOjj-nvbJyuUadY9fBWNbCd9jy2KofRIzIeZ_kTw56sLHfYbNs8Km6YWV7zxXjK4uW1tRsIVyhq4BgJKTbgj27yOzVbDm7" />
                </div>
            </div>
        </header>
        <!-- Main Content Area -->
        <main class="flex-1 w-full max-w-[1440px] mx-auto px-margin py-lg md:px-margin md:py-lg grid grid-cols-4 md:grid-cols-12 gap-gutter">
            <!-- Header Section -->
            <div class="col-span-4 md:col-span-12 flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-md">
                <h1 class="font-headline-xl text-headline-xl text-primary">Mano de Obra</h1>
                <div class="flex flex-wrap items-center gap-4 w-full md:w-auto">
                    <!-- Search -->
                    <div class="relative w-full md:w-64">
                        <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline" data-icon="search">search</span>
                        <input class="w-full pl-10 pr-4 py-2 bg-surface-container-lowest border border-outline-variant rounded-lg focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-colors font-body-md text-on-surface" placeholder="Buscar empleado o ID..." type="text" />
                    </div>
                    <!-- Filters -->
                    <select class="bg-surface-container-lowest border border-outline-variant rounded-lg px-4 py-2 focus:outline-none focus:border-primary font-body-md text-on-surface cursor-pointer">
                        <option value="">Todos los estados</option>
                        <option value="pendiente">Pendiente</option>
                        <option value="en_proceso">En Proceso</option>
                        <option value="finalizado">Finalizado</option>
                    </select>
                    <!-- New Assignment Button -->
                    <button type="button" onclick="abrirModalAsignacion()" class="bg-primary text-on-primary hover:bg-primary/90 px-6 py-2 rounded-lg font-label-md text-label-md flex items-center gap-2 transition-colors active:bg-primary/80 focus:ring-2 focus:ring-primary-container focus:outline-none shadow-sm">
                        <span class="material-symbols-outlined" data-icon="add">add</span>
                        Nueva asignación
                    </button>
                </div>
            </div>
            <!-- Summary Cards (Bento Grid Style) -->
            <div class="col-span-4 md:col-span-12 grid grid-cols-1 md:grid-cols-4 gap-gutter mb-lg">
                <!-- Card 1 -->
                <div class="bg-surface-container-lowest p-md rounded-xl card-shadow card-hover transition-all flex flex-col gap-4 relative overflow-hidden border border-outline-variant/30">
                    <div class="absolute top-0 right-0 p-4 opacity-10">
                        <span class="material-symbols-outlined text-[64px]" data-icon="group">group</span>
                    </div>
                    <div class="flex items-center gap-3">
                        <div class="p-3 bg-secondary-container rounded-lg text-primary">
                            <span class="material-symbols-outlined" data-icon="group">group</span>
                        </div>
                        <h3 class="font-label-md text-label-md text-on-surface-variant uppercase tracking-wider">Empleados Trabajando</h3>
                    </div>
                    <div class="font-headline-xl text-headline-xl text-on-surface">24</div>
                </div>
                <!-- Card 2 -->
                <div class="bg-surface-container-lowest p-md rounded-xl card-shadow card-hover transition-all flex flex-col gap-4 relative overflow-hidden border border-outline-variant/30">
                    <div class="absolute top-0 right-0 p-4 opacity-10">
                        <span class="material-symbols-outlined text-[64px]" data-icon="pending_actions">pending_actions</span>
                    </div>
                    <div class="flex items-center gap-3">
                        <div class="p-3 bg-error-container rounded-lg text-error">
                            <span class="material-symbols-outlined" data-icon="pending_actions">pending_actions</span>
                        </div>
                        <h3 class="font-label-md text-label-md text-on-surface-variant uppercase tracking-wider">Trabajos Pendientes</h3>
                    </div>
                    <div class="font-headline-xl text-headline-xl text-on-surface">12</div>
                </div>
                <!-- Card 3 -->
                <div class="bg-surface-container-lowest p-md rounded-xl card-shadow card-hover transition-all flex flex-col gap-4 relative overflow-hidden border border-outline-variant/30">
                    <div class="absolute top-0 right-0 p-4 opacity-10">
                        <span class="material-symbols-outlined text-[64px]" data-icon="check_circle">check_circle</span>
                    </div>
                    <div class="flex items-center gap-3">
                        <div class="p-3 bg-tertiary-fixed rounded-lg text-tertiary">
                            <span class="material-symbols-outlined" data-icon="check_circle">check_circle</span>
                        </div>
                        <h3 class="font-label-md text-label-md text-on-surface-variant uppercase tracking-wider">Trabajos Finalizados</h3>
                    </div>
                    <div class="font-headline-xl text-headline-xl text-on-surface">45</div>
                </div>
                <!-- Card 4 -->
                <div class="bg-surface-container-lowest p-md rounded-xl card-shadow card-hover transition-all flex flex-col gap-4 relative overflow-hidden border border-outline-variant/30">
                    <div class="absolute top-0 right-0 p-4 opacity-10">
                        <span class="material-symbols-outlined text-[64px]" data-icon="payments">payments</span>
                    </div>
                    <div class="flex items-center gap-3">
                        <div class="p-3 bg-primary-fixed rounded-lg text-primary">
                            <span class="material-symbols-outlined" data-icon="payments">payments</span>
                        </div>
                        <h3 class="font-label-md text-label-md text-on-surface-variant uppercase tracking-wider">Costo Total Mano Obra</h3>
                    </div>
                    <div class="font-headline-xl text-headline-xl text-on-surface">$14,500</div>
                </div>
            </div>
            <!-- Table Controls -->
            <div class="col-span-4 md:col-span-12 flex justify-end gap-3 mb-4">
                <button class="flex items-center gap-2 px-4 py-2 bg-surface-container border border-outline-variant rounded-lg font-label-md text-label-md hover:bg-surface-container-high transition-colors text-on-surface">
                    <span class="material-symbols-outlined text-sm" data-icon="picture_as_pdf">picture_as_pdf</span>
                    Exportar PDF
                </button>
                <button class="flex items-center gap-2 px-4 py-2 bg-surface-container border border-outline-variant rounded-lg font-label-md text-label-md hover:bg-surface-container-high transition-colors text-on-surface">
                    <span class="material-symbols-outlined text-sm" data-icon="table_view">table_view</span>
                    Excel
                </button>
                <button class="flex items-center gap-2 px-4 py-2 bg-surface-container border border-outline-variant rounded-lg font-label-md text-label-md hover:bg-surface-container-high transition-colors text-on-surface">
                    <span class="material-symbols-outlined text-sm" data-icon="print">print</span>
                    Imprimir
                </button>
            </div>
            <!-- Administrative Table -->
            <div class="col-span-4 md:col-span-12 bg-surface-container-lowest rounded-xl card-shadow overflow-hidden border border-outline-variant/30">
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse">
                        <thead class="bg-surface-container-low border-b border-outline-variant/50 font-label-md text-label-md text-on-surface-variant">
                            <tr>
                                <th class="p-4 py-3 font-semibold">ID</th>
                                <th class="p-4 py-3 font-semibold">Pedido</th>
                                <th class="p-4 py-3 font-semibold">Empleado</th>
                                <th class="p-4 py-3 font-semibold">Cargo</th>
                                <th class="p-4 py-3 font-semibold">Actividad</th>
                                <th class="p-4 py-3 font-semibold text-right">Horas</th>
                                <th class="p-4 py-3 font-semibold text-right">Costo</th>
                                <th class="p-4 py-3 font-semibold text-center">Estado</th>
                                <th class="p-4 py-3 font-semibold text-center">Acciones</th>
                            </tr>
                        </thead>
                        <tbody class="font-body-sm text-body-sm text-on-surface">
                         <tbody>
    @foreach (var item in Model)
    {
        <tr class="border-b border-gray-100 hover:bg-gray-50/50 transition">
            <td class="py-4 px-6 font-bold text-blue-600">@item.CodigoOrden</td>
            <td class="py-4 px-6 text-gray-800 font-medium">Pedido #@item.IdPedido</td>
            <td class="py-4 px-6">
                <div class="flex items-center gap-2">
                    <span class="w-7 h-7 rounded-full bg-blue-100 text-blue-700 flex items-center justify-center text-xs font-bold">
                        EMP
                    </span>
                    <span class="text-gray-700">ID: @item.IdEmpleado</span>
                </div>
            </td>
            <td class="py-4 px-6 text-gray-600">Producto #@item.IdProducto</td>
            <td class="py-4 px-6 text-gray-600">@item.Proceso</td>
            <td class="py-4 px-6 text-gray-700 font-semibold">@(item.HorasReales ?? item.HorasEstimadas)h</td>
            <td class="py-4 px-6 text-gray-900 font-bold">$@string.Format("{0:N2}", (item.HorasReales ?? item.HorasEstimadas) * item.CostoHora)</td>
            <td class="py-4 px-6">
                @if (item.Estado == "Completada" || item.Estado == "Finalizado")
                {
                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-medium bg-emerald-50 text-emerald-700">
                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> @item.Estado
                    </span>
                }
                else if (item.Estado == "En proceso")
                {
                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-medium bg-amber-50 text-amber-700">
                        <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span> @item.Estado
                    </span>
                }
                else
                {
                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-medium bg-rose-50 text-rose-700">
                        <span class="w-1.5 h-1.5 rounded-full bg-rose-500"></span> @item.Estado
                    </span>
                }
            </td>
            <td class="py-4 px-6 flex items-center gap-2 text-gray-400">
                <a href="/ManoObra/Detalles/@item.IdManoObra" class="hover:text-blue-600 transition"><span class="material-symbols-outlined text-sm">visibility</span></a>
                <a href="/ManoObra/Editar/@item.IdManoObra" class="hover:text-blue-600 transition"><span class="material-symbols-outlined text-sm">edit</span></a>
                <a href="/ManoObra/Eliminar/@item.IdManoObra" class="hover:text-rose-600 transition"><span class="material-symbols-outlined text-sm">delete</span></a>
            </td>
        </tr>
    }
</tbody>
                                
                            
                        
                    </table>
                </div>
                <!-- Pagination -->
                <div class="px-4 py-3 border-t border-outline-variant/30 bg-surface-container-lowest flex items-center justify-between">
                    <span class="font-body-sm text-body-sm text-on-surface-variant">Mostrando 1 a 4 de 24 registros</span>
                    <div class="flex gap-2">
                        <button class="p-1 rounded text-outline hover:bg-surface-container-high disabled:opacity-50" disabled="">
                            <span class="material-symbols-outlined text-sm" data-icon="chevron_left">chevron_left</span>
                        </button>
                        <button class="w-8 h-8 rounded bg-primary text-on-primary font-label-md text-label-md">1</button>
                        <button class="w-8 h-8 rounded text-on-surface-variant hover:bg-surface-container-high font-label-md text-label-md">2</button>
                        <button class="w-8 h-8 rounded text-on-surface-variant hover:bg-surface-container-high font-label-md text-label-md">3</button>
                        <button class="p-1 rounded text-outline hover:bg-surface-container-high">
                            <span class="material-symbols-outlined text-sm" data-icon="chevron_right">chevron_right</span>
                        </button>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <!-- Ventana Emergente: Nueva Asignación de Mano de Obra -->
    <div id="modalNuevaAsignacion" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/50 p-4 overflow-y-auto">
        <div class="bg-white rounded-2xl shadow-xl w-full max-w-2xl p-6 space-y-6 relative max-h-[90vh] overflow-y-auto">

            <!-- Cabecera -->
            <div class="flex items-center justify-between border-b border-gray-100 pb-4">
                <div>
                    <h3 class="text-lg font-bold text-gray-900 flex items-center gap-2">
                        <span class="material-symbols-outlined text-blue-600">badge</span>
                        Nueva Asignación de Mano de Obra
                    </h3>
                    <p class="text-xs text-gray-500">Registra las horas y costos asociados a una actividad de producción.</p>
                </div>
                <button type="button" onclick="cerrarModalAsignacion()" class="text-gray-400 hover:text-gray-600">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </div>

            <!-- Formulario -->
            <form asp-controller="ManoObra" asp-action="Crear" method="post" class="space-y-4">

                <!-- Pedido Asociado y Empleado -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-bold text-gray-700 mb-1">Pedido Asociado</label>
                        <select name="IdPedido" class="w-full text-xs border border-gray-200 rounded-lg p-2.5 bg-gray-50 focus:bg-white focus:ring-2 focus:ring-blue-500 outline-none">
                            <option value="">Seleccionar pedido...</option>
                            <!-- Aquí puedes iterar tu ViewBag.ListaPedidos si aplica -->
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-gray-700 mb-1">Empleado Responsable</label>
                        <select name="IdEmpleado" class="w-full text-xs border border-gray-200 rounded-lg p-2.5 bg-gray-50 focus:bg-white focus:ring-2 focus:ring-blue-500 outline-none">
                            <option value="">Seleccionar empleado...</option>
                            <!-- Aquí puedes iterar tu ViewBag.ListaEmpleados si aplica -->
                        </select>
                    </div>
                </div>

                <!-- Producto/Proyecto y Tipo de Actividad -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-xs font-bold text-gray-700 mb-1">
                                Producto o Proyecto
                            </label>

                            <select name="IdProducto"
                                    class="w-full text-xs border border-gray-200 rounded-lg p-2.5 bg-gray-50 focus:bg-white focus:ring-2 focus:ring-blue-500 outline-none">

                                <option value="">Seleccionar producto...</option>

                                @foreach (var producto in ViewBag.ListaProductos)
                                {
                                    <option value="@producto.IdProducto">
                                        @producto.Nombre
                                    </option>
                                }

                            </select>
                        </div>
                    <div>
                        <label class="block text-xs font-bold text-gray-700 mb-1">Tipo de Actividad</label>
                        <select name="Proceso" class="w-full text-xs border border-gray-200 rounded-lg p-2.5 bg-gray-50 focus:bg-white focus:ring-2 focus:ring-blue-500 outline-none">
                            <option value="Diseño">Diseño</option>
                            <option value="Corte">Corte</option>
                            <option value="Ensamblaje">Ensamblaje</option>
                            <option value="Lijado">Lijado</option>
                            <option value="Pintura">Pintura</option>
                            <option value="Instalación">Instalación</option>
                            <option value="Otro">Otro</option>
                        </select>
                    </div>
                </div>

                <!-- Fechas -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-bold text-gray-700 mb-1">Fecha de Inicio</label>
                        <input type="date" name="FechaInicio" class="w-full text-xs border border-gray-200 rounded-lg p-2.5 bg-gray-50 focus:bg-white focus:ring-2 focus:ring-blue-500 outline-none" />
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-gray-700 mb-1">Fecha de Finalización</label>
                        <input type="date" name="FechaFin" class="w-full text-xs border border-gray-200 rounded-lg p-2.5 bg-gray-50 focus:bg-white focus:ring-2 focus:ring-blue-500 outline-none" />
                    </div>
                </div>

                <!-- Costos y Horas (Cálculo automático) -->
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <div>
                        <label class="block text-xs font-bold text-gray-700 mb-1">Horas Trabajadas</label>
                        <input type="number" id="inputHoras" name="HorasReales" step="0.5" placeholder="Ej. 8" oninput="calcularTotal()" class="w-full text-xs border border-gray-200 rounded-lg p-2.5 bg-gray-50 focus:bg-white focus:ring-2 focus:ring-blue-500 outline-none" />
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-gray-700 mb-1">Costo por Hora</label>
                        <input type="number" id="inputCostoHora" name="CostoHora" step="0.01" placeholder="Ej. 15.00" oninput="calcularTotal()" class="w-full text-xs border border-gray-200 rounded-lg p-2.5 bg-gray-50 focus:bg-white focus:ring-2 focus:ring-blue-500 outline-none" />
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-gray-700 mb-1">Costo Total</label>
                            <input type="text"
                                   id="inputCostoTotal"
                                   readonly
                                   placeholder="$0.00"
                                   class="w-full text-xs border border-gray-200 rounded-lg p-2.5 bg-gray-100 font-bold text-blue-600 outline-none cursor-not-allowed" />
                    </div>
                </div>

                <!-- Estado -->
                <div>
                    <label class="block text-xs font-bold text-gray-700 mb-1">Estado</label>
                        <select name="Estado"
                                class="w-full text-xs border border-gray-200 rounded-lg p-2.5 bg-gray-50 focus:bg-white focus:ring-2 focus:ring-blue-500 outline-none">

                            <option value="Pendiente">Pendiente</option>
                            <option value="En proceso">En proceso</option>
                            <option value="Completada">Completada</option>

                        </select>
                </div>

                <!-- Observaciones -->
                <div>
                    <label class="block text-xs font-bold text-gray-700 mb-1">Observaciones</label>
                    <textarea name="Observaciones" rows="2" placeholder="Detalles adicionales sobre la labor realizada..." class="w-full text-xs border border-gray-200 rounded-lg p-2.5 bg-gray-50 focus:bg-white focus:ring-2 focus:ring-blue-500 outline-none"></textarea>
                </div>

                <!-- Botones de Acción -->
                <div class="flex items-center justify-end gap-3 pt-4 border-t border-gray-100">
                    <button type="button" onclick="cerrarModalAsignacion()" class="px-4 py-2 text-xs font-bold text-gray-600 bg-gray-100 rounded-lg hover:bg-gray-200 transition">
                        Cancelar
                    </button>
                    <button type="submit" class="px-4 py-2 text-xs font-bold text-white bg-blue-600 rounded-lg hover:bg-blue-700 transition shadow">
                        Guardar actividad
                    </button>
                </div>
            </form>
        </div>
    </div>

    <script>
            // Funciones para abrir/cerrar y calcular automáticamente el costo total
            function abrirModalAsignacion() {
                document.getElementById('modalNuevaAsignacion').classList.remove('hidden');
            }
            function cerrarModalAsignacion() {
                document.getElementById('modalNuevaAsignacion').classList.add('hidden');
            }
            function calcularTotal() {
                let horas = parseFloat(document.getElementById('inputHoras').value) || 0;
                let costoHora = parseFloat(document.getElementById('inputCostoHora').value) || 0;
                let total = horas * costoHora;
                document.getElementById('inputCostoTotal').value = "$" + total.toLocaleString('es-CO', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            }
    </script>
</body></html>