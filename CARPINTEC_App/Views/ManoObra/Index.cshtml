            <form asp-controller="ManoObra" asp-action="Crear" method="post" class="space-y-4">
                @Html.AntiForgeryToken()

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-bold text-gray-700 mb-1">Código de Orden (Opcional)</label>
                        <input type="text" name="CodigoOrden" placeholder="Ej. MO-2026-001 (Automático si se deja vacío)" class="w-full text-xs border border-gray-200 rounded-lg p-2.5 bg-gray-50 focus:bg-white focus:ring-2 focus:ring-[#D2B48C] outline-none" />
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-gray-700 mb-1">Pedido Asociado *</label>
                        <select name="IdPedido" required class="w-full text-xs border border-gray-200 rounded-lg p-2.5 bg-gray-50 focus:bg-white focus:ring-2 focus:ring-[#D2B48C] outline-none">
                            <option value="">Seleccionar pedido...</option>
                            @if (ViewBag.ListaPedidos != null)
                            {
                                foreach (var ped in ViewBag.ListaPedidos)
                                {
                                    <option value="@ped.IdPedido">Pedido #@ped.IdPedido @(!string.IsNullOrEmpty(ped.Producto) ? $"- {ped.Producto}" : "")</option>
                                }
                            }
                        </select>
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-bold text-gray-700 mb-1">Empleado Responsable *</label>
                        <select name="IdEmpleado" required class="w-full text-xs border border-gray-200 rounded-lg p-2.5 bg-gray-50 focus:bg-white focus:ring-2 focus:ring-[#D2B48C] outline-none">
                            <option value="">Seleccionar empleado...</option>
                            @if (ViewBag.ListaEmpleados != null)
                            {
                                foreach (var emp in ViewBag.ListaEmpleados)
                                {
                                    <option value="@emp.IdEmpleado">@emp.Nombre @emp.Apellido (@emp.Cargo)</option>
                                }
                            }
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-gray-700 mb-1">Producto / Proyecto *</label>
                        <select name="IdProducto" required class="w-full text-xs border border-gray-200 rounded-lg p-2.5 bg-gray-50 focus:bg-white focus:ring-2 focus:ring-[#D2B48C] outline-none">
                            <option value="">Seleccionar producto...</option>
                            @if (ViewBag.ListaProductos != null)
                            {
                                foreach (var prod in ViewBag.ListaProductos)
                                {
                                    <option value="@prod.IdProducto">@prod.Nombre</option>
                                }
                            }
                        </select>
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-bold text-gray-700 mb-1">Tipo de Actividad / Proceso *</label>
