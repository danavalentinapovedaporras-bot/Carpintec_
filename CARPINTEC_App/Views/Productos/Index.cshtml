<input class="w-full bg-surface-container-lowest border border-outline-variant rounded-xl pl-10 pr-4 py-3 focus:border-primary focus:ring-1 focus:ring-primary transition-all text-sm" placeholder="Buscar por código o nombre..." type="text"/>
</div>
<div class="flex gap-2 overflow-x-auto pb-2 scrollbar-hide">
