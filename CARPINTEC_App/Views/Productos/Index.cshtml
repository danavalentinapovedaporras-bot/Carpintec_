@* ============================================================
   Vista: Productos/Index.cshtml
   Descripción: Catálogo de productos con CRUD completo
   - Muestra tarjetas de productos desde la base de datos
   - Modal para crear nuevo producto
   - Modal para editar producto existente
   - Modal para ver detalles del producto
   - Búsqueda en tiempo real por nombre o código
   ============================================================ *@

@* Modelo: lista de productos desde la base de datos *@
@model IEnumerable<CARPINTEC_App.Models.Producto>

@{
    ViewData["Title"] = "Catálogo de Productos";
}

<!DOCTYPE html>
<html class="light" lang="es">
<head>
    <meta charset="utf-8"/>
    <meta content="width=device-width, initial-scale=1.0" name="viewport"/>
    <title>CARPINTEC - Catálogo de Productos</title>

    @* --- CDN de Tailwind CSS con plugins de formularios --- *@
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>

    @* --- Fuentes Google: Work Sans y Material Symbols --- *@
    <link href="https://fonts.googleapis.com/css2?family=Work+Sans:wght@400;500;600;700;800;900&amp;display=swap" rel="stylesheet"/>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>

    @* --- Configuración de Tailwind personalizada --- *@
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    /* Paleta de colores personalizada para Carpintec */
                    "colors": {
                        "text-main": "#222222",
                        "tertiary": "#005562",
                        "error-container": "#ffdad6",
                        "secondary": "#5e604d",
                        "outline": "#837469",
                        "primary": "#6f4315",
                        "timber-tan": "#D2B48C",
                        "surface-tint": "#835425",
                        "surface": "#f9f9f9",
                        "surface-dim": "#dadada",
                        "border-subtle": "#EAEAEA",
                        "surface-container-low": "#f3f3f3",
                        "on-primary": "#ffffff",
                        "outline-variant": "#d5c3b6",
                        "on-surface-variant": "#51443a",
                        "primary-container": "#8b5a2b",
                        "surface-container-highest": "#e2e2e2",
                        "on-error": "#ffffff",
                        "surface-container-high": "#e8e8e8",
                        "tertiary-container": "#276e7b",
                        "surface-container": "#eeeeee",
                        "surface-container-lowest": "#ffffff",
                        "secondary-container": "#e1e1c9",
                        "surface-bright": "#f9f9f9",
                        "error": "#ba1a1a",
                        "surface-variant": "#e2e2e2",
                        "background": "#f9f9f9",
                        "on-surface": "#1a1c1c",
                        "surface-gray": "#FAFAFA",
                        "wood-dark": "#5D3A1A",
                        "on-background": "#1a1c1c"
                    },
                    "borderRadius": {
                        "DEFAULT": "0.25rem",
                        "lg": "0.5rem",
                        "xl": "0.75rem",
                        "full": "9999px"
                    },
                    "spacing": {
                        "margin-desktop": "32px",
                        "unit": "4px",
                        "gutter": "16px",
                        "margin-mobile": "16px",
                        "sidebar-width": "260px"
                    },
                    /* Configuración Work Sans en Tailwind */
                    "fontFamily": {
                        "headline-md": ["Work Sans", "sans-serif"],
                        "body-md": ["Work Sans", "sans-serif"],
                        "label-xs": ["Work Sans", "sans-serif"],
                        "label-sm": ["Work Sans", "sans-serif"],
                        "body-lg": ["Work Sans", "sans-serif"],
                        "headline-lg": ["Work Sans", "sans-serif"],
                        "display": ["Work Sans", "sans-serif"]
                    },
                    "fontSize": {
                        "headline-md": ["20px", {"lineHeight": "28px", "fontWeight": "600"}],
                        "headline-md-mobile": ["18px", {"lineHeight": "24px", "fontWeight": "600"}],
                        "body-md": ["14px", {"lineHeight": "20px", "fontWeight": "400"}],
                        "label-xs": ["10px", {"lineHeight": "14px", "fontWeight": "600"}],
                        "label-sm": ["12px", {"lineHeight": "16px", "letterSpacing": "0.01em", "fontWeight": "500"}],
                        "body-lg": ["16px", {"lineHeight": "24px", "fontWeight": "400"}],
                        "headline-lg": ["28px", {"lineHeight": "36px", "fontWeight": "600"}],
                        "headline-lg-mobile": ["22px", {"lineHeight": "28px", "fontWeight": "600"}],
                        "display": ["40px", {"lineHeight": "48px", "letterSpacing": "-0.02em", "fontWeight": "700"}]
                    }
                },
            },
        };
    </script>

    @* --- Estilos personalizados: Work Sans en negrita y corrección de colores --- *@
    <style>
        @@import url('https://fonts.googleapis.com/css2?family=Work+Sans:wght@400;500;600;700;800;900&display=swap');

        /* Aplicar Work Sans en negrita a todo el contenido principal */
        button[onclick="history.back()"],
        main,
        main *:not(.material-symbols-outlined):not([class*="fa-"]):not(i),
        #modal-producto,
        #modal-producto *:not(.material-symbols-outlined):not([class*="fa-"]):not(i),
        #modal-editar,
        #modal-editar *:not(.material-symbols-outlined):not([class*="fa-"]):not(i),
        #modal-detalles,
        #modal-detalles *:not(.material-symbols-outlined):not([class*="fa-"]):not(i) {
            font-family: 'Work Sans', sans-serif !important;
            font-weight: 700 !important;
        }

        /* Asegurar que Material Symbols use su fuente correcta */
        .material-symbols-outlined {
            font-family: 'Material Symbols Outlined' !important;
            font-weight: normal !important;
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }

        /* Estilos base del body */
        body {
            background-color: #f9f9f9;
            font-family: 'Work Sans', sans-serif !important;
            font-weight: 700 !important;
            color: #000000;
        }

        /* Corrección de colores azules de Bootstrap a beige (#D2B48C) */
        .bg-primary { background-color: #D2B48C !important; }
        .text-primary { color: #000000 !important; }
        .border-primary { border-color: #D2B48C !important; }

        /* Scrollbar personalizado */
        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-track { background: #f1f1f1; }
        ::-webkit-scrollbar-thumb { background: #d5c3b6; border-radius: 10px; }
        ::-webkit-scrollbar-thumb:hover { background: #8b5a2b; }

        /* Sombra suave para tarjetas de producto */
        .product-card-shadow { box-shadow: 0px 4px 20px rgba(0,0,0,0.04); }
    </style>
</head>

<body class="bg-background text-text-main font-body-md selection:bg-primary/20">

    @* --- Botón Volver (navegación hacia atrás) --- *@
    <button onclick="history.back()"
            class="flex items-center gap-2 text-black font-bold hover:underline mb-4" style="color: #000000;">
        <span class="material-symbols-outlined text-black">arrow_back</span>
        Volver
    </button>

    @* --- Contenido principal de la página --- *@
    <main class="pt-4 min-h-screen bg-background px-4 md:px-8 max-w-full w-full box-border">

        @* ============================================================
           SECCIÓN: Encabezado de página + Botón Nuevo Producto
           ============================================================ *@
        <div class="py-6 space-y-4">
            <div>
                <h1 class="font-headline-lg-mobile text-headline-lg-mobile text-wood-dark">Catálogo de Productos</h1>
                <p class="text-on-surface-variant font-body-md">Administre y gestione el catálogo de productos de Carpintec.</p>
            </div>
            <div class="flex gap-2">
                @* Botón Exportar *@
                <button class="flex-1 bg-surface-container-lowest border border-outline-variant py-2.5 rounded-xl font-label-sm flex items-center justify-center gap-2 hover:bg-surface-container transition-all">
                    <span class="material-symbols-outlined text-[18px]">download</span>
                    Exportar
                </button>

                @* Botón Nuevo Producto - Abre el modal de creación *@
                <button onclick="document.getElementById('modal-producto').classList.remove('hidden')"
                        class="flex-[1.5] bg-[#D2B48C] hover:brightness-95 text-black font-bold py-2.5 rounded-xl font-label-sm flex items-center justify-center gap-2 shadow-md active:scale-95 transition-all"
                        style="background-color: #D2B48C; color: #000000;">
                    <span class="material-symbols-outlined text-[18px] text-black">add</span>
                    Nuevo Producto
                </button>
            </div>
        </div>

        @* ============================================================
           SECCIÓN: Tarjetas de estadísticas (datos dinámicos de ViewBag)
           ============================================================ *@
        <div class="grid grid-cols-2 gap-3 mb-6">
            @* Tarjeta: Total de productos *@
            <div class="bg-surface-container-lowest p-4 rounded-xl border border-border-subtle shadow-sm">
                <p class="text-on-surface-variant font-label-sm mb-1 uppercase tracking-wider text-[10px]">Total</p>
                <p class="font-headline-md text-primary font-bold">@ViewBag.TotalProductos</p>
            </div>

            @* Tarjeta: Productos activos *@
            <div class="bg-surface-container-lowest p-4 rounded-xl border border-border-subtle shadow-sm">
                <p class="text-on-surface-variant font-label-sm mb-1 uppercase tracking-wider text-[10px]">Activos</p>
                <p class="font-headline-md text-tertiary font-bold">@ViewBag.ProductosActivos</p>
            </div>

            @* Tarjeta: Productos inactivos *@
            <div class="bg-surface-container-lowest p-4 rounded-xl border border-border-subtle shadow-sm">
                <p class="text-on-surface-variant font-label-sm mb-1 uppercase tracking-wider text-[10px]">Inactivos</p>
                <p class="font-headline-md text-error font-bold">@ViewBag.ProductosInactivos</p>
            </div>

            @* Tarjeta: Categorías únicas *@
            <div class="bg-surface-container-lowest p-4 rounded-xl border border-border-subtle shadow-sm">
                <p class="text-on-surface-variant font-label-sm mb-1 uppercase tracking-wider text-[10px]">Categorías</p>
                <p class="font-headline-md text-secondary font-bold">@ViewBag.TotalCategorias</p>
            </div>
        </div>

        @* ============================================================
           SECCIÓN: Barra de búsqueda y filtros
           ============================================================ *@
        <div class="space-y-3 mb-6">
            @* Campo de búsqueda en tiempo real *@
            <div class="relative group">
                <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant">search</span>
                <input class="w-full bg-surface-container-lowest border border-outline-variant rounded-xl pl-10 pr-4 py-3 focus:border-primary focus:ring-1 focus:ring-primary transition-all text-sm"
                       placeholder="Buscar por código o nombre..."
                       type="text"
                       id="buscarProducto"
                       oninput="filtrarProductos()" />
            </div>
            <div class="flex gap-2 overflow-x-auto pb-2 scrollbar-hide">
                @* Botón filtro por categoría *@
                <button class="shrink-0 flex items-center gap-1.5 px-4 py-2 bg-white text-black font-bold border border-outline-variant rounded-full text-xs shadow-sm"
                        style="background-color: #ffffff; color: #000000;">
                    <span class="material-symbols-outlined text-[16px] text-black">filter_list</span> Categoría
                </button>
                @* Botón filtro por estado *@
                <button class="shrink-0 flex items-center gap-1.5 px-4 py-2 bg-surface-container-lowest border border-outline-variant rounded-full text-xs font-medium">
                    Estado
                </button>
            </div>
        </div>

        @* ============================================================
           SECCIÓN: Grilla de productos (datos dinámicos del Model)
           ============================================================ *@
        <div class="grid grid-cols-2 md:grid-cols-4 gap-3" id="grilla-productos">

            @* Si no hay productos, mostrar mensaje *@
            @if (!Model.Any())
            {
                <div class="col-span-full text-center py-16">
                    <span class="material-symbols-outlined text-6xl text-outline-variant mb-4">inventory_2</span>
                    <p class="text-on-surface-variant text-lg">No hay productos registrados.</p>
                    <p class="text-on-surface-variant text-sm mt-1">Haz clic en "Nuevo Producto" para agregar el primero.</p>
                </div>
            }

            @* Iterar sobre cada producto del modelo *@
            @foreach (var producto in Model)
            {
                @* Determinar las clases CSS del badge según el estado *@
                var badgeClass = producto.Estado == "Activo"
                    ? "bg-tertiary text-white"
                    : "bg-red-100 text-red-800";

                <div class="bg-surface-container-lowest rounded-xl overflow-hidden product-card-shadow border border-border-subtle producto-card group hover:shadow-md transition-shadow"
                     data-nombre="@producto.Nombre?.ToLower()"
                     data-codigo="@producto.Codigo?.ToLower()">

                    @* --- Imagen del producto (fotografía siempre visible) --- *@
                    <div class="h-44 relative bg-surface-container overflow-hidden">
                        @{
                            var imagenCalculada = CARPINTEC_App.Controllers.ProductosController.ObtenerImagenPorDefecto(producto.Categoria, producto.Nombre);
                            var imagenUrl = !string.IsNullOrWhiteSpace(producto.Imagen) && producto.Imagen != "/images/Wooden.jpeg" && producto.Imagen != "/images/mesac.jpeg"
                                ? (producto.Imagen.StartsWith("~") ? Url.Content(producto.Imagen) : producto.Imagen)
                                : imagenCalculada;

                            var catProd = (producto.Categoria ?? "").ToLowerInvariant();
                            var nomProd = (producto.Nombre ?? "").ToLowerInvariant();
                            var esEscritorio = catProd.Contains("escritorio") || nomProd.Contains("escritorio") || nomProd.Contains("despacho");

                            if (esEscritorio && (string.IsNullOrWhiteSpace(producto.Imagen) || producto.Imagen == "/images/mesac.jpeg" || producto.Imagen == "/images/mesa.jpeg" || producto.Imagen == "/images/Wooden.jpeg"))
                            {
                                imagenUrl = "/images/escritorio.jpeg";
                            }
                        }
                        <img alt="@producto.Nombre"
                             class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                             src="@imagenUrl"
                             loading="lazy"
                             onerror="manejarErrorImagenProducto(this, '@(producto.Categoria?.Replace("'", "\\'"))', '@(producto.Nombre?.Replace("'", "\\'"))');" />

                        @* Badge de estado (Activo/Inactivo) *@
                        <div class="absolute top-2 right-2">
                            <span class="@badgeClass text-[9px] font-bold px-2.5 py-0.5 rounded-full uppercase shadow-sm">
                                @producto.Estado
                            </span>
                        </div>

                        @* Categoría sobre la foto si existe *@
                        @if (!string.IsNullOrEmpty(producto.Categoria))
                        {
                            <div class="absolute bottom-2 left-2">
                                <span class="bg-black/60 backdrop-blur-sm text-white text-[10px] font-medium px-2 py-0.5 rounded-md flex items-center gap-1 shadow-sm">
                                    <span class="material-symbols-outlined text-[11px]">category</span>
                                    @producto.Categoria
                                </span>
                            </div>
                        }
                    </div>

                    @* --- Información del producto --- *@
                    <div class="p-3 space-y-2">
                        <div>
                            @* Código del producto *@
                            <p class="text-primary font-bold text-[10px] mb-0.5">@producto.Codigo</p>
                            @* Nombre del producto *@
                            <h3 class="font-semibold text-sm line-clamp-1">@producto.Nombre</h3>
                        </div>

                        @* Detalles: categoría, material, medidas *@
                        <div class="space-y-1 text-[11px] text-on-surface-variant">
                            @if (!string.IsNullOrEmpty(producto.Categoria))
                            {
                                <div class="flex items-center gap-1">
                                    <span class="material-symbols-outlined text-[12px]">category</span>
                                    @producto.Categoria
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(producto.Material))
                            {
                                <div class="flex items-center gap-1">
                                    <span class="material-symbols-outlined text-[12px]">texture</span>
                                    @producto.Material
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(producto.Medidas))
                            {
                                <div class="flex items-center gap-1">
                                    <span class="material-symbols-outlined text-[12px]">straighten</span>
                                    @producto.Medidas
                                </div>
                            }
                            @if (producto.Precio.HasValue)
                            {
                                <div class="flex items-center gap-1 font-bold text-wood-dark">
                                    <span class="material-symbols-outlined text-[12px]">payments</span>
                                    $@producto.Precio.Value.ToString("N0")
                                </div>
                            }
                        </div>

                        @* --- Botones de acción por producto --- *@
                        <div class="flex gap-1.5 pt-1">
                            @* Botón Editar: abre modal de edición cargando datos por AJAX *@
                            <button onclick="abrirModalEditar(@producto.IdProducto)"
                                    class="flex-1 py-1.5 text-primary border border-primary/20 bg-primary/5 rounded text-[10px] font-bold">
                                Editar
                            </button>
                            @* Botón Detalles: abre modal con info completa *@
                            <button onclick="abrirModalDetalles(@producto.IdProducto)"
                                    class="flex-1 py-1.5 text-on-surface-variant bg-surface-container rounded text-[10px] font-bold">
                                Detalles
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>

    </main>

    @* ============================================================
       MODAL: Crear Nuevo Producto
       Se muestra al hacer clic en "Nuevo Producto"
       Formulario conectado a /Productos/Crear (POST)
       ============================================================ *@
    <div id="modal-producto" class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center hidden z-50 p-4 overflow-y-auto">
        <div class="bg-white rounded-xl shadow-xl w-full max-w-xl p-6 relative my-8">

            @* Botón cerrar (X) *@
            <button onclick="document.getElementById('modal-producto').classList.add('hidden')"
                    class="absolute top-4 right-4 text-gray-400 hover:text-gray-600 font-bold text-xl">
                &times;
            </button>

            @* Título del modal *@
            <h3 class="text-xl font-bold text-gray-800 mb-4">Agregar Nuevo Producto</h3>

            @* Formulario de creación - apunta al controlador Productos, acción Crear *@
            <form asp-controller="Productos" asp-action="Crear" method="post" enctype="multipart/form-data" class="space-y-4">
                @Html.AntiForgeryToken()

                @* Campo: Nombre del producto (obligatorio) *@
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Nombre del Producto *</label>
                    <input type="text" name="Nombre" required
                           class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-[#D2B48C]">
                </div>

                @* Campos en 2 columnas: Código y Precio *@
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Código</label>
                        <input type="text" name="Codigo" placeholder="Ej. CP-001"
                               class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-[#D2B48C]">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Precio</label>
                        <input type="number" name="Precio" step="0.01" min="0" placeholder="0.00"
                               class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-[#D2B48C]">
                    </div>
                </div>

                @* Campos en 2 columnas: Categoría y Material *@
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Categoría</label>
                        <select name="Categoria"
                                class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-[#D2B48C]">
                            <option value="">Seleccione categoría</option>
                            <option value="Sillas">Sillas</option>
                            <option value="Mesas">Mesas</option>
                            <option value="Escritorios">Escritorios</option>
                            <option value="Camas">Camas</option>
                            <option value="Closets">Closets</option>
                            <option value="Estantes">Estantes</option>
                            <option value="Comedores">Comedores</option>
                            <option value="Accesorios">Accesorios</option>
                            <option value="Otro">Otro</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Material</label>
                        <input type="text" name="Material" placeholder="Ej. Roble Macizo"
                               class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-[#D2B48C]">
                    </div>
                </div>

                @* Campo: Medidas *@
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Medidas</label>
                    <input type="text" name="Medidas" placeholder="Ej. 45x45x90 cm"
                           class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-[#D2B48C]">
                </div>

                @* Campo: Imagen del producto (subida de archivo) *@
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Fotografía del Producto</label>
                    <p class="text-xs text-gray-500 mb-2">Puedes subir una foto propia o el sistema asignará automáticamente una fotografía de carpintería según la categoría.</p>
                    <input type="file" name="Imagen" accept="image/*" onchange="previsualizarImagen(event, 'preview-img-crear')"
                           class="w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-semibold file:bg-[#D2B48C]/20 file:text-wood-dark hover:file:bg-[#D2B48C]/30">
                    @* Vista previa de la imagen seleccionada *@
                    <div class="mt-2">
                        <img id="preview-img-crear" src="#" alt="Vista previa" class="hidden h-28 w-28 object-cover rounded-xl border border-gray-200 shadow-sm">
                    </div>
                </div>

                @* Campo: Descripción *@
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Descripción</label>
                    <textarea name="Descripcion" rows="3" placeholder="Detalles de acabados, características especiales, etc."
                              class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-[#D2B48C]"></textarea>
                </div>

                @* Botones del formulario: Cancelar y Guardar *@
                <div class="flex justify-end space-x-3 pt-2">
                    <button type="button" onclick="document.getElementById('modal-producto').classList.add('hidden')"
                            class="px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-700 font-medium rounded-lg transition">
                        Cancelar
                    </button>
                    <button type="submit"
                            class="px-4 py-2 bg-[#D2B48C] hover:brightness-95 text-black font-bold rounded-lg transition shadow-sm"
                            style="background-color: #D2B48C; color: #000000;">
                        Guardar Producto
                    </button>
                </div>
            </form>
        </div>
    </div>

    @* ============================================================
       MODAL: Editar Producto
       Se carga dinámicamente con datos del producto vía fetch/AJAX
       Formulario conectado a /Productos/Editar (POST)
       ============================================================ *@
    <div id="modal-editar" class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center hidden z-50 p-4 overflow-y-auto">
        <div class="bg-white rounded-xl shadow-xl w-full max-w-xl p-6 relative my-8">

            @* Botón cerrar (X) *@
            <button onclick="document.getElementById('modal-editar').classList.add('hidden')"
                    class="absolute top-4 right-4 text-gray-400 hover:text-gray-600 font-bold text-xl">
                &times;
            </button>

            @* Título del modal *@
            <h3 class="text-xl font-bold text-gray-800 mb-4">Editar Producto</h3>

            @* Formulario de edición - apunta al controlador Productos, acción Editar *@
            <form asp-controller="Productos" asp-action="Editar" method="post" enctype="multipart/form-data" class="space-y-4">
                @Html.AntiForgeryToken()

                @* Campo oculto: ID del producto (necesario para identificar qué producto actualizar) *@
                <input type="hidden" name="IdProducto" id="edit-id" />

                @* Campo: Nombre *@
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Nombre del Producto *</label>
                    <input type="text" name="Nombre" id="edit-nombre" required
                           class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-[#D2B48C]">
                </div>

                @* Campos en 2 columnas: Código y Precio *@
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Código</label>
                        <input type="text" name="Codigo" id="edit-codigo"
                               class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-[#D2B48C]">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Precio</label>
                        <input type="number" name="Precio" id="edit-precio" step="0.01" min="0"
                               class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-[#D2B48C]">
                    </div>
                </div>

                @* Campos en 2 columnas: Categoría y Material *@
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Categoría *</label>
                        <select name="Categoria" id="edit-categoria" required
                                class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-[#D2B48C]">
                            <option value="">Seleccione categoría</option>
                            <option value="Sillas">Sillas</option>
                            <option value="Mesas">Mesas</option>
                            <option value="Escritorios">Escritorios</option>
                            <option value="Camas">Camas</option>
                            <option value="Closets">Closets</option>
                            <option value="Estantes">Estantes</option>
                            <option value="Comedores">Comedores</option>
                            <option value="Cocinas">Cocinas</option>
                            <option value="Accesorios">Accesorios</option>
                            <option value="Otro">Otro</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Material</label>
                        <input type="text" name="Material" id="edit-material"
                               class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-[#D2B48C]">
                    </div>
                </div>

                @* Campo: Medidas *@
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Medidas</label>
                    <input type="text" name="Medidas" id="edit-medidas"
                           class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-[#D2B48C]">
                </div>

                @* Campo: Estado (select Activo/Inactivo) *@
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Estado</label>
                    <select name="Estado" id="edit-estado"
                            class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-[#D2B48C]">
                        <option value="Activo">Activo</option>
                        <option value="Inactivo">Inactivo</option>
                    </select>
                </div>

                @* Campo: Fotografía del producto *@
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Fotografía del Producto</label>
                    <p class="text-xs text-gray-500 mb-2">Haz clic en <strong>"Subir / Cambiar Foto"</strong> para seleccionar una nueva imagen desde tu dispositivo.</p>
                    <div class="flex items-center gap-4 p-3 bg-gray-50 rounded-xl border border-gray-200">
                        <div class="relative shrink-0">
                            <img id="edit-imagen-actual" src="/images/Wooden.jpeg" alt="Imagen actual"
                                 class="h-24 w-24 object-cover rounded-xl border-2 border-[#D2B48C] shadow-sm bg-white"
                                 onerror="this.onerror=null; this.src='/images/Wooden.jpeg';">
                        </div>
                        <div class="flex-1 space-y-2">
                            <div class="flex flex-wrap items-center gap-2">
                                <label for="edit-imagen-file"
                                       class="cursor-pointer inline-flex items-center gap-1.5 px-3.5 py-2 bg-[#D2B48C] hover:brightness-95 text-black font-bold text-xs rounded-lg transition shadow-sm select-none"
                                       style="background-color: #D2B48C; color: #000000;">
                                    <span class="material-symbols-outlined text-[18px]">upload</span>
                                    <span>Subir / Cambiar Foto</span>
                                </label>
                                <button type="button" id="btn-quitar-imagen-edit" onclick="limpiarImagenEdicion()"
                                        class="hidden text-xs text-red-600 hover:text-red-800 font-semibold flex items-center gap-1 px-2.5 py-1.5 bg-red-50 hover:bg-red-100 rounded-lg transition">
                                    <span class="material-symbols-outlined text-[14px]">undo</span> Cancelar cambio
                                </button>
                            </div>
                            <input type="file" id="edit-imagen-file" name="Imagen" accept="image/*" onchange="previsualizarImagenEdicion(event)"
                                   class="hidden">
                            <div id="edit-imagen-badge" class="hidden text-xs text-green-700 bg-green-50 border border-green-200 px-2.5 py-1 rounded-md flex items-center gap-1 font-medium">
                                <span class="material-symbols-outlined text-[14px] text-green-600">check_circle</span>
                                <span id="edit-imagen-nombre-archivo">Imagen lista para guardar</span>
                            </div>
                            <p class="text-[11px] text-gray-400">Formatos soportados: JPG, PNG, WEBP, JPEG.</p>
                        </div>
                    </div>
                </div>

                @* Campo: Descripción *@
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Descripción</label>
                    <textarea name="Descripcion" id="edit-descripcion" rows="3"
                              class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-[#D2B48C]"></textarea>
                </div>

                @* Botones: Cancelar y Guardar Cambios *@
                <div class="flex justify-end space-x-3 pt-2">
                    <button type="button" onclick="document.getElementById('modal-editar').classList.add('hidden')"
                            class="px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-700 font-medium rounded-lg transition">
                        Cancelar
                    </button>
                    <button type="submit"
                            class="px-4 py-2 bg-[#D2B48C] hover:brightness-95 text-black font-bold rounded-lg transition shadow-sm"
                            style="background-color: #D2B48C; color: #000000;">
                        Guardar Cambios
                    </button>
                </div>
            </form>
        </div>
    </div>

    @* ============================================================
       MODAL: Detalles del Producto
       Muestra toda la información del producto seleccionado
       ============================================================ *@
    <div id="modal-detalles" class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center hidden z-50 p-4 overflow-y-auto">
        <div class="bg-white rounded-xl shadow-xl w-full max-w-lg p-6 relative my-8">

            @* Botón cerrar (X) *@
            <button onclick="document.getElementById('modal-detalles').classList.add('hidden')"
                    class="absolute top-4 right-4 text-gray-400 hover:text-gray-600 font-bold text-xl">
                &times;
            </button>

            @* Título del modal *@
            <h3 class="text-xl font-bold text-gray-800 mb-4">Detalles del Producto</h3>

            @* Imagen del producto *@
            <div class="mb-4">
                <img id="detalle-imagen" src="/images/Wooden.jpeg" alt="Producto"
                     class="w-full h-52 object-cover rounded-xl border border-gray-200 shadow-sm"
                     onerror="this.onerror=null; this.src='/images/Wooden.jpeg';">
            </div>

            @* Información detallada del producto *@
            <div class="space-y-3">
                <div class="flex justify-between items-start">
                    <div>
                        <p class="text-xs text-on-surface-variant" id="detalle-codigo"></p>
                        <h4 class="text-lg font-bold" id="detalle-nombre"></h4>
                    </div>
                    <span id="detalle-estado" class="text-[10px] font-bold px-3 py-1 rounded-full uppercase"></span>
                </div>

                <div class="grid grid-cols-2 gap-3 text-sm">
                    <div class="bg-surface-gray p-3 rounded-lg">
                        <p class="text-on-surface-variant text-xs mb-1">Categoría</p>
                        <p class="font-bold" id="detalle-categoria">—</p>
                    </div>
                    <div class="bg-surface-gray p-3 rounded-lg">
                        <p class="text-on-surface-variant text-xs mb-1">Material</p>
                        <p class="font-bold" id="detalle-material">—</p>
                    </div>
                    <div class="bg-surface-gray p-3 rounded-lg">
                        <p class="text-on-surface-variant text-xs mb-1">Medidas</p>
                        <p class="font-bold" id="detalle-medidas">—</p>
                    </div>
                    <div class="bg-surface-gray p-3 rounded-lg">
                        <p class="text-on-surface-variant text-xs mb-1">Precio</p>
                        <p class="font-bold text-wood-dark" id="detalle-precio">—</p>
                    </div>
                </div>

                <div class="bg-surface-gray p-3 rounded-lg">
                    <p class="text-on-surface-variant text-xs mb-1">Descripción</p>
                    <p class="text-sm" id="detalle-descripcion">Sin descripción.</p>
                </div>
            </div>

            @* Botones de acción: Editar y Eliminar *@
            <div class="flex justify-end gap-2 mt-4">
                @* Botón eliminar producto (formulario con POST) *@
                <form asp-controller="Productos" asp-action="Eliminar" method="post" class="inline"
                      onsubmit="return confirm('¿Está seguro de eliminar este producto? Esta acción no se puede deshacer.')">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="detalle-eliminar-id" />
                    <button type="submit"
                            class="px-4 py-2 bg-red-50 text-red-700 font-bold rounded-lg hover:bg-red-100 transition text-sm">
                        Eliminar
                    </button>
                </form>

                @* Botón editar (abre modal de edición) *@
                <button id="detalle-btn-editar"
                        class="px-4 py-2 bg-[#D2B48C] hover:brightness-95 text-black font-bold rounded-lg transition shadow-sm text-sm"
                        style="background-color: #D2B48C; color: #000000;">
                    Editar
                </button>
            </div>
        </div>
    </div>

    @* ============================================================
       SCRIPTS JavaScript
       ============================================================ *@
    <script>
        // ============================================================
        // Función: previsualizarImagen
        // Muestra una vista previa de la imagen seleccionada en el input file
        // Parámetros:
        //   event - evento del input file
        //   previewId - ID del elemento <img> donde mostrar la vista previa
        // ============================================================
        function previsualizarImagen(event, previewId) {
            var reader = new FileReader();
            reader.onload = function () {
                var img = document.getElementById(previewId);
                img.src = reader.result;
                img.classList.remove('hidden');
            };
            reader.readAsDataURL(event.target.files[0]);
        }

        // ============================================================
        // Función: filtrarProductos
        // Filtra las tarjetas de productos en tiempo real según el texto
        // de búsqueda (por nombre o código)
        // ============================================================
        function filtrarProductos() {
            // Obtener el texto de búsqueda en minúsculas
            var texto = document.getElementById('buscarProducto').value.toLowerCase();
            // Obtener todas las tarjetas de productos
            var tarjetas = document.querySelectorAll('.producto-card');

            tarjetas.forEach(function (tarjeta) {
                // Obtener nombre y código del data attribute
                var nombre = tarjeta.getAttribute('data-nombre') || '';
                var codigo = tarjeta.getAttribute('data-codigo') || '';

                // Mostrar u ocultar según coincidencia
                if (nombre.includes(texto) || codigo.includes(texto)) {
                    tarjeta.style.display = '';
                } else {
                    tarjeta.style.display = 'none';
                }
            });
        }

        // ============================================================
        // Función: resolverImagenJS
        // Asigna imagen representativa en el cliente según categoría o nombre
        // ============================================================
        // Función: manejarErrorImagenProducto
        // Fallback dinámico si una imagen falla al cargar en el cliente
        // ============================================================
        function manejarErrorImagenProducto(img, categoria, nombre) {
            img.onerror = null;
            var cat = (categoria || '').toLowerCase();
            var nom = (nombre || '').toLowerCase();
            if (cat.includes('escritorio') || nom.includes('escritorio') || nom.includes('despacho')) {
                img.src = '/images/escritorio.jpeg';
                // Fallback secundario a foto de escritorio de alta resolución si el archivo local está en proceso de creación
                img.onerror = function () {
                    this.onerror = null;
                    this.src = 'https://images.unsplash.com/photo-1518455027359-f3f8164ba6bd?w=600';
                };
            } else {
                img.src = resolverImagenJS(categoria, nombre);
            }
        }

        // ============================================================
        // Función: resolverImagenJS
        // Asigna imagen representativa en el cliente según categoría o nombre
        // ============================================================
        function resolverImagenJS(categoria, nombre) {
            categoria = (categoria || '').toLowerCase();
            nombre = (nombre || '').toLowerCase();

            // 1. Escritorios (evaluar antes de mesas)
            if (categoria.includes('escritorio') || nombre.includes('escritorio') || nombre.includes('despacho') || categoria.includes('despacho') || nombre.includes('estudio')) {
                return '/images/escritorio.jpeg';
            }

            // 2. Sillas
            if (categoria.includes('silla') || nombre.includes('silla') || nombre.includes('sillon') || nombre.includes('sillón')) {
                if (nombre.includes('cedro')) return '/images/silladecedro.jpeg';
                return '/images/sillas.jpeg';
            }

            // 3. Mesas
            if (categoria.includes('mesa') || nombre.includes('mesa')) {
                if (nombre.includes('noche')) return '/images/mesadenoche.jpeg';
                if (nombre.includes('centro') || nombre.includes('mesita') || nombre.includes('cafe') || nombre.includes('café')) return '/images/mesita.jpeg';
                return '/images/mesa.jpeg';
            }

            // 4. Camas
            if (categoria.includes('cama') || nombre.includes('cama') || categoria.includes('dormitorio') || nombre.includes('dormitorio') || nombre.includes('cabecero')) {
                return '/images/cama.jpeg';
            }

            // 5. Closets / Armarios
            if (categoria.includes('closet') || nombre.includes('closet') || categoria.includes('armario') || nombre.includes('armario') || nombre.includes('ropero')) {
                return nombre.includes('roble') ? '/images/closetroble.jpeg' : '/images/closet.jpeg';
            }

            // 6. Estantes / Libreros / Repisas
            if (categoria.includes('estante') || nombre.includes('estante') || nombre.includes('librero') || categoria.includes('repisa') || nombre.includes('biblioteca') || categoria.includes('biblioteca')) {
                return '/images/estanteria.jpeg';
            }

            // 7. Comedores
            if (categoria.includes('comedor') || nombre.includes('comedor')) {
                return '/images/comedor.jpeg';
            }

            // 8. Cocinas
            if (categoria.includes('cocina') || nombre.includes('cocina')) {
                if (nombre.includes('cedro')) return '/images/Cocinadecedro.jpeg';
                if (nombre.includes('roble')) return '/images/Cocinaderoble.jpeg';
                if (nombre.includes('rústica') || nombre.includes('rustica')) return '/images/Cocina_rústica.jpeg';
                return '/images/cocina.jpeg';
            }

            // 9. Accesorios / Organizadores
            if (categoria.includes('accesorio') || nombre.includes('organiza') || categoria.includes('organiza') || nombre.includes('caja')) {
                return '/images/organizador.jpeg';
            }

            // 10. Tocadores / Vanity
            if (nombre.includes('vanity') || nombre.includes('tocador') || categoria.includes('vanity') || categoria.includes('tocador')) {
                return '/images/Tocador elegante.jpeg';
            }

            return '/images/Wooden.jpeg';
        }

        // ============================================================
        // Función: previsualizarImagenEdicion
        // Previsualiza la nueva imagen seleccionada en el modal de edición
        // ============================================================
        function previsualizarImagenEdicion(event) {
            var input = event.target;
            if (input.files && input.files[0]) {
                var file = input.files[0];
                var reader = new FileReader();
                reader.onload = function (e) {
                    var imgActual = document.getElementById('edit-imagen-actual');
                    imgActual.src = e.target.result;

                    var badge = document.getElementById('edit-imagen-badge');
                    var txtNombre = document.getElementById('edit-imagen-nombre-archivo');
                    if (badge) badge.classList.remove('hidden');
                    if (txtNombre) txtNombre.textContent = file.name + ' (' + (file.size / 1024).toFixed(1) + ' KB) listo para guardar';

                    var btnQuitar = document.getElementById('btn-quitar-imagen-edit');
                    if (btnQuitar) btnQuitar.classList.remove('hidden');
                };
                reader.readAsDataURL(file);
            }
        }

        // ============================================================
        // Función: limpiarImagenEdicion
        // Cancela la selección de una nueva imagen y restaura la original
        // ============================================================
        function limpiarImagenEdicion() {
            var fileInput = document.getElementById('edit-imagen-file');
            if (fileInput) fileInput.value = '';

            var imgActual = document.getElementById('edit-imagen-actual');
            if (imgActual && imgActual.dataset.original) {
                imgActual.src = imgActual.dataset.original;
            }

            var badge = document.getElementById('edit-imagen-badge');
            if (badge) badge.classList.add('hidden');

            var btnQuitar = document.getElementById('btn-quitar-imagen-edit');
            if (btnQuitar) btnQuitar.classList.add('hidden');
        }

        // ============================================================
        // Función: abrirModalEditar
        // Carga los datos del producto por AJAX (fetch) y abre el modal
        // de edición con los campos pre-llenados
        // Parámetro: id - ID del producto a editar
        // ============================================================
        function abrirModalEditar(id) {
            // Cerrar modal de detalles si está abierto
            document.getElementById('modal-detalles').classList.add('hidden');

            // Resetear input de archivo y controles de imagen
            limpiarImagenEdicion();

            // Hacer petición GET al servidor para obtener datos del producto
            fetch('/Productos/Editar/' + id)
                .then(function (response) { return response.json(); })
                .then(function (data) {
                    // Llenar cada campo del formulario de edición con los datos recibidos
                    var prodId = data.idProducto || data.IdProducto || id;
                    document.getElementById('edit-id').value = prodId;
                    document.getElementById('edit-nombre').value = data.nombre || data.Nombre || '';
                    document.getElementById('edit-codigo').value = data.codigo || data.Codigo || '';
                    document.getElementById('edit-precio').value = (data.precio !== undefined && data.precio !== null) ? data.precio : (data.Precio || '');
                    
                    // Asignación segura de Categoría
                    var catVal = data.categoria || data.Categoria || '';
                    var selectCat = document.getElementById('edit-categoria');
                    if (selectCat && catVal) {
                        selectCat.value = catVal;
                        // Si no coincide exactamente (por ejemplo 'Escritorio' vs 'Escritorios'), buscar coincidencia parcial
                        if (!selectCat.value) {
                            var encontrada = false;
                            for (var i = 0; i < selectCat.options.length; i++) {
                                var optVal = selectCat.options[i].value;
                                if (optVal && (optVal.toLowerCase() === catVal.toLowerCase() ||
                                               optVal.toLowerCase().includes(catVal.toLowerCase()) ||
                                               catVal.toLowerCase().includes(optVal.toLowerCase()))) {
                                    selectCat.selectedIndex = i;
                                    encontrada = true;
                                    break;
                                }
                            }
                            if (!encontrada) {
                                var newOpt = document.createElement('option');
                                newOpt.value = catVal;
                                newOpt.textContent = catVal;
                                newOpt.selected = true;
                                selectCat.appendChild(newOpt);
                            }
                        }
                    }
                    
                    document.getElementById('edit-material').value = data.material || data.Material || '';
                    document.getElementById('edit-medidas').value = data.medidas || data.Medidas || '';
                    document.getElementById('edit-estado').value = data.estado || data.Estado || 'Activo';
                    document.getElementById('edit-descripcion').value = data.descripcion || data.Descripcion || '';

                    // Mostrar imagen actual con fallback
                    var imgActual = document.getElementById('edit-imagen-actual');
                    var imgUrl = data.imagen || data.Imagen || resolverImagenJS(data.categoria, data.nombre);
                    var catEdit = (data.categoria || data.Categoria || '').toLowerCase();
                    var nomEdit = (data.nombre || data.Nombre || '').toLowerCase();
                    if (catEdit.includes('escritorio') || nomEdit.includes('escritorio') || nomEdit.includes('despacho')) {
                        if (!imgUrl || imgUrl.includes('mesac') || imgUrl.includes('Wooden') || imgUrl.includes('mesa.jpeg')) {
                            imgUrl = '/images/escritorio.jpeg';
                        }
                    }
                    imgActual.src = imgUrl;
                    imgActual.dataset.original = imgUrl;
                    imgActual.onerror = function () {
                        this.onerror = null;
                        this.src = catEdit.includes('escritorio') || nomEdit.includes('escritorio')
                            ? 'https://images.unsplash.com/photo-1518455027359-f3f8164ba6bd?w=600'
                            : '/images/Wooden.jpeg';
                    };

                    // Mostrar el modal de edición
                    document.getElementById('modal-editar').classList.remove('hidden');
                })
                .catch(function (error) {
                    console.error('Error al cargar producto:', error);
                    alert('Error al cargar los datos del producto.');
                });
        }

        // ============================================================
        // Función: abrirModalDetalles
        // Carga los datos del producto por AJAX y abre el modal
        // de detalles con toda la información
        // Parámetro: id - ID del producto a consultar
        // ============================================================
        function abrirModalDetalles(id) {
            // Hacer petición GET al servidor
            fetch('/Productos/Editar/' + id)
                .then(function (response) { return response.json(); })
                .then(function (data) {
                    // Llenar los campos del modal de detalles
                    document.getElementById('detalle-codigo').textContent = data.codigo || 'Sin código';
                    document.getElementById('detalle-nombre').textContent = data.nombre || '';
                    document.getElementById('detalle-categoria').textContent = data.categoria || '—';
                    document.getElementById('detalle-material').textContent = data.material || '—';
                    document.getElementById('detalle-medidas').textContent = data.medidas || '—';
                    document.getElementById('detalle-descripcion').textContent = data.descripcion || 'Sin descripción.';

                    // Formatear precio
                    if (data.precio) {
                        document.getElementById('detalle-precio').textContent = '$' + Number(data.precio).toLocaleString('es-CO');
                    } else {
                        document.getElementById('detalle-precio').textContent = '—';
                    }

                    // Mostrar badge de estado con colores apropiados
                    var estadoSpan = document.getElementById('detalle-estado');
                    estadoSpan.textContent = data.estado || 'Activo';
                    if (data.estado === 'Activo') {
                        estadoSpan.className = 'text-[10px] font-bold px-3 py-1 rounded-full uppercase bg-teal-100 text-teal-800';
                    } else {
                        estadoSpan.className = 'text-[10px] font-bold px-3 py-1 rounded-full uppercase bg-red-100 text-red-800';
                    }

                    // Mostrar imagen con fallback
                    var imgDetalle = document.getElementById('detalle-imagen');
                    var imgUrl = data.imagen || resolverImagenJS(data.categoria, data.nombre);
                    var catDet = (data.categoria || '').toLowerCase();
                    var nomDet = (data.nombre || '').toLowerCase();
                    if (catDet.includes('escritorio') || nomDet.includes('escritorio') || nomDet.includes('despacho')) {
                        if (!data.imagen || data.imagen.includes('mesac') || data.imagen.includes('Wooden') || data.imagen.includes('mesa.jpeg')) {
                            imgUrl = '/images/escritorio.jpeg';
                        }
                    }
                    imgDetalle.src = imgUrl;
                    imgDetalle.onerror = function () {
                        this.onerror = null;
                        this.src = catDet.includes('escritorio') || nomDet.includes('escritorio')
                            ? 'https://images.unsplash.com/photo-1518455027359-f3f8164ba6bd?w=600'
                            : '/images/Wooden.jpeg';
                    };

                    // Configurar botón eliminar con el ID del producto
                    document.getElementById('detalle-eliminar-id').value = data.idProducto;

                    // Configurar botón editar para abrir el modal de edición
                    document.getElementById('detalle-btn-editar').onclick = function () {
                        abrirModalEditar(data.idProducto);
                    };

                    // Mostrar el modal de detalles
                    document.getElementById('modal-detalles').classList.remove('hidden');
                })
                .catch(function (error) {
                    console.error('Error al cargar detalles:', error);
                    alert('Error al cargar los detalles del producto.');
                });
        }
    </script>

</body>
</html>