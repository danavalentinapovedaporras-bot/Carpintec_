<div class="ml-auto flex border border-outline-variant rounded-full p-1 bg-surface-container-lowest">
<button class="p-1.5 bg-primary-container text-white rounded-full">
<span class="material-symbols-outlined text-[18px]">grid_view</span>
</button>
<button class="p-1.5 text-on-surface-variant">
<span class="material-symbols-outlined text-[18px]">list</span>
</button>
</div>
</div>
