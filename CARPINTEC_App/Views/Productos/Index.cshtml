    <!-- INICIO: Botón Nuevo Producto inferior en beige (#D2B48C) con letra en negro -->
    <button onclick="document.getElementById('modal-producto').classList.remove('hidden')"
            class="bg-[#D2B48C] hover:brightness-95 text-black font-bold px-4 py-2 rounded-lg shadow-sm transition"
            style="background-color: #D2B48C; color: #000000;">
        Nuevo Producto
    </button>
    <!-- FIN: Botón Nuevo Producto inferior en beige (#D2B48C) con letra en negro -->

    <!-- Fondo oscuro y contenedor de la ventana emergente -->
    <div id="modal-producto" class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center hidden z-50 p-4 overflow-y-auto">
        <div class="bg-white rounded-xl shadow-xl w-full max-w-xl p-6 relative my-8">

            <!-- Botón para cerrar (X) -->
            <button onclick="document.getElementById('modal-producto').classList.add('hidden')"
                    class="absolute top-4 right-4 text-gray-400 hover:text-gray-600 font-bold text-xl">
                &times;
            </button>

            <!-- Título -->
            <h3 class="text-xl font-bold text-gray-800 mb-4">Agregar Nuevo Producto</h3>

            <!-- Formulario (ajusta el action y el method según tu controlador, recuerda usar enctype si subes archivos) -->
            <form action="/Productos/Crear" method="POST" enctype="multipart/form-data" class="space-y-4">

                <!-- Nombre del Producto -->
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Nombre del Producto</label>
                    <input type="text" name="Nombre" required
                           class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-500">
                </div>

                <!-- Carga de Foto -->
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Fotografía del Producto</label>
                    <div class="flex items-center space-x-4">
                        <input type="file" name="Foto" accept="image/*" onchange="previsualizarImagen(event)"
                               class="w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-semibold file:bg-indigo-50 file:text-indigo-700 hover:file:bg-indigo-100">
                    </div>
                    <!-- Vista previa de la imagen -->
                    <div class="mt-2">
                        <img id="preview-img" src="#" alt="Vista previa" class="hidden h-24 w-24 object-cover rounded-lg border border-gray-200">
                    </div>
                </div>

                <!-- Colores Disponibles y Madera Disponible (en 2 columnas) -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Colores Disponibles</label>
                        <input type="text" name="ColoresDisponibles" placeholder="Ej. Nogal, Blanco, Natural"
                               class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-500">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Maderas Disponibles</label>
                        <input type="text" name="MaderasDisponibles" placeholder="Ej. Roble, Pino, Cedro"
                               class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-500">
                    </div>
                </div>

                <!-- Descripción -->
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Descripción</label>
                    <textarea name="Descripcion" rows="3" placeholder="Detalles de las dimensiones, acabados, etc."
                              class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-500"></textarea>
                </div>

                <!-- Botones de Acción -->
                <div class="flex justify-end space-x-3 pt-2">
                    <button type="button" onclick="document.getElementById('modal-producto').classList.add('hidden')"
                            class="px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-700 font-medium rounded-lg transition">
                        Cancelar
                    </button>
                    <!-- INICIO: Botón Guardar Producto en beige (#D2B48C) con letra en negro -->
                    <button type="submit"
                            class="px-4 py-2 bg-[#D2B48C] hover:brightness-95 text-black font-bold rounded-lg transition shadow-sm"
                            style="background-color: #D2B48C; color: #000000;">
                        Guardar Producto
                    </button>
                    <!-- FIN: Botón Guardar Producto en beige (#D2B48C) con letra en negro -->
                </div>

            </form>
        </div>
    </div>

   
  

<!-- Side Sheet / Drawer (Mobile Overlay) -->
<script>
        function toggleDetails() {
            const sheet = document.getElementById('detailsSheet');
            const overlay = sheet.querySelector('.sidebar-overlay');
            const drawer = sheet.querySelector('.drawer-transition');
            
            if (sheet.classList.contains('invisible')) {
                sheet.classList.remove('invisible');
                setTimeout(() => {
                    overlay.classList.replace('opacity-0', 'opacity-100');
                    drawer.classList.replace('translate-x-full', 'translate-x-0');
                }, 10);
            } else {
                overlay.classList.replace('opacity-100', 'opacity-0');
                drawer.classList.replace('translate-x-0', 'translate-x-full');
                setTimeout(() => {
                    sheet.classList.add('invisible');
                }, 300);
            }
        }

        // Search highlight micro-interaction
        const searchInput = document.querySelector('input[type="text"]');
        searchInput.addEventListener('focus', () => {
            searchInput.parentElement.classList.add('scale-[1.02]');
        });
        searchInput.addEventListener('blur', () => {
            searchInput.parentElement.classList.remove('scale-[1.02]');
        });

                   
           
    </script>
