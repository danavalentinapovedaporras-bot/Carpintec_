<span class="material-symbols-outlined text-[16px] text-black">filter_list</span> Categoría
</button>
<!-- FIN: Botón Categoría en blanco con letra en negro -->
<button class="shrink-0 flex items-center gap-1.5 px-4 py-2 bg-surface-container-lowest border border-outline-variant rounded-full text-xs font-medium">
