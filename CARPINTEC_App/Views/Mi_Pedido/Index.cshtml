@using CARPINTEC_App.Models
@model CARPINTEC_App.Models.Pedido
@{
    Layout = null;
    var listaPedidosBD = ViewBag.ListaPedidos as List<Pedido> ?? new List<Pedido>();
    string nombreCliente = ViewBag.NombreCliente as string ?? "Cliente Carpintec";
    string primerNombre = ViewBag.PrimerNombre as string ?? "Cliente";
    string telefonoCliente = ViewBag.TelefonoCliente as string ?? "+57 312 456 7890";
    string direccionCliente = ViewBag.DireccionCliente as string ?? "Calle 127 # 15-42, Bogotá";
    string iniciales = ViewBag.Iniciales as string ?? "CL";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>CARPINTEC - Mis Pedidos</title>

    <!-- Tailwind CSS v3 -->
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>

    <!-- Google Fonts: Plus Jakarta Sans & Lora -->
    <link href="https://fonts.googleapis.com" rel="preconnect" />
    <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect" />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Lora:ital,wght@0,500;0,600;0,700;1,400&family=Montserrat:wght@500;600;700;800&display=swap" rel="stylesheet" />

    <!-- Material Symbols -->
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />

    <!-- Tailwind Configuration -->
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        wood: {
                            950: '#23130a',
                            900: '#382013',
                            800: '#4a2c1b',
                            700: '#5c3822',
                            600: '#75472c',
                            500: '#915a38',
                            active: '#78462a',
                            accent: '#cb9861',
                            accentLight: '#ecd5b8',
                            badgeGreen: '#67774d',
                            badgeOrange: '#be6a2d',
                            badgeGray: '#796455',
                            badgeComplete: '#5c4535'
                        },
                        cream: {
                            50: '#FAF7F2',
                            100: '#F4ECE4',
                            200: '#EDE4D8',
                            card: '#FBF8F4',
                            border: '#e8ded3'
                        }
                    },
                    fontFamily: {
                        sans: ['"Plus Jakarta Sans"', 'sans-serif'],
                        serif: ['"Lora"', 'serif'],
                        montserrat: ['"Montserrat"', 'sans-serif']
                    }
                }
            }
        }
    </script>

    <!-- Custom Styles -->
    <style>
        body {
            background-color: #F3EDE6;
            color: #3b2416;
            font-family: 'Plus Jakarta Sans', sans-serif;
            -webkit-font-smoothing: antialiased;
        }

        .serif-title {
            font-family: 'Lora', Georgia, serif;
        }

        /* Wood texture simulation circles */
        .wood-swatch-nogal {
            background: radial-gradient(circle at 35% 35%, #6a4025, #3c2010);
            box-shadow: inset 0 0 6px rgba(0,0,0,0.4);
        }
        .wood-swatch-roble {
            background: radial-gradient(circle at 35% 35%, #e1b483, #b88653);
            box-shadow: inset 0 0 5px rgba(0,0,0,0.25);
        }
        .wood-swatch-caoba {
            background: radial-gradient(circle at 35% 35%, #92361b, #591907);
            box-shadow: inset 0 0 6px rgba(0,0,0,0.45);
        }
        .wood-swatch-pino {
            background: radial-gradient(circle at 35% 35%, #f1ca9e, #cb9f6d);
            box-shadow: inset 0 0 5px rgba(0,0,0,0.25);
        }
        .wood-swatch-bicolor {
            background: linear-gradient(135deg, #e3dfda 50%, #5d351b 50%);
            box-shadow: inset 0 0 5px rgba(0,0,0,0.3);
        }

        /* Modal backdrop transition */
        .modal-active {
            opacity: 1 !important;
            visibility: visible !important;
            pointer-events: auto !important;
        }

        /* Star rating hover animations */
        .star-rating .star-btn {
            transition: transform 0.15s ease, color 0.15s ease;
        }
        .star-rating .star-btn:hover {
            transform: scale(1.25);
        }

        /* Print styles for Invoice */
        @@media print {
            body * {
                visibility: hidden;
            }
            #invoiceModalContent, #invoiceModalContent * {
                visibility: visible;
            }
            #invoiceModalContent {
                position: absolute;
                left: 0;
                top: 0;
                width: 100%;
                margin: 0;
                padding: 20px;
                background: white !important;
                color: black !important;
                border: none !important;
                box-shadow: none !important;
            }
            .no-print {
                display: none !important;
            }
        }
    </style>
</head>
<body class="min-h-screen flex flex-col antialiased selection:bg-wood-accent selection:text-white pb-16">

    <!-- ========================================== -->
    <!-- MAIN HEADER -->
    <!-- ========================================== -->
    <header class="w-full bg-[#523321] text-white px-6 md:px-12 py-3.5 shadow-md sticky top-0 z-30">
        <div class="max-w-[1400px] mx-auto flex items-center justify-between">
            <!-- Brand Logo & Motto -->
            <a href="/DashboardCliente" class="flex items-center gap-3.5 group cursor-pointer transition-transform hover:scale-[1.01]">
                <div class="text-[#f1be85] flex items-center justify-center group-hover:rotate-6 transition-transform">
                    <svg class="w-9 h-9" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                        <polygon points="12 2 22 8.5 22 15.5 12 22 2 15.5 2 8.5 12 2"></polygon>
                        <line x1="12" x2="12" y1="22" y2="12"></line>
                        <polyline points="22 8.5 12 12 2 8.5"></polyline>
                        <polyline points="2 15.5 12 12 22 15.5"></polyline>
                    </svg>
                </div>
                <div class="flex flex-col">
                    <span class="text-xl font-bold tracking-wider leading-none text-[#F6EDE4]">CARPINTEC</span>
                    <span class="text-[9px] tracking-widest text-[#d8c3b4] font-medium mt-1 uppercase">Muebles que dan vida a tus espacios</span>
                </div>
            </a>

            <!-- Navigation Links (Totalmente Funcionales) -->
            <nav class="flex items-center gap-1 md:gap-3 text-sm font-medium">
                <!-- Inicio -->
                <a href="/DashboardCliente" class="flex items-center gap-2 px-3 py-2 text-[#e3d1c4] hover:text-white hover:bg-[#633f2a]/60 rounded-lg transition-all duration-150">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" stroke-linecap="round" stroke-linejoin="round"></path>
                    </svg>
                    <span class="hidden sm:inline">Inicio</span>
                </a>

                <!-- Catálogo -->
                <a href="/MisProductos" class="flex items-center gap-2 px-3 py-2 text-[#e3d1c4] hover:text-white hover:bg-[#633f2a]/60 rounded-lg transition-all duration-150">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" stroke-linecap="round" stroke-linejoin="round"></path>
                    </svg>
                    <span class="hidden sm:inline">Catálogo</span>
                </a>

                <!-- Mis pedidos (Active Pill) -->
                <a href="/Mi_Pedido" class="flex items-center gap-2 px-4 py-2 bg-[#78472B] text-white rounded-lg font-semibold shadow-inner transition-all border border-[#8e5a3c]">
                    <svg class="w-4 h-4 text-[#eec496]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" stroke-linecap="round" stroke-linejoin="round"></path>
                    </svg>
                    <span>Mis pedidos</span>
                </a>

                <!-- Perfil -->
                <a href="/MiPerfil" class="flex items-center gap-2 px-3 py-2 text-[#e3d1c4] hover:text-white hover:bg-[#633f2a]/60 rounded-lg transition-all duration-150">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" stroke-linecap="round" stroke-linejoin="round"></path>
                    </svg>
                    <span class="hidden sm:inline">Perfil</span>
                </a>

                <!-- Avatar Usuario -->
                <div class="ml-2 pl-3 border-l border-[#754a32] flex items-center gap-2">
                    <div class="w-8 h-8 rounded-full bg-[#cb9861] text-[#3b2011] font-bold text-xs flex items-center justify-center shadow-sm" title="@nombreCliente">
                        @iniciales
                    </div>
                </div>
            </nav>
        </div>
    </header>

    <!-- ========================================== -->
    <!-- MAIN CONTENT -->
    <!-- ========================================== -->
    <main class="max-w-[1400px] w-full mx-auto px-6 md:px-12 pt-8 pb-12 flex-1">

        <!-- SUBHEADER / PAGE TITLE -->
        <section class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-6 mb-2 border-b border-[#e5d9cc]">
            <!-- Title & Clipboard Icon -->
            <div class="flex items-center gap-4">
                <div class="w-14 h-14 rounded-xl border-[2.5px] border-[#53301a] flex items-center justify-center p-2 relative bg-transparent shrink-0 shadow-sm">
                    <div class="absolute -top-2 w-5 h-2 bg-[#53301a] rounded-t-sm"></div>
                    <svg class="w-8 h-8 text-[#53301a]" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24">
                        <rect height="16" rx="2" ry="2" width="16" x="4" y="4"></rect>
                        <line x1="8" x2="16" y1="10" y2="10"></line>
                        <line x1="8" x2="16" y1="14" y2="14"></line>
                        <line x1="8" x2="12" y1="18" y2="18"></line>
                    </svg>
                </div>
                <div>
                    <h1 class="text-3xl md:text-4xl font-bold serif-title text-[#422514] tracking-tight">Mis pedidos</h1>
                    <p class="text-[#644937] text-sm md:text-base mt-0.5 font-normal">Consulta el avance de fabricación en taller, califica tus muebles y visualiza tus facturas.</p>
                </div>
            </div>

            <!-- Botones de Acción Superior -->
            <div class="flex items-center gap-3">
                <!-- Botón Contacto Funcional -->
                <button type="button" onclick="openContactModal()" class="inline-flex items-center gap-2 bg-[#cb9861] hover:bg-[#bd8951] text-[#341b0b] font-semibold text-sm px-5 py-2.5 rounded-full shadow-sm hover:shadow transition duration-150 active:scale-95">
                    <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20">
                        <path d="M18 10c0 3.866-3.582 7-8 7a8.841 8.841 0 01-4.083-.98L2 17l1.338-3.123C2.493 12.767 2 11.434 2 10c0-3.866 3.582-7 8-7s8 3.134 8 7zM7 9H5v2h2V9zm4 0H9v2h2V9zm4 0h-2v2h2V9z"></path>
                    </svg>
                    <span>Contacto / Soporte</span>
                </button>

                <!-- Botón Crear Nueva Cotización -->
                <a href="/NuevaCotizacion" class="inline-flex items-center gap-2 bg-[#523321] hover:bg-[#43291a] text-white font-semibold text-sm px-5 py-2.5 rounded-full shadow-sm hover:shadow transition duration-150 active:scale-95">
                    <span class="material-symbols-outlined text-base">add</span>
                    <span class="hidden sm:inline">Nueva Cotización</span>
                </a>
            </div>
        </section>

        @if (listaPedidosBD != null && listaPedidosBD.Any())
        {
            <!-- FILTERS AND SEARCH BAR -->
            <section class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3 mb-6">
                <!-- Tabs de Filtro -->
                <div class="inline-flex p-1 bg-[#eae0d5] rounded-xl text-xs font-semibold text-[#5c3e29]" id="filterTabs">
                    <button type="button" onclick="filterOrders('todos', this)" class="filter-tab px-4 py-2 rounded-lg bg-[#523321] text-white shadow-sm transition">
                        Todos (<span id="countTodos">@listaPedidosBD.Count</span>)
                    </button>
                    <button type="button" onclick="filterOrders('en-proceso', this)" class="filter-tab px-4 py-2 rounded-lg hover:text-[#382013] transition">
                        En producción (<span id="countProceso">0</span>)
                    </button>
                    <button type="button" onclick="filterOrders('completados', this)" class="filter-tab px-4 py-2 rounded-lg hover:text-[#382013] transition">
                        Completados (<span id="countCompletados">0</span>)
                    </button>
                </div>

                <!-- Buscador Rápido -->
                <div class="relative w-full sm:w-72">
                    <span class="material-symbols-outlined absolute left-3.5 top-2.5 text-[#856550] text-lg">search</span>
                    <input type="text" id="orderSearchInput" onkeyup="searchOrders()" placeholder="Buscar por mueble o código..." 
                           class="w-full bg-[#fbf8f4] border border-[#d9cdbf] rounded-full pl-10 pr-4 py-2 text-xs text-[#3d2415] placeholder:text-[#8d7767] focus:outline-none focus:ring-2 focus:ring-[#cb9861] focus:border-transparent transition" />
                </div>
            </section>

            <!-- ========================================== -->
            <!-- ORDERS GRID (PEDIDOS REALES DE BD)         -->
            <!-- ========================================== -->
            <section class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="ordersContainer">
                @foreach (var p in listaPedidosBD)
                {
                    var primerDetalle = p.DetallePedidos?.FirstOrDefault();
                    var primerProd = primerDetalle?.IdProductoNavigation;
                    string nombreProd = !string.IsNullOrWhiteSpace(p.Producto) 
                        ? p.Producto 
                        : (!string.IsNullOrWhiteSpace(primerProd?.Nombre) ? primerProd.Nombre : $"Mueble Pedido #{p.CodigoPedido}");
                    
                    string estadoStr = !string.IsNullOrWhiteSpace(p.Estado) ? p.Estado : "En producción";
                    bool esEntregado = estadoStr.Contains("Entregado", StringComparison.OrdinalIgnoreCase) || estadoStr.Contains("Completado", StringComparison.OrdinalIgnoreCase) || estadoStr.Contains("Listo", StringComparison.OrdinalIgnoreCase);
                    bool esPreparacion = estadoStr.Contains("Preparación", StringComparison.OrdinalIgnoreCase) || estadoStr.Contains("Pendiente", StringComparison.OrdinalIgnoreCase);
                    string categoria = esEntregado ? "completados" : "en-proceso";
                    string statusClass = esEntregado ? "bg-[#796455]" : (esPreparacion ? "bg-[#be6a2d]" : "bg-[#67774d]");
                    int progreso = esEntregado ? 100 : (esPreparacion ? 35 : 68);
                    string codigo = !string.IsNullOrEmpty(p.CodigoPedido) ? p.CodigoPedido : $"PED-{p.IdPedido:D4}";
                    
                    string fechaPed = p.FechaSolicitud != default 
                        ? p.FechaSolicitud.ToString("d MMM. yyyy", new System.Globalization.CultureInfo("es-CO")) 
                        : (p.FechaRegistro.HasValue ? p.FechaRegistro.Value.ToString("d MMM. yyyy", new System.Globalization.CultureInfo("es-CO")) : "Reciente");
                    
                    string fechaFin = p.FechaEntrega != default 
                        ? p.FechaEntrega.ToString("d MMM. yyyy", new System.Globalization.CultureInfo("es-CO")) 
                        : "Por coordinar";

                    string madera = !string.IsNullOrWhiteSpace(primerDetalle?.Material) 
                        ? primerDetalle.Material 
                        : (!string.IsNullOrWhiteSpace(primerProd?.Material) 
                            ? primerProd.Material 
                            : (!string.IsNullOrWhiteSpace(p.IdCotizacionNavigation?.TipoMadera) ? p.IdCotizacionNavigation.TipoMadera : "Roble / Pino"));
                    
                    string medidas = "A medida";
                    if (primerDetalle?.Ancho.HasValue == true && primerDetalle?.Alto.HasValue == true)
                    {
                        medidas = $"{primerDetalle.Ancho} m (ancho) x {primerDetalle.Alto} m (alto)" + (primerDetalle.Profundidad.HasValue ? $" x {primerDetalle.Profundidad} m" : "");
                    }
                    else if (!string.IsNullOrWhiteSpace(p.IdCotizacionNavigation?.Medidas))
                    {
                        medidas = p.IdCotizacionNavigation.Medidas;
                    }
                    else if (!string.IsNullOrWhiteSpace(primerProd?.Medidas))
                    {
                        medidas = primerProd.Medidas;
                    }

                    string color = "Natural / Tono Roble";
                    if (!string.IsNullOrWhiteSpace(primerProd?.Categoria))
                    {
                        color = primerProd.Categoria;
                    }

                    string desc = !string.IsNullOrWhiteSpace(p.Observaciones) 
                        ? p.Observaciones 
                        : (!string.IsNullOrWhiteSpace(primerProd?.Descripcion) ? primerProd.Descripcion : "Mueble a medida elaborado bajo altos estándares de carpintería y acabados finos.");

                    decimal subtotalVal = Math.Round(p.ValorTotal / 1.19m, 0);
                    decimal ivaVal = p.ValorTotal - subtotalVal;
                    string totalFmt = p.ValorTotal.ToString("C0", new System.Globalization.CultureInfo("es-CO"));
                    string subtotalFmt = subtotalVal.ToString("C0", new System.Globalization.CultureInfo("es-CO"));
                    string ivaFmt = ivaVal.ToString("C0", new System.Globalization.CultureInfo("es-CO"));
                    string folioFmt = $"FAC-{DateTime.Now.Year}-{p.IdPedido:D4}";

                    string imgUrl = "https://images.unsplash.com/photo-1555041469-a586c61ea9bc?auto=format&fit=crop&w=600&q=80";
                    if (!string.IsNullOrWhiteSpace(primerProd?.Imagen))
                    {
                        imgUrl = primerProd.Imagen;
                    }
                    else
                    {
                        string nombreLower = nombreProd.ToLower();
                        if (nombreLower.Contains("cocina")) imgUrl = "https://lh3.googleusercontent.com/aida-public/AB6AXuALK0JD3MIPkcH_QJZdF6rz4L3XxjZs6aQdHqcoVVkKLIzhA2xpO1JhU1xR85kNB2Pnh_ZKabzLWfCYx6KJSsBqQucLIa3YGsFjZtNY2YAtAMHY3MSoeBui-asGkVXdvDxoDistGvA6jPR7bycXPV0u4gCf01myQlaB8qeIUWCeTkRxgkxPVh9iOGT2TCPBHaIxTxx9OjFpufOgiFK9DI5z019jpiagxb8Ggy8SMB7PbIvFrooChPOqEQ";
                        else if (nombreLower.Contains("closet") || nombreLower.Contains("armario")) imgUrl = "https://lh3.googleusercontent.com/aida-public/AB6AXuDdYe-yOgkkc2mdysV9r_AbybqUk5apUu9-iIAnSzjEEMJZXsJ2m5UcR3WbxmosFTdJxTrQ-QcSJVDMjsOHW5T1srMy9CJsX2PB9ZtLC-fGHE3zFlJoHpFunK8DWLa7gLSrBAYgROd5fToPr_Z3CH4pcZXt2N2NV-gmtZ1DDLQymjCLTm-FRfFbSAc0sPNuCyGWYJqwRvHZonLeif77vgCmzX7toDP1kVUpuuVtKzvmqT6ZbMV8tnLTzQ";
                        else if (nombreLower.Contains("comedor") || nombreLower.Contains("mesa")) imgUrl = "https://lh3.googleusercontent.com/aida-public/AB6AXuCsvAhEwMszW2g79c4a1Zv1pbch0MTyt53riMVELNCjmV9RIN3OL9B7m-cFCfcUVFIAclvPwGTEmqWN3-V6ZKhIsis3aalnLudQ67i1EwlAKGB9ntt_mmOI-QFTyK04pxrr7BfRYeH-dU77UVW0ardgYud6roERUQGctbn2SBjUFdrzuAc6KimFCq7V11UxlhdzqYDPU8oDvajWyXsvXR4pnwamQFADNiBIbiUEFFR81tURL_G2dckUkA";
                        else if (nombreLower.Contains("cama")) imgUrl = "https://lh3.googleusercontent.com/aida-public/AB6AXuDTd01xqyIlSN3PPFvgljCi-VSqrvwl1-OppCt8moD_rFd7R0dtvSS5mTcHAxEqbW2_PKuSjAa_zUEih4UrBUwYJu7T5vvNKdif6Zf755jqazYIP-eZbThQtRDkdER7kCQJHaBRHhC-dGd7w0j_OkYY3c9W3S8hshE2jj0wKfMcErT9N0vNzQWP--u2ira0fvrqieZcUjnP3UiTe8g8YKXb7w9eDV6Ab6EDbuOCXP_TCEVK34UQcCntFA";
                        else if (nombreLower.Contains("estant") || nombreLower.Contains("librero")) imgUrl = "https://lh3.googleusercontent.com/aida-public/AB6AXuAa7gwqYqQYc5i7NBdk0IbinqK2UacvAOsWRNxXc5kOlcz6cgss4M1Jl28lnCzQ2cBASmmxeAZK5CyekenSQV9SJHVci4H1dFGCLQOqUU_FJXiwHu6u1ZwE9OaoGAxaFT1E0UTTG3tD1TxdM9Q-7jWGtCaFDjeI4vC927LRzkXsAPqbZjoPchifSTVvSpDAz_BJ3Q0FVhORtdOiN2hn8sqr8Q_dPuHWz0Vh2164lV3y4pynMy5V-roiaw";
                        else if (nombreLower.Contains("silla")) imgUrl = "https://lh3.googleusercontent.com/aida-public/AB6AXuDTvQXOQcK7Ey35_wuYZqwAS5JaxUkZSSMYCxiwCpuBkMT-DTa4kAgNut7BUv1Wzlhvy7-hAT0pisQCA_gqMELH1qjsbEoSiE9I4qNHh8D2S-I0D43qVq3QnLMTZMMuzm3iCfm1muJK89pgMloa92UUjT2rn3AwDpUpyy52XvXvzA-g-wpuAjO7oOgxudWxFMDqmrmz6974U2oNPJXMSVl7ejSkw9BJPf7T6Hu7RnjGh7FElhCJ4MHPFg";
                    }

                    <div class="order-card bg-[#FBF8F4] border border-[#e8ded3] rounded-2xl p-5 shadow-[0_2px_8px_rgba(0,0,0,0.03)] hover:shadow-[0_6px_16px_rgba(92,56,34,0.08)] transition-all duration-200 flex flex-col justify-between"
                         data-category="@categoria"
                         data-id="@p.IdPedido"
                         data-code="@codigo"
                         data-name="@nombreProd"
                         data-status="@estadoStr"
                         data-status-class="@statusClass"
                         data-progress="@progreso"
                         data-order-date="@fechaPed"
                         data-end-date="@fechaFin"
                         data-wood="@madera"
                         data-color="@color"
                         data-measures="@medidas"
                         data-desc="@desc"
                         data-total="@totalFmt"
                         data-subtotal="@subtotalFmt"
                         data-iva="@ivaFmt"
                         data-folio="@folioFmt"
                         data-swatch="wood-swatch-nogal"
                         data-img="@imgUrl">
                        <div>
                            <div class="flex gap-4 items-start">
                                <div class="w-28 h-28 rounded-xl overflow-hidden shrink-0 bg-stone-200 relative group cursor-pointer" onclick="openOrderModalById(@p.IdPedido)">
                                    <img alt="@nombreProd" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" src="@imgUrl" />
                                    <div class="absolute inset-0 bg-black/20 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center text-white">
                                        <span class="material-symbols-outlined text-xl">zoom_in</span>
                                    </div>
                                </div>
                                <div class="flex-1 min-w-0">
                                    <div class="flex items-center justify-between gap-2">
                                        <div class="flex items-center gap-1.5 min-w-0">
