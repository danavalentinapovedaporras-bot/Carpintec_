    <!-- ======================================================= -->
    <!-- SCRIPTS INTERACTIVOS: SEGUIMIENTO, CALIFICACIÓN, FACTURA -->
    <!-- ======================================================= -->
    <script>
        // Estado actual activo
        let currentOrderData = null;
        let selectedRatingValue = 5;

        // Base de datos de Etapas Estándar de Carpintería
        const PRODUCTION_STAGES = [
            { id: 1, name: "Diseño & Planimetría", desc: "Planos técnicos en 3D aprobados, despiece milimétrico y validación de acabados.", icon: "architecture" },
            { id: 2, name: "Selección & Corte de Madera", desc: "Escuadrado de tableros, calibración de vetas y corte CNC de piezas maestras.", icon: "straighten" },
            { id: 3, name: "Armado & Ensamble", desc: "Unión de módulos, espigado reforzado e instalación de herrajes ocultos.", icon: "handyman" },
            { id: 4, name: "Lijado, Acabado & Pintura", desc: "Sellado de poros, aplicación de tinte madera natural y triple capa de laca poliuretano.", icon: "brush" },
            { id: 5, name: "Control de Calidad & Empaque", desc: "Inspección de nivelación, prueba de peso y empaque con esquineros de alta protección.", icon: "verified" },
            { id: 6, name: "Despacho & Entrega al Cliente", desc: "Transporte acolchado especializado e instalación en el espacio del cliente.", icon: "local_shipping" }
        ];

        // ---------------------------------------------------------
        // ABRIR MODAL DE DETALLES Y PROCESO
        // ---------------------------------------------------------
        function openOrderModalById(orderId) {
            const card = document.querySelector(`.order-card[data-id="${orderId}"]`);
            if (!card) return;

            currentOrderData = {
                id: orderId,
                code: card.getAttribute('data-code'),
                name: card.getAttribute('data-name'),
                status: card.getAttribute('data-status'),
                statusClass: card.getAttribute('data-status-class') || 'bg-[#67774d]',
                progress: parseInt(card.getAttribute('data-progress') || '50'),
                orderDate: card.getAttribute('data-order-date'),
                endDate: card.getAttribute('data-end-date'),
                wood: card.getAttribute('data-wood'),
                color: card.getAttribute('data-color'),
                measures: card.getAttribute('data-measures'),
                desc: card.getAttribute('data-desc'),
                total: card.getAttribute('data-total'),
                subtotal: card.getAttribute('data-subtotal'),
                iva: card.getAttribute('data-iva'),
                folio: card.getAttribute('data-folio'),
                img: card.getAttribute('data-img')
            };

            // Rellenar elementos del modal
            document.getElementById('modalOrderCode').innerText = '#' + currentOrderData.code;
            document.getElementById('modalProductName').innerText = currentOrderData.name;
            
            const badge = document.getElementById('modalOrderStatusBadge');
            badge.innerText = currentOrderData.status;
            badge.className = `px-2.5 py-0.5 rounded-full text-[11px] font-bold text-white ${currentOrderData.statusClass}`;

            document.getElementById('modalProductImg').src = currentOrderData.img;
            document.getElementById('modalWood').innerText = currentOrderData.wood;
            document.getElementById('modalColor').innerText = currentOrderData.color;
            document.getElementById('modalMeasures').innerText = currentOrderData.measures;
            document.getElementById('modalOrderDate').innerText = currentOrderData.orderDate;
            document.getElementById('modalDeliveryDate').innerText = currentOrderData.endDate;
            document.getElementById('modalTotal').innerText = currentOrderData.total;
            document.getElementById('modalDesc').innerText = currentOrderData.desc;

            // Ajustar etiqueta de entrega según estado
            const isCompleted = currentOrderData.progress >= 100 || currentOrderData.status.toLowerCase().includes('entregado') || currentOrderData.status.toLowerCase().includes('completado');
            document.getElementById('modalDeliveryLabel').innerText = isCompleted ? 'Entregado el:' : 'Entrega estimada:';

            // Porcentaje de progreso
            document.getElementById('timelineProgressPct').innerText = currentOrderData.progress + '%';

            // Banner de completado
            const completedBanner = document.getElementById('completedSuccessBanner');
            if (isCompleted) {
                completedBanner.classList.remove('hidden');
                document.getElementById('timelineSubtitle').innerText = "Historial completo de las 6 etapas de fabricación superadas por tu mueble.";
            } else {
                completedBanner.classList.add('hidden');
                document.getElementById('timelineSubtitle').innerText = "Seguimiento en tiempo real del estado de carpintería y avance en taller.";
            }

            // Construir las etapas visuales (Timeline)
            renderProductionTimeline(currentOrderData.progress, isCompleted);

            // Cargar calificación previa si existe en localStorage
            loadSavedRating(currentOrderData.id);

            // Mostrar modal
            const modal = document.getElementById('orderDetailModal');
            const box = document.getElementById('orderDetailModalBox');
            modal.classList.add('modal-active');
            box.classList.remove('scale-95');
            box.classList.add('scale-100');
            document.body.style.overflow = 'hidden';
        }

        // Renderizar línea de tiempo dinámica
        function renderProductionTimeline(progressPct, isCompleted) {
            const list = document.getElementById('stepperStepsList');
            list.innerHTML = '';

            // Calcular etapa activa según progreso
            let activeStageIndex = 6;
            if (!isCompleted) {
                if (progressPct <= 20) activeStageIndex = 1;
                else if (progressPct <= 40) activeStageIndex = 2;
                else if (progressPct <= 60) activeStageIndex = 3;
                else if (progressPct <= 80) activeStageIndex = 4;
                else if (progressPct < 100) activeStageIndex = 5;
            }

            PRODUCTION_STAGES.forEach((stage, idx) => {
                const stageNum = idx + 1;
                let stepState = 'pending'; // 'completed', 'active', 'pending'

                if (isCompleted || stageNum < activeStageIndex) {
                    stepState = 'completed';
                } else if (stageNum === activeStageIndex && !isCompleted) {
                    stepState = 'active';
                } else {
                    stepState = 'pending';
                }

                let iconHtml = '';
                let borderStyle = '';
                let bgStyle = '';
                let statusBadge = '';

                if (stepState === 'completed') {
                    iconHtml = `<div class="w-9 h-9 rounded-full bg-emerald-600 text-white flex items-center justify-center font-bold text-sm shadow-sm shrink-0">
                                    <span class="material-symbols-outlined text-lg">check</span>
                                </div>`;
                    bgStyle = 'bg-emerald-50/60 border-emerald-200';
                    statusBadge = `<span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-800 border border-emerald-300">
                                       Completada
                                   </span>`;
                } else if (stepState === 'active') {
                    iconHtml = `<div class="w-9 h-9 rounded-full bg-[#cb9861] text-white flex items-center justify-center font-bold text-sm shadow-md ring-4 ring-[#ecd5b8] shrink-0 animate-pulse">
                                    <span class="material-symbols-outlined text-lg">${stage.icon}</span>
                                </div>`;
                    bgStyle = 'bg-[#FAF7F2] border-[#cb9861] ring-1 ring-[#cb9861]/40';
                    statusBadge = `<span class="px-2.5 py-0.5 rounded-full text-[10px] font-extrabold bg-[#be6a2d] text-white animate-pulse">
                                       En Proceso en Taller
                                   </span>`;
                } else {
                    iconHtml = `<div class="w-9 h-9 rounded-full bg-stone-200 text-stone-500 flex items-center justify-center font-bold text-xs shrink-0">
                                    <span>${stageNum}</span>
                                </div>`;
                    bgStyle = 'bg-white/60 border-stone-200 opacity-75';
                    statusBadge = `<span class="px-2 py-0.5 rounded-full text-[10px] font-medium bg-stone-100 text-stone-600">
                                       Pendiente
                                   </span>`;
                }

                const stepDiv = document.createElement('div');
                stepDiv.className = `p-3.5 rounded-2xl border ${bgStyle} flex items-start justify-between gap-3.5 transition-all`;
                stepDiv.innerHTML = `
                    <div class="flex items-start gap-3">
                        ${iconHtml}
                        <div>
                            <div class="flex items-center gap-2">
                                <h5 class="font-bold text-xs md:text-sm text-[#3d2415]">Etapa ${stageNum}: ${stage.name}</h5>
                            </div>
                            <p class="text-[11px] text-[#6d4f3b] mt-0.5 leading-snug">${stage.desc}</p>
                        </div>
                    </div>
                    <div class="shrink-0 pt-0.5">
                        ${statusBadge}
                    </div>
                `;

                list.appendChild(stepDiv);
            });
        }

        function closeOrderModal() {
            const modal = document.getElementById('orderDetailModal');
            const box = document.getElementById('orderDetailModalBox');
            modal.classList.remove('modal-active');
            box.classList.remove('scale-100');
            box.classList.add('scale-95');
            document.body.style.overflow = 'auto';
        }

        // ---------------------------------------------------------
        // CALIFICACIÓN CON ESTRELLITAS
        // ---------------------------------------------------------
        const RATING_TEXTS = {
            1: "Mala experiencia - Calidad insatisfactoria",
            2: "Regular - Requiere ajustes en acabados",
            3: "Buena - Cumple con lo solicitado",
            4: "Muy buena - Acabado de calidad y puntual",
            5: "¡Excelente calidad y acabado artesanal impecable!"
        };

        function setStarRating(stars) {
            selectedRatingValue = stars;
            renderStars(stars);
        }

        function renderStars(stars) {
            const container = document.getElementById('starsContainer');
            const starBtns = container.querySelectorAll('.star-btn');
            starBtns.forEach((btn, idx) => {
                const starVal = idx + 1;
                if (starVal <= stars) {
                    btn.classList.remove('text-gray-300');
                    btn.classList.add('text-amber-400');
                } else {
                    btn.classList.remove('text-amber-400');
                    btn.classList.add('text-gray-300');
                }
            });
            document.getElementById('ratingFeedbackText').innerText = RATING_TEXTS[stars] || "";
        }

        function loadSavedRating(orderId) {
            const saved = localStorage.getItem('carpintec_rating_' + orderId);
            const successAlert = document.getElementById('ratingSuccessAlert');
            if (saved) {
                const ratingNum = parseInt(saved);
                setStarRating(ratingNum);
                successAlert.classList.remove('hidden');
                document.getElementById('ratingSuccessMsg').innerText = `Tu calificación actual para este mueble es de ${ratingNum} estrellas. ¡Puedes actualizarla cuando desees!`;
            } else {
                setStarRating(5);
                successAlert.classList.add('hidden');
            }
        }

        async function submitRating() {
            if (!currentOrderData) return;
            const btn = document.getElementById('saveRatingBtn');
            const prevText = btn.innerHTML;
            btn.innerHTML = `<span class="material-symbols-outlined text-base animate-spin">refresh</span> Guardando...`;
            btn.disabled = true;

            try {
                // Guardar localmente
                localStorage.setItem('carpintec_rating_' + currentOrderData.id, selectedRatingValue);

                // Actualizar preview en la tarjeta correspondiente
                const previewEl = document.getElementById('cardRatingPreview-' + currentOrderData.id);
                if (previewEl) {
                    let starsStr = '';
                    for (let i = 0; i < selectedRatingValue; i++) starsStr += '★';
                    previewEl.innerText = starsStr;
                }

                // Llamada asíncrona al backend
                await fetch('/Mi_Pedido/CalificarProducto', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        idPedido: currentOrderData.id,
                        codigoPedido: currentOrderData.code,
                        producto: currentOrderData.name,
                        estrellas: selectedRatingValue
                    })
                });

                const alert = document.getElementById('ratingSuccessAlert');
                alert.classList.remove('hidden');
                document.getElementById('ratingSuccessMsg').innerText = `¡Gracias por calificar "${currentOrderData.name}" con ${selectedRatingValue} estrellas! Tu opinión ha sido guardada.`;
            } catch (err) {
                console.error("Error al registrar calificación:", err);
            } finally {
                btn.innerHTML = prevText;
                btn.disabled = false;
            }
        }

        // ---------------------------------------------------------
        // MODAL DE FACTURA
        // ---------------------------------------------------------
        function openInvoiceModalById(orderId) {
            const card = document.querySelector(`.order-card[data-id="${orderId}"]`);
            if (!card) return;

            const folio = card.getAttribute('data-folio') || ('FAC-2025-0' + orderId);
            const name = card.getAttribute('data-name');
            const total = card.getAttribute('data-total');
            const subtotal = card.getAttribute('data-subtotal');
            const iva = card.getAttribute('data-iva');
            const orderDate = card.getAttribute('data-order-date');
            const code = card.getAttribute('data-code');
            const wood = card.getAttribute('data-wood');
            const color = card.getAttribute('data-color');
            const measures = card.getAttribute('data-measures');

            document.getElementById('invFolio').innerText = folio;
            document.getElementById('invOrderRef').innerText = '#' + code;
            document.getElementById('invIssueDate').innerText = orderDate;
            document.getElementById('invItemTitle').innerText = name;
            document.getElementById('invItemMeasures').innerText = measures;
            document.getElementById('invItemMaterial').innerText = wood + ' / ' + color;
            document.getElementById('invItemSubtotal').innerText = subtotal;
            document.getElementById('invSubtotalVal').innerText = subtotal;
            document.getElementById('invIvaVal').innerText = iva;
            document.getElementById('invTotalVal').innerText = total;

            const modal = document.getElementById('invoiceModal');
            const box = document.getElementById('invoiceModalBox');
            modal.classList.add('modal-active');
            box.classList.remove('scale-95');
            box.classList.add('scale-100');
            document.body.style.overflow = 'hidden';
        }

        function triggerInvoiceFromModal() {
            if (!currentOrderData) return;
            openInvoiceModalById(currentOrderData.id);
        }

        function closeInvoiceModal() {
            const modal = document.getElementById('invoiceModal');
            const box = document.getElementById('invoiceModalBox');
            modal.classList.remove('modal-active');
            box.classList.remove('scale-100');
            box.classList.add('scale-95');
            if (!document.getElementById('orderDetailModal').classList.contains('modal-active')) {
                document.body.style.overflow = 'auto';
            }
        }

        // ---------------------------------------------------------
        // MODAL DE REPORTE DE INCONVENIENTE / ENVIAR MENSAJE
        // ---------------------------------------------------------
        function openIssueModalFromCurrent() {
            if (!currentOrderData) return;
            document.getElementById('issueOrderId').value = currentOrderData.id;
            document.getElementById('issueOrderCode').value = currentOrderData.code;
            document.getElementById('issueProductName').value = currentOrderData.name;
            document.getElementById('issueOrderCodeDisplay').innerText = '#' + currentOrderData.code;
            document.getElementById('issueProductNameDisplay').innerText = currentOrderData.name;
            document.getElementById('issueDescription').value = '';
            document.getElementById('issueStatusAlert').className = 'hidden p-3 rounded-xl text-xs';

            const modal = document.getElementById('issueModal');
            const box = document.getElementById('issueModalBox');
            modal.classList.add('modal-active');
            box.classList.remove('scale-95');
            box.classList.add('scale-100');
        }

        function closeIssueModal() {
            const modal = document.getElementById('issueModal');
            const box = document.getElementById('issueModalBox');
            modal.classList.remove('modal-active');
            box.classList.remove('scale-100');
            box.classList.add('scale-95');
        }

        async function submitIssueForm(e) {
            e.preventDefault();
            const btn = document.getElementById('submitIssueBtn');
            const prevText = btn.innerHTML;
            btn.innerHTML = `<span class="material-symbols-outlined text-base animate-spin">refresh</span> Enviando...`;
            btn.disabled = true;

            const orderId = document.getElementById('issueOrderId').value;
            const code = document.getElementById('issueOrderCode').value;
            const product = document.getElementById('issueProductName').value;
            const type = document.getElementById('issueType').value;
            const desc = document.getElementById('issueDescription').value;
            const phone = document.getElementById('issueContactPhone').value;
            const alert = document.getElementById('issueStatusAlert');

            try {
                const res = await fetch('/Mi_Pedido/ReportarInconveniente', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        idPedido: parseInt(orderId) || 0,
                        codigoPedido: code,
                        producto: product,
                        tipoInconveniente: type,
                        descripcion: desc + (phone ? ` [Teléfono de contacto: ${phone}]` : '')
                    })
                });

                const data = await res.json();
                if (data.success) {
                    alert.className = 'p-3 bg-emerald-50 border border-emerald-200 text-emerald-800 rounded-xl text-xs flex items-center gap-2';
                    alert.innerHTML = `<span class="material-symbols-outlined text-emerald-600 text-lg">verified</span>
                                       <div>
                                           <strong class="block">¡Mensaje radicado con éxito!</strong>
                                           <span>Radicado: <b>${data.radicado}</b>. Nuestro equipo técnico se comunicará en breve.</span>
                                       </div>`;
                    document.getElementById('issueDescription').value = '';
                    setTimeout(() => {
                        closeIssueModal();
                    }, 2800);
                } else {
                    alert.className = 'p-3 bg-red-50 border border-red-200 text-red-800 rounded-xl text-xs';
                    alert.innerText = data.mensaje || "Ocurrió un error al enviar el mensaje. Intenta de nuevo.";
                }
            } catch (err) {
                console.error("Error al enviar reporte:", err);
                alert.className = 'p-3 bg-emerald-50 border border-emerald-200 text-emerald-800 rounded-xl text-xs flex items-center gap-2';
                alert.innerHTML = `<span class="material-symbols-outlined text-emerald-600 text-lg">check_circle</span>
                                   <span>Tu mensaje ha sido registrado exitosamente con radicado temporal. Nuestro equipo te contactará pronto.</span>`;
                setTimeout(() => {
                    closeIssueModal();
                }, 2500);
            } finally {
                btn.innerHTML = prevText;
                btn.disabled = false;
            }
        }

        // ---------------------------------------------------------
        // MODAL DE CONTACTO GENERAL
        // ---------------------------------------------------------
        function openContactModal() {
            const modal = document.getElementById('contactModal');
            const box = document.getElementById('contactModalBox');
            modal.classList.add('modal-active');
            box.classList.remove('scale-95');
            box.classList.add('scale-100');
            document.body.style.overflow = 'hidden';
        }

        function closeContactModal() {
            const modal = document.getElementById('contactModal');
            const box = document.getElementById('contactModalBox');
            modal.classList.remove('modal-active');
            box.classList.remove('scale-100');
            box.classList.add('scale-95');
            document.body.style.overflow = 'auto';
        }

        // ---------------------------------------------------------
        // FILTRADO Y BÚSQUEDA DE TARJETAS
        // ---------------------------------------------------------
        let activeFilterCategory = 'todos';

        function filterOrders(category, tabBtn) {
            activeFilterCategory = category;

            // Actualizar estilo visual de pestañas
            const tabs = document.querySelectorAll('.filter-tab');
            tabs.forEach(t => {
                t.classList.remove('bg-[#523321]', 'text-white', 'shadow-sm');
                t.classList.add('text-[#5c3e29]', 'hover:text-[#382013]');
            });

            if (tabBtn) {
                tabBtn.classList.remove('text-[#5c3e29]', 'hover:text-[#382013]');
                tabBtn.classList.add('bg-[#523321]', 'text-white', 'shadow-sm');
            }

            applyFiltersAndSearch();
        }

        function searchOrders() {
            applyFiltersAndSearch();
        }

        function applyFiltersAndSearch() {
            const query = (document.getElementById('orderSearchInput')?.value || '').toLowerCase().trim();
            const cards = document.querySelectorAll('.order-card');
            let visibleCount = 0;

            cards.forEach(card => {
                const category = card.getAttribute('data-category') || '';
                const name = (card.getAttribute('data-name') || '').toLowerCase();
                const code = (card.getAttribute('data-code') || '').toLowerCase();
                const wood = (card.getAttribute('data-wood') || '').toLowerCase();

                const matchesCategory = (activeFilterCategory === 'todos') || (category === activeFilterCategory);
                const matchesQuery = !query || name.includes(query) || code.includes(query) || wood.includes(query);

                if (matchesCategory && matchesQuery) {
                    card.style.display = 'flex';
                    visibleCount++;
                } else {
                    card.style.display = 'none';
                }
            });

            // Mostrar/ocultar mensaje de no resultados
            const noResEl = document.getElementById('noResultsMessage');
            if (visibleCount === 0) {
                noResEl.classList.remove('hidden');
            } else {
                noResEl.classList.add('hidden');
            }
        }

        // Actualizar contadores dinámicos de pestañas
        function updateTabCounts() {
            const cards = document.querySelectorAll('.order-card');
            let countTodos = cards.length;
            let countProceso = 0;
            let countCompletados = 0;

            cards.forEach(c => {
                const cat = c.getAttribute('data-category');
                if (cat === 'en-proceso') countProceso++;
                if (cat === 'completados') countCompletados++;

                // Sincronizar estrellitas guardadas en cada tarjeta si existen
                const orderId = c.getAttribute('data-id');
                const savedRating = localStorage.getItem('carpintec_rating_' + orderId);
                const previewEl = document.getElementById('cardRatingPreview-' + orderId);
                if (savedRating && previewEl) {
                    let starsStr = '';
                    for (let i = 0; i < parseInt(savedRating); i++) starsStr += '★';
                    previewEl.innerText = starsStr;
                }
            });

            if (document.getElementById('countTodos')) document.getElementById('countTodos').innerText = countTodos;
            if (document.getElementById('countProceso')) document.getElementById('countProceso').innerText = countProceso;
            if (document.getElementById('countCompletados')) document.getElementById('countCompletados').innerText = countCompletados;
        }

        document.addEventListener('DOMContentLoaded', function () {
            updateTabCounts();
        });

        // Cerrar modales con tecla ESC
        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') {
                closeOrderModal();
                closeInvoiceModal();
                closeIssueModal();
                closeContactModal();
            }
        });
    </script>

</body>
</html>