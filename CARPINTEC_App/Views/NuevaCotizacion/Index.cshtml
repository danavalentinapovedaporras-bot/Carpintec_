    <script>
        // Precios base por tipo de madera
        function obtenerDatosMadera(clave) {
            switch ((clave || '').toLowerCase()) {
                case 'roble':
                    return { nombre: 'Roble Europeo', base: 500000 };
                case 'cedro':
                    return { nombre: 'Cedro Rojo Tradicional', base: 460000 };
                case 'nogal':
                    return { nombre: 'Nogal Americano Prémium', base: 580000 };
                case 'pino':
                default:
                    return { nombre: 'Pino Macizo - Acabado Natural', base: 320000 };
            }
        }

        // Recalcular costos, dimensiones y diagrama SVG
        function recalcularTotalNuevaCotizacion() {
            const alto = parseFloat(document.getElementById('nc-alto')?.value) || 80;
            const ancho = parseFloat(document.getElementById('nc-ancho')?.value) || 120;
            const prof = parseFloat(document.getElementById('nc-profundidad')?.value) || 60;
            const cantidad = Math.max(1, parseInt(document.getElementById('input-cantidad')?.value) || 1);

            // Actualizar etiquetas en el diagrama isométrico SVG
            const svgAncho = document.getElementById('svgTextAncho');
            if (svgAncho) svgAncho.textContent = `${ancho} cm`;

            const svgProf = document.getElementById('svgTextProfundidad');
            if (svgProf) svgProf.textContent = `${prof} cm`;

            const svgAlto = document.getElementById('svgTextAlto');
            if (svgAlto) svgAlto.textContent = `${alto} cm`;

            // Cálculo volumétrico
            const volBase = 120 * 80 * 60; // 576,000 cm3
            const volActual = ancho * alto * prof;
            let factorVolumen = volActual / volBase;
            factorVolumen = Math.max(0.65, Math.min(2.5, factorVolumen));

            // Tipo de madera
            const selectMadera = document.getElementById('wood-select');
            const claveMadera = selectMadera ? selectMadera.value : 'pino';
            const infoMadera = obtenerDatosMadera(claveMadera);

            // Costo de madera proporcional al volumen y cantidad
            const costoMaderaUnitario = Math.round(infoMadera.base * factorVolumen);
            const costoMaderaTotal = costoMaderaUnitario * cantidad;

            // Mano de obra proporcional
            const manoObraBase = 120000;
            const manoObraUnit = Math.round(manoObraBase * (factorVolumen > 1 ? (1 + (factorVolumen - 1) * 0.4) : 1));
            const manoObraTotal = manoObraUnit * cantidad;

            const subtotal = costoMaderaTotal + manoObraTotal;

            // Método de pago y descuento
            const radioTransfer = document.querySelector('input[name="payment_method"]:checked');
            const esTransferencia = radioTransfer ? (radioTransfer.value === 'transferencia') : true;

            let descuento = 0;
            if (esTransferencia) {
                descuento = Math.round(subtotal * 0.05);
            }

            const totalFinal = Math.max(50000, subtotal - descuento);

            // Formateador de moneda colombiana
            const fmt = (num) => '$' + Number(num).toLocaleString('es-CO');

            // Actualizar resumen visual
            const lblMaderaTexto = document.getElementById('summaryMaderaTexto');
            if (lblMaderaTexto) lblMaderaTexto.textContent = `Madera (${infoMadera.nombre}):`;

            const lblMaderaValor = document.getElementById('summaryMaderaValor');
            if (lblMaderaValor) lblMaderaValor.textContent = fmt(costoMaderaTotal);

            const lblManoObra = document.getElementById('summaryManoObra');
            if (lblManoObra) lblManoObra.textContent = fmt(manoObraTotal);

            const lblDescTexto = document.getElementById('summaryDescuentoTexto');
            const lblDescValor = document.getElementById('summaryDescuentoValor');
            const badgeDesc = document.getElementById('badgeDescuento');

            if (esTransferencia) {
                if (lblDescTexto) lblDescTexto.textContent = 'Descuento Transferencia (-5%):';
                if (lblDescValor) lblDescValor.textContent = '-' + fmt(descuento);
                if (badgeDesc) badgeDesc.classList.remove('hidden');
            } else {
                if (lblDescTexto) lblDescTexto.textContent = 'Descuento por método:';
                if (lblDescValor) lblDescValor.textContent = '$0';
                if (badgeDesc) badgeDesc.classList.add('hidden');
            }

            const lblTotal = document.getElementById('summaryTotalGrande');
            if (lblTotal) lblTotal.textContent = fmt(totalFinal);

            const badgePrecioMadera = document.getElementById('ncWoodPriceBadge');
            if (badgePrecioMadera) badgePrecioMadera.textContent = `Precio Base: ${fmt(infoMadera.base)} COP`;
        }

        // Selección rápida de producto sugerido
        function seleccionarSugerencia(nombre) {
            const inputProd = document.getElementById('product-name');
            if (inputProd) {
                inputProd.value = nombre;
                recalcularTotalNuevaCotizacion();
            }
        }

        // Incrementar o decrementar cantidad
        function cambiarCantidad(delta) {
            const input = document.getElementById('input-cantidad');
            if (!input) return;
            let actual = parseInt(input.value) || 1;
            actual = Math.max(1, actual + delta);
            input.value = actual;
            recalcularTotalNuevaCotizacion();
        }

        // Mostrar nombre del archivo subido en el dropzone
        function mostrarNombreArchivo(input) {
            if (input && input.files && input.files.length > 0) {
                const archivo = input.files[0];
                const dropTexto = document.getElementById('dropzone-texto');
                if (dropTexto) {
                    dropTexto.innerHTML = `<span class="text-emerald-700 font-bold">✓ Foto adjunta: ${archivo.name}</span>`;
                }
            }
        }

        // Enviar formulario al backend para crear Cotización y Pedido de forma inmediata
        async function enviarNuevaCotizacion() {
            const btn = document.getElementById('btnGenerarCotizacionOficial');
            const originalHtml = btn ? btn.innerHTML : '';

            try {
                const nombre = (document.getElementById('client-name')?.value || '').trim();
                const telefono = (document.getElementById('client-phone')?.value || '').trim();
                const correo = (document.getElementById('client-email')?.value || '').trim();
                const producto = (document.getElementById('product-name')?.value || '').trim();
                const estilo = document.getElementById('product-style')?.value || '';
                const maderaSelect = document.getElementById('wood-select');
                const maderaNombre = maderaSelect ? maderaSelect.options[maderaSelect.selectedIndex].text.split('(')[0].trim() : 'Pino Macizo';
                const cantidad = Math.max(1, parseInt(document.getElementById('input-cantidad')?.value) || 1);
                const alto = parseFloat(document.getElementById('nc-alto')?.value) || 80;
                const ancho = parseFloat(document.getElementById('nc-ancho')?.value) || 120;
                const profundidad = parseFloat(document.getElementById('nc-profundidad')?.value) || 60;
                const observaciones = document.getElementById('nc-observaciones')?.value || '';

                if (!producto) {
                    alert('Por favor especifica el nombre o tipo de producto a cotizar.');
                    document.getElementById('product-name')?.focus();
                    return;
                }

                // Obtener total final numérico
                const textoTotal = document.getElementById('summaryTotalGrande')?.textContent || '';
                const totalNumerico = parseInt(textoTotal.replace(/[^0-9]/g, '')) || 418000;

                // Feedback visual en el botón
                if (btn) {
                    btn.disabled = true;
                    btn.innerHTML = `
                        <svg class="animate-spin -ml-1 mr-2 h-5 w-5 text-white inline-block" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                        </svg>
                        Generando Cotización y Pedido...
                    `;
                }

                const formData = new FormData();
                formData.append('nombreCliente', nombre);
                formData.append('telefono', telefono);
                formData.append('correo', correo);
                formData.append('producto', estilo ? `${producto} (${estilo})` : producto);
                formData.append('madera', maderaNombre);
                formData.append('cantidad', cantidad);
                formData.append('alto', alto);
                formData.append('ancho', ancho);
                formData.append('profundidad', profundidad);
                formData.append('tiempoEntrega', '15 días hábiles');
                formData.append('observaciones', observaciones);
                formData.append('total', totalNumerico);

                const fileInput = document.getElementById('nc-foto-lugar');
                if (fileInput && fileInput.files && fileInput.files.length > 0) {
                    formData.append('fotoLugar', fileInput.files[0]);
                }

                const response = await fetch('/NuevaCotizacion/GuardarCotizacion', {
                    method: 'POST',
                    body: formData
                });

                const data = await response.json();

                if (data.success) {
                    const mensajeExito = `🎉 ¡Cotización y Pedido registrados exitosamente!\n\n` +
                        `• Folio Cotización: ${data.folioCotizacion || 'Generado'}\n` +
                        `• Código Pedido: ${data.codigoPedido || 'Generado'}\n\n` +
                        `• Pulsa ACEPTAR para ir a "Mis Pedidos" y ver el avance en tiempo real.\n` +
                        `• Pulsa CANCELAR para ir a "Mis Cotizaciones".`;

                    if (confirm(mensajeExito)) {
                        window.location.href = data.redirectUrl || '/Mi_Pedido';
                    } else {
                        window.location.href = '/MiCotizacion';
                    }
                } else {
                    alert('Error al guardar: ' + (data.message || 'Error desconocido'));
                    if (btn) {
                        btn.disabled = false;
                        btn.innerHTML = originalHtml;
                    }
                }
            } catch (err) {
                console.error('Error al enviar la cotización:', err);
                alert('Ocurrió un error al comunicar con el servidor. Por favor intenta de nuevo.');
                if (btn) {
                    btn.disabled = false;
                    btn.innerHTML = originalHtml;
                }
            }
        }

        // Inicializar cálculos al cargar la página
        document.addEventListener('DOMContentLoaded', () => {
            recalcularTotalNuevaCotizacion();
        });
    </script>
</body></html>