@{
    Layout = null;
}
<!DOCTYPE html>

<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>Carpintec - Nueva Cotización</title>
    <!-- Google Fonts: Montserrat -->
    <link href="https://fonts.googleapis.com" rel="preconnect" />
    <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect" />
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&amp;display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
    <!-- Tailwind CSS v3 with Forms & Container Plugins -->
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script>
            tailwind.config = {
                theme: {
                    extend: {
                        colors: {
                            timber: {
                                50: '#FAF6F0',
                                100: '#F4ECE1',
                                200: '#E6D7C3',
                                300: '#D5BEA2',
                                400: '#BA9B7B',
                                500: '#9C7A59',
                                600: '#7E5F43',
                                700: '#644A34',
                                800: '#4D3827',
                                900: '#34261B',
                                950: '#231810'
                            },
                            wood: {
                                light: '#f5ebe6',
                                accent: '#8b4513',
                                dark: '#5c2c16',
                                surface: '#FFFBF7',
                                border: '#E8DDD5'
                            }
                        },
                        fontFamily: {
                            sans: ['Montserrat', 'sans-serif'],
                        }
                    }
                }
            }
    </script>
    <style data-purpose="custom-utilities">
            body {
                font-family: 'Montserrat', sans-serif;
                background-color: #F8F5F1;
                color: #34261B;
            }

            input[type=number]::-webkit-inner-spin-button,
            input[type=number]::-webkit-outer-spin-button {
                -webkit-appearance: none;
                margin: 0;
            }

            .custom-scroll::-webkit-scrollbar {
                width: 6px;
            }

            .custom-scroll::-webkit-scrollbar-thumb {
                background: #D5BEA2;
                border-radius: 4px;
            }
    </style>
</head>
<body class="min-h-screen bg-[#FAF7F2] text-timber-900 antialiased flex flex-col">
    <!-- BEGIN: MainHeader -->
    <header class="bg-[#FFFDFB] border-b border-[#EAE3DA] sticky top-0 z-50 shadow-sm" data-purpose="site-navigation-header">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
            <!-- Brand Logo & Identity -->
            <div class="flex items-center gap-3">
                <div class="w-12 h-12 rounded-xl overflow-hidden shadow-inner bg-[#4A2613] p-1 flex items-center justify-center border border-[#7E5F43]">
    <img alt="Carpintec Logo"
                     class="h-8 w-8 object-contain mr-2"
                     src="~/images/logo.png">                </div>
                <div>
                    <span class="text-2xl font-bold tracking-tight text-[#4A2613] uppercase flex items-center gap-1">
                        Carpintec
                        <span class="w-2 h-2 rounded-full bg-[#BA7039] inline-block"></span>
                    </span>
                    <span class="text-[10px] tracking-widest text-[#8A7160] uppercase block font-semibold">Muebles &amp; Madera Fina</span>
                </div>
            </div>
            <!-- Navigation Links -->
            <nav class="hidden md:flex items-center space-x-6 text-sm font-medium" data-purpose="main-nav">
                <a class="text-[#7E5F43] hover:text-[#4A2613] transition-colors py-1" href="/DashboardCliente">Inicio</a>
                <a class="text-[#7E5F43] hover:text-[#4A2613] transition-colors py-1" href="/MisProductos">Catálogo</a>
                <a class="text-[#7E5F43] hover:text-[#4A2613] transition-colors py-1" href="/MiCotizacion">Mis Cotizaciones</a>
                <a class="text-[#7E5F43] hover:text-[#4A2613] transition-colors py-1" href="/Mi_Pedido">Mis Pedidos</a>
                <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-[#F0E6DA] text-[#6E4B31] border border-[#E0D0C0]">
                    Cotizador Online
                </span>
            </nav>
            <!-- Customer Profile Quick Access -->
            <div class="flex items-center gap-3.5 pl-4 border-l border-[#EAE3DA] text-[#34261B]" data-purpose="user-profile-badge">
                @await Html.PartialAsync("_ClientUserMenu")
            </div>
        </div>
    </header>
    <!-- END: MainHeader -->
    <!-- BEGIN: QuotationHeroSection -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-7 pb-4 w-full" data-purpose="quotation-overview-header">
        <div class="bg-gradient-to-r from-[#FFFDFB] via-[#FCFAF7] to-[#F7EFE7] rounded-2xl p-6 sm:p-7 border border-[#E5DACD] shadow-sm flex flex-col md:flex-row md:items-center justify-between gap-6">
            <div>
                <div class="inline-flex items-center gap-2 mb-1.5">
                    <span class="text-xs font-semibold uppercase tracking-wider text-[#9C6D45] bg-[#F2E5D7] px-2.5 py-0.5 rounded">Taller Digital</span>
                    <span class="text-xs text-[#8A7869]">• Proforma Técnica</span>
                </div>
                <h1 class="text-2xl sm:text-3xl font-bold text-[#2E1F14] tracking-tight flex items-center gap-2">
                    NUEVA <span class="text-[#9C5A2A] font-extrabold">COTIZACIÓN</span>
                </h1>
                <p class="text-sm text-[#745E4D] mt-1">Define los detalles técnicos para tu pieza personalizada con materiales certificados.</p>
            </div>
            <div class="flex flex-wrap items-center gap-3">
                <!-- Cotización Badge -->
                <div class="bg-white/90 backdrop-blur px-4 py-2.5 rounded-xl border border-[#DECDBE] text-center shadow-xs">
                    <span class="text-[10px] font-bold tracking-wider text-[#8A7566] uppercase block">Folio</span>
                    <span class="text-sm font-bold text-[#422B1D] font-mono tracking-wide">COT-2024-045</span>
                </div>
                <!-- Fecha Badge -->
                <div class="bg-white/90 backdrop-blur px-4 py-2.5 rounded-xl border border-[#DECDBE] text-center shadow-xs">
                    <span class="text-[10px] font-bold tracking-wider text-[#8A7566] uppercase block">Fecha Emisión</span>
                    <span class="text-sm font-bold text-[#422B1D]">20 MAY 2024</span>
                </div>
            </div>
        </div>
    </section>
    <!-- END: QuotationHeroSection -->
    <!-- BEGIN: MainContentGrid -->
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-16 w-full flex-1">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
            <!-- LEFT COLUMN: Form Inputs (8 Cols) -->
            <div class="lg:col-span-8 space-y-7" data-purpose="form-main-column">
                <!-- SECTION 1: Client Information -->
                <section class="bg-[#FFFDFB] rounded-2xl border border-[#E7DCCE] p-6 shadow-sm" data-purpose="client-info-section">
                    <div class="flex items-center gap-2.5 pb-4 mb-5 border-b border-[#F0E6DB]">
                        <span class="w-7 h-7 rounded-lg bg-[#EFE4D6] text-[#7A4B29] flex items-center justify-center font-bold text-xs">01</span>
                        <h2 class="text-sm font-bold uppercase tracking-wider text-[#4A3222]">Información del Cliente</h2>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                        <!-- Full Name -->
                        <div>
                            <label class="block text-xs font-semibold text-[#6C5645] mb-1.5" for="client-name">Nombre del Cliente</label>
                            <div class="relative rounded-lg shadow-xs">
                                <input class="w-full text-xs font-medium text-[#2E1F14] bg-[#FAF7F2] border border-[#D9CABA] rounded-lg px-3.5 py-2.5 focus:bg-white focus:border-[#9C5A2A] focus:ring-1 focus:ring-[#9C5A2A] transition-all" id="client-name" placeholder="Escribe el nombre completo" type="text" value="@(ViewBag.NombreCliente ?? "")" />
                            </div>
                        </div>
                        <!-- Phone -->
                        <div>
                            <label class="block text-xs font-semibold text-[#6C5645] mb-1.5" for="client-phone">Teléfono Móvil</label>
                            <div class="relative rounded-lg shadow-xs">
                                <input class="w-full text-xs font-medium text-[#2E1F14] bg-[#FAF7F2] border border-[#D9CABA] rounded-lg px-3.5 py-2.5 focus:bg-white focus:border-[#9C5A2A] focus:ring-1 focus:ring-[#9C5A2A] transition-all" id="client-phone" placeholder="Ej. 300 000 0000" type="text" value="@(ViewBag.TelefonoCliente ?? "")" />
                            </div>
                        </div>
                        <!-- Email -->
                        <div>
                            <label class="block text-xs font-semibold text-[#6C5645] mb-1.5" for="client-email">Correo Electrónico</label>
                            <div class="relative rounded-lg shadow-xs">
                                <input class="w-full text-xs font-medium text-[#2E1F14] bg-[#FAF7F2] border border-[#D9CABA] rounded-lg px-3.5 py-2.5 focus:bg-white focus:border-[#9C5A2A] focus:ring-1 focus:ring-[#9C5A2A] transition-all" id="client-email" placeholder="correo@ejemplo.com" type="email" value="@(ViewBag.CorreoCliente ?? "")" />
                            </div>
                        </div>
                    </div>
                </section>
                <!-- SECTION 2: Product and Material Selection -->
                <section class="bg-[#FFFDFB] rounded-2xl border border-[#E7DCCE] p-6 shadow-sm" data-purpose="product-material-section">
                    <div class="flex items-center gap-2.5 pb-4 mb-5 border-b border-[#F0E6DB]">
                        <span class="w-7 h-7 rounded-lg bg-[#EFE4D6] text-[#7A4B29] flex items-center justify-center font-bold text-xs">02</span>
                        <h2 class="text-sm font-bold uppercase tracking-wider text-[#4A3222]">Detalles del Producto y Material</h2>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-12 gap-5">
                        <!-- Product Item -->
                        <div class="md:col-span-7">
                            <label class="block text-xs font-semibold text-[#6C5645] mb-1.5" for="product-name">Escribe o selecciona un Producto</label>
                            <div class="relative">
                                <input class="w-full text-xs font-semibold text-[#2E1F14] bg-[#FAF7F2] border border-[#D9CABA] rounded-lg px-3.5 py-2.5 focus:bg-white focus:border-[#9C5A2A] focus:ring-1 focus:ring-[#9C5A2A] transition-all" id="product-name" placeholder="Ej. Mesa de Comedor, Estantería, etc." type="text" value="Mesa de Comedor Artesanal" />
                                <div class="mt-2 flex flex-wrap gap-1.5">
                                    <span class="text-[10px] text-[#8C7564]">Sugerencias:</span>
                                    <button class="text-[10px] bg-[#EFE3D5] hover:bg-[#E2D2C2] text-[#5C3821] px-2 py-0.5 rounded transition" type="button" onclick="seleccionarSugerencia('Mesa Auxiliar')">Mesa Auxiliar</button>
                                    <button class="text-[10px] bg-[#EFE3D5] hover:bg-[#E2D2C2] text-[#5C3821] px-2 py-0.5 rounded transition" type="button" onclick="seleccionarSugerencia('Escritorio Nórdico')">Escritorio Nórdico</button>
                                    <button class="text-[10px] bg-[#EFE3D5] hover:bg-[#E2D2C2] text-[#5C3821] px-2 py-0.5 rounded transition" type="button" onclick="seleccionarSugerencia('Mueble TV')">Mueble TV</button>
                                </div>
                            </div>
                        </div>
                        <!-- Style Selector -->
                        <div class="md:col-span-5">
                            <label class="block text-xs font-semibold text-[#6C5645] mb-1.5" for="product-style">
                                Estilo de Diseño: <span class="text-[#9C5A2A] font-bold">Rústico Moderno</span>
                            </label>
                            <select class="w-full text-xs font-medium text-[#2E1F14] bg-[#FAF7F2] border border-[#D9CABA] rounded-lg px-3.5 py-2.5 focus:bg-white focus:border-[#9C5A2A] focus:ring-1 focus:ring-[#9C5A2A]" id="product-style">
                                <option selected="">Rústico Moderno</option>
                                <option>Industrial Minimalista</option>
                                <option>Nórdico Escandinavo</option>
                                <option>Clásico Colonial</option>
                            </select>
                        </div>
                        <!-- Wood Type -->
                        <div class="md:col-span-7">
                            <div class="flex items-center justify-between mb-1.5">
                                <label class="block text-xs font-semibold text-[#6C5645]" for="wood-select">Tipo de Madera</label>
                                <span id="ncWoodPriceBadge" class="text-xs font-bold text-[#8C5229] bg-[#F7ECE1] px-2 py-0.5 rounded border border-[#DEC9B7]">
                                    Precio Base: $320.000 COP
                                </span>
                            </div>
                            <select class="w-full text-xs font-medium text-[#2E1F14] bg-[#FAF7F2] border border-[#D9CABA] rounded-lg px-3.5 py-2.5 focus:bg-white focus:border-[#9C5A2A] focus:ring-1 focus:ring-[#9C5A2A]" id="wood-select" onchange="recalcularTotalNuevaCotizacion()">
                                <option selected="" value="pino">Pino Macizo - Acabado Natural ($320.000)</option>
                                <option value="roble">Roble Europeo (+ $180.000)</option>
                                <option value="cedro">Cedro Rojo Tradicional (+ $140.000)</option>
                                <option value="nogal">Nogal Americano Prémium (+ $260.000)</option>
                            </select>
                        </div>
                        <!-- Quantity with Stepper -->
                        <div class="md:col-span-5">
                            <label class="block text-xs font-semibold text-[#6C5645] mb-1.5">Cantidad</label>
                            <div class="flex items-center bg-[#FAF7F2] border border-[#D9CABA] rounded-lg p-1">
                                <button class="w-8 h-8 rounded bg-white shadow-xs text-[#5C3821] hover:bg-[#EFE4D6] font-bold text-sm flex items-center justify-center transition" type="button" onclick="cambiarCantidad(-1)">−</button>
                                <input id="input-cantidad" class="w-full text-center border-0 bg-transparent text-sm font-bold text-[#34261B] focus:ring-0" min="1" type="number" value="1" oninput="recalcularTotalNuevaCotizacion()" />
                                <button class="w-8 h-8 rounded bg-white shadow-xs text-[#5C3821] hover:bg-[#EFE4D6] font-bold text-sm flex items-center justify-center transition" type="button" onclick="cambiarCantidad(1)">+</button>
                            </div>
                        </div>
                    </div>
                </section>
                <!-- SECTION 3: Dimensions & Technical Isometric Graphic -->
                <section class="bg-[#FFFDFB] rounded-2xl border border-[#E7DCCE] p-6 shadow-sm" data-purpose="dimensions-section">
                    <div class="flex items-center justify-between pb-4 mb-5 border-b border-[#F0E6DB]">
                        <div class="flex items-center gap-2.5">
                            <span class="w-7 h-7 rounded-lg bg-[#EFE4D6] text-[#7A4B29] flex items-center justify-center font-bold text-xs">03</span>
                            <div>
                                <h2 class="text-sm font-bold uppercase tracking-wider text-[#4A3222]">Medidas Técnicas (cm)</h2>
                                <p class="text-[11px] text-[#8C7665]">Ingresa las cotas exactas en centímetros para el cálculo volumétrico</p>
                            </div>
                        </div>
                        <span class="hidden sm:inline-block text-[11px] bg-[#EFE6DB] text-[#69482F] px-2.5 py-1 rounded-md font-medium border border-[#DECFBD]">
                            Escala 1:1
                        </span>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-12 gap-6 items-center">
                        <!-- Numerical Inputs (3 Axis) -->
                        <div class="md:col-span-7 space-y-3.5">
                            <!-- Alto -->
                            <div class="bg-[#FAF7F2] p-3 rounded-xl border border-[#E5DACD] flex items-center justify-between gap-3">
                                <div class="flex items-center gap-2">
                                    <span class="text-xs font-bold text-[#9C5A2A] bg-[#EFE1D2] w-6 h-6 rounded flex items-center justify-center">▲</span>
                                    <span class="text-xs font-semibold text-[#543D2D] uppercase tracking-wide">Alto</span>
                                </div>
                                <div class="flex items-center gap-2">
                                    <input id="nc-alto" oninput="recalcularTotalNuevaCotizacion()" class="w-20 text-center font-bold text-sm bg-white border border-[#CFBEAE] rounded-lg py-1.5 text-[#34261B] focus:border-[#9C5A2A] focus:ring-1 focus:ring-[#9C5A2A]" type="number" value="80" />
                                    <span class="text-xs font-semibold text-[#7E6654]">cm</span>
                                </div>
                            </div>
                            <!-- Ancho -->
                            <div class="bg-[#FAF7F2] p-3 rounded-xl border border-[#E5DACD] flex items-center justify-between gap-3">
                                <div class="flex items-center gap-2">
                                    <span class="text-xs font-bold text-[#9C5A2A] bg-[#EFE1D2] w-6 h-6 rounded flex items-center justify-center">►</span>
                                    <span class="text-xs font-semibold text-[#543D2D] uppercase tracking-wide">Ancho</span>
                                </div>
                                <div class="flex items-center gap-2">
                                    <input id="nc-ancho" oninput="recalcularTotalNuevaCotizacion()" class="w-20 text-center font-bold text-sm bg-white border border-[#CFBEAE] rounded-lg py-1.5 text-[#34261B] focus:border-[#9C5A2A] focus:ring-1 focus:ring-[#9C5A2A]" type="number" value="120" />
                                    <span class="text-xs font-semibold text-[#7E6654]">cm</span>
                                </div>
                            </div>
                            <!-- Profundidad -->
                            <div class="bg-[#FAF7F2] p-3 rounded-xl border border-[#E5DACD] flex items-center justify-between gap-3">
                                <div class="flex items-center gap-2">
                                    <span class="text-xs font-bold text-[#9C5A2A] bg-[#EFE1D2] w-6 h-6 rounded flex items-center justify-center">↗</span>
                                    <span class="text-xs font-semibold text-[#543D2D] uppercase tracking-wide">Profundidad</span>
                                </div>
                                <div class="flex items-center gap-2">
                                    <input id="nc-profundidad" oninput="recalcularTotalNuevaCotizacion()" class="w-20 text-center font-bold text-sm bg-white border border-[#CFBEAE] rounded-lg py-1.5 text-[#34261B] focus:border-[#9C5A2A] focus:ring-1 focus:ring-[#9C5A2A]" type="number" value="60" />
                                    <span class="text-xs font-semibold text-[#7E6654]">cm</span>
                                </div>
                            </div>
                        </div>
                        <!-- Technical Graphic / Isomeric Table Diagram -->
                        <div class="md:col-span-5 bg-gradient-to-b from-[#F7EFE6] to-[#EFE2D3] border border-dashed border-[#CBB39C] rounded-xl p-4 flex flex-col items-center justify-center relative overflow-hidden min-h-[170px]" data-purpose="isometric-table-graphic">
                            <span class="text-[10px] font-bold text-[#7A5338] uppercase tracking-wider mb-2">Esquema Técnico 3D</span>
                            <!-- SVG Isometric Furniture Diagram -->
                            <svg class="w-48 h-auto drop-shadow-sm" fill="none" viewbox="0 0 200 130" xmlns="http://www.w3.org/2000/svg">
                                <!-- Top Table Board -->
                                <polygon fill="#C99F77" points="100,18 165,48 100,75 35,48" stroke="#7A4C27" stroke-width="1.8"></polygon>
                                <polygon fill="#9F734F" points="35,48 100,75 100,82 35,55" stroke="#7A4C27" stroke-width="1.8"></polygon>
                                <polygon fill="#7A4C27" points="100,75 165,48 165,55 100,82" stroke="#7A4C27" stroke-width="1.8"></polygon>
                                <!-- Front Left Leg -->
                                <rect fill="#8B5731" height="55" rx="1" stroke="#5E381C" stroke-width="1.2" width="8" x="42" y="55"></rect>
                                <!-- Front Center/Right Leg -->
                                <rect fill="#784521" height="38" rx="1" stroke="#5E381C" stroke-width="1.2" width="8" x="96" y="80"></rect>
                                <!-- Far Right Leg -->
                                <rect fill="#8B5731" height="52" rx="1" stroke="#5E381C" stroke-width="1.2" width="7" x="153" y="53"></rect>
                                <!-- Far Left/Back Leg -->
                                <rect fill="#6A3B1B" height="42" opacity="0.4" rx="1" stroke="#482711" stroke-width="1.2" width="6" x="96" y="30"></rect>
                                <!-- Dimension Lines -->
                                <!-- Ancho (Width) -->
                                <line stroke="#8C4412" stroke-dasharray="2 2" stroke-width="1.2" x1="30" x2="95" y1="44" y2="14"></line>
                                <text id="svgTextAncho" fill="#8C4412" font-size="8" font-weight="700" x="50" y="24">120 cm</text>
                                <!-- Profundidad (Depth) -->
                                <line stroke="#8C4412" stroke-dasharray="2 2" stroke-width="1.2" x1="105" x2="170" y1="14" y2="44"></line>
                                <text id="svgTextProfundidad" fill="#8C4412" font-size="8" font-weight="700" x="142" y="24">60 cm</text>
                                <!-- Alto (Height) -->
                                <line stroke="#8C4412" stroke-dasharray="2 2" stroke-width="1.2" x1="28" x2="28" y1="52" y2="110"></line>
                                <text id="svgTextAlto" fill="#8C4412" font-size="8" font-weight="700" x="10" y="85">80 cm</text>
                            </svg>
                            <div class="text-[10px] text-[#7A5B44] text-center mt-2 font-medium">
                                Visualización dimensional aproximada
                            </div>
                        </div>
                    </div>
                </section>
                <!-- SECTION 4: Observations & Notes -->
                <section class="bg-[#FFFDFB] rounded-2xl border border-[#E7DCCE] p-6 shadow-sm" data-purpose="observations-section">
                    <div class="flex items-center gap-2.5 pb-4 mb-4 border-b border-[#F0E6DB]">
                        <span class="w-7 h-7 rounded-lg bg-[#EFE4D6] text-[#7A4B29] flex items-center justify-center font-bold text-xs">04</span>
                        <h2 class="text-sm font-bold uppercase tracking-wider text-[#4A3222]">Observaciones y Especificaciones</h2>
                    </div>
                    <div>
                        <textarea id="nc-observaciones" class="w-full text-xs text-[#2E1F14] bg-[#FAF7F2] border border-[#D9CABA] rounded-xl p-3.5 focus:bg-white focus:border-[#9C5A2A] focus:ring-1 focus:ring-[#9C5A2A] placeholder-[#9E8B7C] transition-all" placeholder="Indica detalles de esquinas redondeadas, perforaciones para cables, tono de barniz mate/satinado o requisitos particulares para el ensamble..." rows="3">Deseo los bordes superiores suavemente biselados con acabado poliuretano semi-mate resistente a la humedad.</textarea>
                    </div>
                </section>
                <!-- SECTION 5: Payment Methods Selection -->
                <section class="bg-[#FFFDFB] rounded-2xl border border-[#E7DCCE] p-6 shadow-sm" data-purpose="payment-methods-section">
                    <div class="flex items-center gap-2.5 pb-4 mb-4 border-b border-[#F0E6DB]">
                        <span class="w-7 h-7 rounded-lg bg-[#EFE4D6] text-[#7A4B29] flex items-center justify-center font-bold text-xs">05</span>
                        <h2 class="text-sm font-bold uppercase tracking-wider text-[#4A3222]">Método de Pago Preferido</h2>
                    </div>
