    <script>
        // Precios base por tipo de madera
        function obtenerDatosMadera(clave) {
            switch ((clave || '').toLowerCase()) {
                case 'roble':
                    return { nombre: 'Roble Europeo', base: 500000 };
                case 'cedro':
                    return { nombre: 'Cedro Rojo Tradicional', base: 460000 };
                case 'nogal':
                    return { nombre: 'Nogal Americano Prémium', base: 580000 };
                case 'pino':
                default:
                    return { nombre: 'Pino Macizo - Acabado Natural', base: 320000 };
            }
        }

        // Recalcular costos, dimensiones y diagrama SVG
        function recalcularTotalNuevaCotizacion() {
            const alto = parseFloat(document.getElementById('nc-alto')?.value) || 80;
            const ancho = parseFloat(document.getElementById('nc-ancho')?.value) || 120;
            const prof = parseFloat(document.getElementById('nc-profundidad')?.value) || 60;
            const cantidad = Math.max(1, parseInt(document.getElementById('input-cantidad')?.value) || 1);

            // Actualizar etiquetas en el diagrama isométrico SVG
            const svgAncho = document.getElementById('svgTextAncho');
            if (svgAncho) svgAncho.textContent = `${ancho} cm`;

            const svgProf = document.getElementById('svgTextProfundidad');
            if (svgProf) svgProf.textContent = `${prof} cm`;

            const svgAlto = document.getElementById('svgTextAlto');
            if (svgAlto) svgAlto.textContent = `${alto} cm`;

            // Cálculo volumétrico
            const volBase = 120 * 80 * 60; // 576,000 cm3
            const volActual = ancho * alto * prof;
            let factorVolumen = volActual / volBase;
            factorVolumen = Math.max(0.65, Math.min(2.5, factorVolumen));

            // Tipo de madera
            const selectMadera = document.getElementById('wood-select');
            const claveMadera = selectMadera ? selectMadera.value : 'pino';
            const infoMadera = obtenerDatosMadera(claveMadera);

            // Costo de madera proporcional al volumen y cantidad
            const costoMaderaUnitario = Math.round(infoMadera.base * factorVolumen);
            const costoMaderaTotal = costoMaderaUnitario * cantidad;

            // Mano de obra proporcional
            const manoObraBase = 120000;
            const manoObraUnit = Math.round(manoObraBase * (factorVolumen > 1 ? (1 + (factorVolumen - 1) * 0.4) : 1));
            const manoObraTotal = manoObraUnit * cantidad;

            const subtotal = costoMaderaTotal + manoObraTotal;

            // Método de pago y descuento
            const radioTransfer = document.querySelector('input[name="payment_method"]:checked');
            const esTransferencia = radioTransfer ? (radioTransfer.value === 'transferencia') : true;

            let descuento = 0;
            if (esTransferencia) {
                descuento = Math.round(subtotal * 0.05);
            }

            const totalFinal = Math.max(50000, subtotal - descuento);

            // Formateador de moneda colombiana
            const fmt = (num) => '$' + Number(num).toLocaleString('es-CO');

            // Actualizar resumen visual
            const lblMaderaTexto = document.getElementById('summaryMaderaTexto');
            if (lblMaderaTexto) lblMaderaTexto.textContent = `Madera (${infoMadera.nombre}):`;

            const lblMaderaValor = document.getElementById('summaryMaderaValor');
            if (lblMaderaValor) lblMaderaValor.textContent = fmt(costoMaderaTotal);

            const lblManoObra = document.getElementById('summaryManoObra');
            if (lblManoObra) lblManoObra.textContent = fmt(manoObraTotal);

            const lblDescTexto = document.getElementById('summaryDescuentoTexto');
            const lblDescValor = document.getElementById('summaryDescuentoValor');
            const badgeDesc = document.getElementById('badgeDescuento');

            if (esTransferencia) {
                if (lblDescTexto) lblDescTexto.textContent = 'Descuento Transferencia (-5%):';
                if (lblDescValor) lblDescValor.textContent = '-' + fmt(descuento);
                if (badgeDesc) badgeDesc.classList.remove('hidden');
            } else {
                if (lblDescTexto) lblDescTexto.textContent = 'Descuento por método:';
                if (lblDescValor) lblDescValor.textContent = '$0';
                if (badgeDesc) badgeDesc.classList.add('hidden');
            }

            const lblTotal = document.getElementById('summaryTotalGrande');
            if (lblTotal) lblTotal.textContent = fmt(totalFinal);

            const badgePrecioMadera = document.getElementById('ncWoodPriceBadge');
            if (badgePrecioMadera) badgePrecioMadera.textContent = `Precio Base: ${fmt(infoMadera.base)} COP`;
        }

        // Selección rápida de producto sugerido
        function seleccionarSugerencia(nombre) {
            const inputProd = document.getElementById('product-name');
            if (inputProd) {
                inputProd.value = nombre;
                recalcularTotalNuevaCotizacion();
            }
        }

        // Incrementar o decrementar cantidad
        function cambiarCantidad(delta) {
            const input = document.getElementById('input-cantidad');
            if (!input) return;
            let actual = parseInt(input.value) || 1;
            actual = Math.max(1, actual + delta);
            input.value = actual;
            recalcularTotalNuevaCotizacion();
        }

        // Mostrar nombre del archivo subido en el dropzone
        function mostrarNombreArchivo(input) {
            if (input && input.files && input.files.length > 0) {
                const archivo = input.files[0];
                const dropTexto = document.getElementById('dropzone-texto');
                if (dropTexto) {
                    dropTexto.innerHTML = `<span class="text-emerald-700 font-bold">✓ Foto adjunta: ${archivo.name}</span>`;
                }
            }
        }

        // ==========================================
        // CONTROL DEL SIMULADOR DE PAGO
        // Si no se confirma el pago, NUNCA se llama al servidor
        // por lo que NO se crea ningún pedido ni cotización.
        // ==========================================
        function abrirSimuladorPagoNuevaCotizacion() {
            const producto = (document.getElementById('product-name')?.value || '').trim();
            const nombre = (document.getElementById('client-name')?.value || '').trim();

            if (!producto) {
                alert('Por favor especifica el nombre o tipo de producto a cotizar.');
                document.getElementById('product-name')?.focus();
                return;
            }

            if (!nombre) {
                alert('Por favor escribe el nombre del cliente.');
                document.getElementById('client-name')?.focus();
                return;
            }

            // Datos para el resumen en el modal
            const estilo = document.getElementById('product-style')?.value || '';
            const maderaSelect = document.getElementById('wood-select');
            const maderaNombre = maderaSelect ? maderaSelect.options[maderaSelect.selectedIndex].text.split('(')[0].trim() : 'Pino Macizo';
            const cantidad = Math.max(1, parseInt(document.getElementById('input-cantidad')?.value) || 1);
            const alto = parseFloat(document.getElementById('nc-alto')?.value) || 80;
            const ancho = parseFloat(document.getElementById('nc-ancho')?.value) || 120;
            const prof = parseFloat(document.getElementById('nc-profundidad')?.value) || 60;
            const totalTexto = document.getElementById('summaryTotalGrande')?.textContent || '$418.000';

            const elProd = document.getElementById('simProductoNombre');
            if (elProd) elProd.textContent = estilo ? `${producto} (${estilo})` : producto;

            const elDet = document.getElementById('simProductoDetalles');
            if (elDet) elDet.textContent = `${maderaNombre} • ${ancho} x ${alto} x ${prof} cm • ${cantidad} unidad(es)`;

            // Actualizar costos de envío y total
            actualizarCostoEnvioSimulador();
            cambiarMetodoPagoSimulador('tarjeta');

            // Pre-rellenar datos del cliente desde el formulario principal
            preLlenarDatosCliente();

            // Resetear overlays y cuotas a Contado
            resetSimuladorPago();
            const radioContado = document.querySelector('input[name="simTipoPago"][value="Contado"]');
            if (radioContado) radioContado.checked = true;
            toggleSimCuotas(false);

            // Mostrar modal con animación fluida
            const modal = document.getElementById('modalSimuladorPago');
            const card = document.getElementById('modalSimuladorPagoCard');
            if (modal && card) {
                modal.classList.remove('hidden');
                document.body.style.overflow = 'hidden';
                requestAnimationFrame(() => {
                    card.classList.remove('scale-95', 'opacity-0');
                    card.classList.add('scale-100', 'opacity-100');
                });
            }
        }

        let metodoPagoActivo = 'tarjeta';

        function cambiarMetodoPagoSimulador(metodo) {
            metodoPagoActivo = metodo;
            const metodos = ['tarjeta', 'pse', 'nequi', 'efectivo'];
            metodos.forEach(m => {
                const panel = document.getElementById('panelMetodo' + m.charAt(0).toUpperCase() + m.slice(1));
                const btn = document.getElementById('tabBtn' + m.charAt(0).toUpperCase() + m.slice(1));
                if (panel) {
                    if (m === metodo) panel.classList.remove('hidden');
                    else panel.classList.add('hidden');
                }
                if (btn) {
                    if (m === metodo) {
                        btn.className = 'metodo-tab-btn py-2.5 px-3 rounded-xl border-2 border-[#8B4513] bg-[#FAF3EC] text-[#34261B] font-bold text-xs flex flex-col items-center gap-1 transition-all';
                    } else {
                        btn.className = 'metodo-tab-btn py-2.5 px-3 rounded-xl border-2 border-[#E8DDD5] bg-white text-gray-600 font-semibold text-xs flex flex-col items-center gap-1 hover:border-[#8B4513] transition-all';
                    }
                }
            });

            // Mostrar/ocultar sección de número de cuenta según el método
            const seccionCuenta = document.getElementById('seccionNumeroCuenta');
            const labelCuenta = document.getElementById('labelNumeroCuenta');
            const textoCuenta = document.getElementById('textoCuentaAyuda');
            const tipoCuenta = document.getElementById('tipoCuentaSelect');
            if (seccionCuenta) {
                if (metodo === 'pse') {
                    seccionCuenta.classList.remove('hidden');
                    if (labelCuenta) labelCuenta.textContent = 'Número de cuenta bancaria (PSE) *';
                    if (tipoCuenta) tipoCuenta.classList.remove('hidden');
                    if (textoCuenta) textoCuenta.textContent = 'Ingresa el número de tu cuenta registrada en el banco seleccionado para débito PSE.';
                } else if (metodo === 'nequi') {
                    seccionCuenta.classList.remove('hidden');
                    if (labelCuenta) labelCuenta.textContent = 'Número de celular Nequi (10 dígitos) *';
                    if (tipoCuenta) tipoCuenta.classList.add('hidden');
                    if (textoCuenta) textoCuenta.textContent = 'Número de celular registrado en tu cuenta Nequi.';
                } else {
                    seccionCuenta.classList.add('hidden');
                }
            }

            // Actualizar label del total en efectivo
            if (metodo === 'efectivo') {
                const totalEl = document.getElementById('simTotalDisplay');
                const efectivoLabel = document.getElementById('efectivoTotalLabel');
                if (efectivoLabel && totalEl) efectivoLabel.textContent = totalEl.textContent + ' COP';
            }
        }

        // Pre-rellenar datos del cliente en el modal desde el formulario principal
        function preLlenarDatosCliente() {
            const nombrePrincipal = document.getElementById('client-name')?.value || '';
            const correoPrincipal = document.getElementById('client-email')?.value || '';
            const telPrincipal = document.getElementById('client-phone')?.value || '';
            const docPrincipal = document.getElementById('client-doc')?.value || '';
            if (nombrePrincipal && document.getElementById('cliente-nombre'))
                document.getElementById('cliente-nombre').value = nombrePrincipal;
            if (correoPrincipal && document.getElementById('cliente-correo'))
                document.getElementById('cliente-correo').value = correoPrincipal;
            if (telPrincipal && document.getElementById('cliente-telefono'))
                document.getElementById('cliente-telefono').value = telPrincipal;
            if (docPrincipal && document.getElementById('cliente-documento'))
                document.getElementById('cliente-documento').value = docPrincipal;
        }


        function actualizarCostoEnvioSimulador() {
            const selCiudad = document.getElementById('simCiudad');
            const optSel = selCiudad ? selCiudad.options[selCiudad.selectedIndex] : null;
            const costoEnvio = parseInt(optSel?.getAttribute('data-costo') || '35000') || 0;

            const textoSubtotal = document.getElementById('summaryTotalGrande')?.textContent || '$418.000';
            const subtotal = parseInt(textoSubtotal.replace(/[^0-9]/g, '')) || 418000;
            const totalCalculado = subtotal + costoEnvio;

            const elSub = document.getElementById('simSubtotalDisplay');
            if (elSub) elSub.textContent = '$' + subtotal.toLocaleString('es-CO');

            const elEnv = document.getElementById('simEnvioDisplay');
            if (elEnv) {
                elEnv.textContent = costoEnvio > 0 ? ('+$' + costoEnvio.toLocaleString('es-CO')) : '¡Gratis! ($0)';
                elEnv.className = costoEnvio > 0 ? 'text-base font-bold text-[#8B4513]' : 'text-base font-bold text-emerald-600';
            }

            const elTot = document.getElementById('simTotalDisplay');
            if (elTot) elTot.textContent = '$' + totalCalculado.toLocaleString('es-CO');
        }

        function cerrarModalSimuladorPago() {
            const modal = document.getElementById('modalSimuladorPago');
            const card = document.getElementById('modalSimuladorPagoCard');
            if (card) {
                card.classList.remove('scale-100', 'opacity-100');
                card.classList.add('scale-95', 'opacity-0');
            }
            setTimeout(() => {
                if (modal) modal.classList.add('hidden');
                document.body.style.overflow = '';
            }, 200);
        }

        // Alternar visual de Contado / Cuotas
        function toggleSimCuotas(mostrar) {
            const seccion = document.getElementById('simSeccionCuotas');
            const labelContado = document.getElementById('simLabelContado');
            const labelCuotas = document.getElementById('simLabelCuotas');

            if (mostrar) {
                if (seccion) seccion.classList.remove('hidden');
                if (labelContado) {
                    labelContado.classList.remove('border-[#8B4513]', 'bg-[#FAF3EC]');
                    labelContado.classList.add('border-[#E8DDD5]', 'bg-white');
                    const chk = labelContado.querySelector('.sim-chk-ind');
                    if (chk) { chk.classList.add('hidden'); chk.classList.remove('flex'); }
                }
                if (labelCuotas) {
                    labelCuotas.classList.remove('border-[#E8DDD5]', 'bg-white');
                    labelCuotas.classList.add('border-[#8B4513]', 'bg-[#FAF3EC]');
                    const chk = labelCuotas.querySelector('.sim-chk-ind');
                    if (chk) { chk.classList.remove('hidden'); chk.classList.add('flex'); }
                }
            } else {
                if (seccion) seccion.classList.add('hidden');
                if (labelCuotas) {
                    labelCuotas.classList.remove('border-[#8B4513]', 'bg-[#FAF3EC]');
                    labelCuotas.classList.add('border-[#E8DDD5]', 'bg-white');
                    const chk = labelCuotas.querySelector('.sim-chk-ind');
                    if (chk) { chk.classList.add('hidden'); chk.classList.remove('flex'); }
                }
                if (labelContado) {
                    labelContado.classList.remove('border-[#E8DDD5]', 'bg-white');
                    labelContado.classList.add('border-[#8B4513]', 'bg-[#FAF3EC]');
                    const chk = labelContado.querySelector('.sim-chk-ind');
                    if (chk) { chk.classList.remove('hidden'); chk.classList.add('flex'); }
                }
            }
        }

        function resetSimuladorPago() {
            const overlays = ['simOverlayProcesando', 'simOverlayExito', 'simOverlayError'];
            overlays.forEach(id => {
                const el = document.getElementById(id);
                if (el) {
                    el.classList.add('hidden');
                    el.classList.remove('flex');
                }
            });
            const btn = document.getElementById('btnConfirmarPagoSimulador');
            if (btn) btn.disabled = false;
        }

        // Ejecutar pago y guardar en BD únicamente al confirmar
        async function ejecutarPagoCotizacion() {
            const btnConfirmar = document.getElementById('btnConfirmarPagoSimulador');
            if (btnConfirmar) btnConfirmar.disabled = true;

            const overlayProc = document.getElementById('simOverlayProcesando');
            if (overlayProc) {
                overlayProc.classList.remove('hidden');
                overlayProc.classList.add('flex');
            }

            try {
                const nombre = (document.getElementById('client-name')?.value || '').trim();
                const telefono = (document.getElementById('client-phone')?.value || '').trim();
                const correo = (document.getElementById('client-email')?.value || '').trim();
                const producto = (document.getElementById('product-name')?.value || '').trim();
                const estilo = document.getElementById('product-style')?.value || '';
                const maderaSelect = document.getElementById('wood-select');
                const maderaNombre = maderaSelect ? maderaSelect.options[maderaSelect.selectedIndex].text.split('(')[0].trim() : 'Pino Macizo';
                const cantidad = Math.max(1, parseInt(document.getElementById('input-cantidad')?.value) || 1);
                const alto = parseFloat(document.getElementById('nc-alto')?.value) || 80;
                const ancho = parseFloat(document.getElementById('nc-ancho')?.value) || 120;
                const profundidad = parseFloat(document.getElementById('nc-profundidad')?.value) || 60;
                const observaciones = document.getElementById('nc-observaciones')?.value || '';

                // Datos de Dirección y Despacho
                const ciudad = document.getElementById('simCiudad')?.value || 'Bogotá D.C.';
                const municipio = (document.getElementById('simMunicipio')?.value || '').trim();
                const direccion = (document.getElementById('simDireccion')?.value || '').trim();
                const localidad = (document.getElementById('simLocalidad')?.value || '').trim();
                const codigoPostal = (document.getElementById('simCodigoPostal')?.value || '').trim();
                const pisoDepto = (document.getElementById('simPisoDepto')?.value || '').trim();
                const tipoLugar = document.getElementById('simTipoLugar')?.value || 'Residencial';
                const hotelEmpresa = (document.getElementById('simHotelEmpresa')?.value || '').trim();

                if (!direccion || !municipio || !localidad) {
                    alert('Por favor ingresa la dirección, municipio y localidad para el despacho.');
                    if (btnConfirmar) btnConfirmar.disabled = false;
                    if (overlayProc) { overlayProc.classList.add('hidden'); overlayProc.classList.remove('flex'); }
                    return;
                }

                // Cálculo de costos
                const selCiudad = document.getElementById('simCiudad');
                const optSel = selCiudad ? selCiudad.options[selCiudad.selectedIndex] : null;
                const costoEnvio = parseInt(optSel?.getAttribute('data-costo') || '35000') || 0;

                const textoSubtotal = document.getElementById('summaryTotalGrande')?.textContent || '';
                const subtotal = parseInt(textoSubtotal.replace(/[^0-9]/g, '')) || 418000;
                const totalNumerico = subtotal + costoEnvio;

                const tipoPagoRadio = document.querySelector('input[name="simTipoPago"]:checked');
                const tipoPago = tipoPagoRadio ? tipoPagoRadio.value : 'Contado';
                const numeroCuotas = tipoPago === 'Cuotas' ? parseInt(document.getElementById('simSelectCuotas')?.value) || 3 : null;

                const formData = new FormData();
                formData.append('nombreCliente', nombre);
                formData.append('telefono', telefono);
                formData.append('correo', correo);
                formData.append('producto', estilo ? `${producto} (${estilo})` : producto);
                formData.append('madera', maderaNombre);
                formData.append('cantidad', cantidad);
                formData.append('alto', alto);
                formData.append('ancho', ancho);
                formData.append('profundidad', profundidad);
                formData.append('tiempoEntrega', '15 días hábiles');
                formData.append('observaciones', observaciones);
                formData.append('total', totalNumerico);
                formData.append('costoEnvio', costoEnvio);
                formData.append('tipoPago', tipoPago);
                if (numeroCuotas) formData.append('numeroCuotas', numeroCuotas);

                // Campos de Despacho
                formData.append('ciudad', ciudad);
                formData.append('municipio', municipio);
                formData.append('codigoPostal', codigoPostal);
                formData.append('direccion', direccion);
                formData.append('localidad', localidad);
                formData.append('pisoDepto', pisoDepto);
                formData.append('tipoLugar', tipoLugar);
                formData.append('hotelEmpresa', hotelEmpresa);
                formData.append('metodoPago', metodoPagoActivo);

                const fileInput = document.getElementById('nc-foto-lugar');
                if (fileInput && fileInput.files && fileInput.files.length > 0) {
                    formData.append('fotoLugar', fileInput.files[0]);
                }

                // Validar y adjuntar datos según método de pago seleccionado
                if (metodoPagoActivo === 'tarjeta') {
                    const cardNumber = (document.getElementById('card-number')?.value || '').trim();
                    const cardExpiry = (document.getElementById('card-expiry')?.value || '').trim();
                    const cardCvv = (document.getElementById('card-cvv')?.value || '').trim();
                    const cardTitular = (document.getElementById('card-titular')?.value || '').trim();
                    if (!cardNumber || !cardExpiry || !cardCvv) {
                        alert('Por favor ingresa los datos completos de la tarjeta de pago.');
                        if (btnConfirmar) btnConfirmar.disabled = false;
                        if (overlayProc) { overlayProc.classList.add('hidden'); overlayProc.classList.remove('flex'); }
                        return;
                    }
                    formData.append('cardNumber', cardNumber);
                    formData.append('cardExpiry', cardExpiry);
                    formData.append('cardCvv', cardCvv);
                    formData.append('titularTarjeta', cardTitular);
                } else if (metodoPagoActivo === 'pse') {
                    const banco = document.getElementById('pse-banco')?.value || 'Bancolombia';
                    const tipoCli = document.getElementById('pse-tipo-persona')?.value || 'Persona Natural';
                    const docPse = (document.getElementById('pse-doc')?.value || '').trim();
                    const emailPse = (document.getElementById('pse-email')?.value || '').trim();
                    if (!docPse || !emailPse) {
                        alert('Por favor ingresa tu documento y correo registrado en PSE.');
                        if (btnConfirmar) btnConfirmar.disabled = false;
                        if (overlayProc) { overlayProc.classList.add('hidden'); overlayProc.classList.remove('flex'); }
                        return;
                    }
                    formData.append('bancoPse', banco);
                    formData.append('tipoClientePse', tipoCli);
                    formData.append('docPse', docPse);
                    formData.append('correoPse', emailPse);
                } else if (metodoPagoActivo === 'nequi') {
                    const telNequi = (document.getElementById('nequi-telefono')?.value || '').trim();
                    if (!telNequi) {
                        alert('Por favor ingresa tu número de celular registrado en Nequi.');
                        if (btnConfirmar) btnConfirmar.disabled = false;
                        if (overlayProc) { overlayProc.classList.add('hidden'); overlayProc.classList.remove('flex'); }
                        return;
                    }
                    formData.append('telefonoNequi', telNequi);
                } else if (metodoPagoActivo === 'daviplata') {
                    const telDavi = (document.getElementById('daviplata-telefono')?.value || '').trim();
                    const docDavi = (document.getElementById('daviplata-doc')?.value || '').trim();
                    if (!telDavi || !docDavi) {
                        alert('Por favor ingresa tu número Daviplata y documento.');
                        if (btnConfirmar) btnConfirmar.disabled = false;
                        if (overlayProc) { overlayProc.classList.add('hidden'); overlayProc.classList.remove('flex'); }
                        return;
                    }
                    formData.append('telefonoDaviplata', telDavi);
                    formData.append('docPse', docDavi);
                }

                // Pequeño retardo simulado para dar sensación realista de pasarela
                await new Promise(r => setTimeout(r, 1000));

                const response = await fetch('/NuevaCotizacion/GuardarCotizacion', {
                    method: 'POST',
                    body: formData
                });

                let data;
                try {
                    data = await response.json();
                } catch (jsonErr) {
                    const textErr = await response.text();
                    console.error('Respuesta no JSON:', textErr);
                    data = { success: false, message: 'Error en la respuesta del servidor (Código ' + response.status + ')' };
                }

                if (overlayProc) {
                    overlayProc.classList.add('hidden');
                    overlayProc.classList.remove('flex');
                }

                if (data && data.success) {
                    const elFolio = document.getElementById('simFolioExito');
                    if (elFolio) elFolio.textContent = data.folioCotizacion || 'COT-2026';

                    const elPed = document.getElementById('simCodigoPedidoExito');
                    if (elPed) elPed.textContent = data.codigoPedido || 'PED-2026';

                    const elEst = document.getElementById('simEstadoPedidoExito');
                    if (elEst) {
                        elEst.textContent = data.estadoPedido || (tipoPago === 'Contado' ? 'En Preparación' : 'Pendiente');
                        elEst.className = tipoPago === 'Contado' ? 'text-emerald-700 font-bold' : 'text-amber-700 font-bold';
                    }

                    const elMsg = document.getElementById('simMensajeExito');
                    if (elMsg && data.message) elMsg.textContent = data.message;

                    const overlayExito = document.getElementById('simOverlayExito');
                    if (overlayExito) {
                        overlayExito.classList.remove('hidden');
                        overlayExito.classList.add('flex');
                    }
                } else {
                    if (btnConfirmar) btnConfirmar.disabled = false;
                    const elErr = document.getElementById('simMensajeError');
                    if (elErr) elErr.textContent = (data && data.message) ? data.message : 'Error desconocido al procesar el pago.';

                    const overlayErr = document.getElementById('simOverlayError');
                    if (overlayErr) {
                        overlayErr.classList.remove('hidden');
                        overlayErr.classList.add('flex');
                    }
                }
            } catch (err) {
                console.error('Error al procesar el pago:', err);
                if (btnConfirmar) btnConfirmar.disabled = false;
                if (overlayProc) {
                    overlayProc.classList.add('hidden');
                    overlayProc.classList.remove('flex');
                }
                const elErr = document.getElementById('simMensajeError');
                if (elErr) elErr.textContent = err.message ? ('Error: ' + err.message) : 'Error de conexión con el servidor. Por favor intenta de nuevo.';

                const overlayErr = document.getElementById('simOverlayError');
                if (overlayErr) {
                    overlayErr.classList.remove('hidden');
                    overlayErr.classList.add('flex');
                }
            }
        }

        // Inicializar cálculos al cargar la página
        document.addEventListener('DOMContentLoaded', () => {
            recalcularTotalNuevaCotizacion();
        });
    </script>
</body></html>