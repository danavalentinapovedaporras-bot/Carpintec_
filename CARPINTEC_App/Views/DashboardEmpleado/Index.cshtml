    static string GetIconSvgLg(string name) => GetIconSvg(name).Replace("w-5 h-5", "w-6 h-6");

    static string GetCardDescription(string nombre)
    {
        string n = (nombre ?? "").ToLowerInvariant()
            .Replace("ó", "o").Replace("á", "a").Replace("é", "e").Replace("í", "i").Replace("ú", "u");

        if (n.Contains("cliente"))
            return "Gestiona la información, historial y seguimiento de clientes.";
        if (n.Contains("cotizac"))
            return "Crea, revisa y administra propuestas y cotizaciones de proyectos.";
        if (n.Contains("pedido"))
            return "Controla el estado y seguimiento de pedidos activos en sistema.";
        if (n.Contains("venta"))
            return "Consulta métricas, cierres y reportes comerciales del mes.";
        if (n.Contains("diseñ") || n.Contains("disen"))
            return "Administra planos, renders y especificaciones técnicas de muebles.";
        if (n.Contains("producc"))
            return "Supervisa órdenes de fabricación y el avance operativo en taller.";
        if (n.Contains("inventar"))
            return "Revisa existencias, alertas de stock y catálogo de bodega.";
        if (n.Contains("reporte"))
            return "Analiza indicadores clave de desempeño, tiempos y resultados.";
        if (n.Contains("tarea"))
            return "Revisa y gestiona las labores asignadas a tu puesto de trabajo.";
        if (n.Contains("material"))
            return "Controla el catálogo de materias primas, maderas y herrajes.";
        if (n.Contains("entrada"))
            return "Registra el ingreso y recepción de nuevos materiales a bodega.";
        if (n.Contains("salida"))
            return "Registra el consumo y despacho de insumos hacia producción.";
        return "Accede a las funciones del módulo correspondiente.";
    }

    static IEnumerable<string> GetCardDetails(string nombre)
    {
        string n = (nombre ?? "").ToLowerInvariant()
            .Replace("ó", "o").Replace("á", "a").Replace("é", "e").Replace("í", "i").Replace("ú", "u");

        if (n.Contains("cliente"))
            return new[] { "Ver listado de clientes activos", "Historial de compras y pedidos", "Datos de contacto y seguimiento" };
        if (n.Contains("cotizac"))
            return new[] { "Crear y gestionar cotizaciones", "Revisar cotizaciones pendientes", "Estado de aprobación por cliente" };
        if (n.Contains("pedido"))
            return new[] { "Pedidos en fabricación y lista", "Seguimiento de tiempos y etapas", "Ver pedidos asignados" };
        if (n.Contains("venta"))
            return new[] { "Resumen de ventas del mes", "Metas y cumplimiento comercial", "Reportes de cierre de negocio" };
        if (n.Contains("diseñ") || n.Contains("disen"))
            return new[] { "Planos y renders de productos", "Diseños aprobados por cliente", "Archivos y especificaciones técnicas" };
        if (n.Contains("producc"))
            return new[] { "Órdenes activas en el taller", "Progreso por etapa de fabricación", "Asignación de tareas operativas" };
        if (n.Contains("inventar"))
            return new[] { "Stock actual de materiales", "Alertas de inventario bajo", "Movimientos de entrada y salida" };
        if (n.Contains("reporte"))
            return new[] { "Indicadores de eficiencia", "Producción y desempeño del período", "Exportar informes consolidados" };
        if (n.Contains("tarea"))
            return new[] { "Tareas asignadas para hoy", "Avance de órdenes en proceso", "Registro de labores finalizadas" };
        if (n.Contains("material"))
            return new[] { "Catálogo de materias primas", "Maderas, tableros y herrajes", "Disponibilidad y stock mínimo" };
        if (n.Contains("entrada"))
            return new[] { "Registrar recepción de materiales", "Validar cantidades con factura", "Historial de ingresos a bodega" };
        if (n.Contains("salida"))
            return new[] { "Registrar entrega a operarios", "Asociar material a orden de pedido", "Historial de despachos" };
        return new[] { "Acceder a las funciones del módulo", "Ver información actualizada" };
    }
}
