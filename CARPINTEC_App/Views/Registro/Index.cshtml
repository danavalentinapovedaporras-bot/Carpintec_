@model CARPINTEC_App.Models.Usuario

@{
    Layout = null;
    ViewData["Title"] = "Crear Cuenta";
}

<!DOCTYPE html>
<html lang="es">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Crear Cuenta - Carpintec</title>

    <!-- Tipografía Work Sans del Dashboard -->
    <link href="https://fonts.googleapis.com/css2?family=Work+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">

    <style>

            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
                font-family: 'Work Sans', Arial, Helvetica, sans-serif;
            }

            body {
                background: linear-gradient(rgba(20, 14, 10, 0.45), rgba(20, 14, 10, 0.65)), url('/images/carpintera.jpeg');
                background-size: cover;
                background-position: center;
                background-repeat: no-repeat;
                background-attachment: fixed;
                display: flex;
                justify-content: center;
                align-items: center;
                min-height: 100vh;
                padding: 20px;
            }

            .contenedor {
                width: 440px;
                max-width: 100%;
                background: rgba(255, 255, 255, 0.96);
                backdrop-filter: blur(12px);
                -webkit-backdrop-filter: blur(12px);
                padding: 38px 34px;
                border-radius: 18px;
                box-shadow: 0 16px 40px rgba(0, 0, 0, 0.35);
                border: 1px solid rgba(195, 157, 122, 0.35);
            }

            /* Título Crear Cuenta con color beige y tipo de letra del Dashboard */
            h2 {
                font-family: 'Work Sans', sans-serif;
                text-align: center;
                color: #c39d7a; /* Color beige característico de Carpintec */
                font-size: 28px;
                font-weight: 800;
                letter-spacing: -0.3px;
                margin-bottom: 22px;
                text-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
            }

            label {
                font-family: 'Work Sans', sans-serif;
                font-size: 13.5px;
                font-weight: 600;
                color: #3f2a22;
                display: block;
                margin-top: 10px;
                margin-bottom: 4px;
            }

            input {
                font-family: 'Work Sans', sans-serif;
                width: 100%;
                padding: 12px 14px;
                margin-top: 2px;
                margin-bottom: 12px;
                border-radius: 8px;
                border: 1px solid #d8c6b5;
                background: #fdfbf9;
                font-size: 14px;
                outline: none;
                transition: border-color 0.2s, box-shadow 0.2s;
            }

            input:focus {
                border-color: #c39d7a;
                box-shadow: 0 0 0 3px rgba(195, 157, 122, 0.25);
                background: #ffffff;
            }

            /* =========================
               CONTENEDOR CONTRASEÑA
               ========================= */

            .password-wrapper {
                position: relative;
                width: 100%;
            }

                .password-wrapper input {
                    width: 100%;
                    padding-right: 45px;
                }

            /* =========================
               BOTÓN OJO
               ========================= */

            .toggle-password {
                position: absolute;
                right: 12px;
                top: calc(50% - 6px);
                transform: translateY(-50%);
                width: auto;
                padding: 4px;
                background: transparent;
                color: #777;
                border: none;
                border-radius: 0;
                font-size: 18px;
                cursor: pointer;
            }

                .toggle-password:hover {
                    background: transparent;
                    color: #c39d7a;
                }

            /* =========================
               BOTÓN CREAR CUENTA
               ========================= */

            .btn-crear {
                font-family: 'Work Sans', sans-serif;
                width: 100%;
                padding: 14px;
                background: #c39d7a; /* Color beige */
                color: #ffffff;
                border: none;
                border-radius: 8px;
                cursor: pointer;
                font-size: 16.5px;
                font-weight: 700;
                margin-top: 10px;
                box-shadow: 0 4px 14px rgba(195, 157, 122, 0.4);
                transition: background 0.2s, transform 0.15s, box-shadow 0.2s;
            }

                .btn-crear:hover {
                    background: #a98260;
                    transform: translateY(-1px);
                    box-shadow: 0 6px 18px rgba(195, 157, 122, 0.5);
                }

                .btn-crear:active {
                    transform: translateY(0);
                }

            .mensaje {
                color: #ba1a1a;
                background: #ffdad6;
                padding: 8px 12px;
                border-radius: 6px;
                font-size: 13px;
                text-align: center;
                margin-bottom: 15px;
            }

            .ok {
                color: #065f46;
                background: #d1fae5;
                padding: 8px 12px;
                border-radius: 6px;
                font-size: 13px;
                text-align: center;
                margin-bottom: 15px;
            }

            .login {
                font-family: 'Work Sans', sans-serif;
                text-align: center;
                margin-top: 22px;
                font-size: 13.5px;
                color: #666;
            }

                .login a {
                    color: #c39d7a;
                    text-decoration: none;
                    font-weight: 700;
                    transition: color 0.2s;
                }

                .login a:hover {
                    color: #8b4513;
                    text-decoration: underline;
                }

    </style>

</head>

<body>

    <div class="contenedor">

        <!-- Logo / Ícono de Carpintería -->
        <div style="text-align:center; margin-bottom:8px;">
            <img src="~/images/logo.png" alt="Logo CARPINTEC" style="width:58px; height:58px; object-fit:contain; display:inline-block;" onerror="this.style.display='none'">
        </div>

        <h2>Crear Cuenta</h2>

        @if (TempData["Error"] != null)
        {
            <div class="mensaje">
                @TempData["Error"]
            </div>
        }

        @if (TempData["Success"] != null)
        {
            <div class="ok">
                @TempData["Success"]
            </div>
        }

        <form asp-controller="Registro"
              asp-action="Registrar"
              method="post">

            <!-- =========================
                 NOMBRE
                 ========================= -->

            <label>Nombre</label>

            <input asp-for="Nombre"
                   required />

            <span asp-validation-for="Nombre"
                  style="color:red;"></span>


            <!-- =========================
                 APELLIDO
                 ========================= -->

            <label>Apellido</label>

            <input asp-for="Apellido"
                   required />

            <span asp-validation-for="Apellido"
                  style="color:red;"></span>


            <!-- =========================
                 CORREO
                 ========================= -->

            <label>Correo</label>

            <input asp-for="Correo"
                   type="email"
                   required />

            <span asp-validation-for="Correo"
                  style="color:red;"></span>


            <!-- =========================
                 CONTRASEÑA
                 ========================= -->

            <label>Contraseña</label>

            <div class="password-wrapper">

                <input asp-for="Contraseña"
                       id="password"
                       type="password"
                       minlength="6"
                       required />

                <button type="button"
                        class="toggle-password"
                        onclick="togglePassword('password', this)"
                        aria-label="Mostrar contraseña">

                    👁

                </button>

            </div>

            <span asp-validation-for="Contraseña"
                  style="color:red;"></span>


            <!-- =========================
                 CONFIRMAR CONTRASEÑA
                 ========================= -->

            <label>Confirmar contraseña</label>

            <div class="password-wrapper">

                <input type="password"
                       id="confirmarPassword"
                       name="confirmarPassword"
                       minlength="6"
                       required />

                <button type="button"
                        class="toggle-password"
                        onclick="togglePassword('confirmarPassword', this)"
                        aria-label="Mostrar contraseña">

                    👁

                </button>

            </div>


            <!-- =========================
                 CREAR CUENTA
                 ========================= -->

            <button type="submit"
                    class="btn-crear">

                Crear Cuenta

            </button>

        </form>


        <!-- =========================
             VOLVER AL LOGIN
             ========================= -->

        <div class="login">

            ¿Ya tienes cuenta?<br />

            <a asp-controller="Login"
               asp-action="Index">

                Iniciar sesión

            </a>

        </div>

    </div>


    <!-- =========================
         JAVASCRIPT
         ========================= -->

    <script>

            function togglePassword(inputId, button) {

                const input =
                    document.getElementById(inputId);

                if (input.type === "password") {

                    input.type = "text";

                    button.textContent = "🙈";

                    button.setAttribute(
                        "aria-label",
                        "Ocultar contraseña"
                    );

                } else {

                    input.type = "password";

                    button.textContent = "👁";

                    button.setAttribute(
                        "aria-label",
                        "Mostrar contraseña"
                    );
                }
            }

    </script>


    @section Scripts {
        @{
            await Html.RenderPartialAsync(
                "_ValidationScriptsPartial"
            );
        }
    }

</body>

</html>