@model CARPINTEC_App.Models.Pqr

@{
    Layout = null;
    ViewData["Title"] = "Editar PQR";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Editar PQR</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />

    <style>
            body {
                margin: 0;
                padding: 30px;
                background: #f2f2f2;
                font-family: Arial, Helvetica, sans-serif;
            }

            .editar {
                max-width: 900px;
                margin: auto;
                background: white;
                padding: 40px;
                border-radius: 12px;
                box-shadow: 0 0 20px rgba(0,0,0,.15);
            }

            h2 {
                text-align: center;
                margin-bottom: 30px;
                color: #8B5E3C;
            }

            .botones {
                margin-top: 30px;
                display: flex;
                justify-content: center;
                gap: 15px;
            }

            label {
                font-weight: bold;
                color: #8B5E3C;
            }

            textarea {
                resize: none;
            }
    </style>
</head>

<body>

    <div class="editar">

        <h2>EDITAR PQR</h2>

        <form asp-action="Edit" method="post">

            <input type="hidden" asp-for="IdPqr" />
            <input type="hidden" asp-for="IdCliente" />
            <p>Cliente enviado: @Model.IdCliente</p>
            <input type="hidden" asp-for="FechaRegistro" />

            <div class="mb-3">
                <label>Código</label>
                <input asp-for="CodigoPqr" class="form-control" readonly />
            </div>

            <div class="mb-3">
                <label>Asunto</label>
                <input asp-for="Asunto" class="form-control" />
            </div>

            <div class="mb-3">
                <label>Tipo</label>
                <select asp-for="Tipo" class="form-select">
                    <option value="Petición">Petición</option>
                    <option value="Queja">Queja</option>
                    <option value="Reclamo">Reclamo</option>
                    <option value="Sugerencia">Sugerencia</option>
                </select>
            </div>

            <div class="mb-3">
                <label>Descripción</label>
                <textarea asp-for="Descripcion" class="form-control" rows="5"></textarea>
            </div>

            <div class="mb-3">
                <label>Estado</label>
                <select asp-for="Estado" class="form-select">
                    <option value="Pendiente">Pendiente</option>
                    <option value="En proceso">En proceso</option>
                    <option value="Respondida">Respondida</option>
                    <option value="Cerrada">Cerrada</option>
                </select>
            </div>

            <div class="mb-3">
                <label>Respuesta</label>
                <textarea asp-for="Respuesta" class="form-control" rows="5"></textarea>
            </div>

            <div class="botones">

                <button type="submit" class="btn btn-success">
                    Guardar Cambios
                </button>

                <a asp-action="Index" class="btn btn-secondary">
                    Cancelar
                </a>

            </div>

        </form>

    </div>

</body>
</html>