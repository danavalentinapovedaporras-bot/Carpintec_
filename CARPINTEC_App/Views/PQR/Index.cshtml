@model IEnumerable<CARPINTEC_App.Models.Pqr>
@{
    ViewData["Title"] = "Gestion de pqr";
}
<!DOCTYPE html>
<html class="light" lang="es" style="">
<head>
    <meta charset="utf-8">
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <title>Gestión de PQR | Carpintec</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;700;800&amp;family=Hanken+Grotesk:wght@400;600&amp;display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet">
    <script id="tailwind-config">
            tailwind.config = {
                darkMode: "class",
                theme: {
                    extend: {
                        "colors": {
                            "primary-fixed": "#ffdbd0",
                            "secondary-fixed-dim": "#c8c8b0",
                            "on-secondary-container": "#636451",
                            "tertiary-fixed": "#cde8e5",
                            "on-tertiary-fixed-variant": "#334b49",
                            "on-surface-variant": "#504441",
                            "on-tertiary-container": "#a0bab7",
                            "on-background": "#1b1c1c",
                            "inverse-surface": "#303030",
                            "surface-container-low": "#f6f3f2",
                            "on-error": "#ffffff",
                            "surface-tint": "#77574d",
                            "surface-container-highest": "#e5e2e1",
                            "surface-bright": "#fcf9f8",
                            "surface-dim": "#dcd9d9",
                            "secondary-fixed": "#e4e4cc",
                            "on-tertiary-fixed": "#061f1e",
                            "on-secondary": "#ffffff",
                            "inverse-on-surface": "#f3f0ef",
                            "on-primary-container": "#d4ada1",
                            "tertiary-fixed-dim": "#b1ccc9",
                            "tertiary-container": "#334b49",
                            "surface-container-lowest": "#ffffff",
                            "inverse-primary": "#e7bdb1",
                            "secondary-container": "#e1e1c9",
                            "on-primary-fixed-variant": "#5d4037",
                            "on-secondary-fixed": "#1b1d0e",
                            "on-tertiary": "#ffffff",
                            "on-surface": "#1b1c1c",
                            "tertiary": "#1c3433",
                            "surface-container-high": "#eae7e7",
                            "surface-container": "#f0eded",
                            "primary-container": "#5d4037",
                            "on-primary-fixed": "#2c160e",
                            "error-container": "#ffdad6",
                            "secondary": "#5e604d",
                            "outline-variant": "#d4c3be",
                            "on-secondary-fixed-variant": "#474836",
                            "background": "#fcf9f8",
                            "primary-fixed-dim": "#e7bdb1",
                            "outline": "#827470",
                            "on-primary": "#ffffff",
                            "primary": "#442a22",
                            "on-error-container": "#93000a",
                            "error": "#ba1a1a",
                            "surface-variant": "#e5e2e1",
                            "surface": "#fcf9f8"
                        },
                        "borderRadius": {
                            "DEFAULT": "0.25rem",
                            "lg": "0.5rem",
                            "xl": "0.75rem",
                            "full": "9999px"
                        },
                        "spacing": {
                            "xl": "64px",
                            "base": "8px",
                            "md": "24px",
                            "xs": "4px",
                            "sm": "12px",
                            "lg": "40px",
                            "margin": "32px",
                            "gutter": "24px"
                        },
                        "fontFamily": {
                            "headline-lg": ["Manrope"],
                            "body-lg": ["Hanken Grotesk"],
                            "body-md": ["Hanken Grotesk"],
                            "headline-md": ["Manrope"],
                            "label-md": ["Hanken Grotesk"],
                            "headline-xl": ["Manrope"],
                            "body-sm": ["Hanken Grotesk"],
                            "headline-lg-mobile": ["Manrope"]
                        }
                    },
                },
            }
    </script>
    <style>
            .material-symbols-outlined {
                font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
            }

            .custom-scrollbar::-webkit-scrollbar {
                width: 6px;
            }

            .custom-scrollbar::-webkit-scrollbar-track {
                background: transparent;
            }

            .custom-scrollbar::-webkit-scrollbar-thumb {
                background: #d4c3be;
                border-radius: 10px;
            }

            .zebra-table tr:nth-child(even) {
                background-color: rgba(245, 245, 220, 0.3);
            }

            .side-nav-active {
    background-color: #5d4037;
    color:white;
}
              
    </style>
</head>
<body class="bg-background text-on-background font-body-md min-h-screen flex">
    <!-- SideNavBar -->
    <!-- Main Content Area -->
    <main class="flex-1 flex flex-col relative">
        <!-- TopNavBar -->
        <header class="w-full h-16 flex justify-between items-center px-margin py-base bg-surface-bright shadow-sm sticky top-0 z-40">
            <div class="flex items-center gap-md">
                <div class="relative w-96">
                    <span class="material-symbols-outlined absolute left-sm top-1/2 -translate-y-1/2 text-on-surface-variant">search</span>
                    <input class="w-full pl-xl pr-md py-xs bg-surface-container-low border-none rounded-full text-body-sm focus:ring-2 focus:ring-primary" placeholder="Buscar radicado o cliente..." type="text">
                </div>
            </div>
            <div class="flex items-center gap-md">
                <button class="w-10 h-10 rounded-full hover:bg-surface-container-low flex items-center justify-center transition-colors">
                    <span class="material-symbols-outlined text-primary">notifications</span>
                </button>
                <button class="w-10 h-10 rounded-full hover:bg-surface-container-low flex items-center justify-center transition-colors">
                    <span class="material-symbols-outlined text-primary">settings</span>
                </button>
                <div class="h-8 w-[1px] bg-outline-variant mx-xs"></div>
                <div class="flex items-center gap-sm">
                    <div class="text-right">
                        <p class="font-bold text-sm text-primary">Admin Principal</p>
                        <p class="text-[10px] text-on-surface-variant uppercase tracking-tighter">Gestion de Calidad</p>
                    </div>
                    <img class="w-10 h-10 rounded-full object-cover border-2 border-primary-fixed" data-alt="A professional headshot of a mature corporate administrator with silvering hair, wearing a high-quality tailored brown blazer. The background is a clean, bright architectural space with soft daylighting and minimal furniture. The aesthetic is sophisticated, trustworthy, and aligned with luxury craftsmanship." src="https://lh3.googleusercontent.com/aida-public/AB6AXuDyn54J2vqfkw_pVo92FfxNkvs0CSxzW9-gBaFatkchi2f0Yyfvfa6BZXBdRznL1NVnkbfzgFCLeYZU8xuoSSl9i_HbOXqodYgUVSdY0AiNB-F3_6QDTWRyoESAHn2vS2PKifDtyyv8bX0h7ha0kSlQbC8aQ7TlpQRSjfkW2A6PIRUwAaGTC0f-6DG2hbT1QDKinfFugvkBr-m31FPhJjlGK7k_j1rhu60YcLnoglokkIBB4QLbdisd">
                </div>
            </div>
        </header>
        <!-- Canvas -->
        <div class="p-margin max-w-7xl w-full mx-auto">
            <!-- Page Header -->
<div class="mb-lg flex justify-between items-center">

    <div>
        <h2 class="font-headline-lg text-headline-lg text-primary mb-xs">
            Gestión de PQR
        </h2>

        <p class="text-on-surface-variant font-body-md">
            Administra las peticiones, quejas, reclamos y sugerencias enviadas por los clientes de forma centralizada.
        </p>
    </div>

  <!-- Botón Nueva PQR -->
<button onclick="abrirModalPQR()"
        class="bg-primary text-on-primary px-md py-sm rounded-lg font-bold flex items-center gap-sm">

    <span class="material-symbols-outlined">
        add
    </span>

    Nueva PQR

</button>

        

</div>
            </div>
            <!-- Resumen Stats -->
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-gutter mb-lg">
                <div class="bg-surface-container-lowest p-md rounded-xl shadow-sm border-l-4 border-yellow-500 hover:-translate-y-1 transition-transform">
                    <div class="flex items-center justify-between">
                        <span class="material-symbols-outlined text-yellow-600 bg-yellow-50 p-sm rounded-lg">pending_actions</span>
                        <span class="text-headline-md font-headline-md text-primary">@ViewBag.Pendientes</span>
                    </div>
                    <p class="mt-sm text-label-md text-on-surface-variant">PQR Pendientes</p>
                </div>
                <div class="bg-surface-container-lowest p-md rounded-xl shadow-sm border-l-4 border-blue-500 hover:-translate-y-1 transition-transform">
                    <div class="flex items-center justify-between">
                        <span class="material-symbols-outlined text-blue-600 bg-blue-50 p-sm rounded-lg">sync</span>
                        <span class="text-headline-md font-headline-md text-primary">@ViewBag.EnProceso</span>
                    </div>
                    <p class="mt-sm text-label-md text-on-surface-variant">En proceso</p>
                </div>
                <div class="bg-surface-container-lowest p-md rounded-xl shadow-sm border-l-4 border-green-500 hover:-translate-y-1 transition-transform">
                    <div class="flex items-center justify-between">
                        <span class="material-symbols-outlined text-green-600 bg-green-50 p-sm rounded-lg">verified</span>
                        <span class="text-headline-md font-headline-md text-primary">@ViewBag.Respondidas</span>
                    </div>
                    <p class="mt-sm text-label-md text-on-surface-variant">Respondidas</p>
                </div>
                <div class="bg-surface-container-lowest p-md rounded-xl shadow-sm border-l-4 border-gray-400 hover:-translate-y-1 transition-transform">
                    <div class="flex items-center justify-between">
                        <span class="material-symbols-outlined text-gray-600 bg-gray-50 p-sm rounded-lg">inventory_2</span>
                        <span class="text-headline-md font-headline-md text-primary">
    @ViewBag.Cerradas
</span>
                    </div>
                    <p class="mt-sm text-label-md text-on-surface-variant">Cerradas</p>
                </div>
            </div>
            <!-- Filtros Section -->
        <div class="bg-surface-container-lowest rounded-xl shadow-sm p-md mb-lg">
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-md items-end">

                <!-- Radicado -->
                <div class="lg:col-span-1">
                    <label class="block text-label-md text-on-surface-variant mb-xs">
                        Radicado/Cliente
                    </label>

                    <input id="filtroRadicado"
                           class="w-full border-outline-variant rounded-lg bg-surface-bright text-body-sm"
                           placeholder="Ej: PQR-2024-001">
                </div>


                <!-- Tipo -->
                <div>
                    <label class="block text-label-md text-on-surface-variant mb-xs">
                        Tipo
                    </label>

                    <select id="filtroTipo"
                            class="w-full border-outline-variant rounded-lg bg-surface-bright text-body-sm">

                        <option value="">Todos</option>
                        <option value="Peticion">Petición</option>
                        <option value="Queja">Queja</option>
                        <option value="Reclamo">Reclamo</option>
                        <option value="Sugerencia">Sugerencia</option>

                    </select>
                </div>


                <!-- Estado -->
                <div>
                    <label class="block text-label-md text-on-surface-variant mb-xs">
                        Estado
                    </label>

                    <select id="filtroEstado"
                            class="w-full border-outline-variant rounded-lg bg-surface-bright text-body-sm">

                        <option value="">Cualquier estado</option>
                        <option value="Pendiente">Pendiente</option>
                        <option value="En proceso">En proceso</option>
                        <option value="Resuelta">Resuelta</option>
                        <option value="Cerrada">Cerrada</option>

                    </select>
                </div>


                <!-- Fecha -->
                <div>
                    <label class="block text-label-md text-on-surface-variant mb-xs">
                        Fecha
                    </label>

                    <input id="filtroFecha"
                           class="w-full border-outline-variant rounded-lg bg-surface-bright text-body-sm"
                           type="date">
                </div>


                <!-- Botones -->
                <div class="flex gap-sm">

                    <button onclick="buscarPQR()"
                            class="flex-1 bg-primary text-on-primary py-sm px-md rounded-lg font-label-md hover:bg-primary-container transition-colors shadow-sm">

                        Buscar

                    </button>


                    <button onclick="limpiarFiltros()"
                            class="bg-secondary-container text-primary py-sm px-md rounded-lg font-label-md hover:bg-outline-variant transition-colors">

                        Limpiar

                    </button>

                </div>

            </div>
        </div>
            <!-- Tabla de PQRs -->
            <div class="bg-surface-container-lowest rounded-xl shadow-sm overflow-hidden">
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse zebra-table">
                        <thead class="bg-surface-container-low border-b border-outline-variant">
                            <tr>
                                <th class="px-md py-sm font-label-md text-on-surface-variant uppercase text-xs">Radicado</th>
                                <th class="px-md py-sm font-label-md text-on-surface-variant uppercase text-xs">Cliente</th>
                                <th class="px-md py-sm font-label-md text-on-surface-variant uppercase text-xs">Tipo</th>
                                <th class="px-md py-sm font-label-md text-on-surface-variant uppercase text-xs">Asunto</th>
                                <th class="px-md py-sm font-label-md text-on-surface-variant uppercase text-xs">Fecha</th>
                                <th class="px-md py-sm font-label-md text-on-surface-variant uppercase text-xs">Estado</th>
                                <th class="px-md py-sm font-label-md text-on-surface-variant uppercase text-xs">Prioridad</th>
                                <th class="px-md py-sm font-label-md text-on-surface-variant uppercase text-xs text-center">Acciones</th>
                            </tr>
                        </thead>
                    <tbody id="tablaPQR" class="text-body-sm divide-y divide-outline-variant/30">

                            @foreach (var item in Model)
                            {
                                <tr class="hover:bg-primary-fixed-variant/5 transition-colors group">

                                    <td class="px-md py-md font-bold text-primary">
                                        @item.CodigoPqr
                                    </td>

                                    <td class="px-md py-md">
                                       @(item.IdClienteNavigation != null 
    ? item.IdClienteNavigation.Nombre + " " + item.IdClienteNavigation.Apellido 
    : "Cliente no encontrado")
                                    </td>

                                    <td class="px-md py-md">
                                        @item.Tipo
                                    </td>

                                    <td class="px-md py-md">
                                        @item.Asunto
                                    </td>

                                    <td class="px-md py-md">
                                        @item.FechaRegistro.ToString("dd/MM/yyyy")
                                    </td>

                                    <td class="px-md py-md">
                                        @item.Estado
                                    </td>

                                    <td class="px-md py-md">
                                        -
                                    </td>

                                    <td class="px-md py-md text-center">

                                        <div class="flex justify-center gap-sm">

                                        <button onclick="abrirDetallePQR(@item.IdPqr)"
                                                class="text-primary hover:scale-110 transition-transform">

                                            <span class="material-symbols-outlined">
                                                visibility
                                            </span>

                                        </button>
                                        <button onclick="abrirDetallePQR(@item.IdPqr)"
                                                class="text-primary hover:scale-110 transition-transform">

                                            <span class="material-symbols-outlined">
                                                reply
                                            </span>

                                        </button>

                                        <button onclick="abrirEditarPQR(@item.IdPqr)"
                                                class="text-primary hover:scale-110 transition-transform">

                                            <span class="material-symbols-outlined">
                                                edit_note
                                            </span>

                                        </button>

                                        </div>

                                    </td>

                                </tr>
                            }

                        </tbody>
                    </table>
                </div>
                <div class="px-md py-sm border-t border-outline-variant bg-surface-bright flex items-center justify-between">
                    <p class="text-body-sm text-on-surface-variant">Mostrando 3 de 185 resultados</p>
                    <div class="flex gap-xs">
                        <button class="p-xs hover:bg-surface-container-low rounded"><span class="material-symbols-outlined">chevron_left</span></button>
                        <button class="px-sm py-xs bg-primary text-on-primary rounded font-bold">1</button>
                        <button class="px-sm py-xs hover:bg-surface-container-low rounded">2</button>
                        <button class="px-sm py-xs hover:bg-surface-container-low rounded">3</button>
                        <button class="p-xs hover:bg-surface-container-low rounded"><span class="material-symbols-outlined">chevron_right</span></button>
                    </div>
                </div>
            </div>
        
    </main>
    <!-- Side Detail Panel (Modal Behavior) -->
    <div class="fixed inset-y-0 right-0 w-full md:w-[600px] bg-white shadow-2xl z-[60] transform translate-x-full transition-transform duration-500 flex flex-col border-l border-outline-variant" id="detailPanel">
        <!-- Header -->
        <div class="bg-primary p-md flex justify-between items-center text-on-primary">
            <div>
                <h3 class="font-headline-md text-headline-md">Detalle de Radicado</h3>
                <p class="text-body-sm text-on-primary/70">Expediente PQR-24-012</p>
            </div>
            <button class="w-10 h-10 flex items-center justify-center hover:bg-white/10 rounded-full" onclick="toggleDetail()">
                <span class="material-symbols-outlined">close</span>
            </button>
        </div>
        <!-- Scrollable Content -->
        <div class="flex-1 overflow-y-auto custom-scrollbar p-lg">
            <!-- Cliente Section -->
            <div class="mb-lg">
                <div class="flex items-center gap-sm mb-md pb-xs border-b border-outline-variant">
                    <span class="material-symbols-outlined text-primary">person</span>
                    <h4 class="font-bold text-primary uppercase text-xs tracking-wider">Información del Cliente</h4>
                </div>
                <div class="grid grid-cols-2 gap-md">
                    <div>
                        <p class="text-xs text-on-surface-variant">Nombre Completo</p>
                        <p id="detalleCliente" class="font-semibold"></p>
                    </div>
                    <div>
                        <p class="text-xs text-on-surface-variant">Documento</p>
                        <p id="detalleDocumento" class="font-semibold"></p>
                    </div>
                    <div>
                        <p class="text-xs text-on-surface-variant">Correo Electrónico</p>
                        <p id="detalleCorreo" class="font-semibold"></p>
                    </div>
                    <div>
                        <p class="text-xs text-on-surface-variant">Teléfono</p>
                        <p id="detalleTelefono" class="font-semibold"></p>
                    </div>
                </div>
            </div>
            <!-- Solicitud Section -->
            <div class="mb-lg">
                <div class="flex items-center gap-sm mb-md pb-xs border-b border-outline-variant">
                    <span class="material-symbols-outlined text-primary">description</span>
                    <h4 class="font-bold text-primary uppercase text-xs tracking-wider">Información de la Solicitud</h4>
                </div>
                <div class="space-y-md">
                    <div class="grid grid-cols-2 gap-md">
                        <div>
                            <p class="text-xs text-on-surface-variant">Tipo de Solicitud</p>
                            <p id="detalleTipo" class="font-semibold"></p>
                        </div>
                        <div>
                            <p class="text-xs text-on-surface-variant">Fecha Radicación</p>
                            <p id="detalleFecha" class="font-semibold"></p>
                        </div>
                    </div>
                    <div>
                        <p class="text-xs text-on-surface-variant">Asunto</p>
                        <p id="detalleAsunto" class="font-semibold text-lg"></p>
                    </div>
                    <div id="detalleDescripcion"
                         class="p-md bg-surface-container rounded-lg border border-outline-variant/20 italic text-body-sm">
                    </div>
                </div>
            </div>
            <!-- Evidencias -->
            <div class="mb-lg">
                <div class="flex items-center gap-sm mb-md pb-xs border-b border-outline-variant">
                    <span class="material-symbols-outlined text-primary">attachment</span>
                    <h4 class="font-bold text-primary uppercase text-xs tracking-wider">Evidencias (2)</h4>
                </div>
                <div class="grid grid-cols-3 gap-sm">
                    <div class="aspect-square bg-surface-container rounded-lg overflow-hidden border border-outline-variant relative group cursor-pointer">
                        <img class="w-full h-full object-cover" data-alt="A high-quality close-up photograph of a luxury dark walnut wood grain texture. The image shows the intricate natural swirls and patterns of the wood, illuminated by warm, soft studio lighting. It reflects the artisanal craftsmanship and premium materials used in high-end carpentry." src="https://lh3.googleusercontent.com/aida-public/AB6AXuCA0udyv0LoZ22uaCpthbzdE-wxLPjmZBYzapdMxQMH4NLRvWSBA_M9LaRJp8Smpq8eVMwO7-LWeS9k1PcwVcsvnM72KiHOQV_rTZDB1Ba-XOtBlu6R4J7jaC0c9TBrrDeKONa3_h-QA4DaZE7Cezr_xoFY8E3LSS-DierK-sr6-2jOzRXkJXBrQIwrXFhVzXkGIjrDousbuGDNP38WBXZv8wFsgiNFWgPZEpEdAAAhjs17SFDzOAoD">
                        <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 flex items-center justify-center transition-opacity">
                            <span class="material-symbols-outlined text-white">open_in_full</span>
                        </div>
                    </div>
                    <div class="aspect-square bg-surface-container rounded-lg overflow-hidden border border-outline-variant flex items-center justify-center">
                        <div class="text-center">
                            <span class="material-symbols-outlined text-primary-fixed-variant text-4xl">picture_as_pdf</span>
                            <p class="text-[10px] mt-xs">Recibo_Caja.pdf</p>
                        </div>
                    </div>
                </div>
            </div>
            <input type="hidden" id="idPqrRespuesta">

            <input type="hidden" id="idPqrEstado">

            <input type="hidden" id="idPqrCerrar">
            <!-- Respuesta del Admin -->
            <div class="mb-lg pt-md bg-surface-container-low p-md rounded-xl border border-outline-variant">
                <form id="formRespuesta">

                    @Html.AntiForgeryToken()

                    <div class="flex items-center gap-sm mb-md">
                        <span class="material-symbols-outlined text-primary">chat_bubble</span>
                        <h4 class="font-bold text-primary uppercase text-xs tracking-wider">
                            Emitir Respuesta
                        </h4>
                    </div>


                    <textarea id="respuestaPQR"
                              name="respuesta"
                              class="w-full border-outline-variant rounded-lg bg-surface-bright text-body-sm focus:ring-primary focus:border-primary mb-md"
                              placeholder="Escribe aquí la respuesta oficial para el cliente..."
                              rows="4"></textarea>


                    <div class="flex flex-col gap-md">

                        <div>
                            <label class="block text-label-md text-on-surface-variant mb-xs">
                                Cambiar Estado Operativo
                            </label>

                            <select id="estadoPQR"
                                    class="w-full border-outline-variant rounded-lg bg-surface-bright text-body-sm focus:ring-primary">

                                <option value="Pendiente">Pendiente (Actual)</option>
                                <option value="En proceso">En proceso</option>
                                <option value="Resuelta">Resuelta</option>
                                <option value="Cerrada">Cerrada</option>

                            </select>
                        </div>


                        <div class="flex flex-wrap gap-sm">

                            <button type="button"
                                    onclick="guardarRespuesta()"
                                    class="flex-1 bg-primary text-on-primary py-sm px-md rounded-lg">

                                Guardar Respuesta

                            </button>


                            <button type="button"
                                    onclick="actualizarEstado()"
                                    class="flex-1 border-2 border-primary text-primary py-sm px-md rounded-lg">

                                Actualizar Estado

                            </button>

                        </div>

                    </div>


                </form>
        </div>

        <!-- Footer -->
        <div class="p-md bg-surface-bright border-t border-outline-variant flex gap-sm">
            <button class="px-md py-sm bg-surface-container-high text-on-surface-variant rounded-lg font-label-md hover:bg-surface-container-highest transition-colors" onclick="toggleDetail()">Volver al Listado</button>
            <button class="ml-auto px-md py-sm bg-error text-on-error rounded-lg font-label-md hover:opacity-90 transition-opacity">Cerrar PQR Permanentemente</button>
        </div>
    </div>
    </div>
    <!-- Overlay for Modal -->
    <div class="fixed inset-0 bg-black/40 backdrop-blur-sm z-[55] opacity-0 pointer-events-none transition-opacity duration-500" id="overlay" onclick="toggleDetail()"></div>
    <script>
            async function abrirDetallePQR(id) {

                const respuesta = await fetch('/PQR/ObtenerPQR?id=' + id);

                const datos = await respuesta.json();


                // Abrir modal

                const panel = document.getElementById('detailPanel');
                const overlay = document.getElementById('overlay');

                panel.classList.remove('translate-x-full');

                overlay.classList.remove('opacity-0');
                overlay.classList.remove('pointer-events-none');


                // Guardar id de la PQR actual

                document.getElementById("idPqrRespuesta").value = datos.id;

                // Cargar información

                document.getElementById("detalleCliente").innerText = datos.cliente;
                document.getElementById("detalleDocumento").innerText = datos.documento;
                document.getElementById("detalleCorreo").innerText = datos.correo;
                document.getElementById("detalleTelefono").innerText = datos.telefono;

                document.getElementById("detalleTipo").innerText = datos.tipo;
                document.getElementById("detalleFecha").innerText = datos.fecha;
                document.getElementById("detalleAsunto").innerText = datos.asunto;
                document.getElementById("detalleDescripcion").innerText = datos.descripcion;

            }
    </script>
<div id="modalPQR"
