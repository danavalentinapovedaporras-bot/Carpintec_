<script>

function abrirModalPQR(){

    let modal = document.getElementById("modalPQR");

    modal.classList.remove("hidden");

    modal.classList.add("flex");

}


function cerrarModalPQR(){

    let modal = document.getElementById("modalPQR");

    modal.classList.add("hidden");

    modal.classList.remove("flex");

}

</script>
    <script>

            async function guardarRespuesta() {

                let id = document.getElementById("idPqrRespuesta").value;
                console.log("ID PQR:", id);

                let respuesta = document.getElementById("respuestaPQR").value;
                console.log("Respuesta:", respuesta);


                if (respuesta.trim() === "") {
                    alert("Escriba una respuesta antes de guardar");
                    return;
                }


                let datos = new FormData();

                datos.append("id", id);
                datos.append("respuesta", respuesta);
                let estado = document.getElementById("estadoPQR").value;

                datos.append("estado", estado);

                let token = document.querySelector('input[name="__RequestVerificationToken"]').value;

                datos.append("__RequestVerificationToken", token);


                let resultado = await fetch('/PQR/Responder',
                    {
                        method: "POST",
                        body: datos
                    });

                if (resultado.ok) {
                    alert("Respuesta guardada correctamente");
                    location.reload();
                }
                else {
                    alert("Error al guardar respuesta");
                }

            }

    </script>

    <script>

            async function actualizarEstado() {

                let id = document.getElementById("idPqrRespuesta").value;

                let datos = new FormData();

                datos.append("id", id);
                datos.append("estado", "En proceso");

                datos.append(
                    "__RequestVerificationToken",
                    document.querySelector('input[name="__RequestVerificationToken"]').value
                );


                let respuesta = await fetch('/PQR/CambiarEstado', {
                    method: "POST",
                    body: datos
                });


                if (respuesta.ok) {

                    alert("Estado actualizado correctamente");
                    location.reload();

                } else {

                    alert("Error actualizando estado");

                }

            }

    </script>
    <script>

            function buscarPQR() {

                let radicado = document.getElementById("filtroRadicado").value.toLowerCase();
                let tipo = document.getElementById("filtroTipo").value.toLowerCase();
                let estado = document.getElementById("filtroEstado").value.toLowerCase();
                let fecha = document.getElementById("filtroFecha").value;


                let filas = document.querySelectorAll("#tablaPQR tr");


                filas.forEach(fila => {

                    let texto = fila.innerText.toLowerCase();


                    let cumpleRadicado =
                        radicado === "" || texto.includes(radicado);


                    let cumpleTipo =
                        tipo === "" || texto.includes(tipo);


                    let cumpleEstado =
                        estado === "" || texto.includes(estado);


                    let cumpleFecha =
                        fecha === "" || texto.includes(fecha);


                    if (cumpleRadicado &&
                        cumpleTipo &&
                        cumpleEstado &&
                        cumpleFecha) {
                        fila.style.display = "";
                    }
                    else {
                        fila.style.display = "none";
                    }


                });

            }



            function limpiarFiltros() {

                document.getElementById("filtroRadicado").value = "";

                document.getElementById("filtroTipo").value = "";

                document.getElementById("filtroEstado").value = "";

                document.getElementById("filtroFecha").value = "";


                let filas = document.querySelectorAll("#tablaPQR tr");


                filas.forEach(fila => {

                    fila.style.display = "";

                });

            }
            

                async function abrirEditarPQR(id){

                    let respuesta = await fetch('/PQR/ObtenerPQR?id=' + id);

                let datos = await respuesta.json();


                document.getElementById("editIdPqr").value = datos.id;

                document.getElementById("editIdCliente").value = datos.idCliente;

                document.getElementById("editId").value = datos.id;

                document.getElementById("editCodigo").value = datos.codigo;

                document.getElementById("editTipo").value = datos.tipo;

                document.getElementById("editAsunto").value = datos.asunto;

                document.getElementById("editDescripcion").value = datos.descripcion;

                document.getElementById("editEstado").value = datos.estado;

                document.getElementById("editRespuesta").value = datos.respuesta ?? "";


                let modal = document.getElementById("modalEditarPQR");

                modal.classList.remove("hidden");

                modal.classList.add("flex");

            }


                function cerrarEditarPQR(){

                    let modal = document.getElementById("modalEditarPQR");

                modal.classList.add("hidden");

                modal.classList.remove("flex");

            }

    </script>

</body>
</html>

   