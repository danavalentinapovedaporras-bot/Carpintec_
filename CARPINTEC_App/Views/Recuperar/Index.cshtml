@{
    Layout = null;
    ViewData["Title"] = "Recuperar contraseña";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Recuperar Contraseña - Carpintec</title>

    <!-- Tipografía Work Sans del Dashboard -->
    <link href="https://fonts.googleapis.com/css2?family=Work+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Work Sans', Arial, Helvetica, sans-serif;
        }

        body {
            background: linear-gradient(rgba(20, 14, 10, 0.45), rgba(20, 14, 10, 0.65)), url('/images/carpintera.jpeg');
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
            background-attachment: fixed;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            padding: 20px;
        }

        /* Cuadro en color beige con efecto glassmorphism elegante */
        .contenedor {
            width: 440px;
            max-width: 100%;
            background: rgba(250, 246, 240, 0.97); /* Cuadro beige cálido */
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            padding: 38px 34px;
            border-radius: 18px;
            box-shadow: 0 16px 40px rgba(0, 0, 0, 0.35);
            border: 1.5px solid rgba(195, 157, 122, 0.55);
        }

        /* Título con color beige y tipo de letra del Dashboard */
        h2 {
            font-family: 'Work Sans', sans-serif;
            text-align: center;
            color: #c39d7a; /* Color beige característico de Carpintec */
            font-size: 26px;
            font-weight: 800;
            letter-spacing: -0.3px;
            margin-bottom: 10px;
            text-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
        }

        p.subtitulo {
            font-family: 'Work Sans', sans-serif;
            text-align: center;
            margin-bottom: 22px;
            color: #6b5547;
            font-size: 14px;
            line-height: 1.45;
        }

        label {
            font-family: 'Work Sans', sans-serif;
            font-size: 13.5px;
            font-weight: 600;
            color: #3f2a22;
            display: block;
            margin-bottom: 6px;
        }

        input {
            font-family: 'Work Sans', sans-serif;
            width: 100%;
            padding: 12px 14px;
            margin-bottom: 20px;
            border-radius: 8px;
            border: 1px solid #d8c6b5;
            background: #ffffff;
            font-size: 14px;
            outline: none;
            transition: border-color 0.2s, box-shadow 0.2s;
            color: #333;
        }

        input:focus {
            border-color: #c39d7a;
            box-shadow: 0 0 0 3px rgba(195, 157, 122, 0.25);
        }

        /* Botón con el color beige característico y tipografía Work Sans */
        button {
            font-family: 'Work Sans', sans-serif;
            width: 100%;
            padding: 14px;
            background: #c39d7a; /* Beige */
            color: #ffffff;
            border: none;
            border-radius: 8px;
            font-size: 16.5px;
            font-weight: 700;
            cursor: pointer;
            box-shadow: 0 4px 14px rgba(195, 157, 122, 0.4);
            transition: background 0.2s, transform 0.15s, box-shadow 0.2s;
        }

        button:hover {
            background: #a98260;
            transform: translateY(-1px);
            box-shadow: 0 6px 18px rgba(195, 157, 122, 0.5);
        }

        button:active {
            transform: translateY(0);
        }

        .mensaje {
            color: #ba1a1a;
            background: #ffdad6;
            padding: 9px 12px;
            border-radius: 6px;
            font-size: 13px;
            text-align: center;
            margin-bottom: 18px;
            font-weight: 500;
        }

        .volver {
            font-family: 'Work Sans', sans-serif;
            text-align: center;
            margin-top: 24px;
            font-size: 13.5px;
        }

        .volver a {
            text-decoration: none;
            color: #c39d7a;
            font-weight: 700;
            transition: color 0.2s;
        }

        .volver a:hover {
            color: #8b4513;
            text-decoration: underline;
        }
    </style>

</head>
<body>

    <div class="contenedor">

        <!-- Logo / Ícono de Carpintería -->
        <div style="text-align:center; margin-bottom:10px;">
            <img src="~/images/logo.png" alt="Logo CARPINTEC" style="width:58px; height:58px; object-fit:contain; display:inline-block;" onerror="this.style.display='none'">
        </div>

        <h2>Recuperar Contraseña</h2>

        <p class="subtitulo">Ingresa el correo con el que creaste tu cuenta para continuar con la recuperación.</p>

        @if (TempData["Error"] != null)
        {
            <div class="mensaje">
                @TempData["Error"]
            </div>
        }

        <form asp-action="BuscarCorreo" method="post">

            <label for="correo">Correo electrónico</label>

            <input type="email"
                   id="correo"
                   name="correo"
                   placeholder="ejemplo@correo.com"
                   required />

            <button type="submit">
                Continuar
            </button>

        </form>

        <div class="volver">

            <a asp-controller="Login"
               asp-action="Index">
                ← Volver al inicio de sesión
            </a>

        </div>

    </div>

</body>
</html>