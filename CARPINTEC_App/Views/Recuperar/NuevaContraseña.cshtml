@{
    Layout = null;
    ViewData["Title"] = "Nueva Contraseña";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Nueva Contraseña - Carpintec</title>

    <!-- Tipografía Work Sans del Dashboard -->
    <link href="https://fonts.googleapis.com/css2?family=Work+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Work Sans', Arial, Helvetica, sans-serif;
        }

        body {
            background: linear-gradient(rgba(20, 14, 10, 0.45), rgba(20, 14, 10, 0.65)), url('/images/carpintera.jpeg');
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
            background-attachment: fixed;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            padding: 20px;
        }

        /* Cuadro en color beige con efecto glassmorphism */
        .card {
            width: 440px;
            max-width: 100%;
            background: rgba(250, 246, 240, 0.97); /* Beige cálido */
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            padding: 38px 34px;
            border-radius: 18px;
            box-shadow: 0 16px 40px rgba(0, 0, 0, 0.35);
            border: 1.5px solid rgba(195, 157, 122, 0.55);
        }

        /* Título con color beige y tipo de letra del Dashboard */
        h2 {
            font-family: 'Work Sans', sans-serif;
            text-align: center;
            color: #c39d7a; /* Color beige característico de Carpintec */
            font-size: 26px;
            font-weight: 800;
            letter-spacing: -0.3px;
            margin-bottom: 10px;
            text-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
        }

        p.subtitulo {
            font-family: 'Work Sans', sans-serif;
            text-align: center;
            color: #6b5547;
            font-size: 14px;
            line-height: 1.45;
            margin-bottom: 22px;
        }

        label {
            font-family: 'Work Sans', sans-serif;
            font-size: 13.5px;
            font-weight: 600;
            color: #3f2a22;
            display: block;
            margin-bottom: 6px;
        }

        /* Contenedor de Contraseña */
        .password-wrapper {
            position: relative;
            width: 100%;
            margin-bottom: 16px;
        }

        .password-wrapper input {
            font-family: 'Work Sans', sans-serif;
            width: 100%;
            padding: 12px 45px 12px 14px;
            border-radius: 8px;
            border: 1px solid #d8c6b5;
            background: #ffffff;
            font-size: 14px;
            outline: none;
            transition: border-color 0.2s, box-shadow 0.2s;
            color: #333;
        }

        .password-wrapper input:focus {
            border-color: #c39d7a;
            box-shadow: 0 0 0 3px rgba(195, 157, 122, 0.25);
        }

        /* Botón del ojo */
        .toggle-password {
            position: absolute;
            right: 12px;
            top: 50%;
            transform: translateY(-50%);
            width: auto;
            padding: 4px;
            background: transparent;
            color: #777;
            border: none;
            border-radius: 0;
            font-size: 18px;
            cursor: pointer;
        }

        .toggle-password:hover {
            background: transparent;
            color: #c39d7a;
        }

        /* Botón Cambiar Contraseña */
        .btn-cambiar {
            font-family: 'Work Sans', sans-serif;
            width: 100%;
            padding: 14px;
            background: #c39d7a; /* Color beige */
            color: #ffffff;
            border: none;
            border-radius: 8px;
            font-size: 16.5px;
            font-weight: 700;
            cursor: pointer;
            margin-top: 8px;
            box-shadow: 0 4px 14px rgba(195, 157, 122, 0.4);
            transition: background 0.2s, transform 0.15s, box-shadow 0.2s;
        }

        .btn-cambiar:hover {
            background: #a98260;
            transform: translateY(-1px);
            box-shadow: 0 6px 18px rgba(195, 157, 122, 0.5);
        }

        .btn-cambiar:active {
            transform: translateY(0);
        }

        /* Mensajes de feedback */
        .mensajeError {
            background: #ffdad6;
            color: #ba1a1a;
            padding: 10px 12px;
            border-radius: 6px;
            text-align: center;
            font-size: 13px;
            font-weight: 500;
            margin-bottom: 18px;
        }

        .mensajeOk {
            background: #d1fae5;
            color: #065f46;
            padding: 10px 12px;
            border-radius: 6px;
            text-align: center;
            font-size: 13px;
            font-weight: 500;
            margin-bottom: 18px;
        }

        .volver {
            font-family: 'Work Sans', sans-serif;
            text-align: center;
            margin-top: 24px;
            font-size: 13.5px;
        }

        .volver a {
            text-decoration: none;
            color: #c39d7a;
            font-weight: 700;
            transition: color 0.2s;
        }

        .volver a:hover {
            color: #8b4513;
            text-decoration: underline;
        }
    </style>

</head>

<body>

    <div class="card">

        <!-- Logo / Ícono de Carpintería -->
        <div style="text-align:center; margin-bottom:10px;">
            <img src="~/images/logo.png" alt="Logo CARPINTEC" style="width:58px; height:58px; object-fit:contain; display:inline-block;" onerror="this.style.display='none'">
        </div>

        <h2>Nueva Contraseña</h2>

        <p class="subtitulo">
            Ingresa y confirma la nueva contraseña para restablecer el acceso a tu cuenta.
        </p>

        @if (TempData["Error"] != null)
        {
            <div class="mensajeError">
                @TempData["Error"]
            </div>
        }

        @if (TempData["Success"] != null)
        {
            <div class="mensajeOk">
                @TempData["Success"]
            </div>
        }

        <form asp-controller="Recuperar"
              asp-action="GuardarNuevaContraseña"
              method="post">

            <!-- NUEVA CONTRASEÑA -->
            <label for="password">Nueva contraseña</label>

            <div class="password-wrapper">
                <input type="password"
                       id="password"
                       name="password"
                       minlength="8"
                       placeholder="Mínimo 8 caracteres"
                       required />

                <button type="button"
                        class="toggle-password"
                        onclick="togglePassword('password', this)"
                        aria-label="Mostrar contraseña">
                    👁
                </button>
            </div>

            <!-- CONFIRMAR CONTRASEÑA -->
            <label for="confirmarPassword">Confirmar contraseña</label>

            <div class="password-wrapper">
                <input type="password"
                       id="confirmarPassword"
                       name="confirmarPassword"
                       minlength="8"
                       placeholder="Confirma la nueva contraseña"
                       required />

                <button type="button"
                        class="toggle-password"
                        onclick="togglePassword('confirmarPassword', this)"
                        aria-label="Mostrar contraseña">
                    👁
                </button>
            </div>

            <!-- BOTÓN -->
            <button type="submit"
                    class="btn-cambiar">
                Cambiar Contraseña
            </button>

        </form>

        <div class="volver">
            <a asp-controller="Login"
               asp-action="Index">
                ← Cancelar y volver al inicio de sesión
            </a>
        </div>

    </div>

    <!-- JAVASCRIPT -->
    <script>
        function togglePassword(inputId, button) {
            const input = document.getElementById(inputId);
            if (input.type === "password") {
                input.type = "text";
                button.textContent = "🙈";
                button.setAttribute("aria-label", "Ocultar contraseña");
            } else {
                input.type = "password";
                button.textContent = "👁";
                button.setAttribute("aria-label", "Mostrar contraseña");
            }
        }
    </script>

</body>
</html>