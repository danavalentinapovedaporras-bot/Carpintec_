@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Mis Cotizaciones - Carpintec</title>

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
            tailwind.config = {
                theme: {
                    extend: {
                        colors: {
                            carpintecPrimary: '#8B5A2B',    /* Marrón madera */
                            carpintecSecondary: '#2F4F4F',  /* Azulado / Oscuro */
                            carpintecAccent: '#F7F7B5',     /* Beige claro de acento */
                            carpintecBackground: '#FFFFFF', /* Fondo blanco */
                            carpintecSurface: '#FAF3E0',    /* Fondo secundario / tarjetas */
                            carpintecText: '#333333',       /* Gris oscuro para texto */
                            carpintecTitle: '#5A3E1B'       /* Marrón oscuro para títulos */
                        }
                    }
                }
            }
    </script>

    <!-- Google Fonts: Montserrat y Open Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700&family=Open+Sans:wght@400;600&display=swap" rel="stylesheet">

    <!-- Material Symbols -->
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" />

    <style>
            body {
                font-family: 'Open Sans', sans-serif;
                background-color: #FAF3E0;
                color: #333333;
                margin: 0;
                padding: 0;
            }

            h1, h2, h3, h4, h5, h6, button, label, th {
                font-family: 'Montserrat', sans-serif;
            }
    </style>
</head>
<body class="antialiased min-h-screen py-10 px-4 md:px-8">

    <!-- CONTENEDOR PRINCIPAL DE LA VISTA -->
    <div class="max-w-6xl mx-auto space-y-6">

        <!-- Cabecera de la Página -->
        <div class="flex flex-col md:flex-row justify-between items-start md:items-center bg-carpintecBackground p-6 rounded-xl border border-[#8B5A2B]/20 shadow-sm gap-4">
            <div>
                <h1 class="text-2xl md:text-3xl font-bold text-carpintecTitle flex items-center gap-3">
                    <span class="material-symbols-outlined text-carpintecPrimary text-3xl">history_edu</span>
                    Historial de Mis Cotizaciones
                </h1>
                <p class="text-sm text-carpintecText/80 mt-1">
                    Consulte el estado de sus productos cotizados, cuáles han sido aprobados, pagados o se encuentran en proceso.
                </p>
            </div>
            <!-- Botón para solicitar nueva cotización o regresar -->
            <button type="button" onclick="abrirModalCotizacion()" class="px-5 py-2.5 bg-carpintecPrimary text-white text-sm font-bold rounded-lg shadow-md hover:bg-[#734A23] transition-colors flex items-center gap-2">
                <span class="material-symbols-outlined text-sm">add</span> Solicitar Cotización
            </button>
        </div>

        <!-- Tarjetas de Resumen Rápido (Indicadores de Estado) -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <!-- Aprobadas / Pagadas -->
            <div class="bg-carpintecBackground p-5 rounded-xl border border-[#8B5A2B]/20 shadow-sm flex items-center gap-4">
                <div class="p-3 bg-[#7ae67e]/20 text-[#2F4F4F] rounded-lg">
                    <span class="material-symbols-outlined text-2xl">task_alt</span>
                </div>
                <div>
                    <p class="text-xs font-bold text-carpintecText/70 uppercase">Aprobadas / Pagadas</p>
                    <h3 class="text-xl font-bold text-carpintecTitle">2</h3>
                </div>
            </div>
            <!-- Pendientes -->
            <div class="bg-carpintecBackground p-5 rounded-xl border border-[#8B5A2B]/20 shadow-sm flex items-center gap-4">
                <div class="p-3 bg-[#f2e605]/20 text-[#8B5A2B] rounded-lg">
                    <span class="material-symbols-outlined text-2xl">schedule</span>
                </div>
                <div>
                    <p class="text-xs font-bold text-carpintecText/70 uppercase">Pendientes de Revisión</p>
                    <h3 class="text-xl font-bold text-carpintecTitle">1</h3>
                </div>
            </div>
            <!-- Total de Cotizaciones -->
            <div class="bg-carpintecBackground p-5 rounded-xl border border-[#8B5A2B]/20 shadow-sm flex items-center gap-4">
                <div class="p-3 bg-carpintecSurface text-carpintecPrimary rounded-lg">
                    <span class="material-symbols-outlined text-2xl">receipt_long</span>
                </div>
                <div>
                    <p class="text-xs font-bold text-carpintecText/70 uppercase">Total Solicitadas</p>
                    <h3 class="text-xl font-bold text-carpintecTitle">3</h3>
                </div>
            </div>
        </div>

        <!-- Tabla de Listado de Cotizaciones del Cliente -->
        <div class="bg-carpintecBackground rounded-xl border border-[#8B5A2B]/20 shadow-sm overflow-hidden">
            <div class="p-5 border-b border-[#8B5A2B]/20">
                <h2 class="text-lg font-bold text-carpintecTitle">Detalle de Productos Cotizados</h2>
            </div>

            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="bg-carpintecSurface/60 text-carpintecTitle text-xs uppercase tracking-wider border-b border-[#8B5A2B]/20">
                            <th class="py-3 px-4 font-bold">Nº Cotización</th>
                            <th class="py-3 px-4 font-bold">Fecha</th>
                            <th class="py-3 px-4 font-bold">Producto / Mueble</th>
                            <th class="py-3 px-4 font-bold">Total ($)</th>
                            <th class="py-3 px-4 font-bold">Estado de Aprobación</th>
                            <th class="py-3 px-4 font-bold">Estado de Pago</th>
                            <th class="py-3 px-4 text-center font-bold">Acciones</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-[#8B5A2B]/10 text-sm text-carpintecText">

                        <!-- Fila de Ejemplo 1: Aprobada y Pagada -->
                        <tr class="hover:bg-carpintecSurface/30 transition-colors">
                            <td class="py-4 px-4 font-semibold text-carpintecPrimary">COT-2026-001</td>
                            <td class="py-4 px-4 text-xs">2026-06-01</td>
                            <td class="py-4 px-4 font-medium">Closet a medida en Madera Roble</td>
                            <td class="py-4 px-4 font-bold">$ 1,450.00</td>
                            <td class="py-4 px-4">
                                <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-semibold bg-[#7ae67e]/20 text-green-800">
                                    <span class="material-symbols-outlined text-xs">check_circle</span> Aprobada
                                </span>
                            </td>
                            <td class="py-4 px-4">
                                <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-semibold bg-[#7ae67e]/30 text-green-900">
                                    <span class="material-symbols-outlined text-xs">verified</span> Pagado
                                </span>
                            </td>
                            <td class="py-4 px-4 text-center">
                                <button class="p-1.5 hover:bg-carpintecSurface rounded-lg text-carpintecPrimary transition-colors" title="Ver Detalle">
                                    <span class="material-symbols-outlined text-base">visibility</span>
                                </button>
                            </td>
                        </tr>

                        <!-- Fila de Ejemplo 2: Pendiente -->
                        <tr class="hover:bg-carpintecSurface/30 transition-colors">
                            <td class="py-4 px-4 font-semibold text-carpintecPrimary">COT-2026-002</td>
                            <td class="py-4 px-4 text-xs">2026-06-05</td>
                            <td class="py-4 px-4 font-medium">Mesa de Centro Estilo Moderno</td>
                            <td class="py-4 px-4 font-bold">$ 380.00</td>
                            <td class="py-4 px-4">
                                <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-semibold bg-[#f2e605]/20 text-yellow-800">
                                    <span class="material-symbols-outlined text-xs">hourglass_top</span> Pendiente
                                </span>
                            </td>
                            <td class="py-4 px-4">
                                <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-semibold bg-gray-200 text-gray-700">
                                    <span class="material-symbols-outlined text-xs">remove</span> No pagado
                                </span>
                            </td>
                            <td class="py-4 px-4 text-center">
                                <button class="p-1.5 hover:bg-carpintecSurface rounded-lg text-carpintecPrimary transition-colors" title="Ver Detalle">
                                    <span class="material-symbols-outlined text-base">visibility</span>
                                </button>
                            </td>
                        </tr>

                        <!-- Fila de Ejemplo 3: Rechazada -->
                        <tr class="hover:bg-carpintecSurface/30 transition-colors">
                            <td class="py-4 px-4 font-semibold text-carpintecPrimary">COT-2026-003</td>
                            <td class="py-4 px-4 text-xs">2026-05-20</td>
                            <td class="py-4 px-4 font-medium">Biblioteca Empotrada de Pared</td>
                            <td class="py-4 px-4 font-bold">$ 920.00</td>
                            <td class="py-4 px-4">
                                <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-semibold bg-[#f70d07]/15 text-red-700">
                                    <span class="material-symbols-outlined text-xs">cancel</span> Rechazada
                                </span>
                            </td>
                            <td class="py-4 px-4">
                                <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-semibold bg-gray-200 text-gray-700">
                                    <span class="material-symbols-outlined text-xs">remove</span> N/A
                                </span>
                            </td>
                            <td class="py-4 px-4 text-center">
                                <button class="p-1.5 hover:bg-carpintecSurface rounded-lg text-carpintecPrimary transition-colors" title="Ver Detalle">
                                    <span class="material-symbols-outlined text-base">visibility</span>
                                </button>
                            </td>
                        </tr>

                    </tbody>
                </table>
            </div>
        </div>

    </div>

</body>
</html>