@model IEnumerable<CARPINTEC_App.Models.Cotizacion>
@{
    Layout = null;
    int totalCotizaciones = ViewBag.TotalCotizaciones ?? (Model != null ? Model.Count() : 0);
    int aprobadas = ViewBag.Aprobadas ?? (Model != null ? Model.Count(c => c.Estado != null && (c.Estado.Equals("Aprobada", StringComparison.OrdinalIgnoreCase) || c.Estado.Equals("Pagada", StringComparison.OrdinalIgnoreCase))) : 0);
    int pendientes = ViewBag.Pendientes ?? (Model != null ? Model.Count(c => c.Estado != null && c.Estado.Equals("Pendiente", StringComparison.OrdinalIgnoreCase)) : 0);
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Mis Cotizaciones - Carpintec</title>

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        carpintecPrimary: '#8B5A2B',    /* Marrón madera */
                        carpintecSecondary: '#2F4F4F',  /* Azulado / Oscuro */
                        carpintecAccent: '#F7F7B5',     /* Beige claro de acento */
                        carpintecBackground: '#FFFFFF', /* Fondo blanco */
                        carpintecSurface: '#FAF3E0',    /* Fondo secundario / tarjetas */
                        carpintecText: '#333333',       /* Gris oscuro para texto */
                        carpintecTitle: '#5A3E1B',      /* Marrón oscuro para títulos */
                        primary: '#8B5A2B',
                        'on-surface': '#2E1F14',
                        'on-surface-variant': '#6B584C',
                        'outline': '#9C877A',
                        'outline-variant': '#E5D8D0',
                        'surface-container-low': '#F7EFE9',
                        'secondary-container': '#734A23'
                    }
                }
            }
        }
    </script>

    <!-- Google Fonts: Montserrat y Open Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@500;600;700;800&family=Open+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">

    <!-- Material Symbols -->
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" />

    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA==" crossorigin="anonymous" referrerpolicy="no-referrer" />

    <style>
        body {
            font-family: 'Open Sans', sans-serif;
            background-color: #FAF3E0;
            color: #333333;
            margin: 0;
            padding: 0;
        }

        h1, h2, h3, h4, h5, h6, button, label, th, .font-heading {
            font-family: 'Montserrat', sans-serif;
        }

        /* Estilos para las tarjetas y campos del modal */
        .card-container {
            background-color: #FFFFFF;
            border: 1px solid #EADDD5;
            border-radius: 0.875rem;
            padding: 1.25rem;
            box-shadow: 0 2px 6px rgba(90, 62, 27, 0.04);
            transition: border-color 0.2s, box-shadow 0.2s;
        }

        .card-container:hover {
            border-color: #D2BEB0;
        }

        .section-title {
            font-size: 0.8rem;
            font-weight: 700;
            letter-spacing: 0.05em;
            color: #5A3E1B;
            margin-bottom: 0.875rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            text-transform: uppercase;
        }

        .section-icon {
            color: #8B5A2B;
        }

        .input-field {
            width: 100%;
            background-color: #FAF7F4;
            border: 1px solid #D9C8BE;
            border-radius: 0.625rem;
            padding: 0.625rem 0.875rem;
            font-size: 0.875rem;
            color: #2E1F14;
            transition: all 0.2s ease-in-out;
        }

        .input-field:focus {
            outline: none;
            background-color: #FFFFFF;
            border-color: #8B5A2B;
            box-shadow: 0 0 0 3px rgba(139, 90, 43, 0.15);
        }

        .input-field::placeholder {
            color: #A39084;
            font-weight: 400;
        }

        /* Custom Scrollbar */
        ::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }

        ::-webkit-scrollbar-track {
            background: #F2E8DC;
        }

        ::-webkit-scrollbar-thumb {
            background: #C4AD9D;
            border-radius: 4px;
        }

        ::-webkit-scrollbar-thumb:hover {
            background: #8B5A2B;
        }
    </style>
</head>
<body class="antialiased min-h-screen flex flex-col">

    <!-- BARRA SUPERIOR DE NAVEGACIÓN CLIENTE -->
    <header class="w-full bg-[#8B5A2B] text-white shadow-md sticky top-0 z-40">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
            <div class="flex items-center gap-3">
                <a asp-controller="DashboardCliente" asp-action="Index" class="w-9 h-9 flex items-center justify-center rounded-lg hover:bg-white/10 transition-colors" title="Volver al inicio">
                    <span class="material-symbols-outlined text-2xl">arrow_back</span>
                </a>
                <span class="font-bold text-xl uppercase tracking-wider font-heading flex items-center gap-2">
                        <img alt="Carpintec Logo"
                     class="h-8 w-8 object-contain mr-2"
                     src="~/images/logo.png">
                   
                    Carpintec
                </span>
            </div>
            <!-- Enlaces del Portal de Cliente -->
            <nav class="hidden md:flex items-center gap-2 text-sm font-semibold">
                <a asp-controller="DashboardCliente" asp-action="Index" class="px-3 py-1.5 rounded-lg text-white/85 hover:text-white hover:bg-white/10 transition-colors">
                    Inicio
                </a>
                <a asp-controller="MisProductos" asp-action="Index" class="px-3 py-1.5 rounded-lg text-white/85 hover:text-white hover:bg-white/10 transition-colors">
                    Catálogo
                </a>
                <a asp-controller="MiCotizacion" asp-action="Index" class="px-3 py-1.5 rounded-lg bg-white/20 text-white border-b-2 border-carpintecAccent font-bold">
                    Mis Cotizaciones
                </a>
                <a asp-controller="Mi_Pedido" asp-action="Index" class="px-3 py-1.5 rounded-lg text-white/85 hover:text-white hover:bg-white/10 transition-colors">
                    Mis Pedidos
                </a>
                <a asp-controller="Miperfil" asp-action="Index" class="px-3 py-1.5 rounded-lg text-white/85 hover:text-white hover:bg-white/10 transition-colors">
                    Mi Perfil
                </a>
            </nav>
            <div class="flex items-center gap-2">
                @await Html.PartialAsync("_ClientUserMenu")
            </div>
        </div>
    </header>

    <!-- CONTENEDOR PRINCIPAL DE LA VISTA -->
    <main class="flex-1 max-w-6xl w-full mx-auto p-4 md:p-6 lg:p-8 space-y-6">

        <!-- Cabecera de la Página -->
        <div class="flex flex-col md:flex-row justify-between items-start md:items-center bg-carpintecBackground p-6 rounded-2xl border border-[#8B5A2B]/20 shadow-sm gap-4">
            <div>
                <div class="flex items-center gap-2 text-xs font-bold text-carpintecPrimary uppercase tracking-wider mb-1">
                    <a asp-controller="DashboardCliente" asp-action="Index" class="hover:underline flex items-center gap-1">
                        <span class="material-symbols-outlined text-sm">home</span> Inicio
                    </a>
                    <span>/</span>
                    <span>Mis Cotizaciones</span>
                </div>
                <h1 class="text-2xl md:text-3xl font-bold text-carpintecTitle flex items-center gap-3">
                    <span class="material-symbols-outlined text-carpintecPrimary text-3xl">history_edu</span>
                    Historial de Mis Cotizaciones
                </h1>
                <p class="text-sm text-carpintecText/80 mt-1">
                    Consulte el estado de sus muebles y piezas cotizadas, presupuestos aprobados y solicitudes en proceso técnico.
                </p>
            </div>
            <!-- Botón para solicitar nueva cotización -->
            <button type="button" onclick="abrirModalCotizacion()" class="px-5 py-3 bg-carpintecPrimary text-white text-sm font-bold rounded-xl shadow-md hover:bg-[#734A23] transition-all transform active:scale-95 flex items-center gap-2">
                <span class="material-symbols-outlined text-lg">add_circle</span> Solicitar Cotización
            </button>
        </div>

        <!-- Tarjetas de Resumen Rápido (Indicadores de Estado) -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <!-- Aprobadas / Pagadas -->
            <div class="bg-carpintecBackground p-5 rounded-2xl border border-[#8B5A2B]/20 shadow-sm flex items-center gap-4">
                <div class="w-12 h-12 bg-green-100 text-green-700 rounded-xl flex items-center justify-center shrink-0">
                    <span class="material-symbols-outlined text-2xl">task_alt</span>
                </div>
                <div>
                    <p class="text-xs font-bold text-carpintecText/70 uppercase">Aprobadas / Pagadas</p>
                    <h3 class="text-2xl font-bold text-carpintecTitle">@aprobadas</h3>
                </div>
            </div>
            <!-- Pendientes -->
            <div class="bg-carpintecBackground p-5 rounded-2xl border border-[#8B5A2B]/20 shadow-sm flex items-center gap-4">
                <div class="w-12 h-12 bg-amber-100 text-amber-800 rounded-xl flex items-center justify-center shrink-0">
                    <span class="material-symbols-outlined text-2xl">schedule</span>
                </div>
                <div>
                    <p class="text-xs font-bold text-carpintecText/70 uppercase">Pendientes de Revisión</p>
                    <h3 class="text-2xl font-bold text-carpintecTitle">@pendientes</h3>
                </div>
            </div>
            <!-- Total de Cotizaciones -->
            <div class="bg-carpintecBackground p-5 rounded-2xl border border-[#8B5A2B]/20 shadow-sm flex items-center gap-4">
                <div class="w-12 h-12 bg-[#8B5A2B]/10 text-carpintecPrimary rounded-xl flex items-center justify-center shrink-0">
                    <span class="material-symbols-outlined text-2xl">receipt_long</span>
                </div>
                <div>
                    <p class="text-xs font-bold text-carpintecText/70 uppercase">Total Solicitadas</p>
                    <h3 class="text-2xl font-bold text-carpintecTitle">@totalCotizaciones</h3>
                </div>
            </div>
        </div>

        <!-- Tabla de Listado de Cotizaciones del Cliente -->
        <div class="bg-carpintecBackground rounded-2xl border border-[#8B5A2B]/20 shadow-sm overflow-hidden">
            <div class="p-5 border-b border-[#8B5A2B]/20 flex justify-between items-center bg-white">
                <h2 class="text-lg font-bold text-carpintecTitle flex items-center gap-2">
                    <span class="material-symbols-outlined text-carpintecPrimary">table_rows</span>
                    Detalle de Productos Cotizados
                </h2>
                <span class="text-xs text-carpintecText/60">
                    @totalCotizaciones @(totalCotizaciones == 1 ? "registro encontrado" : "registros encontrados")
                </span>
            </div>

            @if (Model != null && Model.Any())
            {
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="bg-carpintecSurface/60 text-carpintecTitle text-xs uppercase tracking-wider border-b border-[#8B5A2B]/20">
                                <th class="py-3.5 px-4 font-bold">Nº Cotización</th>
                                <th class="py-3.5 px-4 font-bold">Fecha</th>
                                <th class="py-3.5 px-4 font-bold">Producto / Mueble</th>
                                <th class="py-3.5 px-4 font-bold">Madera</th>
                                <th class="py-3.5 px-4 font-bold">Total ($)</th>
                                <th class="py-3.5 px-4 font-bold">Estado</th>
                                <th class="py-3.5 px-4 text-center font-bold">Acciones</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-[#8B5A2B]/10 text-sm text-carpintecText">
                            @foreach (var item in Model)
                            {
                                string estadoLower = (item.Estado ?? "pendiente").ToLower();
                                string badgeClase = "bg-amber-100 text-amber-800 border border-amber-300";
                                string iconEstado = "hourglass_top";

                                if (estadoLower == "aprobada" || estadoLower == "pagada" || estadoLower == "finalizada")
                                {
                                    badgeClase = "bg-green-100 text-green-800 border border-green-300";
                                    iconEstado = "check_circle";
                                }
                                else if (estadoLower == "rechazada" || estadoLower == "cancelada")
                                {
                                    badgeClase = "bg-red-100 text-red-700 border border-red-300";
                                    iconEstado = "cancel";
                                }

                                string nombreProducto = !string.IsNullOrWhiteSpace(item.DetalleProducto)
                                    ? item.DetalleProducto
                                    : (item.DetalleCotizacions?.FirstOrDefault()?.IdProductoNavigation?.Nombre ?? "Mueble personalizado");

                                string tipoMadera = !string.IsNullOrWhiteSpace(item.TipoMadera)
                                    ? item.TipoMadera
                                    : (item.DetalleCotizacions?.FirstOrDefault()?.IdProductoNavigation?.Material ?? "Pino Macizo");

                                string medidasItem = !string.IsNullOrWhiteSpace(item.Medidas)
                                    ? item.Medidas
                                    : (item.DetalleCotizacions?.FirstOrDefault()?.Medidas ?? "");

                                int cantidadItem = item.Cantidad ?? item.DetalleCotizacions?.FirstOrDefault()?.Cantidad ?? 1;

                                <tr class="hover:bg-carpintecSurface/30 transition-colors">
                                    <td class="py-4 px-4 font-bold text-carpintecPrimary font-mono">@item.Folio</td>
                                    <td class="py-4 px-4 text-xs font-medium text-gray-600">@item.Fecha.ToString("yyyy-MM-dd")</td>
                                    <td class="py-4 px-4">
                                        <div class="font-semibold text-gray-800">@nombreProducto</div>
                                        @if (!string.IsNullOrEmpty(medidasItem))
                                        {
                                            <div class="text-xs text-gray-500 mt-0.5 flex items-center gap-1">
                                                <i class="fa-solid fa-ruler-combined text-[10px] text-[#8B5A2B]/70"></i>
                                                <span>@medidasItem</span>
                                            </div>
                                        }
                                    </td>
                                    <td class="py-4 px-4 text-xs">
                                        <span class="bg-[#8B5A2B]/10 text-carpintecPrimary px-2.5 py-1 rounded-md font-medium inline-flex items-center gap-1">
                                            <i class="fa-solid fa-tree text-[10px]"></i>
                                            @tipoMadera
                                        </span>
                                        @if (cantidadItem > 1)
                                        {
                                            <span class="ml-1 text-gray-600 font-bold">x@cantidadItem</span>
                                        }
                                    </td>
                                    <td class="py-4 px-4 font-bold text-carpintecTitle">
                                        $ @item.Total.ToString("N0") COP
                                    </td>
                                    <td class="py-4 px-4">
                                        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold @badgeClase">
                                            <span class="material-symbols-outlined text-xs">@iconEstado</span>
                                            @(item.Estado ?? "Pendiente")
                                        </span>
                                    </td>
                                    <td class="py-4 px-4 text-center">
                                        <button type="button" onclick="verDetalleCotizacion(@item.IdCotizacion)" class="p-2 hover:bg-[#8B5A2B]/10 rounded-xl text-carpintecPrimary transition-colors inline-flex items-center justify-center" title="Ver Detalle Completo">
                                            <span class="material-symbols-outlined text-lg">visibility</span>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <!-- Estado vacío cuando no hay cotizaciones -->
                <div class="text-center py-16 px-4">
                    <div class="w-16 h-16 bg-[#8B5A2B]/10 text-carpintecPrimary rounded-full flex items-center justify-center mx-auto mb-4">
                        <span class="material-symbols-outlined text-3xl">post_add</span>
                    </div>
                    <h3 class="text-lg font-bold text-carpintecTitle mb-1">Aún no tienes cotizaciones registradas</h3>
                    <p class="text-sm text-carpintecText/70 max-w-md mx-auto mb-6">
                        Puedes solicitar el presupuesto para tus muebles de madera a medida ahora mismo de forma rápida y sencilla.
                    </p>
                    <button type="button" onclick="abrirModalCotizacion()" class="px-6 py-2.5 bg-carpintecPrimary text-white text-sm font-bold rounded-lg shadow hover:bg-[#734A23] transition-colors inline-flex items-center gap-2">
                        <span class="material-symbols-outlined text-sm">add</span> Crear Mi Primera Cotización
                    </button>
                </div>
            }
        </div>

    </main>

    <!-- ========================================== -->
    <!-- MODAL DE NUEVA COTIZACIÓN                  -->
    <!-- ========================================== -->
    <div id="modalNuevaCotizacion" class="fixed inset-0 z-50 hidden overflow-y-auto bg-black/60 backdrop-blur-sm flex justify-center items-center p-4 md:p-6">

        <!-- Contenedor interno del modal -->
        <div class="bg-[#FAF6F2] w-full max-w-[1300px] rounded-3xl shadow-2xl overflow-hidden relative max-h-[92vh] flex flex-col border border-[#E0D2C7]">

            <!-- Barra Superior del Modal -->
            <div class="bg-white border-b border-[#EADDD5] px-6 py-4 flex items-center justify-between shrink-0">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-[#8B5A2B]/15 text-carpintecPrimary flex items-center justify-center">
                        <i class="fa-solid fa-file-invoice text-lg"></i>
                    </div>
                    <div>
                        <h2 class="text-xl font-extrabold text-carpintecTitle uppercase tracking-tight">
                            Nueva <span class="text-carpintecPrimary">Cotización</span>
                        </h2>
                        <p class="text-xs text-carpintecText/70">Define los detalles técnicos para tu pieza personalizada de carpintería.</p>
                    </div>
                </div>

                <!-- Botón cerrar modal -->
                <button type="button" onclick="cerrarModalCotizacion()" class="w-9 h-9 bg-gray-100 border border-gray-200 rounded-full flex items-center justify-center text-gray-600 hover:bg-red-50 hover:text-red-600 transition-colors shadow-sm" title="Cerrar ventana">
                    <i class="fa-solid fa-xmark text-base"></i>
                </button>
            </div>

            <!-- Contenido del Formulario (con Scroll) -->
            <div class="overflow-y-auto p-6 md:p-8 space-y-6 flex-1">
                <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">

                    <!-- Left Column (Form Area) -->
                    <div class="lg:col-span-8 space-y-6">

                        <!-- Grid para los campos del formulario -->
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                            <!-- Client Info -->
                            <section class="card-container" data-purpose="client-info">
                                <h3 class="section-title">
                                    <i class="fa-regular fa-user section-icon"></i> Información del Cliente
                                </h3>
                                <div class="space-y-3">
                                    <div class="relative">
                                        <i class="fa-regular fa-user absolute left-3.5 top-1/2 -translate-y-1/2 text-[#A39084]"></i>
                                        <input id="txtCliente" class="input-field pl-10" type="text" placeholder="Nombre completo" value="@ViewBag.NombreCliente">
                                    </div>
                                    <div class="relative">
                                        <i class="fa-solid fa-phone absolute left-3.5 top-1/2 -translate-y-1/2 text-[#A39084] text-xs"></i>
                                        <input id="txtTelefono" class="input-field pl-10" type="text" placeholder="Teléfono de contacto" value="@ViewBag.TelefonoCliente">
                                    </div>
                                    <div class="relative">
                                        <i class="fa-regular fa-envelope absolute left-3.5 top-1/2 -translate-y-1/2 text-[#A39084]"></i>
                                        <input id="txtEmail" class="input-field pl-10" type="email" placeholder="Correo electrónico" value="@ViewBag.CorreoCliente">
                                    </div>
                                </div>
                            </section>

                            <!-- Product Details -->
                            <section class="card-container" data-purpose="product-details">
                                <h3 class="section-title">
                                    <i class="fa-solid fa-cube section-icon text-sm"></i> Detalles del Producto
                                </h3>
                                <div class="space-y-3 h-full flex flex-col justify-between">
                                    <div class="relative">
                                        <input id="selectProducto" list="listaProductos" class="input-field pr-10 font-semibold" placeholder="Escribe o selecciona un producto...">
                                        <datalist id="listaProductos">
                                            <option value="Mesa de Comedor Artesanal"></option>
                                            <option value="Escritorio Moderno de Oficina"></option>
                                            <option value="Closet Empotrado en Roble"></option>
                                            <option value="Biblioteca de Pared Flotante"></option>
                                            <option value="Cama Rústica King Size"></option>
                                            <option value="Cómoda con Gaveteros"></option>
                                            <option value="Mueble para TV y Entretenimiento"></option>
                                        </datalist>
                                        <i class="fa-solid fa-pen-to-square absolute right-4 top-1/2 -translate-y-1/2 text-[#A39084] text-sm pointer-events-none"></i>
                                    </div>
                                    <div class="p-2.5 bg-[#FAF7F4] rounded-lg border border-[#EADDD5] text-xs flex items-center justify-between">
                                        <span class="text-carpintecText/70 font-semibold">Acabado sugerido:</span>
                                        <span class="font-bold text-carpintecPrimary">Natural / Barniz Mate</span>
                                    </div>
                                </div>
                            </section>

                            <!-- Wood Type -->
                            <section class="card-container" data-purpose="wood-type">
                                <h3 class="section-title">
                                    <i class="fa-solid fa-tree section-icon text-sm"></i> Tipo de Madera
                                </h3>
                                <div class="relative">
                                    <select id="selectMadera" class="input-field appearance-none pr-10 font-bold text-carpintecTitle cursor-pointer">
                                        <option value="Pino Macizo">Pino Macizo (Económico & Resistente)</option>
                                        <option value="Roble">Roble (Duro & Elegante)</option>
                                        <option value="Cedro">Cedro (Fino & Aromático)</option>
                                        <option value="Nogal">Nogal (Premium & Exclusivo)</option>
                                    </select>
                                    <i class="fa-solid fa-chevron-down absolute right-4 top-1/2 -translate-y-1/2 text-[#A39084] text-sm pointer-events-none"></i>
                                </div>
                                <div class="mt-2 text-right">
                                    <span id="labelPrecioMadera" class="text-xs font-bold text-carpintecPrimary">Base: $320.000 COP</span>
                                </div>
                            </section>

                            <!-- Quantity -->
                            <section class="card-container flex flex-col justify-between" data-purpose="quantity">
                                <h3 class="section-title">
                                    <i class="fa-solid fa-boxes-stacked section-icon text-sm"></i> Cantidad de Piezas
                                </h3>
                                <div class="flex items-center mt-2">
                                    <button type="button" onclick="cambiarCantidad(-1)" class="w-12 h-11 bg-[#F2E8DC] text-carpintecTitle font-bold flex items-center justify-center rounded-l-xl hover:bg-[#E2D2C2] transition-colors active:scale-95">
                                        <i class="fa-solid fa-minus text-sm"></i>
                                    </button>
                                    <input id="inputCantidad" class="w-20 h-11 text-center border-y border-[#D9C8BE] font-bold text-xl focus:outline-none bg-white text-carpintecTitle" type="number" value="1" min="1">
