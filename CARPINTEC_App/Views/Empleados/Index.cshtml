    <script>

            function abrirModalVer(id) {

                fetch('/Empleados/ObtenerEmpleado?id=' + id)
                    .then(response => response.json())
                    .then(data => {

                        let fechaIni = data.fechaInicioEstado || data.fechaInicioVacaciones;
                        let fechaFin = data.fechaFinEstado || data.fechaFinVacaciones;
                        let textoPeriodo = '';
                        if (fechaIni && fechaFin) {
                            textoPeriodo = `<div class="p-3 bg-amber-50 rounded-xl border border-amber-200 text-amber-950 mt-3">
                                <p class="font-bold flex items-center gap-1"><span class="material-symbols-outlined text-sm text-[#b07d4b]">calendar_month</span> Periodo de ${data.estado}:</p>
                                <p class="text-sm mt-1">Del <b>${formatearFechaLocal(fechaIni)}</b> al <b>${formatearFechaLocal(fechaFin)}</b></p>
                            </div>`;
                        }

                        document.getElementById("datosEmpleado").innerHTML = `

                                <p><b>Documento:</b> ${data.documento}</p>
                                <p><b>Nombre:</b> ${data.nombre} ${data.apellido}</p>
                                <p><b>Cargo:</b> ${data.cargo}</p>
                                <p><b>Correo:</b> ${data.correo ?? ''}</p>
                                <p><b>Teléfono:</b> ${data.telefono ?? ''}</p>
                                <p><b>Estado:</b> ${data.estado}</p>
                                ${textoPeriodo}

                            `;


                        document.getElementById("modalVerEmpleado")
                            .classList.remove("hidden");

                        document.getElementById("modalVerEmpleado")
                            .classList.add("flex");

                    });

            }



            function cerrarModalVer() {

                document.getElementById("modalVerEmpleado")
                    .classList.add("hidden");

                document.getElementById("modalVerEmpleado")
                    .classList.remove("flex");

            }



            function abrirModalEditar(id) {

                fetch('/Empleados/ObtenerEmpleado?id=' + id)

                    .then(response => response.json())

                    .then(data => {


                        document.getElementById("editarIdEmpleado").value = data.idEmpleado;
                        document.getElementById("editarDocumento").value = data.documento;
                        document.getElementById("editarNombre").value = data.nombre;
                        document.getElementById("editarApellido").value = data.apellido;
                        document.getElementById("editarCargo").value = data.cargo;
                        document.getElementById("editarCorreo").value = data.correo ?? "";
                        document.getElementById("editarTelefono").value = data.telefono ?? "";
                        document.getElementById("editarDireccion").value = data.direccion ?? "";
                        document.getElementById("editarSalario").value = data.salario ?? 0;
                        const fechaIniEdit = data.fechaInicioEstado || data.fechaInicioVacaciones || "";
                        const fechaFinEdit = data.fechaFinEstado || data.fechaFinVacaciones || "";
                        document.getElementById("editarFechaInicioVacaciones").value = fechaIniEdit;
                        document.getElementById("editarFechaFinVacaciones").value = fechaFinEdit;



                        document.getElementById("modalEditarEmpleado")
                            .classList.remove("hidden");


                        document.getElementById("modalEditarEmpleado")
                            .classList.add("flex");


                    });

            }




            function cerrarModalEditar() {

                document.getElementById("modalEditarEmpleado")
                    .classList.add("hidden");


                document.getElementById("modalEditarEmpleado")
                    .classList.remove("flex");

            }




            function guardarEditarEmpleado() {


                const fIni = document.getElementById("editarFechaInicioVacaciones").value || null;
                const fFin = document.getElementById("editarFechaFinVacaciones").value || null;

                let empleado = {


                    idEmpleado:
                        document.getElementById("editarIdEmpleado").value,


                    documento:
                        document.getElementById("editarDocumento").value,


                    nombre:
                        document.getElementById("editarNombre").value,


                    apellido:
                        document.getElementById("editarApellido").value,


                    cargo:
                        document.getElementById("editarCargo").value,


                    correo:
                        document.getElementById("editarCorreo").value,


                    telefono:
                        document.getElementById("editarTelefono").value,


                    direccion:
                        document.getElementById("editarDireccion").value,


                    salario:
                        document.getElementById("editarSalario").value,

                    fechaInicioVacaciones: fIni,

                    fechaFinVacaciones: fFin,

                    fechaInicioEstado: fIni,

                    fechaFinEstado: fFin

                };



                fetch('/Empleados/EditarEmpleado',
                    {

                        method: 'POST',

                        headers: {
                            'Content-Type': 'application/json'
                        },


                        body: JSON.stringify(empleado)

                    })


                    .then(response => {

                        if (response.ok) {

                            location.reload();

                        }
                        else {

                            alert("Error al actualizar empleado");

                        }

                    });


            }





            function abrirModalEstado(id) {
                fetch('/Empleados/ObtenerEmpleado?id=' + id)
                    .then(response => response.json())
                    .then(data => {
                        document.getElementById("estadoIdEmpleado").value = data.idEmpleado;
                        document.getElementById("nuevoEstado").value = data.estado;
                        document.getElementById("estadoFechaInicio").value = data.fechaInicioVacaciones ?? "";
                        document.getElementById("estadoFechaFin").value = data.fechaFinVacaciones ?? "";

                        toggleCamposVacaciones(data.estado === "Vacaciones");

                        document.getElementById("modalEstadoEmpleado").classList.remove("hidden");
                        document.getElementById("modalEstadoEmpleado").classList.add("flex");
                    });
            }

            function toggleCamposVacaciones(mostrar) {
                const cont = document.getElementById("contenedorFechasVacaciones");
                if (cont) {
                    if (mostrar) cont.classList.remove("hidden");
                    else cont.classList.add("hidden");
                }
            }

            function cerrarModalEstado() {
                document.getElementById("modalEstadoEmpleado").classList.add("hidden");
                document.getElementById("modalEstadoEmpleado").classList.remove("flex");
            }

            function guardarEstadoEmpleado() {
                const estado = document.getElementById("nuevoEstado").value;
                const fechaInicio = document.getElementById("estadoFechaInicio").value || null;
                const fechaFin = document.getElementById("estadoFechaFin").value || null;

                if (estado === "Vacaciones") {
                    if (!fechaInicio || !fechaFin) {
                        alert("Por favor ingrese tanto la fecha de inicio como la fecha de fin de las vacaciones.");
                        return;
                    }
                    if (fechaFin < fechaInicio) {
                        alert("La fecha de fin de vacaciones no puede ser anterior a la fecha de inicio.");
                        return;
                    }
                }

                let datos = {
                    idEmpleado: document.getElementById("estadoIdEmpleado").value,
                    estado: estado,
                    fechaInicioVacaciones: fechaInicio,
                    fechaFinVacaciones: fechaFin
                };

                fetch('/Empleados/CambiarEstado', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(datos)
                })
                .then(response => {
                    if (response.ok) {
                        location.reload();
                    }
                    else {
                        alert("Error cambiando estado");
                    }
                });
            }


    </script>
