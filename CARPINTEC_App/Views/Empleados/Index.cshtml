                    </div>
                </div>
                <p id="calMsgError" class="text-xs text-red-600 font-bold mt-2 hidden">⚠️ La fecha fin no puede ser anterior a la fecha inicio.</p>
            </div>

            <!-- Lista de empleados en vacaciones (vista general) -->
            <div id="calListaEmpleadosGeneral" class="mt-6 pt-4 border-t border-gray-200 hidden">
                <h5 class="text-xs uppercase tracking-wider font-extrabold text-gray-600 mb-3">Personal en periodo de vacaciones</h5>
                <div id="calContenedorListaEmpleados" class="space-y-2 max-h-48 overflow-y-auto"></div>
            </div>

            <div class="flex justify-end gap-3 mt-6">
                <button type="button"
                        onclick="cerrarModalCalendario()"
                        class="px-5 py-2.5 rounded-xl font-bold transition text-sm border border-gray-300 hover:bg-gray-50">
                    Cancelar
                </button>
                <!-- Botón guardar: visible solo en modo editar -->
                <button type="button"
                        id="calBtnGuardar"
                        onclick="calGuardarFechas()"
                        class="hidden px-6 py-2.5 rounded-xl font-bold transition shadow-sm text-sm flex items-center gap-2"
                        style="background:#D2B48C; color:#442a22;">
                    <span class="material-symbols-outlined text-sm" style="vertical-align:middle">save</span>
                    Guardar Fechas
                </button>
                <!-- Botón cerrar: visible solo en modo vista -->
                <button type="button"
                        id="calBtnCerrar"
                        onclick="cerrarModalCalendario()"
                        class="px-6 py-2.5 rounded-xl font-bold transition shadow-sm text-sm"
                        style="background:#D2B48C; color:#442a22;">
                    Cerrar
                </button>
            </div>
        </div>
    </div>

    <!-- SCRIPT DE CONTROL DEL CALENDARIO DE VACACIONES -->
    <script>
        let calFechaActualVisual = new Date();
        let calFechaInicioSel = null;
        let calFechaFinSel = null;
        let calModoEdicion = false;        // true = permite editar y guardar
        let calIdEmpleado = null;          // id del empleado en modo edición
        let calEstadoEmpleado = null;      // estado actual del empleado en modo edición
        let calSeleccionando = 'inicio';   // 'inicio' o 'fin' para selección por clic

        // Lista de empleados en vacaciones obtenida desde Razor
        const empleadosVacacionesDatos = [
            @foreach (var emp in (ViewBag.EmpleadosVacaciones as List<CARPINTEC_App.Models.Empleado> ?? new List<CARPINTEC_App.Models.Empleado>()))
            {
                <text>{
                    id: @emp.IdEmpleado,
                    nombre: "@emp.Nombre @emp.Apellido",
                    cargo: "@emp.Cargo",
                    inicio: "@(emp.FechaInicioVacaciones?.ToString("yyyy-MM-dd") ?? "")",
                    fin: "@(emp.FechaFinVacaciones?.ToString("yyyy-MM-dd") ?? "")"
                },</text>
            }
        ];

        // ─── Abrir en modo DETALLE (solo lectura) ───────────────────────────
        function abrirCalendarioDetalle(nombreEmpleado, inicioStr, finStr, estado) {
            calModoEdicion = false;
            calIdEmpleado = null;
            calEstadoEmpleado = null;
            const tituloEstado = estado || 'Vacaciones';
            document.getElementById("calModalTitulo").innerText = tituloEstado + " de " + nombreEmpleado;
            document.getElementById("calModalSubtitulo").innerText = "Periodo programado para el empleado";
            document.getElementById("calListaEmpleadosGeneral").classList.add("hidden");
            calAplicarModo();
            configurarPeriodoCalendario(inicioStr, finStr);
            document.getElementById("modalCalendarioVacaciones").classList.remove("hidden");
            document.getElementById("modalCalendarioVacaciones").classList.add("flex");
        }

        // ─── Abrir en modo EDICIÓN (permite guardar fechas) ─────────────────
        function abrirCalendarioEditar(idEmpleado, nombreEmpleado, estado, inicioStr, finStr) {
            calModoEdicion = true;
            calIdEmpleado = idEmpleado;
            calEstadoEmpleado = estado;
            calSeleccionando = 'inicio';
            document.getElementById("calModalTitulo").innerText = "Asignar periodo — " + nombreEmpleado;
            document.getElementById("calModalSubtitulo").innerText = "Selecciona las fechas de " + estado;
            document.getElementById("calListaEmpleadosGeneral").classList.add("hidden");
            // Pre-cargar inputs con fechas actuales si existen
            document.getElementById("calInputInicio").value = inicioStr || "";
            document.getElementById("calInputFin").value = finStr || "";
            document.getElementById("calMsgError").classList.add("hidden");
            calAplicarModo();
            configurarPeriodoCalendario(inicioStr || null, finStr || null);
            document.getElementById("modalCalendarioVacaciones").classList.remove("hidden");
            document.getElementById("modalCalendarioVacaciones").classList.add("flex");
        }

        // ─── Mostrar/ocultar elementos según el modo ────────────────────────
        function calAplicarModo() {
            const panelEdicion    = document.getElementById("calPanelEdicion");
            const btnGuardar      = document.getElementById("calBtnGuardar");
            const btnCerrar       = document.getElementById("calBtnCerrar");
            const leyendaEdicion  = document.getElementById("calLeyendaEdicion");
            if (calModoEdicion) {
                panelEdicion.classList.remove("hidden");
                btnGuardar.classList.remove("hidden");
                btnCerrar.classList.add("hidden");
                leyendaEdicion.classList.remove("hidden");
                leyendaEdicion.classList.add("flex");
            } else {
                panelEdicion.classList.add("hidden");
                btnGuardar.classList.add("hidden");
                btnCerrar.classList.remove("hidden");
                leyendaEdicion.classList.add("hidden");
            }
        }

        // ─── Abrir calendario general ───────────────────────────────────────
        function abrirModalCalendarioGeneral() {
            calModoEdicion = false;
            calIdEmpleado = null;
            document.getElementById("calModalTitulo").innerText = "Calendario General de Vacaciones";
            document.getElementById("calModalSubtitulo").innerText = "Resumen del personal de CARPINTEC en vacaciones";
            calAplicarModo();

            const contenedorLista = document.getElementById("calContenedorListaEmpleados");
            contenedorLista.innerHTML = '';

            const conFechas = empleadosVacacionesDatos.filter(e => e.inicio && e.fin);

            if (conFechas.length > 0) {
                conFechas.forEach(e => {
                    const hoy = new Date();
                    hoy.setHours(0, 0, 0, 0);
                    const dInicio = new Date(e.inicio + 'T00:00:00');
                    const dFin = new Date(e.fin + 'T00:00:00');
                    let textoEstado = '';

                    if (hoy < dInicio) {
                        const diff = Math.ceil((dInicio - hoy) / (1000 * 60 * 60 * 24));
                        textoEstado = `⏳ Inicia en ${diff} día(s)`;
                    } else if (hoy <= dFin) {
                        const diff = Math.ceil((dFin - hoy) / (1000 * 60 * 60 * 24));
                        textoEstado = `⏳ En curso: faltan ${diff} día(s)`;
                    } else {
                        textoEstado = 'Periodo finalizado';
                    }

                    const item = document.createElement("div");
                    item.className = "p-3 rounded-xl border border-gray-200 bg-gray-50 flex items-center justify-between hover:bg-blue-50/60 transition cursor-pointer";
                    item.onclick = function() {
                        configurarPeriodoCalendario(e.inicio, e.fin);
                        document.getElementById("calModalTitulo").innerText = "Vacaciones de " + e.nombre;
                    };
                    item.innerHTML = `
                        <div>
                            <p class="text-xs font-bold text-[#442a22]">${e.nombre}</p>
                            <p class="text-[11px] text-gray-500 font-semibold">${e.cargo} • Del ${formatearFechaLocal(e.inicio)} al ${formatearFechaLocal(e.fin)}</p>
                        </div>
                        <span class="text-xs font-bold text-blue-700 bg-white px-2.5 py-1 rounded-lg border border-blue-200 shadow-sm">${textoEstado}</span>
                    `;
                    contenedorLista.appendChild(item);
                });
                document.getElementById("calListaEmpleadosGeneral").classList.remove("hidden");
                configurarPeriodoCalendario(conFechas[0].inicio, conFechas[0].fin);
            } else {
                configurarPeriodoCalendario(null, null);
                document.getElementById("calListaEmpleadosGeneral").classList.add("hidden");
            }

            document.getElementById("modalCalendarioVacaciones").classList.remove("hidden");
            document.getElementById("modalCalendarioVacaciones").classList.add("flex");
        }

        // ─── Actualizar estado resumen desde los valores actuales ────────────
        function configurarPeriodoCalendario(inicioStr, finStr) {
            if (inicioStr && finStr) {
                calFechaInicioSel = new Date(inicioStr + 'T00:00:00');
                calFechaFinSel = new Date(finStr + 'T00:00:00');
                calFechaActualVisual = new Date(calFechaInicioSel.getTime());

                document.getElementById("calResumenInicio").innerText = formatearFechaLocal(inicioStr);
                document.getElementById("calResumenFin").innerText = formatearFechaLocal(finStr);

                const totalDias = Math.round((calFechaFinSel - calFechaInicioSel) / (1000 * 60 * 60 * 24)) + 1;
                document.getElementById("calResumenTotal").innerText = `${totalDias} día(s)`;

                const hoy = new Date();
                hoy.setHours(0, 0, 0, 0);
                if (hoy < calFechaInicioSel) {
                    const faltan = Math.ceil((calFechaInicioSel - hoy) / (1000 * 60 * 60 * 24));
                    document.getElementById("calResumenFaltan").innerText = `Inicia en ${faltan} día(s)`;
                } else if (hoy <= calFechaFinSel) {
                    const faltan = Math.ceil((calFechaFinSel - hoy) / (1000 * 60 * 60 * 24));
                    document.getElementById("calResumenFaltan").innerText = `Faltan ${faltan} día(s)`;
                } else {
                    document.getElementById("calResumenFaltan").innerText = "Finalizado";
                }
            } else {
                calFechaInicioSel = null;
                calFechaFinSel = null;
                calFechaActualVisual = new Date();
                document.getElementById("calResumenInicio").innerText = "-";
                document.getElementById("calResumenFin").innerText = "-";
                document.getElementById("calResumenTotal").innerText = "-";
                document.getElementById("calResumenFaltan").innerText = "-";
            }
            dibujarCuadriculaCalendario();
        }

        // ─── Actualizar calendario cuando el usuario edita los inputs ────────
        function calActualizarDesdeCampos() {
            const ini = document.getElementById("calInputInicio").value;
            const fin = document.getElementById("calInputFin").value;
            const msgError = document.getElementById("calMsgError");

            if (ini && fin && fin < ini) {
                msgError.classList.remove("hidden");
                return;
            }
            msgError.classList.add("hidden");

            if (ini) calFechaInicioSel = new Date(ini + 'T00:00:00');
            else calFechaInicioSel = null;

            if (fin) calFechaFinSel = new Date(fin + 'T00:00:00');
            else calFechaFinSel = null;

            // Actualizar resumen
            document.getElementById("calResumenInicio").innerText = ini ? formatearFechaLocal(ini) : "-";
            document.getElementById("calResumenFin").innerText = fin ? formatearFechaLocal(fin) : "-";
            if (calFechaInicioSel && calFechaFinSel) {
                const totalDias = Math.round((calFechaFinSel - calFechaInicioSel) / (1000 * 60 * 60 * 24)) + 1;
                document.getElementById("calResumenTotal").innerText = totalDias + " día(s)";
            } else {
                document.getElementById("calResumenTotal").innerText = "-";
            }
            document.getElementById("calResumenFaltan").innerText = "-";

            if (ini) calFechaActualVisual = new Date(ini + 'T00:00:00');
            dibujarCuadriculaCalendario();
        }

        function calCambiarMes(delta) {
            calFechaActualVisual.setMonth(calFechaActualVisual.getMonth() + delta);
            dibujarCuadriculaCalendario();
        }

        function dibujarCuadriculaCalendario() {
            const año = calFechaActualVisual.getFullYear();
            const mes = calFechaActualVisual.getMonth();

            const nombresMeses = ["Enero", "Febrero", "Marzo", "Abril", "Mayo", "Junio", "Julio", "Agosto", "Septiembre", "Octubre", "Noviembre", "Diciembre"];
            document.getElementById("calMesAñoTexto").innerText = `${nombresMeses[mes]} ${año}`;

            const primerDiaMes = new Date(año, mes, 1);
            const ultimoDiaMes = new Date(año, mes + 1, 0);

            let primerDiaSemana = primerDiaMes.getDay() - 1;
            if (primerDiaSemana === -1) primerDiaSemana = 6;

            const totalDias = ultimoDiaMes.getDate();
            const cuadricula = document.getElementById("calCuadriculaDias");
            cuadricula.innerHTML = '';

            for (let i = 0; i < primerDiaSemana; i++) {
                const celdaVacia = document.createElement("div");
                celdaVacia.className = "h-9";
                cuadricula.appendChild(celdaVacia);
            }

            const hoy = new Date();
            hoy.setHours(0, 0, 0, 0);

            for (let dia = 1; dia <= totalDias; dia++) {
                const fechaDia = new Date(año, mes, dia);
                fechaDia.setHours(0, 0, 0, 0);

                const celda = document.createElement("div");

                const esHoy = fechaDia.getTime() === hoy.getTime();
                let enRango = false;
                let esInicio = false;
                let esFin = false;

                if (calFechaInicioSel && calFechaFinSel) {
                    enRango = fechaDia >= calFechaInicioSel && fechaDia <= calFechaFinSel;
                    esInicio = fechaDia.getTime() === calFechaInicioSel.getTime();
                    esFin = fechaDia.getTime() === calFechaFinSel.getTime();
                } else if (calFechaInicioSel) {
                    esInicio = fechaDia.getTime() === calFechaInicioSel.getTime();
                }

                let clases = "h-9 flex items-center justify-center text-xs font-bold rounded-xl transition ";
                if (calModoEdicion) {
                    clases += "cursor-pointer ";
                } else {
                    clases += "cursor-default ";
                }

                if (enRango) {
                    clases += "bg-[#D2B48C] text-[#442a22] shadow-sm font-extrabold ";
                } else if (esInicio && !calFechaFinSel) {
                    clases += "bg-[#D2B48C] text-[#442a22] ring-2 ring-[#b07d4b] font-extrabold ";
                } else {
                    clases += calModoEdicion ? "hover:bg-[#D2B48C]/30 text-gray-800 " : "hover:bg-gray-100 text-gray-800 ";
                }

                if (esHoy) clases += "border-2 border-black ";

                celda.className = clases;
                celda.innerText = dia;

                if (calModoEdicion) {
                    const fechaStr = `${año}-${String(mes + 1).padStart(2,'0')}-${String(dia).padStart(2,'0')}`;
                    celda.addEventListener('click', function() {
                        calSeleccionarDia(fechaStr);
                    });
                }

                cuadricula.appendChild(celda);
            }
        }

        // ─── Lógica de selección de rango al hacer clic en un día ────────────
        function calSeleccionarDia(fechaStr) {
            if (!calModoEdicion) return;

            const inputInicio = document.getElementById("calInputInicio");
            const inputFin    = document.getElementById("calInputFin");

            if (calSeleccionando === 'inicio') {
                inputInicio.value = fechaStr;
                inputFin.value = "";
                calFechaInicioSel = new Date(fechaStr + 'T00:00:00');
                calFechaFinSel = null;
                calSeleccionando = 'fin';
            } else {
                if (fechaStr < inputInicio.value) {
                    // Si fecha fin es anterior al inicio, reiniciar
                    inputInicio.value = fechaStr;
                    inputFin.value = "";
                    calFechaInicioSel = new Date(fechaStr + 'T00:00:00');
                    calFechaFinSel = null;
                    calSeleccionando = 'fin';
                } else {
                    inputFin.value = fechaStr;
                    calFechaFinSel = new Date(fechaStr + 'T00:00:00');
                    calSeleccionando = 'inicio'; // reset para siguiente selección
                }
            }

            document.getElementById("calMsgError").classList.add("hidden");
            // Actualizar resumen
            document.getElementById("calResumenInicio").innerText = inputInicio.value ? formatearFechaLocal(inputInicio.value) : "-";
            document.getElementById("calResumenFin").innerText   = inputFin.value   ? formatearFechaLocal(inputFin.value)   : "-";
            if (calFechaInicioSel && calFechaFinSel) {
                const totalDias = Math.round((calFechaFinSel - calFechaInicioSel) / (1000 * 60 * 60 * 24)) + 1;
                document.getElementById("calResumenTotal").innerText = totalDias + " día(s)";
            } else {
                document.getElementById("calResumenTotal").innerText = "-";
            }
            document.getElementById("calResumenFaltan").innerText = "-";
            dibujarCuadriculaCalendario();
        }

        // ─── Guardar fechas al servidor ──────────────────────────────────────
        function calGuardarFechas() {
            const ini = document.getElementById("calInputInicio").value;
            const fin = document.getElementById("calInputFin").value;

            if (!ini || !fin) {
                alert("Por favor selecciona tanto la fecha de inicio como la fecha de fin.");
                return;
            }
            if (fin < ini) {
                document.getElementById("calMsgError").classList.remove("hidden");
                return;
            }

            const btnGuardar = document.getElementById("calBtnGuardar");
            btnGuardar.disabled = true;
            btnGuardar.innerText = "Guardando...";

            const datos = {
                idEmpleado: calIdEmpleado,
                estado: calEstadoEmpleado,
                fechaInicioVacaciones: ini,
                fechaFinVacaciones: fin,
                fechaInicioEstado: ini,
                fechaFinEstado: fin
            };

            fetch('/Empleados/CambiarEstado', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(datos)
            })
            .then(response => {
                if (response.ok) {
                    cerrarModalCalendario();
                    location.reload();
                } else {
                    btnGuardar.disabled = false;
                    btnGuardar.innerText = "Guardar Fechas";
                    alert("Error al guardar las fechas. Intenta de nuevo.");
                }
            })
            .catch(() => {
                btnGuardar.disabled = false;
                btnGuardar.innerText = "Guardar Fechas";
                alert("Error de conexión. Intenta de nuevo.");
            });
        }

        function formatearFechaLocal(fechaStr) {
            if (!fechaStr) return "-";
            const partes = fechaStr.split('-');
            if (partes.length === 3) return `${partes[2]}/${partes[1]}/${partes[0]}`;
            return fechaStr;
        }

        function cerrarModalCalendario() {
            document.getElementById("modalCalendarioVacaciones").classList.add("hidden");
            document.getElementById("modalCalendarioVacaciones").classList.remove("flex");
        }
    </script>

        <!-- DataTables buscador únicamente -->
        <link rel="stylesheet" href="https://cdn.datatables.net/2.0.8/css/dataTables.dataTables.css">

        <script src="https://cdn.datatables.net/2.0.8/js/dataTables.js"></script>

        <script>
                document.addEventListener("DOMContentLoaded", function () {

                    new DataTable('#tablaEmpleados', {

                        // Solo buscador
                        searching: true,

                        // Desactivar paginación de DataTables
                        paging: false,

                        // Desactivar ordenamiento por columnas
                        ordering: false,

                        // Ocultar "Mostrando 1 de X registros"
                        info: false,

                        // Evita que DataTables cambie el ancho de la tabla
                        autoWidth: false,

                        language: {
                            search: "Buscar empleado:",
                            zeroRecords: "No se encontraron empleados",
                            emptyTable: "No hay empleados registrados"
                        }

                    });

                });
        </script>
</body>
</html>
