    <script>

            // Colocar fecha actual y bloquear fechas anteriores
            document.addEventListener("DOMContentLoaded", function() {

                let fecha = new Date();

                let dia = String(fecha.getDate()).padStart(2, '0');
                let mes = String(fecha.getMonth() + 1).padStart(2, '0');
                let año = fecha.getFullYear();

                let fechaActual = `${año}-${mes}-${dia}`;

                let inputFecha = document.getElementById("FechaIngreso");

                inputFecha.value = fechaActual;
                inputFecha.min = fechaActual;

            });

    </script>
    <script>
    function filtrarEmpleados() {
        const filter = document.getElementById('empleadoSearch').value.toLowerCase().trim();
        const rows = document.querySelectorAll('#tablaEmpleados tbody tr');
        rows.forEach(row => {
            const text = row.textContent.toLowerCase();
            row.style.display = text.includes(filter) ? '' : 'none';
        });
    }
