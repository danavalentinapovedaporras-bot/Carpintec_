@{
    Layout = null;
    var notificaciones = ViewBag.ListaNotificaciones as List<CARPINTEC_App.Controllers.DashboardClienteController.NotificacionClienteItem> 
                        ?? new List<CARPINTEC_App.Controllers.DashboardClienteController.NotificacionClienteItem>();
    int totalNotif = ViewBag.TotalNotificaciones ?? notificaciones.Count;
    int totalPagos = ViewBag.TotalPagosPendientes ?? notificaciones.Count(n => n.Tipo == "pago");
    int totalPagados = ViewBag.TotalPagados ?? notificaciones.Count(n => n.Tipo == "pagado");
    int totalDespacho = ViewBag.TotalDespacho ?? notificaciones.Count(n => n.Tipo == "despacho");
    int totalCatalogo = ViewBag.TotalCatalogo ?? notificaciones.Count(n => n.Tipo == "catalogo");
    var primerPago = ViewBag.PrimerPagoPendiente as CARPINTEC_App.Controllers.DashboardClienteController.NotificacionClienteItem;
    var primerPagado = ViewBag.PrimerPagado as CARPINTEC_App.Controllers.DashboardClienteController.NotificacionClienteItem;
    var primerDespacho = ViewBag.PrimerDespacho as CARPINTEC_App.Controllers.DashboardClienteController.NotificacionClienteItem;
    var primerCatalogo = ViewBag.PrimerCatalogo as CARPINTEC_App.Controllers.DashboardClienteController.NotificacionClienteItem;
}
<!DOCTYPE html>
<html class="light" lang="es">
<head>
    <meta charset="utf-8">
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <title>Dashboard - CARPINTEC</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&amp;family=Work+Sans:wght@400;500;600&amp;display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet">
    <script id="tailwind-config">
        tailwind.config = {
        darkMode: "class",
        theme: {
        extend: {
        "colors": {
        "primary": "#5C4033",
        "secondary": "#D2B48C",
        "background": "#FFFFFF",
        "surface": "#FDFBF7",
        "surface-container": "#F5EFE6",
        "surface-container-high": "#EAE0D5",
        "surface-container-low": "#FFFFFF",
        "on-surface": "#3E2723",
        "on-surface-variant": "#5D4037",
        "outline": "#8D6E63",
        "outline-variant": "#D7CCC8",
        "primary-container": "#D2B48C",
        "on-primary-container": "#3E2723",
        "secondary-container": "#EFEBE9",
        "on-secondary-container": "#4E342E",
        "error": "#D32F2F",
        "on-error": "#FFFFFF",
        "error-container": "#FFCDD2",
        "on-error-container": "#B71C1C",
        "on-primary": "#FFFFFF",
        "on-secondary": "#FFFFFF",
        "on-background": "#3E2723"
        },
        "borderRadius": {
        "DEFAULT": "16px",
        "lg": "20px",
        "xl": "24px",
        "full": "9999px"
        },
        "spacing": {
        "base": "8px",
        "margin-mobile": "16px",
        "margin-desktop": "64px",
        "container-max": "1280px",
        "gutter": "24px"
        },
        "fontFamily": {
        "title-md": ["Montserrat"],
        "headline-lg": ["Montserrat"],
        "headline-lg-mobile": ["Montserrat"],
        "display-lg": ["Montserrat"],
        "label-md": ["Montserrat"],
        "body-lg": ["Montserrat"],
        "body-md": ["Montserrat"]
        },
        "fontSize": {
        "title-md": ["20px", { "lineHeight": "28px", "fontWeight": "600" }],
        "headline-lg": ["32px", { "lineHeight": "40px", "fontWeight": "700" }],
        "headline-lg-mobile": ["24px", { "lineHeight": "32px", "fontWeight": "700" }],
        "display-lg": ["48px", { "lineHeight": "56px", "letterSpacing": "-0.02em", "fontWeight": "700" }],
        "label-md": ["14px", { "lineHeight": "20px", "letterSpacing": "0.05em", "fontWeight": "500" }],
        "body-lg": ["18px", { "lineHeight": "28px", "fontWeight": "400" }],
        "body-md": ["16px", { "lineHeight": "24px", "fontWeight": "400" }]
        }
        }
        }
        }
    </script>
    <style>
        body {
        background-color: theme('colors.background');
        color: theme('colors.on-background');
        font-family: 'Montserrat', sans-serif;
        }

        .material-symbols-outlined {
        font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }

        .fill-icon {
        font-variation-settings: 'FILL' 1;
        }

        .glass-card {
        background: theme('colors.surface');
        border: 1px solid theme('colors.outline-variant');
        box-shadow: 0 4px 20px rgba(92, 64, 51, 0.05);
        }

        .heavy-border {
        border: 2px solid theme('colors.primary');
        }
    </style>
</head>
<body class="flex min-h-screen font-body-md text-body-md">
    <!-- Main Content Area -->
    <main class="flex-1 ml-0 flex flex-col min-h-screen w-full relative">
        <!-- TopAppBar -->
        <header class="w-full h-16 sticky top-0 z-40 bg-[#F5EBE1] text-primary border-b border-outline-variant shadow-sm flex items-center justify-between px-6 md:px-margin-desktop transition-all">
            <div class="flex items-center">
                        <img alt="Carpintec Logo"
                     class="h-8 w-8 object-contain mr-2"
                     src="~/images/logo.png">

                <span class="font-headline-lg-mobile md:font-headline-lg text-headline-lg-mobile md:text-headline-lg font-bold text-on-primary dark:text-on-primary-container tracking-tight">
                    CARPINTEC
                </span>
                <div class="hidden md:flex items-center bg-surface-container rounded-full px-4 py-2 focus-within:ring-2 focus-within:ring-secondary transition-all">
                    <span class="material-symbols-outlined text-on-surface-variant mr-2">search</span>
                    <input class="bg-transparent border-none outline-none font-body-md text-body-md text-on-surface w-64 placeholder:text-on-surface-variant/60 focus:ring-0 p-0" placeholder="Buscar en CARPINTEC..." type="text">
                </div>
            </div>
            <div class="flex items-center space-x-6">
                <!-- Campanita con Notificaciones Flotantes -->
                <div class="relative" id="containerCampanita">
                    <button id="btnCampanita" onclick="toggleDropdownCampanita(event)" type="button" 
                            class="text-on-surface-variant hover:text-primary transition-colors relative p-2 rounded-full hover:bg-surface-container flex items-center justify-center focus:outline-none cursor-pointer"
                            title="Ver notificaciones">
                        <span class="material-symbols-outlined text-2xl">notifications</span>
                        @if (totalNotif > 0)
                        {
                            <span class="absolute top-0.5 right-0.5 min-w-[19px] h-[19px] bg-rose-600 text-white text-[10px] font-black rounded-full flex items-center justify-center px-1 border-2 border-surface animate-bounce shadow-sm">
                                @totalNotif
                            </span>
                        }
                    </button>

                    <!-- Menú Flotante de Notificaciones -->
                    <div id="dropdownCampanita" 
                         class="hidden absolute right-0 mt-3 w-80 sm:w-96 bg-white border border-outline-variant/60 rounded-2xl shadow-2xl z-50 overflow-hidden transform transition-all duration-200 origin-top-right">
                        <!-- Cabecera -->
                        <div class="p-4 bg-[#FAF6F0] border-b border-[#E8DDD5] flex items-center justify-between">
                            <div class="flex items-center gap-2">
                                <span class="material-symbols-outlined text-primary text-xl">notifications_active</span>
                                <h3 class="font-bold text-sm text-[#34261B]">Notificaciones</h3>
                                <span class="bg-primary/10 text-primary text-xs font-bold px-2 py-0.5 rounded-full">@totalNotif</span>
                            </div>
                            <button type="button" onclick="cerrarDropdownCampanita()" class="text-[#8C7665] hover:text-[#34261B] text-xs font-semibold">
                                <span class="material-symbols-outlined text-lg">close</span>
                            </button>
                        </div>

                        <!-- Filtros Rápidos -->
                        <div class="flex items-center gap-1.5 px-3 py-2 bg-[#F8F5F1] border-b border-[#EAE0D5] text-[11px] font-medium overflow-x-auto">
                            <button type="button" onclick="filtrarNotificacionesCampanita('todas', this)" class="btn-filtro-notif px-2.5 py-1 rounded-full bg-primary text-white font-semibold transition shrink-0">
                                Todas (@totalNotif)
                            </button>
                            @if (totalPagos > 0)
                            {
                                <button type="button" onclick="filtrarNotificacionesCampanita('pago', this)" class="btn-filtro-notif px-2.5 py-1 rounded-full bg-white text-[#6C5645] border border-[#D9CABA] hover:bg-[#EAE0D5] transition shrink-0">
                                    Pendientes (@totalPagos)
                                </button>
                            }
                            @if (totalPagados > 0)
                            {
                                <button type="button" onclick="filtrarNotificacionesCampanita('pagado', this)" class="btn-filtro-notif px-2.5 py-1 rounded-full bg-white text-[#6C5645] border border-[#D9CABA] hover:bg-[#EAE0D5] transition shrink-0">
                                    Pagados (@totalPagados)
                                </button>
                            }
                            @if (totalDespacho > 0)
                            {
                                <button type="button" onclick="filtrarNotificacionesCampanita('despacho', this)" class="btn-filtro-notif px-2.5 py-1 rounded-full bg-white text-[#6C5645] border border-[#D9CABA] hover:bg-[#EAE0D5] transition shrink-0">
                                    Despacho (@totalDespacho)
                                </button>
                            }
                            @if (totalCatalogo > 0)
                            {
                                <button type="button" onclick="filtrarNotificacionesCampanita('catalogo', this)" class="btn-filtro-notif px-2.5 py-1 rounded-full bg-white text-[#6C5645] border border-[#D9CABA] hover:bg-[#EAE0D5] transition shrink-0">
                                    Catálogo (@totalCatalogo)
                                </button>
                            }
                        </div>

                        <!-- Listado de Notificaciones -->
                        <div class="max-h-80 overflow-y-auto divide-y divide-[#F0E6DB]" id="listaNotifCampanita">
                            @if (notificaciones.Any())
                            {
                                foreach (var notif in notificaciones)
                                {
                                    <div class="item-notif p-3.5 hover:bg-[#FAF7F2] transition flex items-start gap-3" data-tipo="@notif.Tipo">
                                        <div class="w-8 h-8 rounded-lg flex items-center justify-center text-white shrink-0 mt-0.5 shadow-xs @(notif.Tipo == "pago" ? "bg-rose-500" : (notif.Tipo == "pagado" ? "bg-emerald-600" : (notif.Tipo == "despacho" ? "bg-sky-600" : (notif.Tipo == "catalogo" ? "bg-amber-600" : "bg-[#8B4513]"))))">
                                            <span class="material-symbols-outlined text-[18px]">@notif.Icono</span>
                                        </div>
                                        <div class="flex-1 min-w-0">
                                            <div class="flex items-center justify-between gap-1 mb-0.5">
                                                <h4 class="text-xs font-bold text-[#2E1F14] truncate">@notif.Titulo</h4>
                                                <span class="text-[10px] text-[#8C7665] shrink-0">@notif.FechaStr</span>
                                            </div>
                                            <p class="text-[11px] text-[#5C4535] leading-snug mb-2">@notif.Mensaje</p>
                                            <div class="flex items-center justify-between">
                                                @if (!string.IsNullOrEmpty(notif.Monto))
                                                {
                                                    <span class="text-xs font-black @(notif.Tipo == "pago" ? "text-rose-700" : (notif.Tipo == "pagado" ? "text-emerald-700" : "text-amber-800"))">@notif.Monto</span>
                                                }
                                                else if (!string.IsNullOrEmpty(notif.Estado))
                                                {
                                                    <span class="text-[10px] font-bold px-2 py-0.5 rounded @(notif.Tipo == "despacho" ? "bg-sky-100 text-sky-800 border border-sky-200" : (notif.Tipo == "pagado" ? "bg-emerald-100 text-emerald-800 border border-emerald-200" : "bg-[#EFE3D5] text-[#5C3821]"))">@notif.Estado</span>
                                                }
                                                @if (notif.Tipo == "pago" && notif.IdVenta > 0)
                                                {
                                                    <button type="button" onclick="abrirModalPago(this)" data-id-venta="@notif.IdVenta" data-monto="@notif.Monto" data-codigo="@notif.Codigo" class="inline-flex items-center gap-1 text-[11px] font-bold text-rose-600 hover:text-rose-800 transition ml-auto cursor-pointer bg-transparent border-none p-0">
                                                        Pagar
                                                        <span class="material-symbols-outlined text-[12px]">arrow_forward</span>
                                                    </button>
                                                }
                                                else
                                                {
                                                    <a href="@notif.UrlAccion" class="inline-flex items-center gap-1 text-[11px] font-bold text-primary hover:text-secondary transition ml-auto">
                                                        @notif.TextoAccion
                                                        <span class="material-symbols-outlined text-[12px]">chevron_right</span>
                                                    </a>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="p-6 text-center text-[#8C7665]">
                                    <span class="material-symbols-outlined text-3xl text-emerald-600 mb-1">verified</span>
                                    <p class="text-xs font-bold text-[#34261B]">¡Todo al día!</p>
                                    <p class="text-[11px] mt-0.5">No tienes pagos pendientes ni pedidos por vencer.</p>
                                </div>
                            }
                        </div>

                        <!-- Pie del Menú -->
                        <div class="p-3 bg-[#FAF6F0] border-t border-[#E8DDD5] flex items-center justify-between text-xs">
                            <a asp-controller="GestionFacturas" asp-action="Index" class="font-bold text-primary hover:underline text-[11px] flex items-center gap-1">
                                <span class="material-symbols-outlined text-sm">receipt</span> Mis Facturas
                            </a>
                            <a asp-controller="Mi_Pedido" asp-action="Index" class="font-bold text-primary hover:underline text-[11px] flex items-center gap-1">
                                <span class="material-symbols-outlined text-sm">inventory_2</span> Mis Pedidos
                            </a>
                        </div>
                    </div>
                </div>
                <!-- Menú de usuario con dropdown -->
                @await Html.PartialAsync("_ClientUserMenu")

            </div>
        </div>
    </header>
    <!-- Canvas -->
    <div class="flex-1 p-6 md:p-12 max-w-container-max mx-auto w-full space-y-12">
        <!-- Greeting & Banner Section -->
        <section class="space-y-6">
            <div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
                <div>
                    <h2 class="font-headline-lg text-headline-lg-mobile md:text-headline-lg text-primary mb-1">@(ViewBag.SaludoPersonalizado ?? "Bienvenido, Cliente")</h2>
                    <p class="font-body-lg text-body-lg text-on-surface-variant">Aquí está el resumen de tus proyectos en el taller.</p>
                </div>
                <p class="font-label-md text-label-md text-on-surface-variant/80">@(ViewBag.FechaActual ?? DateTime.Now.ToString("dddd, d 'de' MMMM yyyy"))</p>
            </div>
            <!-- Hero Banner -->
            <div class="relative w-full h-64 md:h-80 rounded-lg overflow-hidden border border-outline-variant group">
                <div class="absolute inset-0 bg-black/40 z-10 transition-opacity group-hover:bg-black/50"></div>
                <div class="absolute inset-0 bg-cover bg-center transition-transform duration-700 group-hover:scale-105" data-alt="Woodworking studio" style="background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuC33Km2jrTUezlbqzUcD2K7mPV-akme7-YL0z5BGR92-pZaGmXvyigKxmbNajsgDgUSL5qSX136R4MHlbVa3QxjEZT2k0N7eheRjIGgyhprNE5o7eN7sndUorPS7NiOtmQEuND3xD-yonJykx3U3XPfem60yUdXGdzwKjETOqbIQPN7DWeLj8ryh-RJqhfpljec-sOCKDEnTX6Y8AanHMBe9cmOX3DA5FloQ72lbWzbVCx097aX_BHuDg')"></div>
                <div class="absolute inset-0 z-20 flex flex-col justify-center items-start p-8 md:p-12">
                    <span class="inline-block px-3 py-1 bg-secondary/90 text-primary font-label-md text-label-md rounded-md uppercase tracking-widest mb-4 backdrop-blur-sm font-bold">Artesanía Pura</span>
                    <h3 class="font-display-lg text-headline-lg md:text-display-lg text-white max-w-2xl leading-tight mb-6 drop-shadow-lg">Diseñamos muebles personalizados para transformar tus espacios</h3>
                    <a asp-controller="NuevaCotizacion"
                       asp-action="Index"
                       class="bg-secondary text-on-secondary w-full py-4 rounded-lg font-bold text-headline-lg-mobile shadow-lg active:scale-95 transition-all relative z-10 flex items-center justify-center">
                        Crear Cotización
                    </a>
                </div>
            </div>
        </section>
        <!-- KPI Bento Grid -->
        <section class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            <!-- Card 1: Cotizaciones -->
            <div class="glass-card rounded-lg p-6 relative overflow-hidden group">
                <div class="absolute top-0 right-0 w-24 h-24 bg-surface-container-high rounded-bl-full -mr-4 -mt-4 transition-transform group-hover:scale-110"></div>
                <div class="flex justify-between items-start mb-4">
                    <div class="p-3 bg-surface-container rounded-lg text-primary">
                        <span class="material-symbols-outlined fill-icon text-3xl">request_quote</span>
                    </div>
                    <span class="font-title-md text-title-md font-bold text-primary">@(ViewBag.TotalCotizaciones ?? 0)</span>
                </div>
                <h4 class="font-title-md text-title-md text-on-surface mb-2">Cotizaciones</h4>
                <div class="space-y-2 mt-4">
                    <div class="flex justify-between items-center text-sm">
                        <span class="text-on-surface-variant flex items-center"><span class="w-1.5 h-1.5 rounded-full bg-secondary mr-2"></span>Pendientes</span>
                        <span class="font-medium text-on-surface">@(ViewBag.CotizacionesPendientes ?? 0)</span>
                    </div>
                    <div class="flex justify-between items-center text-sm">
                        <span class="text-on-surface-variant flex items-center"><span class="w-1.5 h-1.5 rounded-full bg-green-600 mr-2"></span>Aprobadas</span>
                        <span class="font-medium text-on-surface">@(ViewBag.CotizacionesAprobadas ?? 0)</span>
                    </div>
                </div>
                <div class="mt-6 pt-4 border-t border-outline-variant/30">
                    <a asp-controller="MiCotizacion"
                       asp-action="Index"
                       class="w-full bg-primary text-on-primary font-bold py-3 rounded-lg flex items-center justify-center gap-2 group-hover:bg-secondary transition-colors">
                        Ver cotizaciones
                        <span class="material-symbols-outlined text-sm">chevron_right</span>
                    </a>
                </div>
            </div>
            <!-- Card 2: Pedidos -->
            <div class="glass-card rounded-lg p-6 relative overflow-hidden group">
                <div class="absolute top-0 right-0 w-24 h-24 bg-surface-container-high rounded-bl-full -mr-4 -mt-4 transition-transform group-hover:scale-110"></div>
                <div class="flex justify-between items-start mb-4">
                    <div class="p-3 bg-surface-container rounded-lg text-primary">
                        <span class="material-symbols-outlined fill-icon text-3xl">shopping_bag</span>
                    </div>
                    <span class="font-title-md text-title-md font-bold text-primary">@(ViewBag.TotalPedidos ?? 0)</span>
                </div>
                <h4 class="font-title-md text-title-md text-on-surface mb-2">Pedidos</h4>
                <div class="space-y-2 mt-4">
                    <div class="flex justify-between items-center text-sm">
                        <span class="text-on-surface-variant flex items-center"><span class="w-1.5 h-1.5 rounded-full bg-secondary mr-2"></span>En Fabricación</span>
                        <span class="font-medium text-on-surface">@(ViewBag.PedidosEnFabricacion ?? 0)</span>
                    </div>
                    <div class="flex justify-between items-center text-sm">
                        <span class="text-on-surface-variant flex items-center"><span class="w-1.5 h-1.5 rounded-full bg-primary mr-2"></span>Listos</span>
                        <span class="font-medium text-on-surface">@(ViewBag.PedidosListos ?? 0)</span>
                    </div>
                </div>
                <div class="mt-6 pt-4 border-t border-outline-variant/30">
                    <a asp-controller="Mi_Pedido"
                       asp-action="Index"
                       class="w-full bg-primary text-on-primary font-bold py-3 rounded-lg flex items-center justify-center gap-2 group-hover:bg-secondary transition-colors">
                        Ver pedidos
                        <span class="material-symbols-outlined text-sm">chevron_right</span>
                    </a>
                </div>
            </div>
            <!-- Card 3: Facturas -->
            <div class="glass-card rounded-lg p-6 relative overflow-hidden group border-t-4 border-t-primary">
                <div class="absolute top-0 right-0 w-24 h-24 bg-surface-container-high rounded-bl-full -mr-4 -mt-4 transition-transform group-hover:scale-110"></div>
                <div class="flex justify-between items-start mb-4">
                    <div class="p-3 bg-surface-container rounded-lg text-primary">
                        <span class="material-symbols-outlined fill-icon text-3xl">receipt</span>
                    </div>
                    <span class="font-title-md text-title-md font-bold text-primary">@(ViewBag.TotalFacturas ?? 0)</span>
                </div>
                <h4 class="font-title-md text-title-md text-on-surface mb-2">Facturas</h4>
                <div class="space-y-2 mt-4">
                    <div class="flex justify-between items-center text-sm">
                        <span class="text-on-surface-variant flex items-center"><span class="w-1.5 h-1.5 rounded-full bg-error mr-2"></span>Pendientes</span>
                        <span class="font-medium text-on-surface font-bold text-error">@(ViewBag.FacturasPendientes ?? 0)</span>
                    </div>
                    <div class="flex justify-between items-center text-sm">
                        <span class="text-on-surface-variant flex items-center"><span class="w-1.5 h-1.5 rounded-full bg-green-600 mr-2"></span>Pagadas</span>
                        <span class="font-medium text-on-surface">@(ViewBag.FacturasPagadas ?? 0)</span>
                    </div>
                </div>
                <div class="mt-6 pt-4 border-t border-outline-variant/30">
                    <a asp-controller="GestionFacturas"
                       asp-action="Index"
                       class="w-full bg-primary text-on-primary font-bold py-3 rounded-lg flex items-center justify-center gap-2 group-hover:bg-secondary transition-colors">
                        Ver Factura
                        <span class="material-symbols-outlined text-sm">chevron_right</span>
                    </a>
                </div>
            </div>
            <!-- Card 4: Notificaciones y Novedades del Taller -->
            <div class="glass-card rounded-lg p-6 relative overflow-hidden group bg-gradient-to-br from-surface to-surface-container border-2 border-primary/15 hover:border-primary/30 transition-all shadow-sm">
                <div class="absolute top-0 right-0 w-28 h-28 bg-primary/5 rounded-bl-full -mr-4 -mt-4 transition-transform group-hover:scale-110 pointer-events-none"></div>
                
                <div class="flex justify-between items-start mb-3 relative z-10">
                    <div class="p-2.5 bg-primary/10 text-primary rounded-xl flex items-center gap-2">
                        <span class="material-symbols-outlined fill-icon text-2xl animate-pulse">notifications_active</span>
                        <span class="text-xs font-bold uppercase tracking-wider text-primary">Notificaciones</span>
                    </div>
                    @if (totalNotif > 0)
                    {
                        <span class="text-xs font-bold px-2.5 py-1 rounded-full bg-rose-100 text-rose-800 border border-rose-200 flex items-center gap-1">
                            <span class="w-1.5 h-1.5 rounded-full bg-rose-600 animate-ping"></span>
                            @totalNotif @(totalNotif == 1 ? "alerta" : "alertas")
                        </span>
                    }
                    else
                    {
                        <span class="text-xs font-bold px-2.5 py-1 rounded-full bg-emerald-100 text-emerald-800 border border-emerald-200">
                            Al día
                        </span>
                    }
                </div>

                <h4 class="font-title-md text-title-md text-primary font-bold mb-3 relative z-10">
                    Centro de Novedades
                </h4>

                <!-- Contenido Dinámico según Alertas Reales -->
                <div class="space-y-3 relative z-10 text-xs">
                    <!-- SECCIÓN 1: Pagos Pendientes -->
                    @if (primerPago != null)
                    {
                        <div class="bg-rose-50/90 border border-rose-200 rounded-xl p-3 flex items-start justify-between gap-3 shadow-2xs">
                            <div class="flex items-start gap-2.5 min-w-0">
                                <div class="w-7 h-7 rounded-lg bg-rose-500 text-white flex items-center justify-center shrink-0 mt-0.5 shadow-xs">
                                    <span class="material-symbols-outlined text-[16px]">payments</span>
                                </div>
                                <div class="min-w-0">
                                    <div class="flex items-center gap-1.5">
                                        <span class="font-bold text-rose-900 text-xs">Pago Pendiente</span>
                                        @if (!string.IsNullOrEmpty(primerPago.Codigo))
                                        {
                                            <span class="text-[10px] bg-rose-200/80 text-rose-950 px-1.5 py-0.2 rounded font-semibold">@primerPago.Codigo</span>
                                        }
                                    </div>
                                    <p class="text-[11px] text-rose-800 line-clamp-1 mt-0.5">@primerPago.Mensaje</p>
                                    @if (!string.IsNullOrEmpty(primerPago.Monto))
                                    {
                                        <span class="font-black text-xs text-rose-700 block mt-1">@primerPago.Monto</span>
                                    }
                                </div>
                            </div>
                            @if (primerPago.IdVenta > 0)
                            {
                                <button type="button" onclick="abrirModalPago(this)" data-id-venta="@primerPago.IdVenta" data-monto="@primerPago.Monto" data-codigo="@primerPago.Codigo" class="shrink-0 bg-rose-600 hover:bg-rose-700 text-white text-[11px] font-bold px-3 py-1.5 rounded-lg transition shadow-xs flex items-center gap-1 cursor-pointer border-none">
                                    Pagar
                                    <span class="material-symbols-outlined text-[13px]">arrow_forward</span>
                                </button>
                            }
                            else
                            {
                                <a href="@primerPago.UrlAccion" class="shrink-0 bg-rose-600 hover:bg-rose-700 text-white text-[11px] font-bold px-3 py-1.5 rounded-lg transition shadow-xs flex items-center gap-1">
                                    Pagar
                                    <span class="material-symbols-outlined text-[13px]">arrow_forward</span>
                                </a>
                            }
                        </div>
                    }

                    <!-- SECCIÓN 2: Productos Pagos (Confirmados / En Preparación) -->
                    @if (primerPagado != null)
                    {
                        <div class="bg-emerald-50/90 border border-emerald-200 rounded-xl p-3 flex items-start justify-between gap-3 shadow-2xs">
                            <div class="flex items-start gap-2.5 min-w-0">
                                <div class="w-7 h-7 rounded-lg bg-emerald-600 text-white flex items-center justify-center shrink-0 mt-0.5 shadow-xs">
                                    <span class="material-symbols-outlined text-[16px]">verified</span>
                                </div>
                                <div class="min-w-0">
                                    <div class="flex items-center gap-1.5">
                                        <span class="font-bold text-emerald-950 text-xs">Pago Confirmado</span>
                                        @if (!string.IsNullOrEmpty(primerPagado.Estado))
                                        {
                                            <span class="text-[10px] bg-emerald-200/80 text-emerald-900 px-1.5 py-0.2 rounded font-bold">@primerPagado.Estado</span>
                                        }
                                    </div>
                                    <p class="text-[11px] text-emerald-800 line-clamp-1 mt-0.5">@primerPagado.Mensaje</p>
                                </div>
                            </div>
                            <a href="@primerPagado.UrlAccion" class="shrink-0 bg-emerald-700 hover:bg-emerald-800 text-white text-[11px] font-bold px-3 py-1.5 rounded-lg transition shadow-xs flex items-center gap-1">
                                Ver
                                <span class="material-symbols-outlined text-[13px]">arrow_forward</span>
                            </a>
                        </div>
                    }

                    <!-- SECCIÓN 3: Despacho y Entrega al Cliente -->
                    @if (primerDespacho != null)
                    {
                        <div class="bg-sky-50/90 border border-sky-200 rounded-xl p-3 flex items-start justify-between gap-3 shadow-2xs">
                            <div class="flex items-start gap-2.5 min-w-0">
                                <div class="w-7 h-7 rounded-lg bg-sky-600 text-white flex items-center justify-center shrink-0 mt-0.5 shadow-xs">
                                    <span class="material-symbols-outlined text-[16px]">local_shipping</span>
                                </div>
                                <div class="min-w-0">
                                    <div class="flex items-center gap-1.5">
                                        <span class="font-bold text-sky-950 text-xs">Despacho & Entrega</span>
                                        @if (!string.IsNullOrEmpty(primerDespacho.Codigo))
                                        {
                                            <span class="text-[10px] bg-sky-200/80 text-sky-950 px-1.5 py-0.2 rounded font-semibold">@primerDespacho.Codigo</span>
                                        }
                                    </div>
                                    <p class="text-[11px] text-sky-800 line-clamp-1 mt-0.5">@primerDespacho.Mensaje</p>
                                </div>
                            </div>
                            <a href="@primerDespacho.UrlAccion" class="shrink-0 bg-sky-700 hover:bg-sky-800 text-white text-[11px] font-bold px-3 py-1.5 rounded-lg transition shadow-xs flex items-center gap-1">
                                Rastrear
                                <span class="material-symbols-outlined text-[13px]">arrow_forward</span>
                            </a>
                        </div>
                    }

                    <!-- SECCIÓN 4: Nuevos Productos del Catálogo -->
                    @if (primerCatalogo != null)
                    {
                        <div class="bg-amber-50/90 border border-amber-200 rounded-xl p-3 flex items-start justify-between gap-3 shadow-2xs">
                            <div class="flex items-start gap-2.5 min-w-0">
                                <div class="w-7 h-7 rounded-lg bg-amber-600 text-white flex items-center justify-center shrink-0 mt-0.5 shadow-xs">
                                    <span class="material-symbols-outlined text-[16px]">storefront</span>
                                </div>
                                <div class="min-w-0">
                                    <div class="flex items-center gap-1.5">
                                        <span class="font-bold text-amber-950 text-xs">Nuevo en Catálogo</span>
                                        <span class="text-[10px] bg-amber-200/80 text-amber-950 px-1.5 py-0.2 rounded font-semibold">Destacado</span>
                                    </div>
                                    <p class="text-[11px] text-amber-800 line-clamp-1 mt-0.5">@primerCatalogo.Titulo</p>
                                    @if (!string.IsNullOrEmpty(primerCatalogo.Monto))
                                    {
                                        <span class="font-black text-xs text-amber-900 block mt-0.5">@primerCatalogo.Monto</span>
                                    }
                                </div>
                            </div>
                            <a href="@primerCatalogo.UrlAccion" class="shrink-0 bg-amber-700 hover:bg-amber-800 text-white text-[11px] font-bold px-3 py-1.5 rounded-lg transition shadow-xs flex items-center gap-1">
                                Catálogo
                                <span class="material-symbols-outlined text-[13px]">arrow_forward</span>
                            </a>
                        </div>
                    }

                    <!-- Si no hay alertas en absoluto -->
                    @if (primerPago == null && primerPagado == null && primerDespacho == null && primerCatalogo == null)
                    {
                        <div class="bg-surface-container rounded-xl p-3.5 flex items-center gap-3">
                            <div class="w-8 h-8 rounded-full bg-emerald-100 text-emerald-700 flex items-center justify-center shrink-0">
                                <span class="material-symbols-outlined text-lg">check_circle</span>
                            </div>
                            <div>
                                <p class="text-xs font-bold text-on-surface">No tienes notificaciones pendientes</p>
                                <p class="text-[11px] text-on-surface-variant mt-0.5">Tus pedidos y finanzas están al día.</p>
                            </div>
                        </div>
                    }
                </div>

                <!-- Botón de Acción Ver Todas las Notificaciones -->
                <div class="mt-4 pt-3 border-t border-outline-variant/30 flex items-center justify-between relative z-10">
                    <button type="button" onclick="toggleDropdownCampanita(event)" class="text-primary hover:text-secondary font-label-md text-xs font-bold flex items-center gap-1 transition cursor-pointer">
                        <span>Ver todas (@totalNotif)</span>
                        <span class="material-symbols-outlined text-sm">open_in_new</span>
                    </button>
                    <a asp-controller="Mi_Pedido" asp-action="Index" class="text-on-surface-variant hover:text-primary text-[11px] font-medium transition">
                        Ver Mis Pedidos →
                    </a>
                </div>
            </div>
            <!-- Card 5: Pagos Pendientes -->
            <div class="glass-card rounded-lg p-6 relative overflow-hidden group">
                <div class="absolute top-0 right-0 w-24 h-24 bg-surface-container-high rounded-bl-full -mr-4 -mt-4 transition-transform group-hover:scale-110"></div>
                <div class="flex justify-between items-start mb-4">
                    <div class="p-3 bg-surface-container rounded-lg text-primary">
                        <span class="material-symbols-outlined fill-icon text-3xl">payments</span>
                    </div>
                    <span class="font-title-md text-title-md font-bold text-primary">2</span>
                </div>
                <h4 class="font-title-md text-title-md text-on-surface mb-2">Productos</h4>
                <div class="space-y-2 mt-4">
                    <div class="flex justify-between items-center text-sm">
                        <span class="text-on-surface-variant flex items-center"><span class="w-1.5 h-1.5 rounded-full bg-secondary mr-2"></span>Por Vencer</span>
                        <span class="font-medium text-on-surface">1</span>
                    </div>
                    <div class="flex justify-between items-center text-sm">
                        <span class="text-on-surface-variant flex items-center"><span class="w-1.5 h-1.5 rounded-full bg-error mr-2"></span>Vencidos</span>
                        <span class="font-medium text-on-surface">1</span>
                    </div>
                </div>
                <div class="mt-6 pt-4 border-t border-outline-variant/30">
                   <a asp-controller="MisProductos"
   asp-action="Index"
   class="w-full bg-primary text-on-primary font-bold py-3 rounded-lg flex items-center justify-center gap-2 group-hover:bg-secondary transition-colors">
    Ver Productos
    <span class="material-symbols-outlined text-sm">chevron_right</span>
</a>
                </div>
            </div>
            <!-- Card 6: PQR -->
            <div class="glass-card rounded-lg p-6 relative overflow-hidden group">
                <div class="absolute top-0 right-0 w-24 h-24 bg-surface-container-high rounded-bl-full -mr-4 -mt-4 transition-transform group-hover:scale-110"></div>
                <div class="flex justify-between items-start mb-4">
                    <div class="p-3 bg-surface-container rounded-lg text-primary">
                        <span class="material-symbols-outlined fill-icon text-3xl">support_agent</span>
                    </div>
                    <span class="font-title-md text-title-md font-bold text-primary">@(ViewBag.TotalPqrs ?? 0)</span>
                </div>
                <h4 class="font-title-md text-title-md text-on-surface mb-2">PQR</h4>
                <div class="space-y-2 mt-4">
                    <div class="flex justify-between items-center text-sm">
                        <span class="text-on-surface-variant flex items-center"><span class="w-1.5 h-1.5 rounded-full bg-secondary mr-2"></span>Abiertas</span>
                        <span class="font-medium text-on-surface">@(ViewBag.PqrsAbiertas ?? 0)</span>
                    </div>
                    <div class="flex justify-between items-center text-sm">
                        <span class="text-on-surface-variant flex items-center"><span class="w-1.5 h-1.5 rounded-full bg-green-600 mr-2"></span>Resueltas</span>
                        <span class="font-medium text-on-surface">@(ViewBag.PqrsResueltas ?? 0)</span>
                    </div>
                </div>
                <div class="mt-6 pt-4 border-t border-outline-variant/30">
                  <a asp-controller="PQRCliente" asp-action="Index" class="w-full text-primary font-label-md text-label-md font-bold flex items-center justify-center hover:underline">
    Ver detalles <span class="material-symbols-outlined text-sm ml-1">arrow_forward</span>
</a>
                </div>
            </div>
        </section>
    </div>
    <!-- Footer -->
    <footer class="w-full py-gutter bg-surface-container text-on-surface-variant border-t border-outline-variant flex justify-between items-center px-6 md:px-margin-desktop mt-auto">
        <span class="font-body-md text-body-md opacity-80">© 2024 CARPINTEC. Crafted for Durability.</span>
        <div class="flex space-x-6 font-label-md text-label-md">
            <a class="hover:text-primary transition-colors opacity-80 hover:opacity-100" href="#">Privacy Policy</a>
            <a class="hover:text-primary transition-colors opacity-80 hover:opacity-100" href="#">Terms of Service</a>
            <a class="hover:text-primary transition-colors opacity-80 hover:opacity-100" href="#">Sustainability</a>
        </div>
    </footer>
    <!-- ========== MODAL SIMULADOR DE PAGO ========== -->
    <div id="modalPago" class="fixed inset-0 z-[100] hidden" style="font-family:'Montserrat',sans-serif;">
        <!-- Overlay -->
        <div class="absolute inset-0 bg-black/50 backdrop-blur-sm transition-opacity" onclick="cerrarModalPago()"></div>
        <!-- Modal Content -->
        <div class="absolute inset-0 flex items-center justify-center p-4">
            <div id="modalPagoCard" class="bg-white rounded-2xl shadow-2xl w-full max-w-lg relative overflow-hidden transform transition-all duration-300 scale-95 opacity-0" style="max-height:90vh; overflow-y:auto;">
                <!-- Header con gradiente madera -->
                <div class="bg-gradient-to-r from-[#5C4033] via-[#7B5B3A] to-[#8B6914] p-5 text-white">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 bg-white/20 rounded-xl flex items-center justify-center backdrop-blur-sm">
                                <span class="material-symbols-outlined text-2xl">payments</span>
                            </div>
                            <div>
                                <h3 class="text-lg font-bold tracking-tight">Pasarela de Pago</h3>
                                <span class="text-[10px] bg-white/20 px-2 py-0.5 rounded-full font-medium">CARPINTEC · Modo Simulación</span>
                            </div>
                        </div>
                        <button type="button" onclick="cerrarModalPago()" class="w-8 h-8 rounded-full bg-white/10 hover:bg-white/25 flex items-center justify-center transition cursor-pointer">
                            <span class="material-symbols-outlined text-lg">close</span>
                        </button>
                    </div>
                </div>

                <!-- Cuerpo del Modal -->
                <div class="p-6">
                    <!-- Resumen del monto -->
                    <div class="bg-gradient-to-br from-[#FAF6F0] to-[#F5EFE6] border border-[#E8DDD5] rounded-xl p-4 mb-5 flex justify-between items-center">
                        <div>
                            <p class="text-[10px] text-[#8C7665] uppercase tracking-widest font-semibold">Total a Pagar</p>
                            <p class="text-2xl font-black text-[#34261B] mt-0.5" id="modalMontoDisplay">$0</p>
                        </div>
                        <div class="text-right">
                            <p class="text-[10px] text-[#8C7665] uppercase tracking-widest font-semibold">Referencia</p>
                            <span class="text-xs font-bold text-[#5C4033]" id="modalCodigoDisplay">---</span>
                        </div>
                    </div>

                    <!-- Formulario -->
                    <form id="formPagoModal">
                        @Html.AntiForgeryToken()
                        <input type="hidden" id="modalIdVenta" name="idVenta" />

                        <!-- Selección de método de pago -->
                        <div class="mb-5">
                            <label class="block text-xs font-bold text-[#34261B] mb-3 uppercase tracking-wider">Método de pago</label>
                            <div class="grid grid-cols-2 gap-3">
                                <!-- Opción Contado -->
                                <label id="labelContado" class="metodo-pago-opt border-2 border-[#D2B48C] bg-[#FAF6F0] rounded-xl p-4 flex flex-col items-center cursor-pointer hover:border-[#5C4033] transition-all relative">
                                    <input type="radio" name="tipoPago" value="Contado" checked class="sr-only" onchange="toggleCuotasModal(false)">
                                    <div class="w-10 h-10 rounded-full bg-[#5C4033]/10 flex items-center justify-center mb-2">
                                        <span class="material-symbols-outlined text-xl text-[#5C4033]">credit_card</span>
                                    </div>
                                    <span class="text-xs font-bold text-[#34261B]">Contado</span>
                                    <span class="text-[10px] text-[#8C7665] text-center mt-0.5">Pago inmediato simulado</span>
                                    <div class="absolute top-2 right-2 w-5 h-5 rounded-full bg-[#5C4033] flex items-center justify-center chk-ind shadow-sm">
                                        <span class="material-symbols-outlined text-white text-[11px]">check</span>
                                    </div>
                                </label>
                                <!-- Opción Cuotas -->
                                <label id="labelCuotas" class="metodo-pago-opt border-2 border-[#E8DDD5] bg-white rounded-xl p-4 flex flex-col items-center cursor-pointer hover:border-[#5C4033] transition-all relative">
                                    <input type="radio" name="tipoPago" value="Cuotas" class="sr-only" onchange="toggleCuotasModal(true)">
                                    <div class="w-10 h-10 rounded-full bg-[#8C7665]/10 flex items-center justify-center mb-2">
                                        <span class="material-symbols-outlined text-xl text-[#8C7665]">calendar_month</span>
                                    </div>
                                    <span class="text-xs font-bold text-[#34261B]">Cuotas</span>
                                    <span class="text-[10px] text-[#8C7665] text-center mt-0.5">Requiere aprobación</span>
                                    <div class="absolute top-2 right-2 w-5 h-5 rounded-full bg-[#5C4033] items-center justify-center chk-ind shadow-sm hidden">
                                        <span class="material-symbols-outlined text-white text-[11px]">check</span>
                                    </div>
                                </label>
                            </div>
                        </div>

                        <!-- Sección cuotas (oculta por defecto) -->
                        <div id="seccionCuotasModal" class="hidden mb-5 bg-amber-50 border border-amber-200 rounded-xl p-4 transition-all">
                            <label class="block text-xs font-bold text-amber-800 mb-2">Número de Cuotas:</label>
                            <select name="numeroCuotas" id="selectCuotasModal" class="w-full border border-amber-300 rounded-lg px-3 py-2.5 text-sm bg-white focus:ring-2 focus:ring-[#5C4033] focus:border-[#5C4033] outline-none">
                                <option value="3">3 Cuotas mensuales</option>
                                <option value="6">6 Cuotas mensuales</option>
                                <option value="12">12 Cuotas mensuales</option>
                            </select>
                            <p class="text-[10px] text-amber-700 mt-2 flex items-center gap-1">
                                <span class="material-symbols-outlined text-xs">warning</span>
                                Al elegir cuotas, el pedido queda pendiente de validación. <strong>No pasará a En Preparación.</strong>
                            </p>
                        </div>

                        <!-- Datos de tarjeta simulados -->
                        <div class="mb-6 border border-[#E8DDD5] rounded-xl p-4 bg-[#FDFBF7]">
                            <h4 class="text-[11px] font-bold text-[#34261B] mb-3 flex items-center gap-1.5 uppercase tracking-wider">
                                <span class="material-symbols-outlined text-sm text-[#8C7665]">credit_card</span>
                                Datos de Tarjeta (Simulador)
                            </h4>
                            <div class="space-y-2.5">
                                <input type="text" placeholder="Número de tarjeta (16 dígitos)" class="w-full bg-white border border-[#D7CCC8] rounded-lg text-sm text-[#34261B] px-3 py-2.5">
                                <div class="grid grid-cols-2 gap-2.5">
                                    <input type="text" placeholder="MM/AA" class="bg-white border border-[#D7CCC8] rounded-lg text-sm text-[#34261B] px-3 py-2.5">
                                    <input type="text" placeholder="CVV" class="bg-white border border-[#D7CCC8] rounded-lg text-sm text-[#34261B] px-3 py-2.5">
                                </div>
                            </div>
                        </div>

                        <!-- Botones de acción -->
                        <div class="flex gap-3">
                            <button type="button" onclick="cerrarModalPago()" class="flex-1 border-2 border-[#D7CCC8] text-[#5C4033] font-bold py-3 rounded-xl hover:bg-[#F5EFE6] transition-all flex items-center justify-center gap-2 text-sm cursor-pointer bg-transparent">
                                <span class="material-symbols-outlined text-lg">close</span>
                                Cancelar
                            </button>
                            <button type="button" onclick="procesarPagoModal()" id="btnProcesarPago" class="flex-1 bg-gradient-to-r from-[#5C4033] to-[#8B6914] text-white font-bold py-3 rounded-xl hover:opacity-90 transition-all shadow-lg flex items-center justify-center gap-2 text-sm cursor-pointer border-none">
                                <span class="material-symbols-outlined text-lg">lock</span>
                                Confirmar Pago
                            </button>
                        </div>
                    </form>
                </div>

                <!-- Overlay: Procesando -->
                <div id="modalProcesando" class="absolute inset-0 bg-white/95 backdrop-blur-sm hidden items-center justify-center z-10 flex-col">
                    <div class="w-16 h-16 border-4 border-[#D2B48C] border-t-[#5C4033] rounded-full animate-spin mb-4"></div>
                    <p class="text-sm font-bold text-[#34261B]">Procesando pago...</p>
                    <p class="text-xs text-[#8C7665] mt-1">No cierres esta ventana</p>
                </div>

                <!-- Overlay: Éxito -->
                <div id="modalExito" class="absolute inset-0 bg-white hidden items-center justify-center z-10 flex-col p-8">
                    <div class="w-20 h-20 bg-emerald-100 rounded-full flex items-center justify-center mb-4 shadow-lg shadow-emerald-100">
                        <span class="material-symbols-outlined text-4xl text-emerald-600 fill-icon">check_circle</span>
                    </div>
                    <h3 class="text-lg font-bold text-[#34261B] mb-2">¡Pago Exitoso!</h3>
                    <p class="text-sm text-[#8C7665] text-center mb-6 max-w-xs" id="modalMensajeExito">Tu pago ha sido procesado correctamente.</p>
                    <button type="button" onclick="window.location.reload()" class="bg-emerald-600 text-white font-bold px-8 py-3 rounded-xl hover:bg-emerald-700 transition shadow-lg cursor-pointer border-none text-sm">
                        <span class="material-symbols-outlined text-sm mr-1 align-middle">check</span>
                        Aceptar
                    </button>
                </div>

                <!-- Overlay: Error -->
                <div id="modalError" class="absolute inset-0 bg-white hidden items-center justify-center z-10 flex-col p-8">
                    <div class="w-20 h-20 bg-rose-100 rounded-full flex items-center justify-center mb-4 shadow-lg shadow-rose-100">
                        <span class="material-symbols-outlined text-4xl text-rose-600 fill-icon">error</span>
                    </div>
                    <h3 class="text-lg font-bold text-[#34261B] mb-2">Error en el Pago</h3>
                    <p class="text-sm text-[#8C7665] text-center mb-6 max-w-xs" id="modalMensajeError">Ocurrió un error inesperado.</p>
                    <button type="button" onclick="resetModalPago()" class="bg-[#5C4033] text-white font-bold px-8 py-3 rounded-xl hover:opacity-90 transition shadow-lg cursor-pointer border-none text-sm">
                        Reintentar
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- FAB Chatbot -->
    <button class="fixed bottom-8 right-8 w-14 h-14 bg-primary text-white rounded-full shadow-lg hover:bg-primary/90 hover:scale-105 transition-all duration-300 flex items-center justify-center z-50">
        <span class="material-symbols-outlined text-2xl">chat</span>
    </button>
</main>

    <script>
        // Control interactivo del Dropdown de la Campanita de Notificaciones
        function toggleDropdownCampanita(e) {
            if (e) e.stopPropagation();
            const dropdown = document.getElementById('dropdownCampanita');
            if (dropdown) {
                dropdown.classList.toggle('hidden');
            }
        }

        function cerrarDropdownCampanita() {
            const dropdown = document.getElementById('dropdownCampanita');
            if (dropdown) {
                dropdown.classList.add('hidden');
            }
        }

        // Filtro de pestañas dentro del dropdown de la campanita
        function filtrarNotificacionesCampanita(tipo, btn) {
            // Actualizar estilo visual de los botones
            const botones = document.querySelectorAll('.btn-filtro-notif');
            botones.forEach(b => {
                b.classList.remove('bg-primary', 'text-white');
                b.classList.add('bg-white', 'text-[#6C5645]', 'border', 'border-[#D9CABA]');
            });
            if (btn) {
                btn.classList.remove('bg-white', 'text-[#6C5645]', 'border', 'border-[#D9CABA]');
                btn.classList.add('bg-primary', 'text-white');
            }

            // Filtrar elementos
            const items = document.querySelectorAll('#listaNotifCampanita .item-notif');
            items.forEach(item => {
                const itemTipo = item.getAttribute('data-tipo');
                if (tipo === 'todas' || itemTipo === tipo) {
                    item.classList.remove('hidden');
                } else {
                    item.classList.add('hidden');
                }
            });
        }

        // Cerrar dropdown al hacer clic fuera
        document.addEventListener('click', function (e) {
            const container = document.getElementById('containerCampanita');
            const dropdown = document.getElementById('dropdownCampanita');
            if (dropdown && !dropdown.classList.contains('hidden')) {
                if (container && !container.contains(e.target)) {
                    dropdown.classList.add('hidden');
                }
            }

            // Cerrar menú de usuario al hacer clic fuera
            const userContainer = document.getElementById('containerUserMenu');
            const userDropdown = document.getElementById('dropdownUserMenu');
            if (userDropdown && !userDropdown.classList.contains('hidden')) {
                if (userContainer && !userContainer.contains(e.target)) {
                    userDropdown.classList.add('hidden');
                }
            }
        });

        // Toggle menú de usuario
        function toggleUserMenu(event) {
            event.stopPropagation();
            const dropdown = document.getElementById('dropdownUserMenu');
            const campDropdown = document.getElementById('dropdownCampanita');

            // Cerrar campanita si está abierta
            if (campDropdown && !campDropdown.classList.contains('hidden')) {
                campDropdown.classList.add('hidden');
            }

            if (dropdown) {
                dropdown.classList.toggle('hidden');
            }
        }

        // ===== MODAL SIMULADOR DE PAGO DESDE NOTIFICACIONES =====
        function abrirModalPago(btn) {
            const idVenta = btn.getAttribute('data-id-venta');
            const monto = btn.getAttribute('data-monto');
            const codigo = btn.getAttribute('data-codigo');

            document.getElementById('modalIdVenta').value = idVenta;
            document.getElementById('modalMontoDisplay').textContent = monto || '$0';
            document.getElementById('modalCodigoDisplay').textContent = codigo || '---';

            // Reset modal al estado inicial
            resetModalPago();

            // Resetear selección a Contado
            const radioContado = document.querySelector('#formPagoModal input[name="tipoPago"][value="Contado"]');
            if (radioContado) radioContado.checked = true;
            toggleCuotasModal(false);

            // Mostrar modal con animación
            const modal = document.getElementById('modalPago');
            const card = document.getElementById('modalPagoCard');
            modal.classList.remove('hidden');
            document.body.style.overflow = 'hidden';

            // Cerrar dropdown de notificaciones
            cerrarDropdownCampanita();

            // Animar entrada
            requestAnimationFrame(() => {
                card.classList.remove('scale-95', 'opacity-0');
                card.classList.add('scale-100', 'opacity-100');
            });
        }

        function cerrarModalPago() {
            const modal = document.getElementById('modalPago');
            const card = document.getElementById('modalPagoCard');

            // Animar salida
            card.classList.remove('scale-100', 'opacity-100');
            card.classList.add('scale-95', 'opacity-0');

            setTimeout(() => {
                modal.classList.add('hidden');
                document.body.style.overflow = '';
            }, 200);
        }

        function resetModalPago() {
            const ids = ['modalProcesando', 'modalExito', 'modalError'];
            ids.forEach(id => {
                const el = document.getElementById(id);
                if (el) {
                    el.classList.add('hidden');
                    el.classList.remove('flex');
                }
            });
            const btnProcesar = document.getElementById('btnProcesarPago');
            if (btnProcesar) btnProcesar.disabled = false;
        }

        function toggleCuotasModal(mostrar) {
            const seccion = document.getElementById('seccionCuotasModal');
            const labelContado = document.getElementById('labelContado');
            const labelCuotas = document.getElementById('labelCuotas');

            if (mostrar) {
                seccion.classList.remove('hidden');
                labelContado.classList.remove('border-[#D2B48C]', 'bg-[#FAF6F0]');
                labelContado.classList.add('border-[#E8DDD5]', 'bg-white');
                labelContado.querySelector('.chk-ind').classList.add('hidden');
                labelContado.querySelector('.chk-ind').classList.remove('flex');
                labelCuotas.classList.remove('border-[#E8DDD5]', 'bg-white');
                labelCuotas.classList.add('border-[#D2B48C]', 'bg-[#FAF6F0]');
                labelCuotas.querySelector('.chk-ind').classList.remove('hidden');
                labelCuotas.querySelector('.chk-ind').classList.add('flex');
            } else {
                seccion.classList.add('hidden');
                labelCuotas.classList.remove('border-[#D2B48C]', 'bg-[#FAF6F0]');
                labelCuotas.classList.add('border-[#E8DDD5]', 'bg-white');
                labelCuotas.querySelector('.chk-ind').classList.add('hidden');
                labelCuotas.querySelector('.chk-ind').classList.remove('flex');
                labelContado.classList.remove('border-[#E8DDD5]', 'bg-white');
                labelContado.classList.add('border-[#D2B48C]', 'bg-[#FAF6F0]');
                labelContado.querySelector('.chk-ind').classList.remove('hidden');
                labelContado.querySelector('.chk-ind').classList.add('flex');
            }
        }

        async function procesarPagoModal() {
            const idVenta = document.getElementById('modalIdVenta').value;
            const tipoPagoRadio = document.querySelector('#formPagoModal input[name="tipoPago"]:checked');
            const tipoPago = tipoPagoRadio ? tipoPagoRadio.value : 'Contado';
            const numeroCuotas = tipoPago === 'Cuotas' ? document.getElementById('selectCuotasModal').value : null;
            const tokenInput = document.querySelector('#formPagoModal input[name="__RequestVerificationToken"]');
            const token = tokenInput ? tokenInput.value : '';

            // Mostrar overlay de procesando
            document.getElementById('btnProcesarPago').disabled = true;
            const procOverlay = document.getElementById('modalProcesando');
            procOverlay.classList.remove('hidden');
            procOverlay.classList.add('flex');

            try {
                const formData = new URLSearchParams();
                formData.append('idVenta', idVenta);
                formData.append('tipoPago', tipoPago);
                if (numeroCuotas) formData.append('numeroCuotas', numeroCuotas);
                formData.append('__RequestVerificationToken', token);

                // Simular un pequeño delay para efecto visual
                await new Promise(r => setTimeout(r, 1500));

                const response = await fetch('@Url.Action("ProcesarPagoDesdeNotificacion", "DashboardCliente")', {
                    method: 'POST',
                    body: formData,
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' }
                });

                const result = await response.json();

                // Ocultar procesando
                procOverlay.classList.add('hidden');
                procOverlay.classList.remove('flex');

                if (result.success) {
                    document.getElementById('modalMensajeExito').textContent = result.mensaje;
                    const exitoOverlay = document.getElementById('modalExito');
                    exitoOverlay.classList.remove('hidden');
                    exitoOverlay.classList.add('flex');
                } else {
                    document.getElementById('modalMensajeError').textContent = result.mensaje;
                    const errorOverlay = document.getElementById('modalError');
                    errorOverlay.classList.remove('hidden');
                    errorOverlay.classList.add('flex');
                }
            } catch (err) {
                const procOv = document.getElementById('modalProcesando');
                procOv.classList.add('hidden');
                procOv.classList.remove('flex');
                document.getElementById('modalMensajeError').textContent = 'Error de conexión. Inténtalo de nuevo.';
                const errorOverlay = document.getElementById('modalError');
                errorOverlay.classList.remove('hidden');
                errorOverlay.classList.add('flex');
            }
        }
    </script>
</body></html>
