@model CARPINTEC_App.Models.Usuario

@{
    Layout = null;
    ViewData["Title"] = "Detalle del Usuario";
}

<!DOCTYPE html>
<html lang="es">

<head>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Detalle del Usuario</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <style>

            body {
                background: #ececec;
                font-family: Arial, Helvetica, sans-serif;
            }

            .hoja {
                width: 900px;
                margin: 40px auto;
                background: white;
                padding: 40px;
                border-radius: 15px;
                box-shadow: 0 0 20px rgba(0,0,0,.20);
            }

            h2 {
                text-align: center;
                margin-bottom: 30px;
                color: #7a4f24;
            }

            label {
                font-weight: bold;
            }

            .botones {
                text-align: right;
                margin-top: 30px;
            }

    </style>

</head>

<body>

    <div class="hoja">

        <h2>Detalle del Usuario</h2>

        <div class="row">

            <div class="col-md-6 mb-3">

                <label>Nombre</label>

                <input class="form-control"
                       value="@Model.Nombre @Model.Apellido"
                       readonly />

            </div>

            <div class="col-md-6 mb-3">

                <label>Correo</label>

                <input class="form-control"
                       value="@Model.Correo"
                       readonly />

            </div>

            <div class="col-md-6 mb-3">

                <label>Rol</label>

                <input class="form-control"
                       value="@Model.Rol"
                       readonly />

            </div>

            <div class="col-md-6 mb-3">

                <label>Estado</label>

                <input class="form-control"
                       value="@Model.Estado"
                       readonly />

            </div>

            @{
                var empleado = Model.Empleados.FirstOrDefault(e => e.Estado == "Activo") 
                              ?? Model.Empleados.FirstOrDefault();
            }

            @if (empleado != null)
            {
                <div class="col-12 mt-3 p-4 rounded-3 border" style="background-color: #fdfaf6; border-color: #D2B48C !important;">
                    <h5 class="mb-3" style="color: #7a4f24;">Información de Empleado</h5>
                    <div class="row">
                        <div class="col-md-6 mb-2">
                            <label>Puesto / Cargo</label>
                            <input class="form-control fw-bold" value="@empleado.Cargo" readonly />
                        </div>
                        <div class="col-md-6 mb-2">
                            <label>Documento</label>
                            <input class="form-control" value="@empleado.TipoDocumento @empleado.Documento" readonly />
                        </div>
                        <div class="col-md-6 mb-2">
                            <label>Teléfono</label>
                            <input class="form-control" value="@(string.IsNullOrEmpty(empleado.Telefono) ? "No registrado" : empleado.Telefono)" readonly />
                        </div>
                        <div class="col-md-6 mb-2">
                            <label>Dirección</label>
                            <input class="form-control" value="@(string.IsNullOrEmpty(empleado.Direccion) ? "No registrada" : empleado.Direccion)" readonly />
                        </div>
                        <div class="col-md-6 mb-2">
                            <label>Fecha de Ingreso</label>
                            <input class="form-control" value="@empleado.FechaIngreso.ToString("yyyy-MM-dd")" readonly />
                        </div>
                        <div class="col-md-6 mb-2">
                            <label>Salario</label>
                            <input class="form-control fw-bold text-success" value="@(empleado.Salario.HasValue ? "$" + empleado.Salario.Value.ToString("N0") : "No asignado")" readonly />
                        </div>
                    </div>
                </div>
            }

        </div>

        <div class="botones">

            <a asp-action="Index"
               class="btn btn-secondary">
                Volver
            </a>

            <a asp-action="Edit"
               asp-route-id="@Model.IdUsuario"
               class="btn btn-warning">
                Editar
            </a>

        </div>

    </div>

</body>

</html>