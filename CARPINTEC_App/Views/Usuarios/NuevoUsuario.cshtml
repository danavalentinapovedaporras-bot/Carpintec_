@model CARPINTEC_App.Models.Usuario

@{
    ViewData["Title"] = "Crear Usuario";
}

<!DOCTYPE html>
<html lang="es">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>CARPINTEC - Crear Usuario</title>


    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">


    <style>

            body {
                background: #fcf9f8;
                font-family: Arial, Helvetica, sans-serif;
            }


            .contenedor {
                width: 850px;
                margin: 40px auto;
                background: white;
                padding: 40px;
                border-radius: 25px;
                box-shadow: 0 5px 20px rgba(0,0,0,.15);
            }


            h1 {
                color: #442a22;
                text-align: center;
                margin-bottom: 30px;
            }


            label {
                font-weight: bold;
            }


            .btn-carpintec {
                background-color: rgb(210,180,140);
                color: black;
            }


                .btn-carpintec:hover {
                    opacity: .8;
                }

    </style>


</head>


<body>


    <div class="contenedor">


        <h1>
            Crear Usuario
        </h1>



        <form asp-controller="Usuarios"
              asp-action="NuevoUsuario"
              method="post">


            @Html.AntiForgeryToken()



            <div asp-validation-summary="ModelOnly"
                 class="text-danger">
            </div>




            <div class="row">



                <!-- Nombre -->

                <div class="col-md-6 mb-3">

                    <label asp-for="Nombre">
                        Nombre
                    </label>


                    <input asp-for="Nombre"
                           class="form-control"
                           placeholder="Ingrese nombre">


                    <span asp-validation-for="Nombre"
                          class="text-danger">
                    </span>


                </div>




                <!-- Apellido -->


                <div class="col-md-6 mb-3">


                    <label asp-for="Apellido">
                        Apellido
                    </label>


                    <input asp-for="Apellido"
                           class="form-control"
                           placeholder="Ingrese apellido">


                    <span asp-validation-for="Apellido"
                          class="text-danger">
                    </span>


                </div>





                <!-- Correo -->


                <div class="col-md-12 mb-3">


                    <label asp-for="Correo">
                        Correo electrónico
                    </label>


                    <input asp-for="Correo"
                           type="email"
                           class="form-control"
                           placeholder="correo@ejemplo.com">


                    <span asp-validation-for="Correo"
                          class="text-danger">
                    </span>


                </div>





                <!-- Contraseña -->


                <div class="col-md-12 mb-3">


                    <label asp-for="Contraseña">
                        Contraseña
                    </label>


                    <input asp-for="Contraseña"
                           type="password"
                           class="form-control"
                           placeholder="Ingrese contraseña">


                    <span asp-validation-for="Contraseña"
                          class="text-danger">
                    </span>


                </div>





                <!-- Rol -->


                <div class="col-md-6 mb-3">


                    <label asp-for="Rol">
                        Rol
                    </label>


                    <select asp-for="Rol"
                            class="form-select">


                        <option value="">
                            Seleccione un rol
                        </option>


                        <option value="Administrador">
                            Administrador
                        </option>


                        <option value="Empleado">
                            Empleado
                        </option>


                    </select>


                </div>






                <!-- Estado -->


                <div class="col-md-6 mb-3">


                    <label>
                        Estado inicial
                    </label>


                    <input class="form-control"
                           value="Activo"
                           readonly>


                </div>



            </div>




            <div class="text-end mt-4">


                <a asp-controller="Usuarios"
                   asp-action="Index"
                   class="btn btn-secondary">

                    Cancelar

                </a>



                <button type="submit"
                        class="btn btn-carpintec">


                    <span class="material-symbols-outlined">

                        person_add

                    </span>


                    Crear Usuario


                </button>


            </div>



        </form>


    </div>



    <partial name="_ValidationScriptsPartial" />


</body>

</html>