@model CARPINTEC_App.Models.ViewModels.UsuarioGestionViewModel

@{
    ViewData["Title"] = "Crear Usuario";
}

<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CARPINTEC - Crear Usuario</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined" rel="stylesheet">

    <style>
        body {
            background: #fcf9f8;
            font-family: Arial, Helvetica, sans-serif;
        }

        .contenedor {
            width: 850px;
            max-width: 95%;
            margin: 40px auto;
            background: white;
            padding: 40px;
            border-radius: 25px;
            box-shadow: 0 5px 20px rgba(0,0,0,.15);
        }

        h1 {
            color: #442a22;
            text-align: center;
            margin-bottom: 30px;
        }

        label {
            font-weight: bold;
        }

        .btn-carpintec {
            background-color: rgb(210,180,140);
            color: black;
            font-weight: 600;
        }

        .btn-carpintec:hover {
            opacity: .85;
            background-color: rgb(190,160,120);
        }

        .seccion-empleado {
            background-color: #fdfaf6;
            border: 2px dashed #D2B48C;
            border-radius: 15px;
            padding: 20px;
            margin-top: 15px;
        }
    </style>
</head>

<body>

    <div class="contenedor">
        <h1>Crear Usuario</h1>

        <form asp-controller="Usuarios" asp-action="NuevoUsuario" method="post">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row">
                <!-- Nombre -->
                <div class="col-md-6 mb-3">
                    <label asp-for="Nombre">Nombre</label>
                    <input asp-for="Nombre" class="form-control" placeholder="Ingrese nombre" required>
                    <span asp-validation-for="Nombre" class="text-danger"></span>
                </div>

                <!-- Apellido -->
                <div class="col-md-6 mb-3">
                    <label asp-for="Apellido">Apellido</label>
                    <input asp-for="Apellido" class="form-control" placeholder="Ingrese apellido" required>
                    <span asp-validation-for="Apellido" class="text-danger"></span>
                </div>

                <!-- Correo -->
                <div class="col-md-12 mb-3">
                    <label asp-for="Correo">Correo electrónico</label>
                    <input asp-for="Correo" type="email" class="form-control" placeholder="correo@ejemplo.com" required>
                    <span asp-validation-for="Correo" class="text-danger"></span>
                </div>

                <!-- Contraseña -->
                <div class="col-md-12 mb-3">
                    <label asp-for="Contraseña">Contraseña</label>
                    <input asp-for="Contraseña" type="password" class="form-control" placeholder="Ingrese contraseña" required>
                    <span asp-validation-for="Contraseña" class="text-danger"></span>
                </div>

                <!-- Rol -->
                <div class="col-md-6 mb-3">
                    <label asp-for="Rol">Rol</label>
                    <select asp-for="Rol" id="rolSelect" class="form-select" onchange="toggleEmpleadoCampos()" required>
                        <option value="">Seleccione un rol</option>
                        <option value="Cliente">Cliente</option>
                        <option value="Empleado">Empleado</option>
                        <option value="Administrador">Administrador</option>
                    </select>
                    <span asp-validation-for="Rol" class="text-danger"></span>
                </div>

                <!-- Estado -->
                <div class="col-md-6 mb-3">
                    <label>Estado inicial</label>
                    <input class="form-control" value="Activo" readonly>
                </div>

                <!-- SECCIÓN EMPLEADO -->
                <div id="seccionEmpleado" class="col-12 seccion-empleado d-none">
                    <h5 class="text-brown mb-3" style="color: #442a22;">
                        <span class="material-symbols-outlined align-middle me-1">badge</span>
                        Datos Obligatorios del Empleado
                    </h5>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="TipoDocumento">Tipo de Documento</label>
                            <select asp-for="TipoDocumento" class="form-select">
                                <option value="CC">Cédula de Ciudadanía (CC)</option>
                                <option value="CE">Cédula de Extranjería (CE)</option>
                                <option value="TI">Tarjeta de Identidad (TI)</option>
                                <option value="Pasaporte">Pasaporte</option>
                            </select>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="Documento">Número de Documento *</label>
                            <input asp-for="Documento" id="docInput" class="form-control" placeholder="Ej: 1020304050">
                            <span asp-validation-for="Documento" class="text-danger"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="Cargo">Puesto / Cargo *</label>
                            <select asp-for="Cargo" id="cargoSelect" class="form-select">
                                <option value="">Seleccione cargo...</option>
                                <option value="Supervisor">Supervisor</option>
                                <option value="Asesor comercial">Asesor comercial</option>
                                <option value="Diseñador de muebles">Diseñador de muebles</option>
                                <option value="Jefe de producción">Jefe de producción</option>
                                <option value="Operario de carpintería">Operario de carpintería</option>
                                <option value="Encargado de inventario">Encargado de inventario</option>
                            </select>
                            <span asp-validation-for="Cargo" class="text-danger"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="Telefono">Teléfono</label>
                            <input asp-for="Telefono" class="form-control" placeholder="Ej: 3101234567">
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="Direccion">Dirección</label>
                            <input asp-for="Direccion" class="form-control" placeholder="Ej: Calle 10 # 20-30">
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="FechaIngreso">Fecha de Ingreso</label>
                            <input asp-for="FechaIngreso" type="date" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")">
                        </div>

                        <div class="col-12 mb-2">
                            <label asp-for="Salario">Salario Mensual ($)</label>
                            <input asp-for="Salario" type="number" step="0.01" min="0" class="form-control" placeholder="Ej: 1500000">
                        </div>
                    </div>
                </div>
            </div>

            <div class="text-end mt-4">
                <a asp-controller="Usuarios" asp-action="Index" class="btn btn-secondary me-2">
                    Cancelar
                </a>

                <button type="submit" class="btn btn-carpintec">
                    <span class="material-symbols-outlined align-middle me-1">person_add</span>
                    Crear Usuario
                </button>
            </div>
        </form>
    </div>

    <script>
        function toggleEmpleadoCampos() {
            const rol = document.getElementById("rolSelect").value;
            const seccion = document.getElementById("seccionEmpleado");
            const doc = document.getElementById("docInput");
            const cargo = document.getElementById("cargoSelect");

            if (rol === "Empleado") {
                seccion.classList.remove("d-none");
                doc.required = true;
                cargo.required = true;
            } else {
                seccion.classList.add("d-none");
                doc.required = false;
                cargo.required = false;
            }
        }

        // Ejecutar al cargar por si hay postback con error
        document.addEventListener("DOMContentLoaded", function () {
            toggleEmpleadoCampos();
        });
    </script>

    <partial name="_ValidationScriptsPartial" />
</body>

</html>