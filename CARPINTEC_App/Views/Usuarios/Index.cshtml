@model IEnumerable<CARPINTEC_App.Models.Usuario>

@{
    ViewData["Title"] = "Usuarios";
}


<!DOCTYPE html>
<html lang="es" class="light">

<head>

<meta charset="UTF-8">

<meta name="viewport" content="width=device-width, initial-scale=1.0">


<title>CARPINTEC - Gestión de Usuarios</title>


<link href="https://fonts.googleapis.com/css2?family=Work+Sans:wght@400;500;600;700;800;900&amp;display=swap"
      rel="stylesheet">


<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined"
      rel="stylesheet">


<script src="https://cdn.tailwindcss.com"></script>

<!-- DATATABLES -->
<link rel="stylesheet" href="https://cdn.datatables.net/2.0.8/css/dataTables.dataTables.css">

<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

<script src="https://cdn.datatables.net/2.0.8/js/dataTables.js"></script>


<!-- INICIO: Tipografía Work Sans en negrita -->
<style>
    @@import url('https://fonts.googleapis.com/css2?family=Work+Sans:wght@400;500;600;700;800;900&display=swap');

    button[onclick="history.back()"],
    main,
    main *:not(.material-symbols-outlined) {
        font-family: 'Work Sans', sans-serif !important;
        font-weight: 700 !important;
    }

    .material-symbols-outlined {
        font-family: 'Material Symbols Outlined' !important;
        font-weight: normal !important;
        font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
    }
</style>
<!-- FIN: Tipografía Work Sans en negrita -->


</head>


<body class="bg-[#fcf9f8] text-[#1b1c1c]">


<!-- BOTÓN VOLVER -->

<button onclick="history.back()"
        class="flex items-center gap-2 text-[#442a22] hover:underline mb-4">


    <span class="material-symbols-outlined">
        arrow_back
    </span>


    Volver


</button>




<main class="min-h-screen p-8">


<div class="max-w-7xl mx-auto">





<!-- ALERTAS TEMP DATA -->
@if (TempData["Success"] != null)
{
    <div class="mb-6 p-4 rounded-2xl bg-green-50 border border-green-200 text-green-800 flex items-center gap-3 shadow-sm">
        <span class="material-symbols-outlined text-green-600">check_circle</span>
        <span class="font-bold">@TempData["Success"]</span>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="mb-6 p-4 rounded-2xl bg-red-50 border border-red-200 text-red-800 flex items-center gap-3 shadow-sm">
        <span class="material-symbols-outlined text-red-600">error</span>
        <span class="font-bold">@TempData["Error"]</span>
    </div>
}

<!-- INICIO: Cuadro beige estilo Dashboard para encabezado -->
<div class="mb-8 bg-[#D2B48C] text-[#442a22] rounded-2xl p-6 shadow-md" style="background-color: #D2B48C;">

<div class="flex flex-col md:flex-row md:items-center justify-between gap-4">


<div>


<h1 class="text-3xl font-bold text-black">

Gestión de Usuarios

</h1>


<p class="mt-2 opacity-90 text-black">

Administra los accesos y roles del equipo de Carpintec

</p>


</div>




<!-- NUEVO BOTÓN MODAL -->


<button type="button"
        onclick="abrirModalUsuario()"
        class="px-6 py-3 rounded-xl shadow-md text-white flex items-center gap-2 transition"
        style="background-color: #442a22;"
        onmouseover="this.style.backgroundColor='#5a382d'"
        onmouseout="this.style.backgroundColor='#442a22'">


<span class="material-symbols-outlined align-middle">

person_add

</span>


Crear Usuario


</button>



</div>

</div>
<!-- FIN: Cuadro beige estilo Dashboard para encabezado -->







<!-- TARJETAS -->


 <div class="grid grid-cols-1 md:grid-cols-5 gap-6 mb-8">



<div class="bg-white rounded-3xl p-6 shadow">

<p class="text-gray-500">

Total Usuarios

</p>


<h2 class="text-3xl font-bold text-[#442a22]">

@Model.Count()

</h2>


</div>




                <div class="bg-white rounded-3xl p-6 shadow">

                    <p class="text-gray-500">
                        Usuarios Activos
                    </p>

                    <h2 class="text-3xl font-bold text-[#442a22]">

                        @Model.Count(x => x.Estado == "Activo")

                    </h2>

                </div>





<div class="bg-white rounded-3xl p-6 shadow">


<p class="text-gray-500">

Administradores

</p>


<h2 class="text-3xl font-bold text-[#442a22]">


@Model.Count(x => x.Rol == "Administrador")


</h2>


                </div>

                <!-- TARJETA INACTIVOS -->

                <div class="bg-white rounded-3xl p-6 shadow">

                    <p class="text-gray-500">
                        Inactivos
                    </p>

                    <h2 class="text-3xl font-bold text-[#442a22]">

                        @Model.Count(x => x.Estado == "Inactivo")

                    </h2>

                </div>



                <!-- TARJETA BLOQUEADOS -->

                <div class="bg-white rounded-3xl p-6 shadow">

                    <p class="text-gray-500">
                        Bloqueados
                    </p>

                    <h2 class="text-3xl font-bold text-[#442a22]">

                        @Model.Count(x => x.Estado == "Bloqueado")

                    </h2>

                </div>
</div>



</div>







<!-- BARRA DE BÚSQUEDA Y FILTRO DE USUARIOS -->
<div class="bg-white rounded-2xl p-4 shadow mb-6">
    <form method="get" action="@Url.Action("Index", "Usuarios")" class="flex flex-col md:flex-row items-center justify-between gap-4">
        <div class="relative w-full md:w-96">
            <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-gray-400">search</span>
            <input name="search" value="@ViewBag.Search" class="w-full pl-10 pr-4 py-2 bg-gray-50 border border-gray-200 rounded-xl text-sm font-semibold text-black focus:border-[#442a22] focus:ring-1 focus:ring-[#442a22] outline-none" placeholder="Buscar por usuario, correo, nombre, documento..." type="text">
        </div>
        <div class="flex flex-wrap md:flex-nowrap items-center gap-3 w-full md:w-auto">
            <select name="rol" onchange="this.form.submit()" class="bg-gray-50 border border-gray-200 rounded-xl px-4 py-2 text-sm font-semibold text-black focus:border-[#442a22] outline-none cursor-pointer">
                <option value="" selected="@(string.IsNullOrEmpty((string?)ViewBag.Rol))">Todos los roles</option>
                <option value="Administrador" selected="@((string?)ViewBag.Rol == "Administrador")">Administrador</option>
                <option value="Empleado" selected="@((string?)ViewBag.Rol == "Empleado")">Empleado</option>
                <option value="Cliente" selected="@((string?)ViewBag.Rol == "Cliente")">Cliente</option>
            </select>
            <button type="submit" class="px-5 py-2 bg-[#442a22] text-white font-bold rounded-xl hover:bg-[#5a382d] transition-all text-sm shadow">
                Buscar
            </button>
            @if (!string.IsNullOrEmpty((string?)ViewBag.Search) || !string.IsNullOrEmpty((string?)ViewBag.Rol))
            {
                <a href="/Usuarios/Index" class="p-2 text-gray-600 hover:bg-gray-100 rounded-xl transition-all border border-gray-200" title="Limpiar filtros">
                    <span class="material-symbols-outlined text-sm">filter_alt_off</span>
                </a>
            }
        </div>
    </form>
</div>

<!-- TABLA -->
<div class="bg-white rounded-3xl shadow overflow-hidden">



<div class="overflow-x-auto">


<table id="tablaUsuarios" class="w-full text-left">

<thead class="bg-[#f0eded]">


<tr>


<th class="px-6 py-4">
Usuario
</th>


<th class="px-6 py-4">
Correo
</th>


<th class="px-6 py-4">
Rol
</th>


<th class="px-6 py-4 text-center">
Estado
</th>


<th class="px-6 py-4 text-right">
Acciones
</th>


</tr>


</thead>



<tbody>



@foreach(var item in Model)
{


<tr class="border-b hover:bg-gray-50">



<td class="px-6 py-4">

@item.Nombre @item.Apellido

</td>




<td class="px-6 py-4">

@item.Correo

</td>




<td class="px-6 py-4">

@item.Rol

</td>




                                    <td class="px-6 py-4 text-center">


                                        @if (item.Estado == "Activo")
                                        {

                                            <span class="px-3 py-1 rounded-full bg-green-100 text-green-700">
                                                Activo
                                            </span>

                                        }
                                        else if (item.Estado == "Bloqueado")
                                        {

                                            <span class="px-3 py-1 rounded-full bg-red-100 text-red-700">
                                                Bloqueado
                                            </span>

                                        }
                                        else
                                        {

                                            <span class="px-3 py-1 rounded-full bg-gray-200 text-gray-700">
                                                Inactivo
                                            </span>

                                        }


                                    </td>


                                    <td class="px-6 py-4">


                                        <div class="flex justify-end gap-3">


                                            <!-- VER USUARIO -->

                                            <button type="button"
                                                    onclick="abrirModalVer('@item.IdUsuario')">

                                                <span class="material-symbols-outlined text-blue-700">

                                                    visibility

                                                </span>

                                            </button>



                                            <!-- EDITAR USUARIO -->

                                            <button type="button"
                                                    onclick="abrirModalEditar('@item.IdUsuario')">

                                                <span class="material-symbols-outlined text-yellow-600">

                                                    edit

                                                </span>

                                            </button>




                                            <!-- CAMBIAR ESTADO -->

                                            <button type="button"
                                                    onclick="abrirModalEstado('@item.IdUsuario','@item.Estado')">

                                                <span class="material-symbols-outlined text-red-600">

                                                    manage_accounts

                                                </span>

                                            </button>

                              </div>

                 </td>

</tr>

}


</tbody>


                </table>

            </div>

            <!-- PAGINACIÓN DE USUARIOS -->
            <div class="px-6 py-4 border-t border-gray-100 bg-white flex flex-col sm:flex-row items-center justify-between gap-4">
                <span class="text-sm font-semibold text-gray-600">
                    Mostrando @(ViewBag.RegistroInicio ?? 0) a @(ViewBag.RegistroFin ?? 0) de @(ViewBag.TotalRegistros ?? 0) usuarios
                </span>
                <div class="flex gap-2 items-center">
                    @if ((ViewBag.PaginaActual ?? 1) > 1)
                    {
                        <a href="@Url.Action("Index", new { pagina = ViewBag.PaginaActual - 1, search = ViewBag.Search, rol = ViewBag.Rol })" class="px-3 py-1.5 rounded-lg border border-gray-200 font-bold text-gray-700 hover:bg-gray-50 text-sm transition-colors">
                            Anterior
                        </a>
                    }
                    else
                    {
                        <button class="px-3 py-1.5 rounded-lg border border-gray-100 text-gray-400 text-sm cursor-not-allowed" disabled>
                            Anterior
                        </button>
                    }

                    @for (int p = 1; p <= (ViewBag.TotalPaginas ?? 1); p++)
                    {
                        if (p == ViewBag.PaginaActual)
                        {
                            <button class="w-8 h-8 rounded-lg bg-[#442a22] text-white font-bold text-sm shadow-sm">
                                @p
                            </button>
                        }
                        else
                        {
                            <a href="@Url.Action("Index", new { pagina = p, search = ViewBag.Search, rol = ViewBag.Rol })" class="w-8 h-8 rounded-lg text-gray-700 hover:bg-gray-100 font-bold flex items-center justify-center transition-colors text-sm">
                                @p
                            </a>
                        }
                    }

                    @if ((ViewBag.PaginaActual ?? 1) < (ViewBag.TotalPaginas ?? 1))
                    {
                        <a href="@Url.Action("Index", new { pagina = ViewBag.PaginaActual + 1, search = ViewBag.Search, rol = ViewBag.Rol })" class="px-3 py-1.5 rounded-lg border border-gray-200 font-bold text-gray-700 hover:bg-gray-50 text-sm transition-colors">
                            Siguiente
                        </a>
                    }
                    else
                    {
                        <button class="px-3 py-1.5 rounded-lg border border-gray-100 text-gray-400 text-sm cursor-not-allowed" disabled>
                            Siguiente
                        </button>
                    }
                </div>
            </div>
        </div>


    
  <!-- ==========================
     MODAL CREAR USUARIO
=========================== -->


            <div id="modalUsuario"
                 class="fixed inset-0 bg-black/50 hidden items-center justify-center z-50">



                <div class="bg-white w-full max-w-3xl rounded-3xl shadow-xl p-8 max-h-[90vh] overflow-y-auto">



                    <!-- TITULO -->

                    <div class="flex justify-between items-center mb-6">


                        <h2 class="text-3xl font-bold text-[#442a22]">

                            Crear Usuario

                        </h2>



                        <button type="button"
                                onclick="cerrarModalUsuario()">


                            <span class="material-symbols-outlined">

                                close

                            </span>


                        </button>


                    </div>






                    <!-- FORMULARIO -->


                    <form asp-controller="Usuarios"
                          asp-action="NuevoUsuario"
                          method="post">


                        @Html.AntiForgeryToken()



                        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">





                            <!-- Nombre -->

                            <div>


                                <label class="font-semibold">

                                    Nombre

                                </label>


                                <input name="Nombre"
                                       type="text"
                                       class="w-full border rounded-xl px-4 py-3"
                                       placeholder="Ingrese nombre"
                                       required>


                            </div>






                            <!-- Apellido -->


                            <div>


                                <label class="font-semibold">

                                    Apellido

                                </label>


                                <input name="Apellido"
                                       type="text"
                                       class="w-full border rounded-xl px-4 py-3"
                                       placeholder="Ingrese apellido"
                                       required>


                            </div>








                            <!-- Correo -->


                            <div>


                                <label class="font-semibold">

                                    Correo

                                </label>


                                <input name="Correo"
                                       type="email"
                                       class="w-full border rounded-xl px-4 py-3"
                                       placeholder="correo@ejemplo.com"
                                       required>


                            </div>







                            <!-- Contraseña -->


                            <div>


                                <label class="font-semibold">

                                    Contraseña

                                </label>


                                <input name="Contraseña"
                                       type="password"
                                       class="w-full border rounded-xl px-4 py-3"
                                       placeholder="Ingrese contraseña"
                                       required>


                            </div>



                            <!-- ROL -->


                            <div>


                                <label class="font-semibold">

                                    Rol

                                </label>



                                <select name="Rol"
                                        id="crearRol"
                                        onchange="cambiarRolCrear()"
                                        class="w-full border rounded-xl px-4 py-3"
                                        required>

                                    <option value="">
                                        Seleccione rol
                                    </option>

                                    <option value="Cliente">
                                        Cliente
                                    </option>

                                    <option value="Empleado">
                                        Empleado
                                    </option>

                                    <option value="Administrador">
                                        Administrador
                                    </option>

                                </select>

                            </div>

                            <!-- ESTADO -->

                            <div>

                                <label class="font-semibold">
                                    Estado
                                </label>

                                <input type="text"
                                       name="Estado"
                                       value="Activo"
                                       class="w-full border rounded-xl px-4 py-3 bg-gray-100"
                                       readonly>

                            </div>

                            <!-- SECCIÓN DINÁMICA DE EMPLEADO -->
                            <div id="seccionEmpleadoCrear" class="hidden col-span-1 md:col-span-2 border-t-2 border-[#D2B48C] pt-4 mt-2 bg-amber-50/40 p-4 rounded-2xl">
                                <div class="flex items-center gap-2 mb-3 text-[#442a22]">
                                    <span class="material-symbols-outlined text-lg">badge</span>
                                    <h3 class="font-bold text-base">Datos del Empleado</h3>
                                </div>
                                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                    <div>
                                        <label class="font-semibold text-sm">Tipo de Documento</label>
                                        <select name="TipoDocumento" id="crearTipoDocumento" class="w-full border rounded-xl px-4 py-2.5 mt-1 bg-white">
                                            <option value="CC">Cédula de Ciudadanía (CC)</option>
                                            <option value="CE">Cédula de Extranjería (CE)</option>
                                            <option value="TI">Tarjeta de Identidad (TI)</option>
                                            <option value="Pasaporte">Pasaporte</option>
                                        </select>
                                    </div>
                                    <div>
                                        <label class="font-semibold text-sm">Número de Documento *</label>
                                        <input name="Documento" id="crearDocumento" type="text" class="w-full border rounded-xl px-4 py-2.5 mt-1 bg-white" placeholder="Ej: 1020304050">
                                    </div>
                                    <div>
                                        <label class="font-semibold text-sm">Puesto / Cargo *</label>
                                        <select name="Cargo" id="crearCargo" class="w-full border rounded-xl px-4 py-2.5 mt-1 bg-white">
                                            <option value="">Seleccione cargo...</option>
                                            <option value="Supervisor">Supervisor</option>
                                            <option value="Asesor comercial">Asesor comercial</option>
                                            <option value="Diseñador de muebles">Diseñador de muebles</option>
                                            <option value="Jefe de producción">Jefe de producción</option>
                                            <option value="Operario de carpintería">Operario de carpintería</option>
                                            <option value="Encargado de inventario">Encargado de inventario</option>
                                        </select>
                                    </div>
                                    <div>
                                        <label class="font-semibold text-sm">Teléfono</label>
                                        <input name="Telefono" id="crearTelefono" type="text" class="w-full border rounded-xl px-4 py-2.5 mt-1 bg-white" placeholder="Ej: 3101234567">
                                    </div>
                                    <div>
                                        <label class="font-semibold text-sm">Dirección</label>
                                        <input name="Direccion" id="crearDireccion" type="text" class="w-full border rounded-xl px-4 py-2.5 mt-1 bg-white" placeholder="Ej: Calle 10 # 20-30">
                                    </div>
                                    <div>
                                        <label class="font-semibold text-sm">Fecha de Ingreso</label>
                                        <input name="FechaIngreso" id="crearFechaIngreso" type="date" value="@DateTime.Today.ToString("yyyy-MM-dd")" class="w-full border rounded-xl px-4 py-2.5 mt-1 bg-white">
                                    </div>
                                    <div class="col-span-1 md:col-span-2">
                                        <label class="font-semibold text-sm">Salario Mensual ($)</label>
                                        <input name="Salario" id="crearSalario" type="number" step="0.01" min="0" class="w-full border rounded-xl px-4 py-2.5 mt-1 bg-white" placeholder="Ej: 1500000">
                                    </div>
                                </div>
                            </div>

                        </div>


                        <!-- BOTONES -->


                        <div class="flex justify-end gap-4 mt-8">



                            <button type="button"
                                    onclick="cerrarModalUsuario()"
                                    class="px-6 py-3 rounded-xl border">


                                Cancelar


                            </button>


                            <button type="submit"
                                    class="px-6 py-3 rounded-xl font-semibold"
                                    style="background-color:rgb(210,180,140);">


                                Guardar Usuario


                            </button>



                        </div>

                    </form>

                </div>


            </div>




  <!-- ==========================
MODAL VER USUARIO
=========================== -->

            <div id="modalVer"
                 class="fixed inset-0 bg-black/50 hidden items-center justify-center z-50">

                <div class="bg-white rounded-3xl shadow-xl w-full max-w-2xl p-8 max-h-[90vh] overflow-y-auto">

                    <div class="flex justify-between items-center mb-6">

                        <h2 class="text-3xl font-bold text-[#442a22]">
                            Información del Usuario
                        </h2>

                        <button onclick="cerrarModalVer()">
                            <span class="material-symbols-outlined">
                                close
                            </span>
                        </button>

                    </div>

                    <div class="grid grid-cols-2 gap-5">

                        <div>
                            <label class="font-semibold">Nombre</label>
                            <input id="verNombre"
                                   class="w-full border rounded-xl px-4 py-3 bg-gray-100"
                                   readonly>
                        </div>

                        <div>
                            <label class="font-semibold">Apellido</label>
                            <input id="verApellido"
                                   class="w-full border rounded-xl px-4 py-3 bg-gray-100"
                                   readonly>
                        </div>

                        <div>
                            <label class="font-semibold">Correo</label>
                            <input id="verCorreo"
                                   class="w-full border rounded-xl px-4 py-3 bg-gray-100"
                                   readonly>
                        </div>

                        <div>
                            <label class="font-semibold">Rol</label>
                            <input id="verRol"
                                   class="w-full border rounded-xl px-4 py-3 bg-gray-100"
                                   readonly>
                        </div>

                        <div class="col-span-2">
                            <label class="font-semibold">Estado</label>
                            <input id="verEstado"
                                   class="w-full border rounded-xl px-4 py-3 bg-gray-100"
                                   readonly>
                        </div>

                        <!-- DETALLES EMPLEADO EN VER -->
                        <div id="seccionEmpleadoVer" class="hidden col-span-2 border-t-2 border-[#D2B48C] pt-4 mt-2 bg-amber-50/40 p-4 rounded-2xl">
                            <div class="flex items-center gap-2 mb-3 text-[#442a22]">
                                <span class="material-symbols-outlined text-lg">badge</span>
                                <h3 class="font-bold text-base">Datos de Empleado</h3>
                            </div>
                            <div class="grid grid-cols-2 gap-4">
                                <div>
                                    <label class="font-semibold text-sm">Puesto / Cargo</label>
                                    <input id="verCargo" class="w-full border rounded-xl px-4 py-2.5 bg-gray-100 mt-1 font-bold text-[#442a22]" readonly>
                                </div>
                                <div>
                                    <label class="font-semibold text-sm">Documento</label>
                                    <input id="verDocumento" class="w-full border rounded-xl px-4 py-2.5 bg-gray-100 mt-1 font-semibold" readonly>
                                </div>
                                <div>
                                    <label class="font-semibold text-sm">Teléfono</label>
                                    <input id="verTelefono" class="w-full border rounded-xl px-4 py-2.5 bg-gray-100 mt-1 font-semibold" readonly>
                                </div>
                                <div>
                                    <label class="font-semibold text-sm">Dirección</label>
                                    <input id="verDireccion" class="w-full border rounded-xl px-4 py-2.5 bg-gray-100 mt-1 font-semibold" readonly>
                                </div>
                                <div>
                                    <label class="font-semibold text-sm">Fecha Ingreso</label>
                                    <input id="verFechaIngreso" class="w-full border rounded-xl px-4 py-2.5 bg-gray-100 mt-1 font-semibold" readonly>
                                </div>
                                <div>
                                    <label class="font-semibold text-sm">Salario Mensual</label>
                                    <input id="verSalario" class="w-full border rounded-xl px-4 py-2.5 bg-gray-100 mt-1 font-bold text-green-700" readonly>
                                </div>
                            </div>
                        </div>

                    </div>

                </div>

            </div>

            <!-- ==========================
MODAL EDITAR
=========================== -->

            <div id="modalEditar"
                 class="fixed inset-0 bg-black/50 hidden items-center justify-center z-50">

                <div class="bg-white rounded-3xl shadow-xl w-full max-w-3xl p-8 max-h-[90vh] overflow-y-auto">

                    <div class="flex justify-between mb-6">

                        <h2 class="text-3xl font-bold text-[#442a22]">

                            Editar Usuario

                        </h2>

                        <button onclick="cerrarModalEditar()">

                            <span class="material-symbols-outlined">

                                close

                            </span>

                        </button>

                    </div>

                <form id="formEditarUsuario">

                    <input type="hidden" id="editIdUsuario" name="IdUsuario">


                    <div class="grid grid-cols-2 gap-5">


                        <div>
                            <label class="font-semibold text-sm">Nombre</label>

                            <input id="editNombre"
                                   name="Nombre"
                                   class="border rounded-xl px-4 py-3 w-full" required>

                        </div>


                        <div>
                            <label class="font-semibold text-sm">Apellido</label>

                            <input id="editApellido"
                                   name="Apellido"
                                   class="border rounded-xl px-4 py-3 w-full" required>

                        </div>


                        <div>
                            <label class="font-semibold text-sm">Correo</label>

                            <input id="editCorreo"
                                   name="Correo"
                                   type="email"
                                   class="border rounded-xl px-4 py-3 w-full" required>

                        </div>


                        <div>
                            <label class="font-semibold text-sm">Rol</label>

                            <select id="editRol"
                                    name="Rol"
                                    onchange="cambiarRolEditar()"
                                    class="border rounded-xl px-4 py-3 w-full" required>

                                <option value="Cliente">
                                    Cliente
                                </option>

                                <option value="Empleado">
                                    Empleado
                                </option>

                                <option value="Administrador">
                                    Administrador
                                </option>

                            </select>

                        </div>

                        <!-- SECCIÓN DINÁMICA DE EMPLEADO EDITAR -->
                        <div id="seccionEmpleadoEditar" class="hidden col-span-2 border-t-2 border-[#D2B48C] pt-4 mt-2 bg-amber-50/40 p-4 rounded-2xl">
                            <div class="flex items-center gap-2 mb-3 text-[#442a22]">
                                <span class="material-symbols-outlined text-lg">badge</span>
                                <h3 class="font-bold text-base">Datos del Empleado</h3>
                            </div>
                            <div class="grid grid-cols-2 gap-4">
                                <div>
                                    <label class="font-semibold text-sm">Tipo de Documento</label>
                                    <select id="editTipoDocumento" class="w-full border rounded-xl px-4 py-2.5 mt-1 bg-white">
                                        <option value="CC">Cédula de Ciudadanía (CC)</option>
                                        <option value="CE">Cédula de Extranjería (CE)</option>
                                        <option value="TI">Tarjeta de Identidad (TI)</option>
                                        <option value="Pasaporte">Pasaporte</option>
                                    </select>
                                </div>
                                <div>
                                    <label class="font-semibold text-sm">Número de Documento *</label>
                                    <input id="editDocumento" type="text" class="w-full border rounded-xl px-4 py-2.5 mt-1 bg-white" placeholder="Ej: 1020304050">
                                </div>
                                <div>
                                    <label class="font-semibold text-sm">Puesto / Cargo *</label>
                                    <select id="editCargo" class="w-full border rounded-xl px-4 py-2.5 mt-1 bg-white">
                                        <option value="">Seleccione cargo...</option>
                                        <option value="Supervisor">Supervisor</option>
                                        <option value="Asesor comercial">Asesor comercial</option>
                                        <option value="Diseñador de muebles">Diseñador de muebles</option>
                                        <option value="Jefe de producción">Jefe de producción</option>
                                        <option value="Operario de carpintería">Operario de carpintería</option>
                                        <option value="Encargado de inventario">Encargado de inventario</option>
                                    </select>
                                </div>
                                <div>
                                    <label class="font-semibold text-sm">Teléfono</label>
                                    <input id="editTelefono" type="text" class="w-full border rounded-xl px-4 py-2.5 mt-1 bg-white" placeholder="Ej: 3101234567">
                                </div>
                                <div>
                                    <label class="font-semibold text-sm">Dirección</label>
                                    <input id="editDireccion" type="text" class="w-full border rounded-xl px-4 py-2.5 mt-1 bg-white" placeholder="Ej: Calle 10 # 20-30">
                                </div>
                                <div>
                                    <label class="font-semibold text-sm">Fecha de Ingreso</label>
                                    <input id="editFechaIngreso" type="date" class="w-full border rounded-xl px-4 py-2.5 mt-1 bg-white">
                                </div>
                                <div class="col-span-2">
                                    <label class="font-semibold text-sm">Salario Mensual ($)</label>
                                    <input id="editSalario" type="number" step="0.01" min="0" class="w-full border rounded-xl px-4 py-2.5 mt-1 bg-white" placeholder="Ej: 1500000">
                                </div>
                            </div>
                        </div>

                    </div>

                        <div class="flex justify-end mt-8">

                        <button type="button"
                                onclick="guardarUsuarioEditado()"
                                class="px-6 py-3 rounded-xl"
                                style="background:rgb(210,180,140);">

                            Guardar Cambios

                        </button>

                        </div>

                    </form>

                </div>

            </div>


        <!-- ==========================
MODAL ESTADO
=========================== -->

        <div id="modalEstado"
             class="fixed inset-0 bg-black/50 hidden items-center justify-center z-50">

            <div class="bg-white rounded-3xl p-8 w-full max-w-lg">

                <h2 class="text-3xl font-bold mb-6 text-[#442a22]">
                    Cambiar Estado
                </h2>


                <form asp-controller="Usuarios"
                      asp-action="CambiarEstado"
                      method="post">

                    @Html.AntiForgeryToken()


                    <!-- ID DEL USUARIO -->
                    <input type="hidden"
                           id="idUsuarioEstado"
                           name="id" />


                    <label class="font-semibold">
                        Nuevo Estado
                    </label>


                    <select id="nuevoEstado"
                            name="estado"
                            class="w-full border rounded-xl px-4 py-3 mt-2">


                        <option value="Activo">
                            Activo
                        </option>


                        <option value="Inactivo">
                            Inactivo
                        </option>


                        <option value="Bloqueado">
                            Bloqueado
                        </option>


                    </select>



                    <div class="flex justify-end gap-3 mt-8">


                        <button type="button"
                                onclick="cerrarModalEstado()"
                                class="border px-6 py-3 rounded-xl">

                            Cancelar

                        </button>



                        <button type="submit"
                                class="px-6 py-3 rounded-xl"
                                style="background:rgb(210,180,140);">

                            Guardar

                        </button>


                    </div>


                </form>


            </div>

        </div>


    
</main>


<script>

// ======================
// DATATABLE USUARIOS
// ======================
</script>
<script>


                // ======================
                // MODAL CREAR USUARIO
                // ======================

                function abrirModalUsuario() {
                    let modal = document.getElementById("modalUsuario");
                    modal.classList.remove("hidden");
                    modal.classList.add("flex");
                    cambiarRolCrear();
                }

                function cerrarModalUsuario() {
                    let modal = document.getElementById("modalUsuario");
                    modal.classList.add("hidden");
                    modal.classList.remove("flex");
                }

                function cambiarRolCrear() {
                    const rolSelect = document.getElementById("crearRol");
                    const seccion = document.getElementById("seccionEmpleadoCrear");
                    const docInput = document.getElementById("crearDocumento");
                    const cargoSelect = document.getElementById("crearCargo");
                    if (!rolSelect || !seccion) return;

                    if (rolSelect.value === "Empleado") {
                        seccion.classList.remove("hidden");
                        if (docInput) docInput.required = true;
                        if (cargoSelect) cargoSelect.required = true;
                    } else {
                        seccion.classList.add("hidden");
                        if (docInput) docInput.required = false;
                        if (cargoSelect) cargoSelect.required = false;
                    }
                }

                // ======================
                // MODAL VER USUARIO
                // ======================

                function abrirModalVer(id) {
                    fetch('/Usuarios/ObtenerUsuario?id=' + id)
                    .then(response => {
                        if (!response.ok) throw new Error("No se pudo obtener la información.");
                        return response.json();
                    })
                    .then(data => {
                        document.getElementById("verNombre").value = data.nombre || '';
                        document.getElementById("verApellido").value = data.apellido || '';
                        document.getElementById("verCorreo").value = data.correo || '';
                        document.getElementById("verRol").value = data.rol || '';
                        document.getElementById("verEstado").value = data.estado || '';

                        const seccionEmp = document.getElementById("seccionEmpleadoVer");
                        if (data.rol === "Empleado") {
                            seccionEmp.classList.remove("hidden");
                            document.getElementById("verCargo").value = data.cargo || 'No asignado';
                            document.getElementById("verDocumento").value = (data.tipoDocumento ? data.tipoDocumento + ' ' : '') + (data.documento || 'No registrado');
                            document.getElementById("verTelefono").value = data.telefono || 'No registrado';
                            document.getElementById("verDireccion").value = data.direccion || 'No registrada';
                            document.getElementById("verFechaIngreso").value = data.fechaIngreso || 'No registrada';
                            document.getElementById("verSalario").value = data.salario != null ? '$' + Number(data.salario).toLocaleString('es-CO') : 'No asignado';
                        } else {
                            seccionEmp.classList.add("hidden");
                        }

                        let modal = document.getElementById("modalVer");
                        modal.classList.remove("hidden");
                        modal.classList.add("flex");
                    })
                    .catch(error => {
                        console.error(error);
                        alert("Error al obtener datos del usuario.");
                    });
                }

                function cerrarModalVer() {
                    let modal = document.getElementById("modalVer");
                    modal.classList.add("hidden");
                    modal.classList.remove("flex");
                }

                // ======================
                // MODAL EDITAR USUARIO
                // ======================

                function cambiarRolEditar() {
                    const rolSelect = document.getElementById("editRol");
                    const seccion = document.getElementById("seccionEmpleadoEditar");
                    if (!rolSelect || !seccion) return;

                    if (rolSelect.value === "Empleado") {
                        seccion.classList.remove("hidden");
                    } else {
                        seccion.classList.add("hidden");
                    }
                }

                function abrirModalEditar(id) {
                    fetch('/Usuarios/ObtenerUsuario?id=' + id)
                    .then(response => {
                        if (!response.ok) throw new Error("No se pudo obtener el usuario.");
                        return response.json();
                    })
                    .then(data => {
                        document.getElementById("editIdUsuario").value = data.idUsuario;
                        document.getElementById("editNombre").value = data.nombre || '';
                        document.getElementById("editApellido").value = data.apellido || '';
                        document.getElementById("editCorreo").value = data.correo || '';
                        document.getElementById("editRol").value = data.rol || 'Cliente';

                        const seccionEmp = document.getElementById("seccionEmpleadoEditar");
                        if (data.rol === "Empleado") {
                            seccionEmp.classList.remove("hidden");
                            document.getElementById("editTipoDocumento").value = data.tipoDocumento || 'CC';
                            document.getElementById("editDocumento").value = data.documento || '';
                            document.getElementById("editCargo").value = data.cargo || '';
                            document.getElementById("editTelefono").value = data.telefono || '';
                            document.getElementById("editDireccion").value = data.direccion || '';
                            document.getElementById("editFechaIngreso").value = data.fechaIngreso || '';
                            document.getElementById("editSalario").value = data.salario != null ? data.salario : '';
                        } else {
                            seccionEmp.classList.add("hidden");
                            document.getElementById("editTipoDocumento").value = 'CC';
                            document.getElementById("editDocumento").value = '';
                            document.getElementById("editCargo").value = '';
                            document.getElementById("editTelefono").value = '';
                            document.getElementById("editDireccion").value = '';
                            document.getElementById("editFechaIngreso").value = '';
                            document.getElementById("editSalario").value = '';
                        }

                        let modal = document.getElementById("modalEditar");
                        modal.classList.remove("hidden");
                        modal.classList.add("flex");
                    })
                    .catch(error => {
                        console.error(error);
                        alert("Error al cargar la información del usuario.");
                    });
                }

                function cerrarModalEditar() {
                    let modal = document.getElementById("modalEditar");
                    modal.classList.add("hidden");
                    modal.classList.remove("flex");
                }

                function guardarUsuarioEditado() {
                    const rol = document.getElementById("editRol").value;
                    const documento = document.getElementById("editDocumento").value.trim();
                    const cargo = document.getElementById("editCargo").value;

                    if (rol === "Empleado") {
                        if (!documento) {
                            alert("Por favor ingrese el número de documento para el empleado.");
                            return;
                        }
                        if (!cargo) {
                            alert("Por favor seleccione un puesto/cargo para el empleado.");
                            return;
                        }
                    }

                    let usuario = {
                        IdUsuario: parseInt(document.getElementById("editIdUsuario").value),
                        Nombre: document.getElementById("editNombre").value.trim(),
                        Apellido: document.getElementById("editApellido").value.trim(),
                        Correo: document.getElementById("editCorreo").value.trim(),
                        Rol: rol,
                        TipoDocumento: document.getElementById("editTipoDocumento").value,
                        Documento: documento,
                        Cargo: cargo,
                        Telefono: document.getElementById("editTelefono").value.trim(),
                        Direccion: document.getElementById("editDireccion").value.trim(),
                        FechaIngreso: document.getElementById("editFechaIngreso").value || null,
                        Salario: document.getElementById("editSalario").value ? parseFloat(document.getElementById("editSalario").value) : null
                    };

                    fetch('/Usuarios/Edit', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify(usuario)
                    })
                    .then(async response => {
                        if (response.ok) {
                            location.reload();
                        } else {
                            const data = await response.json().catch(() => null);
                            alert(data && data.mensaje ? data.mensaje : "No se pudo actualizar el usuario.");
                        }
                    })
                    .catch(error => {
                        console.error(error);
                        alert("Error al intentar actualizar el usuario.");
                    });
                }



                // ======================
                // MODAL CAMBIAR ESTADO
                // ======================

            function abrirModalEstado(id, estado) {

                let modal = document.getElementById("modalEstado");

                modal.classList.remove("hidden");
                modal.classList.add("flex");


                document.getElementById("idUsuarioEstado").value = id;

                document.getElementById("nuevoEstado").value = estado;

            }



                function cerrarModalEstado() {

                    let modal = document.getElementById("modalEstado");

                    modal.classList.add("hidden");
                    modal.classList.remove("flex");

                }


    </script>


</body>

</html>