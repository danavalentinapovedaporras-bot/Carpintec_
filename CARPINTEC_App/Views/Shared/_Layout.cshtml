
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>CARPINTEC</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <!-- Tipografía Work Sans idéntica a la del Dashboard -->
    <link href="https://fonts.googleapis.com/css2?family=Work+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />

    <style>
        /* Tipografía Work Sans aplicada al Sidebar */
        .sidebar-carpintec,
        .sidebar-carpintec *:not(i):not(.bi) {
            font-family: 'Work Sans', sans-serif !important;
        }

        .sidebar-carpintec i.bi {
            font-family: 'bootstrap-icons' !important;
        }

        .sidebar-carpintec .nav-link {
            font-weight: 600;
            letter-spacing: -0.2px;
            border-radius: 8px;
            transition: all 0.2s ease;
        }

        .sidebar-carpintec .nav-link:hover {
            background-color: rgba(255, 255, 255, 0.15);
            color: #ffffff !important;
        }

        .sidebar-carpintec small {
            font-weight: 800 !important;
            letter-spacing: 0.5px;
            font-size: 0.75rem;
        }
    </style>
</head>

<body>

    <div class="d-flex">

        <!-- Sidebar -->
        <div class="sidebar-carpintec p-3 text-white" style="width:270px; min-height:100vh; background-color:#c39d7a;">

            <!-- Logo -->
            <div class="flex flex-col items-center justify-center py-6">
                <img src="~/images/logo.png" alt="Logo CARPINTEC" class="w-20 h-20 object-contain mb-2">
                <h2 class="text-xl font-bold">CARPINTEC</h2>
            </div>

            <ul class="nav flex-column">

                <!-- Dashboard -->
                <li class="nav-item mb-3">
                    <a class="nav-link text-white" asp-controller="Dashboard" asp-action="Index">
                        <i class="bi bi-speedometer2"></i> Dashboard
                    </a>
                </li>

                <!-- Administración -->
                <small class="text-uppercase text-dark fw-bold mb-2">
                    Administración
                </small>

                <li class="nav-item">
                    <a class="nav-link text-white" asp-controller="Usuarios" asp-action="Index">
                        <i class="bi bi-people-fill"></i> Gestión de usuarios
                    </a>
                </li>

                <li class="nav-item mb-3">
                    <a class="nav-link text-white" asp-controller="Empleados" asp-action="Index">
                        <i class="bi bi-person-badge-fill"></i> Gestión de empleados
                    </a>
                </li>

                <!-- Gestión Comercial -->
                <small class="text-uppercase text-dark fw-bold mt-2 mb-2">
                    Gestión Comercial
                </small>

                <li class="nav-item">
                    <a class="nav-link text-white" asp-controller="Clientes" asp-action="Index">
                        <i class="bi bi-person-lines-fill"></i> Gestión de clientes
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link text-white" asp-controller="Cotizaciones" asp-action="Index">
                        <i class="bi bi-file-earmark-text"></i> Cotizaciones
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link text-white" asp-controller="Pedidos" asp-action="Index">
                        <i class="bi bi-cart-fill"></i> Pedidos
                    </a>
                </li>

                <li class="nav-item mb-3">
                    <a class="nav-link text-white" asp-controller="Ventas" asp-action="Index">
                        <i class="bi bi-cash-stack"></i> Ventas y facturación
                    </a>
                </li>

                <!-- Producción -->
                <small class="text-uppercase text-dark fw-bold mt-2 mb-2">
                    Producción
                </small>

                <li class="nav-item">
                    <a class="nav-link text-white" asp-controller="Productos" asp-action="Index">
                        <i class="bi bi-box-seam"></i> Productos
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link text-white" asp-controller="Inventario" asp-action="Index">
                        <i class="bi bi-boxes"></i> Inventario
                    </a>
                </li>

                <li class="nav-item mb-3">
                    <a class="nav-link text-white" asp-controller="ManoObra" asp-action="Index">
                        <i class="bi bi-hammer"></i> Mano de obra
                    </a>
                </li>

                <!-- Reportes -->
                <small class="text-uppercase text-dark fw-bold mt-2 mb-2">
                    Reportes y soporte
                </small>

                <li class="nav-item">
                    <a class="nav-link text-white" asp-controller="Reportes" asp-action="Index">
                        <i class="bi bi-bar-chart-fill"></i> Reportes
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link text-white" asp-controller="Pqr" asp-action="Index">
                        <i class="bi bi-chat-left-dots-fill"></i> PQR
                    </a>
                </li>

                <li class="nav-item mb-3">
                    <a class="nav-link text-white" asp-controller="Configuracion" asp-action="Index">
                        <i class="bi bi-gear-fill"></i> Configuración
                    </a>
                </li>

                <hr />

                <a class="btn text-white w-100"
                   style="background-color: #442a22;"
                   asp-controller="Login"
                   asp-action="CerrarSesion"
                   onmouseover="this.style.backgroundColor='#5a382d'"
                   onmouseout="this.style.backgroundColor='#442a22'">
                    <i class="bi bi-box-arrow-right"></i>
                    Cerrar sesión
                </a>

            </ul>

        </div>

        <!-- Contenido -->
        <div class="flex-grow-1">
            <main class="flex-grow-1 p-4">

                <!-- Barra superior -->
                <header class="bg-white shadow-sm border-b px-8 py-4 flex justify-between items-center">

                    <div>
                        <h1 class="text-2xl font-bold text-gray-800">
                            Bienvenido, Admin 👋
                        </h1>

                        <p class="text-gray-500 text-sm">
                            Sistema de Gestión CARPINTEC
                        </p>
                    </div>

                    <div class="flex items-center gap-4">

                        <span class="font-semibold text-gray-700">
                            Administrador
                        </span>

                        <a asp-controller="Login"
                           asp-action="CerrarSesion"
                           class="text-white px-4 py-2 rounded-lg"
                           style="background-color: #442a22; text-decoration: none;"
                           onmouseover="this.style.backgroundColor='#5a382d'"
                           onmouseout="this.style.backgroundColor='#442a22'">
                            Cerrar sesión
                        </a>

                    </div>

                </header>

            </main>
            <div class="container-fluid p-4">
                @RenderBody()
            </div>

        </div>

    </div>

    <!-- CHATBOT CARPINTEC -->
    <div id="chatbot-box"
         style="
        position:fixed;
        bottom:92px;
        right:24px;
        width:420px;
        max-width:calc(100vw - 32px);
        height:590px;
        max-height:calc(100vh - 120px);
        background:#ffffff;
        border-radius:18px;
        box-shadow:0 12px 36px rgba(0,0,0,0.22);
        z-index:9999;
        display:none;
        flex-direction:column;
        overflow:hidden;
        border:1px solid #e5dbcf;
        font-family: inherit;">

        <!-- Encabezado con identidad CARPINTEC -->
        <div style="
            background: linear-gradient(135deg, #442a22 0%, #5d3a30 100%);
            color: white;
            padding: 14px 18px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            box-shadow: 0 2px 8px rgba(0,0,0,0.15);">

            <div style="display:flex; align-items:center; gap:12px;">
                <div style="
                    width:38px;
                    height:38px;
                    border-radius:50%;
                    background:#c39d7a;
                    display:flex;
                    align-items:center;
                    justify-content:center;
                    font-size:20px;
                    box-shadow: 0 2px 6px rgba(0,0,0,0.2);">
                    🪵
                </div>
                <div>
                    <div style="font-weight:700; font-size:15px; letter-spacing:0.3px;">Asistente CARPINTEC</div>
                    <div style="font-size:12px; opacity:0.9; display:flex; align-items:center; gap:5px;">
                        <span style="width:8px; height:8px; background:#10b981; border-radius:50%; display:inline-block;"></span>
                        <span>En línea •&nbsp;<span id="chatbot-vista-label">Base de datos</span></span>
                    </div>
                </div>
            </div>

            <div style="display:flex; align-items:center; gap:6px;">
                <button type="button"
                        onclick="reiniciarChatbot()"
                        title="Limpiar conversación"
                        style="
                    background:rgba(255,255,255,0.12);
                    border:none;
                    color:white;
                    width:32px;
                    height:32px;
                    border-radius:50%;
                    display:flex;
                    align-items:center;
                    justify-content:center;
                    cursor:pointer;
                    transition:background 0.2s;"
                        onmouseover="this.style.background='rgba(255,255,255,0.25)'"
                        onmouseout="this.style.background='rgba(255,255,255,0.12)'">
                    <i class="bi bi-arrow-clockwise" style="font-size:15px;"></i>
                </button>

                <button type="button"
                        onclick="cerrarChatbot()"
                        title="Cerrar chat"
                        style="
                    background:rgba(255,255,255,0.12);
                    border:none;
                    color:white;
                    width:32px;
                    height:32px;
                    border-radius:50%;
                    display:flex;
                    align-items:center;
                    justify-content:center;
                    cursor:pointer;
                    transition:background 0.2s;
                    font-size:16px;"
                        onmouseover="this.style.background='rgba(255,255,255,0.25)'"
                        onmouseout="this.style.background='rgba(255,255,255,0.12)'">
                    ✕
                </button>
            </div>
        </div>

        <!-- Barra de Sugerencias Rápidas / Chips -->
        <div style="
            background:#fbf8f5;
            padding:10px 14px;
            border-bottom:1px solid #ebdcd0;
            overflow-x:auto;
            white-space:nowrap;
            scrollbar-width:none;
            display:flex;
            gap:6px;
            align-items:center;">

            <!-- CHIP CONTEXTUAL: detecta vista actual y explica qué puede hacer el usuario -->
            <button type="button"
                    id="chip-contexto"
                    onclick="preguntarContexto()"
                    class="btn btn-sm"
                    style="background: linear-gradient(135deg,#c39d7a,#9a7452); color:white; border-radius:20px; font-size:12px; padding:4px 13px; font-weight:700; white-space:nowrap; border:none; box-shadow:0 2px 6px rgba(0,0,0,0.18); flex-shrink:0;">
                📍 ¿Qué puedo hacer aquí?
            </button>

            <button type="button"
                    onclick="enviarPregunta('¿Cómo añadir un cliente?')"
                    class="btn btn-sm"
                    style="background:#ffffff; color:#442a22; border:1px solid #d8c6b5; border-radius:20px; font-size:12px; padding:4px 10px; font-weight:500; white-space:nowrap;">
                ➕ ¿Cómo añadir un cliente?
            </button>

            <button type="button"
                    onclick="enviarPregunta('Resumen general')"
                    class="btn btn-sm"
                    style="background:#ffffff; color:#442a22; border:1px solid #d8c6b5; border-radius:20px; font-size:12px; padding:4px 10px; font-weight:500; white-space:nowrap;">
                📊 Resumen general
            </button>

            <button type="button"
                    onclick="enviarPregunta('Stock bajo')"
                    class="btn btn-sm"
                    style="background:#ffffff; color:#442a22; border:1px solid #d8c6b5; border-radius:20px; font-size:12px; padding:4px 10px; font-weight:500; white-space:nowrap;">
                ⚠️ Stock bajo
            </button>

            <button type="button"
                    onclick="enviarPregunta('Pedidos pendientes')"
                    class="btn btn-sm"
                    style="background:#ffffff; color:#442a22; border:1px solid #d8c6b5; border-radius:20px; font-size:12px; padding:4px 10px; font-weight:500; white-space:nowrap;">
                📦 Pedidos pendientes
            </button>

            <button type="button"
                    onclick="enviarPregunta('Clientes registrados')"
                    class="btn btn-sm"
                    style="background:#ffffff; color:#442a22; border:1px solid #d8c6b5; border-radius:20px; font-size:12px; padding:4px 10px; font-weight:500; white-space:nowrap;">
                👥 Clientes
            </button>

            <button type="button"
                    onclick="enviarPregunta('Total facturado')"
                    class="btn btn-sm"
                    style="background:#ffffff; color:#442a22; border:1px solid #d8c6b5; border-radius:20px; font-size:12px; padding:4px 10px; font-weight:500; white-space:nowrap;">
                💰 Facturación
            </button>

            <button type="button"
                    onclick="enviarPregunta('¿Qué puedo preguntar?')"
                    class="btn btn-sm"
                    style="background:#ffffff; color:#442a22; border:1px solid #d8c6b5; border-radius:20px; font-size:12px; padding:4px 10px; font-weight:500; white-space:nowrap;">
                ❓ Ayuda
            </button>
        </div>

        <!-- Área de Conversación / Mensajes -->
        <div id="chat-respuestas"
             style="
            flex:1;
            overflow-y:auto;
            padding:16px;
            background:#fdfcfb;
            display:flex;
            flex-direction:column;
            gap:14px;">

            <!-- Mensaje de bienvenida inicial -->
            <div style="display:flex; gap:10px; align-items:flex-start;">
                <div style="
                    width:32px;
                    height:32px;
                    border-radius:50%;
                    background:#c39d7a;
                    display:flex;
                    align-items:center;
                    justify-content:center;
                    font-size:16px;
                    flex-shrink:0;">
                    🪵
                </div>
                <div style="
                    background:#ffffff;
                    border:1px solid #ebdcd0;
                    border-radius:0 14px 14px 14px;
                    padding:12px 14px;
                    color:#333333;
                    font-size:13.5px;
                    line-height:1.55;
                    box-shadow:0 2px 6px rgba(0,0,0,0.04);
                    max-width:88%;">
                    <div style="font-weight:700; color:#5d3a30; margin-bottom:4px; font-size:12px;">Asistente CARPINTEC</div>
                    👋 ¡Hola! Soy tu asistente virtual conectado en tiempo real a la base de datos de <b>CARPINTEC</b>.<br><br>
                    Puedo responder cualquier duda sobre <b>clientes, inventario, pedidos, cotizaciones, facturas, empleados</b> o explicarte paso a paso <b>cómo llenar los campos</b> para registrar información en el sistema.<br><br>
                    💡 <i>Prueba escribiendo "¿Cómo añadir un cliente?" o seleccionando un botón de arriba.</i>
                </div>
            </div>

            <!-- Indicador de escritura dinámico -->
            <div id="chat-typing" style="display:none; gap:10px; align-items:flex-start;">
                <div style="
                    width:32px;
                    height:32px;
                    border-radius:50%;
                    background:#c39d7a;
                    display:flex;
                    align-items:center;
                    justify-content:center;
                    font-size:16px;
                    flex-shrink:0;">
                    🪵
                </div>
                <div style="
                    background:#ffffff;
                    border:1px solid #ebdcd0;
                    border-radius:0 14px 14px 14px;
                    padding:10px 14px;
                    color:#666666;
                    font-size:12.5px;
                    display:flex;
                    align-items:center;
                    gap:8px;">
                    <span class="spinner-border spinner-border-sm text-secondary" role="status" style="width:14px; height:14px;"></span>
                    <span>Consultando base de datos...</span>
                </div>
            </div>

        </div>

        <!-- Entrada de Texto / Footer -->
        <div style="
            padding:12px 14px;
            background:#ffffff;
            border-top:1px solid #ebdcd0;
            display:flex;
            align-items:center;
            gap:8px;">

            <input id="chat-input"
                   type="text"
                   class="form-control"
                   placeholder="Escribe tu pregunta o pide una guía..."
                   autocomplete="off"
                   style="
                border-radius:24px;
                padding:9px 16px;
                border:1px solid #d8c6b5;
                font-size:13.5px;
                box-shadow:none;
                outline:none;"
                   onkeydown="if(event.key === 'Enter' && !event.shiftKey){ event.preventDefault(); enviarMensaje(); }">

            <button type="button"
                    onclick="enviarMensaje()"
                    title="Enviar mensaje"
                    class="btn text-white"
                    style="
                background: linear-gradient(135deg, #442a22 0%, #5d3a30 100%);
                border-radius:50%;
                width:42px;
                height:42px;
                padding:0;
                display:flex;
                align-items:center;
                justify-content:center;
                flex-shrink:0;
                border:none;
                box-shadow:0 2px 6px rgba(0,0,0,0.15);
                transition:transform 0.15s;"
                    onmouseover="this.style.transform='scale(1.05)'"
                    onmouseout="this.style.transform='scale(1)'">
                <i class="bi bi-send-fill" style="font-size:15px; margin-left:2px;"></i>
            </button>
        </div>

    </div>

    <!-- BOTÓN FLOTANTE PRINCIPAL -->
    <button id="chatbot-float-btn"
            type="button"
            onclick="abrirChatbot()"
            title="Abrir asistente virtual"
            style="
        position:fixed;
        bottom:22px;
        right:22px;
        width:62px;
        height:62px;
        border-radius:50%;
        border:2px solid #ffffff;
        background: linear-gradient(135deg, #c39d7a 0%, #9a7452 100%);
        color:white;
        font-size:27px;
        box-shadow:0 8px 24px rgba(195,157,122,0.45);
        display:flex;
        align-items:center;
        justify-content:center;
        cursor:pointer;
        z-index:9998;
        transition:transform 0.2s, box-shadow 0.2s;"
            onmouseover="this.style.transform='scale(1.08)'; this.style.boxShadow='0 10px 28px rgba(195,157,122,0.6)';"
            onmouseout="this.style.transform='scale(1)'; this.style.boxShadow='0 8px 24px rgba(195,157,122,0.45)';">
        🤖
    </button>

    <!-- SCRIPTS DEL CHATBOT -->
    <script>
        // Mapa de rutas a nombres amigables para mostrar en el header del chatbot
        var _vistaLabels = {
            'dashboard':     'Dashboard',
            'clientes':      'Gestión Clientes',
            'empleados':     'Gestión Empleados',
            'usuarios':      'Gestión Usuarios',
            'ventas':        'Ventas y Facturación',
            'factura':       'Ventas y Facturación',
            'pedidos':       'Pedidos',
            'cotizaciones':  'Cotizaciones',
            'inventario':    'Inventario',
            'manoobra':      'Mano de Obra',
            'mano':          'Mano de Obra',
            'reportes':      'Reportes',
            'pqr':           'PQR',
            'configuracion': 'Configuración',
            'productos':     'Productos'
        };

        // Devuelve el nombre amigable de la vista actual basado en la URL
        function _detectarVistaLabel() {
            var path = window.location.pathname.toLowerCase();
            for (var clave in _vistaLabels) {
                if (path.indexOf(clave) !== -1) return _vistaLabels[clave];
            }
            return 'Panel Admin';
        }

        // ¿Es la primera vez que se abre el chatbot en esta sesión de página?
        var _chatbotYaAbierto = false;

        function abrirChatbot() {
            var box = document.getElementById("chatbot-box");
            box.style.display = "flex";
            document.getElementById("chatbot-float-btn").style.display = "none";

            // Actualizar el label de la vista en el header del chatbot
            var label = document.getElementById("chatbot-vista-label");
            if (label) label.textContent = _detectarVistaLabel();

            setTimeout(function() {
                document.getElementById("chat-input").focus();
                scrollChatFinal();

                // Auto-consulta contextual solo la primera vez que se abre en esta página
                if (!_chatbotYaAbierto) {
                    _chatbotYaAbierto = true;
                    // Pequeño delay para que el usuario vea el chatbot antes del mensaje
                    setTimeout(function() {
                        enviarMensajeContexto('¿Qué puedo hacer aquí?');
                    }, 500);
                }
            }, 150);
        }

        // Envía la pregunta de contexto SIN mostrarla como burbuja de usuario (es automática)
        async function enviarMensajeContexto(pregunta) {
            var contenedor = document.getElementById("chat-respuestas");
            var typing = document.getElementById("chat-typing");
            typing.style.display = "flex";
            scrollChatFinal();

            try {
                var respuesta = await fetch('/Chatbot/Preguntar', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ mensaje: pregunta, contextoVista: window.location.pathname })
                });
                var data = await respuesta.json();
                typing.style.display = "none";

                var botMsgHtml = document.createElement("div");
                botMsgHtml.style.cssText = "display:flex; gap:10px; align-items:flex-start;";
                botMsgHtml.innerHTML = `
                    <div style="width:32px;height:32px;border-radius:50%;background:#c39d7a;display:flex;align-items:center;justify-content:center;font-size:16px;flex-shrink:0;">
                        🪵
                    </div>
                    <div style="background:#fffaf5;border:1px solid #ddc9b8;border-radius:0 14px 14px 14px;padding:12px 14px;color:#333333;font-size:13.5px;line-height:1.55;box-shadow:0 2px 6px rgba(0,0,0,0.06);max-width:88%;word-break:break-word;">
                        <div style="font-weight:700;color:#5d3a30;margin-bottom:4px;font-size:11px;text-transform:uppercase;letter-spacing:0.5px;">📍 Vista actual: ${_detectarVistaLabel()}</div>
                        ${formatearTextoMarkdown(data.respuesta)}
                    </div>
                `;
                contenedor.insertBefore(botMsgHtml, typing);
                scrollChatFinal();
            } catch (e) {
                typing.style.display = "none";
            }
        }

        // Botón chip: "¿Qué puedo hacer aquí?" — envía con burbuja visible del usuario
        function preguntarContexto() {
            enviarPregunta('¿Qué puedo hacer aquí?');
        }

        function cerrarChatbot() {
            document.getElementById("chatbot-box").style.display = "none";
            document.getElementById("chatbot-float-btn").style.display = "flex";
        }

        function reiniciarChatbot() {
            var contenedor = document.getElementById("chat-respuestas");
            var typing = document.getElementById("chat-typing");
            contenedor.innerHTML = `
            <div style="display:flex; gap:10px; align-items:flex-start;">
                <div style="width:32px; height:32px; border-radius:50%; background:#c39d7a; display:flex; align-items:center; justify-content:center; font-size:16px; flex-shrink:0;">
                    🪵
                </div>
                <div style="background:#ffffff; border:1px solid #ebdcd0; border-radius:0 14px 14px 14px; padding:12px 14px; color:#333333; font-size:13.5px; line-height:1.55; box-shadow:0 2px 6px rgba(0,0,0,0.04); max-width:88%;">
                    <div style="font-weight:700; color:#5d3a30; margin-bottom:4px; font-size:12px;">Asistente CARPINTEC</div>
                    👋 Conversación reiniciada. ¿En qué puedo ayudarte ahora?<br>
                    Puedes preguntarme sobre <b>clientes, inventario, pedidos, cotizaciones, facturas, empleados</b> o pedirme una guía de cómo llenar formularios.
                </div>
            </div>`;
            contenedor.appendChild(typing);
            document.getElementById("chat-input").focus();
        }

        function enviarPregunta(texto) {
            document.getElementById("chat-input").value = texto;
            enviarMensaje();
        }

        function scrollChatFinal() {
            var contenedor = document.getElementById("chat-respuestas");
            contenedor.scrollTop = contenedor.scrollHeight;
        }

        function formatearTextoMarkdown(texto) {
            if (!texto) return "";

            // Sanitizar caracteres básicos
            var res = texto
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;");

            // Convertir negrita **texto**
            res = res.replace(/\*\*(.*?)\*\*/g, "<strong style='color:#3a2016;'>$1</strong>");

            // Convertir cursiva *texto*
            res = res.replace(/\*(.*?)\*/g, "<em>$1</em>");

            // Convertir código `texto`
            res = res.replace(/`(.*?)`/g, "<code style='background:#f3ede7; padding:2px 6px; border-radius:4px; font-size:12px; color:#5d3a30;'>$1</code>");

            // Convertir líneas con viñeta •
            var lineas = res.split('\n');
            var procesadas = lineas.map(function(linea) {
                var l = linea.trim();
                if (l.startsWith('•')) {
                    return "<div style='display:flex; gap:6px; margin:3px 0;'><span style='color:#c39d7a; font-weight:bold;'>•</span><span>" + l.substring(1).trim() + "</span></div>";
                }
                return linea;
            });

            res = procesadas.join('<br>');
            return res;
        }

        async function enviarMensaje() {
            var input = document.getElementById("chat-input");
            var mensaje = input.value.trim();

            if (mensaje === "") return;

            var contenedor = document.getElementById("chat-respuestas");
            var typing = document.getElementById("chat-typing");

            // 1. Mostrar mensaje del usuario en burbuja derecha
            var userMsgHtml = document.createElement("div");
            userMsgHtml.style.cssText = "display:flex; justify-content:flex-end;";
            userMsgHtml.innerHTML = `
                <div style="
                    background: linear-gradient(135deg, #442a22 0%, #5d3a30 100%);
                    color: white;
                    border-radius: 14px 14px 0 14px;
                    padding: 10px 14px;
                    font-size: 13.5px;
                    line-height: 1.45;
                    max-width: 85%;
                    box-shadow: 0 2px 6px rgba(0,0,0,0.12);
                    word-break: break-word;">
                    ${mensaje.replace(/</g, "&lt;").replace(/>/g, "&gt;")}
                </div>
            `;
            contenedor.insertBefore(userMsgHtml, typing);

            input.value = "";
            typing.style.display = "flex";
            scrollChatFinal();

            try {
                var respuesta = await fetch('/Chatbot/Preguntar', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ mensaje: mensaje, contextoVista: window.location.pathname })
                });

                var data = await respuesta.json();
                typing.style.display = "none";

                var botMsgHtml = document.createElement("div");
                botMsgHtml.style.cssText = "display:flex; gap:10px; align-items:flex-start;";
                botMsgHtml.innerHTML = `
                    <div style="
                        width:32px;
                        height:32px;
                        border-radius:50%;
                        background:#c39d7a;
                        display:flex;
                        align-items:center;
                        justify-content:center;
                        font-size:16px;
                        flex-shrink:0;">
                        🪵
                    </div>
                    <div style="
                        background:#ffffff;
                        border:1px solid #ebdcd0;
                        border-radius:0 14px 14px 14px;
                        padding:12px 14px;
                        color:#333333;
                        font-size:13.5px;
                        line-height:1.55;
                        box-shadow:0 2px 6px rgba(0,0,0,0.04);
                        max-width:88%;
                        word-break: break-word;">
                        <div style="font-weight:700; color:#5d3a30; margin-bottom:4px; font-size:12px;">Asistente CARPINTEC</div>
                        ${formatearTextoMarkdown(data.respuesta)}
                    </div>
                `;
                contenedor.insertBefore(botMsgHtml, typing);
            } catch (error) {
                typing.style.display = "none";
                var errorMsgHtml = document.createElement("div");
                errorMsgHtml.style.cssText = "display:flex; gap:10px; align-items:flex-start;";
                errorMsgHtml.innerHTML = `
                    <div style="width:32px; height:32px; border-radius:50%; background:#e11d48; color:white; display:flex; align-items:center; justify-content:center; font-size:16px; flex-shrink:0;">
                        ⚠️
                    </div>
                    <div style="background:#fff1f2; border:1px solid #fecdd3; border-radius:0 14px 14px 14px; padding:10px 14px; color:#9f1239; font-size:13px; max-width:88%;">
                        No fue posible conectar con el servidor en este momento. Por favor verifica tu conexión o intenta nuevamente.
                    </div>
                `;
                contenedor.insertBefore(errorMsgHtml, typing);
            }

            scrollChatFinal();
            input.focus();
        }
    </script>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>