
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>CARPINTEC</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body>

    <div class="d-flex">

        <!-- Sidebar -->
        <div class="p-3 text-white" style="width:270px; min-height:100vh; background-color:#c39d7a;">

            <!-- Logo -->
            <div class="flex flex-col items-center justify-center py-6">
                <img src="~/images/logo.png" alt="Logo CARPINTEC" class="w-20 h-20 object-contain mb-2">
                <h2 class="text-xl font-bold">CARPINTEC</h2>
            </div>

            <ul class="nav flex-column">

                <!-- Dashboard -->
                <li class="nav-item mb-3">
                    <a class="nav-link text-white" asp-controller="Dashboard" asp-action="Index">
                        <i class="bi bi-speedometer2"></i> Dashboard
                    </a>
                </li>

                <!-- Administración -->
                <small class="text-uppercase text-dark fw-bold mb-2">
                    Administración
                </small>

                <li class="nav-item">
                    <a class="nav-link text-white" asp-controller="Usuarios" asp-action="Index">
                        <i class="bi bi-people-fill"></i> Gestión de usuarios
                    </a>
                </li>

                <li class="nav-item mb-3">
                    <a class="nav-link text-white" asp-controller="Empleados" asp-action="Index">
                        <i class="bi bi-person-badge-fill"></i> Gestión de empleados
                    </a>
                </li>

                <!-- Gestión Comercial -->
                <small class="text-uppercase text-dark fw-bold mt-2 mb-2">
                    Gestión Comercial
                </small>

                <li class="nav-item">
                    <a class="nav-link text-white" asp-controller="Clientes" asp-action="Index">
                        <i class="bi bi-person-lines-fill"></i> Gestión de clientes
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link text-white" asp-controller="Cotizaciones" asp-action="Index">
                        <i class="bi bi-file-earmark-text"></i> Cotizaciones
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link text-white" asp-controller="Pedidos" asp-action="Index">
                        <i class="bi bi-cart-fill"></i> Pedidos
                    </a>
                </li>

                <li class="nav-item mb-3">
                    <a class="nav-link text-white" asp-controller="Ventas" asp-action="Index">
                        <i class="bi bi-cash-stack"></i> Ventas y facturación
                    </a>
                </li>

                <!-- Producción -->
                <small class="text-uppercase text-dark fw-bold mt-2 mb-2">
                    Producción
                </small>

                <li class="nav-item">
                    <a class="nav-link text-white" asp-controller="Productos" asp-action="Index">
                        <i class="bi bi-box-seam"></i> Productos
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link text-white" asp-controller="Inventario" asp-action="Index">
                        <i class="bi bi-boxes"></i> Inventario
                    </a>
                </li>

                <li class="nav-item mb-3">
                    <a class="nav-link text-white" asp-controller="ManoObra" asp-action="Index">
                        <i class="bi bi-hammer"></i> Mano de obra
                    </a>
                </li>

                <!-- Reportes -->
                <small class="text-uppercase text-dark fw-bold mt-2 mb-2">
                    Reportes y soporte
                </small>

                <li class="nav-item">
                    <a class="nav-link text-white" asp-controller="Reportes" asp-action="Index">
                        <i class="bi bi-bar-chart-fill"></i> Reportes
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link text-white" asp-controller="Pqr" asp-action="Index">
                        <i class="bi bi-chat-left-dots-fill"></i> PQR
                    </a>
                </li>

                <li class="nav-item mb-3">
                    <a class="nav-link text-white" asp-controller="Configuracion" asp-action="Index">
                        <i class="bi bi-gear-fill"></i> Configuración
                    </a>
                </li>

                <hr />

                <a class="btn btn-danger w-100"
                   asp-controller="Login"
                   asp-action="CerrarSesion">
                    <i class="bi bi-box-arrow-right"></i>
                    Cerrar sesión
                </a>

            </ul>

        </div>

        <!-- Contenido -->
        <div class="flex-grow-1">
            <main class="flex-grow-1 p-4">

                <!-- Barra superior -->
                <header class="bg-white shadow-sm border-b px-8 py-4 flex justify-between items-center">

                    <div>
                        <h1 class="text-2xl font-bold text-gray-800">
                            Bienvenido, Admin 👋
                        </h1>

                        <p class="text-gray-500 text-sm">
                            Sistema de Gestión CARPINTEC
                        </p>
                    </div>

                    <div class="flex items-center gap-4">

                        <span class="font-semibold text-gray-700">
                            Administrador
                        </span>

                        <a asp-controller="Login"
                           asp-action="CerrarSesion"
                           class="bg-red-500 hover:bg-red-600 text-white px-4 py-2 rounded-lg">
                            Cerrar sesión
                        </a>

                    </div>

                </header>

            </main>
            <div class="container-fluid p-4">
                @RenderBody()
            </div>

        </div>

    </div>

    <!-- CHATBOT CARPINTEC -->

    <div id="chatbot-box"
         class="hidden"
         style="
        position:fixed;
        bottom:90px;
        right:20px;
        width:350px;
        background:white;
        border-radius:15px;
        box-shadow:0 5px 20px rgba(0,0,0,0.3);
        z-index:9999;">

        <!-- Encabezado -->
        <div style="
            background:#c39d7a;
            color:white;
            padding:15px;
            border-radius:15px 15px 0 0;">

            <b>🤖 Asistente CARPINTEC</b>

            <button onclick="cerrarChatbot()"
                    style="
                float:right;
                background:none;
                border:none;
                color:white;
                font-size:18px;">
                ✖
            </button>

        </div>

        <!-- MENU CHATBOT -->

        <div style="
            padding:10px;
            background:#f8f5f2;
            border-bottom:1px solid #ddd;">

            <p style="margin:0 0 8px 0;">
                👋 Hola, soy el asistente de CARPINTEC.
            </p>

            <small>
                Selecciona una opción:
            </small>

            <div style="margin-top:10px;">

                <button onclick="enviarPregunta('productos')"
                        class="btn btn-sm text-white m-1"
                        style="background:#c39d7a;">
                    🪑 Productos
                </button>


                <button onclick="enviarPregunta('clientes')"
                        class="btn btn-sm text-white m-1"
                        style="background:#c39d7a;">
                    👥 Clientes
                </button>


                <button onclick="enviarPregunta('cotizaciones')"
                        class="btn btn-sm text-white m-1"
                        style="background:#c39d7a;">
                    📄 Cotizaciones
                </button>


                <button onclick="enviarPregunta('pedidos')"
                        class="btn btn-sm text-white m-1"
                        style="background:#c39d7a;">
                    📦 Pedidos
                </button>


                <button onclick="enviarPregunta('inventario')"
                        class="btn btn-sm text-white m-1"
                        style="background:#c39d7a;">
                    📊 Inventario
                </button>


                <button onclick="enviarPregunta('facturas')"
                        class="btn btn-sm text-white m-1"
                        style="background:#c39d7a;">
                    💰 Facturas
                </button>

            </div>

        </div>

        <!-- Mensajes -->
        <div id="chat-respuestas"
             style="
            height:250px;
            overflow-y:auto;
            padding:15px;">
        </div>


        <!-- Entrada -->
        <div style="
            display:flex;
            padding:10px;">

            <input id="chat-input"
                   class="form-control"
                   placeholder="Escribe un mensaje..."
                   style="margin-right:5px;">


            <button onclick="enviarMensaje()"
                    class="btn text-white"
                    style="background:#c39d7a;">
                Enviar
            </button>

        </div>

    </div>


    <!-- BOTÓN FLOTANTE -->

    <button onclick="abrirChatbot()"
            style="
        position:fixed;
        bottom:20px;
        right:20px;
        width:60px;
        height:60px;
        border-radius:50%;
        border:none;
        background:#c39d7a;
        color:white;
        font-size:25px;
        z-index:9999;">
        🤖
    </button>



    <script>

            function abrirChatbot() {

                document.getElementById("chatbot-box")
                    .style.display = "block";

            }


            function cerrarChatbot() {

                document.getElementById("chatbot-box")
                    .style.display = "none";

            }

            function enviarPregunta(texto) {

                document.getElementById("chat-input").value = texto;

                enviarMensaje();

            }

            async function enviarMensaje() {

                let input = document.getElementById("chat-input");

                let mensaje = input.value;


                if (mensaje.trim() == "") {
                    return;
                }


                document.getElementById("chat-respuestas").innerHTML +=
                    `
                <p><b>Tú:</b> ${mensaje}</p>
                `;


                let respuesta = await fetch('/Chatbot/Preguntar',
                    {

                        method: 'POST',

                        headers:
                        {
                            'Content-Type': 'application/json'
                        },

                        body: JSON.stringify(
                            {
                                mensaje: mensaje
                            })

                    });



                let data = await respuesta.json();



                document.getElementById("chat-respuestas").innerHTML +=
                    `
                <p><b>Bot:</b> ${data.respuesta}</p>
                `;


                input.value = "";


            }

    </script>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>