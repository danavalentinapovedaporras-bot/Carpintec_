@model IEnumerable<CARPINTEC_App.Models.Inventario>
<!DOCTYPE html>
<html class="light" lang="es" style="">
<head>
    <meta charset="utf-8">
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <title>Inventario - CARPINTEC</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Work+Sans:wght@400;500;600;700;800;900&amp;display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet">
    <script id="tailwind-config">
            tailwind.config = {
                darkMode: "class",
                theme: {
                    extend: {
                        "colors": {
                            "secondary-container": "#e1e1c9",
                            "on-secondary-fixed-variant": "#474836",
                            "tertiary-container": "#334b49",
                            "on-surface-variant": "#504441",
                            "tertiary-fixed": "#cde8e5",
                            "surface": "#fcf9f8",
                            "outline-variant": "#d4c3be",
                            "on-surface": "#1b1c1c",
                            "surface-container-high": "#eae7e7",
                            "error-container": "#ffdad6",
                            "primary-container": "#5d4037",
                            "primary-fixed": "#ffdbd0",
                            "surface-container": "#f0eded",
                            "error": "#ba1a1a",
                            "on-error-container": "#93000a",
                            "inverse-surface": "#303030",
                            "on-tertiary-container": "#a0bab7",
                            "surface-variant": "#e5e2e1",
                            "secondary": "#5e604d",
                            "surface-bright": "#fcf9f8",
                            "surface-container-highest": "#e5e2e1",
                            "primary": "#442a22",
                            "on-secondary-fixed": "#1b1d0e",
                            "on-tertiary-fixed": "#061f1e",
                            "on-error": "#ffffff",
                            "primary-fixed-dim": "#e7bdb1",
                            "on-secondary-container": "#636451",
                            "surface-tint": "#77574d",
                            "tertiary": "#1c3433",
                            "on-primary-fixed-variant": "#5d4037",
                            "on-primary-container": "#d4ada1",
                            "surface-container-lowest": "#ffffff",
                            "surface-dim": "#dcd9d9",
                            "outline": "#827470",
                            "inverse-primary": "#e7bdb1",
                            "background": "#fcf9f8",
                            "inverse-on-surface": "#f3f0ef",
                            "secondary-fixed": "#e4e4cc",
                            "secondary-fixed-dim": "#c8c8b0",
                            "on-secondary": "#ffffff",
                            "tertiary-fixed-dim": "#b1ccc9",
                            "on-tertiary": "#ffffff",
                            "surface-container-low": "#f6f3f2",
                            "on-primary-fixed": "#2c160e",
                            "on-primary": "#ffffff",
                            "on-background": "#1b1c1c",
                            "on-tertiary-fixed-variant": "#334b49"
                        },
                        "borderRadius": {
                            "DEFAULT": "0.25rem",
                            "lg": "0.5rem",
                            "xl": "0.75rem",
                            "full": "9999px"
                        },
                        "spacing": {
                            "md": "24px",
                            "sm": "12px",
                            "base": "8px",
                            "lg": "40px",
                            "gutter": "24px",
                            "xl": "64px",
                            "xs": "4px",
                            "margin": "32px"
                        },
                        /* INICIO: Configuración Work Sans en Tailwind */
                        "fontFamily": {
                            "body-md": ["Work Sans", "sans-serif"],
                            "headline-lg-mobile": ["Work Sans", "sans-serif"],
                            "body-lg": ["Work Sans", "sans-serif"],
                            "body-sm": ["Work Sans", "sans-serif"],
                            "headline-xl": ["Work Sans", "sans-serif"],
                            "headline-md": ["Work Sans", "sans-serif"],
                            "headline-lg": ["Work Sans", "sans-serif"],
                            "label-md": ["Work Sans", "sans-serif"]
                        },
                        /* FIN: Configuración Work Sans en Tailwind */
                        "fontSize": {
                            "body-md": ["16px", { "lineHeight": "24px", "fontWeight": "400" }],
                            "headline-lg-mobile": ["28px", { "lineHeight": "36px", "fontWeight": "600" }],
                            "body-lg": ["18px", { "lineHeight": "28px", "fontWeight": "400" }],
                            "body-sm": ["14px", { "lineHeight": "20px", "fontWeight": "400" }],
                            "headline-xl": ["40px", { "lineHeight": "48px", "letterSpacing": "-0.02em", "fontWeight": "700" }],
                            "headline-md": ["24px", { "lineHeight": "32px", "fontWeight": "600" }],
                            "headline-lg": ["32px", { "lineHeight": "40px", "letterSpacing": "-0.01em", "fontWeight": "600" }],
                            "label-md": ["14px", { "lineHeight": "16px", "letterSpacing": "0.05em", "fontWeight": "600" }]
                        }
                    },
                },
            }
    </script>
    <!-- INICIO: Estilos de tipografía Work Sans en negrita y corrección de colores -->
    <style>
            @@import url('https://fonts.googleapis.com/css2?family=Work+Sans:wght@400;500;600;700;800;900&display=swap');

            button[onclick="history.back()"],
            main,
            main *:not(.material-symbols-outlined):not([class*="fa-"]):not(i),
            #modalReposicion,
            #modalReposicion *:not(.material-symbols-outlined):not([class*="fa-"]):not(i) {
                font-family: 'Work Sans', sans-serif !important;
                font-weight: 700 !important;
            }

            .material-symbols-outlined {
                font-family: 'Material Symbols Outlined' !important;
                font-weight: normal !important;
                font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
                vertical-align: middle;
            }

            body {
                font-family: 'Work Sans', sans-serif !important;
                font-weight: 700 !important;
                background-color: #fcf9f8;
                color: #000000;
            }

            /* Corrección de azul de Bootstrap a beige (#D2B48C) y negro */
            .bg-primary {
                background-color: #D2B48C !important;
            }

            .text-primary {
                color: #000000 !important;
            }

            .border-primary {
                border-color: #D2B48C !important;
            }

            .glass-card {
                background: rgba(255, 255, 255, 0.9);
                backdrop-filter: blur(8px);
                border: 1px solid rgba(245, 245, 220, 0.5);
            }

            .wood-shadow {
                box-shadow: 0 4px 12px rgba(68, 42, 34, 0.08);
            }

            .zebra-row:nth-child(even) {
                background-color: rgba(245, 245, 220, 0.3);
            }

            .swatch-glow {
                transition: all 0.3s ease;
            }

                .swatch-glow:hover {
                    transform: translateY(-2px);
                    box-shadow: 0 8px 16px rgba(68, 42, 34, 0.12);
                }

            .sidebar-item-active {
                background-color: rgba(255, 219, 208, 0.15);
                color: #ffdbd0;
                border-left: 4px solid #ffdbd0;
            }
    </style>
    <!-- FIN: Estilos de tipografía Work Sans en negrita y corrección de colores -->
    <style>
            body {
                min-height: max(884px, 100dvh);
            }
    </style>
</head>
<body class="bg-surface selection:bg-primary-fixed selection:text-on-primary-fixed">
    <!-- Sidebar Navigation Drawer -->
    <button onclick="history.back()"
            class="flex items-center gap-2 text-black font-bold hover:underline mb-4" style="color: #000000;">
        <span class="material-symbols-outlined text-black">arrow_back</span>
        Volver
    </button>

    <!-- Main Content Canvas -->
    <main class="pt-4 min-h-screen bg-background">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-6">
            <h1 class="text-headline-xl font-headline-xl font-bold text-black" style="color: #000000;">Inventario</h1>
            @if (TempData["Exito"] != null)
            {
                <div class="mt-3 p-3 rounded-lg bg-green-100 border border-green-300 text-green-800 text-sm font-bold flex items-center gap-2">
                    <span class="material-symbols-outlined text-green-600">check_circle</span>
                    @TempData["Exito"]
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="mt-3 p-3 rounded-lg bg-red-100 border border-red-300 text-red-800 text-sm font-bold flex items-center gap-2">
                    <span class="material-symbols-outlined text-red-600">error</span>
                    @TempData["Error"]
                </div>
            }
        </div>
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-lg">
            <!-- Summary Stats Bento Grid -->
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-md">
                <div class="bg-surface-container-lowest p-md rounded-xl wood-shadow border border-outline-variant/20">
                    <div class="flex items-center justify-between mb-4">
                        <span class="text-label-md text-on-surface-variant font-bold">Productos Totales</span>
                        <span class="material-symbols-outlined text-black">inventory</span>
                    </div>
                    <p class="text-headline-lg font-headline-lg text-black font-bold" style="color: #000000;">@ViewBag.ProductosTotales</p>
                    <p class="text-body-sm text-tertiary mt-2 font-bold">Total registrados en inventario</p>
                </div>
                <!-- INICIO: Tarjeta estadística Stock Bajo en color beige (#D2B48C) -->
                <div class="bg-[#D2B48C]/30 p-md rounded-xl wood-shadow border border-[#D2B48C]/50" style="background-color: rgba(210, 180, 140, 0.3);">
                    <div class="flex items-center justify-between mb-4">
                        <span class="text-label-md text-black font-bold">Stock Bajo</span>
                        <span class="material-symbols-outlined text-[#8b5a2b]">warning</span>
                    </div>
                    <p class="text-headline-lg font-headline-lg text-black font-bold" style="color: #000000;">@ViewBag.StockBajoCount</p>
                    <p class="text-body-sm text-black/70 mt-2 font-bold">Requieren atención inmediata</p>
                </div>
                <!-- FIN: Tarjeta estadística Stock Bajo en color beige (#D2B48C) -->
                <div class="bg-surface-container-lowest p-md rounded-xl wood-shadow border border-outline-variant/20">
                    <div class="flex items-center justify-between mb-4">
                        <span class="text-label-md text-on-surface-variant font-bold">Valor Inventario</span>
                        <span class="material-symbols-outlined text-black">payments</span>
                    </div>
                    @{
                        decimal valorInv = ViewBag.ValorInventario ?? 0m;
                    }
                    <p class="text-headline-lg font-headline-lg text-black font-bold" style="color: #000000;">@valorInv.ToString("C0")</p>
                    <p class="text-body-sm text-on-surface-variant mt-2 font-bold">Basado en precio de compra</p>
                </div>
                <div class="bg-surface-container-lowest p-md rounded-xl wood-shadow border border-outline-variant/20">
                    <div class="flex items-center justify-between mb-4">
                        <span class="text-label-md text-on-surface-variant font-bold">Movimientos</span>
                        <span class="material-symbols-outlined text-black">sync_alt</span>
                    </div>
                    <p class="text-headline-lg font-headline-lg text-black font-bold" style="color: #000000;">@ViewBag.MovimientosCount</p>
                    <p class="text-body-sm text-on-surface-variant mt-2 font-bold">Últimos 30 días</p>
                </div>
            </div>
            <!-- Main Actions & Filters -->
            <div class="flex flex-col sm:flex-row justify-between items-center gap-4">
                <div class="flex bg-surface-container-high p-1 rounded-lg">
                    <button class="px-6 py-2 rounded-md text-label-md font-label-md transition-all" style="background-color: rgb(210, 180, 140); color: rgb(0, 0, 0);">Madera</button>
                    <button class="px-6 py-2 hover:bg-surface-container-highest text-on-surface-variant rounded-md text-label-md font-label-md transition-all">Herrajes</button>
                    <button class="px-6 py-2 hover:bg-surface-container-highest text-on-surface-variant rounded-md text-label-md font-label-md transition-all">Herramientas</button>
                    <button class="px-6 py-2 hover:bg-surface-container-highest text-on-surface-variant rounded-md text-label-md font-label-md transition-all">Químicos</button>
                </div>
               
                <!-- FIN: Botón Facturas PDF en color beige (#D2B48C) -->
            </div>
            <!-- Inventory List Table Card -->
            <div class="bg-surface-container-lowest rounded-xl wood-shadow overflow-hidden border border-outline-variant/20">
                <div class="p-6 border-b border-outline-variant/30 bg-surface-container-low/50 flex justify-between items-center">
                    <h3 class="text-headline-md font-headline-md text-black font-bold" style="color: #000000;">Catálogo de Materiales</h3>
                    <div class="flex gap-2">
                        <span class="text-body-sm text-on-surface-variant">Filtro: Todo el stock</span>
                        <span class="material-symbols-outlined text-on-surface-variant cursor-pointer">filter_list</span>
                    </div>
                </div>
                <div class="overflow-x-auto">
                    <table class="w-full text-left">
                        <thead>
                            <tr class="bg-surface-container text-on-surface-variant text-label-md border-b border-outline-variant/30">
                                <th class="px-6 py-4 font-semibold">PRODUCTO</th>
                                <th class="px-6 py-4 font-semibold">CATEGORÍA</th>
                                <th class="px-6 py-4 font-semibold text-center">STOCK</th>
                                <th class="px-6 py-4 font-semibold">UNIDAD</th>
                                <th class="px-6 py-4 font-semibold">PRECIO UNIT.</th>
                                <th class="px-6 py-4 font-semibold">ESTADO</th>
                                <th class="px-6 py-4 font-semibold text-right">ACCIONES</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-outline-variant/20">
                            <!-- Low Stock Alert Row -->
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    // Lógica para alternar el estilo si el stock es bajo (ejemplo menor o igual a 15)
                                    bool esStockBajo = item.StockActual <= 15;
                                    string claseFila = esStockBajo ? "zebra-row hover:bg-surface-container-low transition-colors group bg-primary-fixed/10" : "zebra-row hover:bg-surface-container-low transition-colors group";

                                    <tr class="@claseFila">
                                        <td class="px-6 py-4">
                                            <div class="flex items-center gap-4">
                                                <div class="w-12 h-12 rounded-lg bg-surface-variant flex items-center justify-center overflow-hidden border border-outline-variant/30">
                                                    @if (!string.IsNullOrEmpty(item.NombreProducto) && item.NombreProducto.Contains("Tornillo"))
                                                    {
                                                        <span class="material-symbols-outlined text-black text-3xl">build</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="material-symbols-outlined text-black text-3xl">inventory_2</span>
                                                    }
                                                </div>
                                                <div>
                                                    <p class="text-body-md font-bold text-black" style="color: #000000;">@item.NombreProducto</p>
                                                    <p class="text-body-sm text-on-surface-variant font-bold">Ref: @item.IdInventario</p>
                                                </div>
                                            </div>
                                        </td>
                                        @{
                                            var catDict = ViewBag.Categorias as Dictionary<int, string>;
                                            string catNombre = (catDict != null && catDict.ContainsKey(item.IdProducto)) ? catDict[item.IdProducto] : "General";
                                        }
                                        <td class="px-6 py-4 text-body-sm font-bold">@catNombre</td>
                                        <td class="px-6 py-4 text-center">
                                            @if (esStockBajo)
                                            {
                                                <span class="px-3 py-1 rounded-full bg-error-container text-error text-label-md font-bold">@item.StockActual</span>
                                            }
                                            else
                                            {
                                                <span class="text-body-md font-bold text-black" style="color: #000000;">@item.StockActual</span>
                                            }
                                        </td>
                                        <td class="px-6 py-4 text-body-sm font-bold">@item.UnidadMedida</td>
                                        <td class="px-6 py-4 text-body-md font-bold text-black" style="color: #000000;">$@item.PrecioCompra.ToString("N0")</td>
                                        <td class="px-6 py-4">
                                            @if (esStockBajo)
                                            {
                                                <span class="flex items-center gap-1 text-error text-label-md font-bold uppercase tracking-wider">
                                                    <span class="w-2 h-2 rounded-full bg-error animate-pulse"></span> Stock Bajo
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="flex items-center gap-1 text-tertiary text-label-md font-bold uppercase tracking-wider">
                                                    <span class="w-2 h-2 rounded-full bg-tertiary"></span> Disponible
                                                </span>
                                            }
                                        </td>
                                        <td class="px-6 py-4 text-right">
                                            <a asp-action="Edit" asp-route-id="@item.IdInventario" class="p-2 text-on-surface-variant hover:text-primary transition-colors inline-block" title="Editar"><span class="material-symbols-outlined">edit</span></a>
                                            <form asp-action="Delete" asp-route-id="@item.IdInventario" method="post" class="inline-block" onsubmit="return confirm('¿Está seguro de eliminar este registro de inventario?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="p-2 text-on-surface-variant hover:text-error transition-colors" title="Eliminar"><span class="material-symbols-outlined">delete</span></button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                            <div class="p-6 border-t border-outline-variant/30 bg-surface-container-low/30 flex flex-col sm:flex-row items-center justify-between gap-4">
                                @{
                                    int paginaActual = ViewBag.PaginaActual ?? 1;
                                    int totalPaginas = ViewBag.TotalPaginas ?? 1;
                                    int totalRegistros = ViewBag.TotalRegistros ?? 0;
                                    int registrosPorPagina = ViewBag.RegistrosPorPagina ?? 5;

                                    int inicio = totalRegistros == 0 ? 0 : ((paginaActual - 1) * registrosPorPagina) + 1;
                                    int fin = Math.Min(paginaActual * registrosPorPagina, totalRegistros);
                                }

                                <!-- Texto de conteo dinámico -->
                                <p class="text-body-sm text-on-surface-variant">
                                    Mostrando @inicio - @fin de @totalRegistros productos
                                </p>

                                <!-- Botones de paginación funcionales -->
                                <div class="flex gap-2 items-center">
                                    @if (paginaActual > 1)
                                    {
                                        <a asp-action="Index" asp-route-pagina="@(paginaActual - 1)"
                                           class="px-3 h-10 rounded-lg flex items-center justify-center border border-outline-variant/30 text-on-surface-variant hover:bg-primary hover:text-on-primary transition-all text-body-sm font-medium">
                                            Anterior
                                        </a>
                                    }

                                    @for (int i = 1; i <= totalPaginas; i++)
                                    {
                                        if (i == paginaActual)
                                        {
                                            <span class="w-10 h-10 rounded-lg flex items-center justify-center bg-[#D2B48C] text-black font-bold shadow-sm" style="background-color: #D2B48C; color: #000000;">
                                                @i
                                            </span>
                                        }
                                        else
                                        {
                                            <a asp-action="Index" asp-route-pagina="@i"
                                               class="w-10 h-10 rounded-lg flex items-center justify-center border border-outline-variant/30 text-on-surface-variant hover:bg-primary hover:text-on-primary transition-all font-medium">
                                                @i
                                            </a>
                                        }
                                    }

                                    @if (paginaActual < totalPaginas)
                                    {
                                        <a asp-action="Index" asp-route-pagina="@(paginaActual + 1)"
                                           class="px-3 h-10 rounded-lg flex items-center justify-center border border-outline-variant/30 text-on-surface-variant hover:bg-primary hover:text-on-primary transition-all text-body-sm font-medium">
                                            Siguiente
                                        </a>
                                    }
                                </div>
                            </div>
                    </table>
                    </div>
                </div>
            </div>
            <!-- Recent Stock History / Entries & Exits -->
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-md">
                <div class="lg:col-span-2 bg-surface-container-lowest p-md rounded-xl wood-shadow border border-outline-variant/20">
                    <div class="flex justify-between items-center mb-6">
                        <h3 class="text-headline-md font-headline-md text-black font-bold" style="color: #000000;">Historial de Movimientos</h3>
                        <a class="text-label-md font-bold text-black hover:underline" href="#" style="color: #000000;">Ver reporte completo</a>
                    </div>
                    <div class="space-y-4">
                        @{
                            var movimientos = ViewBag.HistorialMovimientos as List<CARPINTEC_App.Models.MovimientoInventario>;
                        }
                        @if (movimientos != null && movimientos.Any())
                        {
                            @foreach (var mov in movimientos)
                            {
                                bool esEntrada = mov.Tipo != null && mov.Tipo.ToLower().Contains("entrada");
                                string iconoMov = esEntrada ? "south_east" : "north_east";
                                string colorIcono = esEntrada ? "bg-tertiary/10 text-tertiary" : "bg-error/10 text-error";
                                string colorCantidad = esEntrada ? "text-tertiary" : "text-error";
                                string prefijo = esEntrada ? "+" : "-";

                                <div class="flex items-center justify-between p-4 bg-surface-container-low rounded-lg border border-outline-variant/10">
                                    <div class="flex items-center gap-4">
                                        <div class="w-10 h-10 rounded-full @colorIcono flex items-center justify-center">
                                            <span class="material-symbols-outlined">@iconoMov</span>
                                        </div>
                                        <div>
                                            <p class="text-body-md font-bold text-black" style="color: #000000;">@mov.Tipo: @mov.NombreProducto</p>
                                            <p class="text-body-sm text-on-surface-variant font-bold">@mov.ReferenciaOProyecto</p>
                                        </div>
                                    </div>
                                    <div class="text-right">
                                        <p class="text-body-md font-bold @colorCantidad">@prefijo@mov.Cantidad @mov.UnidadMedida</p>
                                        <p class="text-body-sm text-on-surface-variant font-bold">@mov.FechaMovimiento.ToString("dd MMM yyyy, hh:mm tt")</p>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="p-4 text-center text-on-surface-variant text-sm italic font-bold">
                                No hay movimientos registrados aún.
                            </div>
                        }
                    </div>
                </div>
                <!-- Custom Material Swatches / Specialty Component -->
                <!-- INICIO: Tarjeta lateral Stock Bajo en color beige (#D2B48C) con letras en negro -->
                <div class="bg-[#D2B48C] text-black p-6 rounded-xl wood-shadow flex flex-col justify-between" style="background-color: #D2B48C !important; color: #000000 !important;">
                    <div>
                        <h3 class="text-headline-md font-headline-md font-bold mb-2 text-black" style="color: #000000 !important;">&nbsp;Stock Bajo</h3>
                        <p class="text-body-sm mb-6 text-black/80 font-bold" style="color: #000000 !important;">Materiales con existencias críticas (1 a 10 unidades)</p>

                        <div class="space-y-4">
                            @{
                                var stockBajo = ViewBag.ProductosBajos as List<CARPINTEC_App.Models.Inventario>;
                            }

                            @if (stockBajo != null && stockBajo.Any())
                            {
                                @foreach (var item in stockBajo)
                                {
                                    <div class="flex items-center justify-between p-3 rounded-lg bg-white/10 border border-white/10">
                                        <div class="flex items-center gap-3">
                                            <span class="material-symbols-outlined text-warning">warning</span>
                                            <div>
                                                <!-- INICIO: Texto de producto y stock en negro sobre tarjeta beige -->
                                                <span class="text-body-md font-bold block text-black" style="color: #000000 !important;">@item.NombreProducto</span>
                                                <span class="text-xs text-black/80 font-bold" style="color: #000000 !important;">Quedan: @item.StockActual @item.UnidadMedida</span>
                                                <!-- FIN: Texto de producto y stock en negro sobre tarjeta beige -->
                                            </div>
                                        </div>
                                        <span class="text-label-md font-bold text-error uppercase">Bajo</span>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="p-3 text-center text-black/80 text-sm italic font-bold">
                                    No hay productos con stock crítico actualmente.
                                </div>
                            }
                        </div>
                    </div>

                    <!-- INICIO: Botón Solicitar Reposición en tarjeta beige -->
                    <button type="button" onclick="abrirModal()" class="mt-6 w-full py-3 rounded-lg bg-black text-white font-bold hover:bg-neutral-800 transition-all flex items-center justify-center gap-2 cursor-pointer shadow-sm" style="background-color: #000000 !important; color: #ffffff !important;">
                        <span class="material-symbols-outlined text-white">add_shopping_cart</span>
                        Solicitar Reposición
                    </button>
                    <!-- FIN: Botón Solicitar Reposición en tarjeta beige -->
                </div>
    </main>
    <!-- Bottom Navigation Bar (Mobile only) -->
    <nav class="fixed bottom-0 w-full lg:hidden z-50 rounded-t-xl bg-surface dark:bg-surface-container-highest border-t border-outline-variant/30 shadow-[0_-4px_12px_rgba(68,42,34,0.08)]">
        <div class="flex justify-around items-center h-16 pb-safe">
            <a class="flex flex-col items-center justify-center text-on-surface-variant hover:bg-surface-variant/50 transition-all p-2 rounded-lg" href="#">
                <span class="material-symbols-outlined">home</span>
                <span class="text-label-md font-label-md">Home</span>
            </a>
            <a class="flex flex-col items-center justify-center text-on-surface-variant hover:bg-surface-variant/50 transition-all p-2 rounded-lg" href="#">
                <span class="material-symbols-outlined">groups</span>
                <span class="text-label-md font-label-md">Clientes</span>
            </a>
            <a class="flex flex-col items-center justify-center text-on-surface-variant bg-surface-container-high rounded-full px-4 py-1" href="#">
                <span class="material-symbols-outlined text-black" style="font-variation-settings: &quot;FILL:&quot; 1;">add_circle</span>
                <span class="text-label-md font-label-md font-bold text-black" style="color: #000000;">Cotizar</span>
            </a>
            <a class="flex flex-col items-center justify-center text-black font-bold" href="#" style="color: #000000;">
                <span class="material-symbols-outlined text-black" style="font-variation-settings: &quot;FILL&quot; 1;">inventory_2</span>
                <span class="text-label-md font-label-md text-black" style="color: #000000;">Inv.</span>
            </a>
            <a class="flex flex-col items-center justify-center text-on-surface-variant hover:bg-surface-variant/50 transition-all p-2 rounded-lg" href="#">
                <span class="material-symbols-outlined">more_horiz</span>
                <span class="text-label-md font-label-md">Más</span>
            </a>
        </div>
    </nav>
            <!-- VENTANA EMERGENTE (MODAL) DE SOLICITUD DE REPOSICIÓN -->
            <dialog id="modalReposicion" class="rounded-2xl p-0 shadow-2xl backdrop:bg-black/50 w-full max-w-xl border border-outline-variant/30">
                <div class="bg-surface-container p-6 max-h-[90vh] overflow-y-auto">
                    <!-- Cabecera del Modal -->
                    <div class="flex justify-between items-center mb-4 border-b border-outline-variant/20 pb-3">
                        <div>
                            <h3 class="text-lg font-bold text-primary flex items-center gap-2">
                                <span class="material-symbols-outlined text-error">local_shipping</span>
                                Solicitar reposición de inventario
                            </h3>
                            <p class="text-xs text-on-surface-variant">Registra una solicitud para reabastecer un producto agotado o con existencias bajas.</p>
                        </div>
                        <button type="button" onclick="cerrarModal()" class="text-on-surface-variant hover:text-primary transition-colors">
                            <span class="material-symbols-outlined">close</span>
                        </button>
                    </div>

                    <!-- Formulario completo -->
                    <form asp-controller="Inventario" asp-action="CrearReposicion" method="post" class="space-y-4">

                        <!-- 1. Producto -->
                        <div>
                            <label class="block text-sm font-medium text-on-surface-variant mb-1">Producto</label>
                            <select name="ProductoId" id="selectProductoReposicion" class="w-full rounded-lg border border-outline-variant/40 p-2.5 bg-surface text-primary text-sm focus:outline-none focus:border-primary" required onchange="actualizarStockModal(this)">
                                <option value="" data-stock="0" data-unidad="unidades">Seleccione el producto...</option>
                                @{
                                    var todosInv = ViewBag.TodosInventario as List<CARPINTEC_App.Models.Inventario>;
                                }
                                @if (todosInv != null)
                                {
                                    @foreach (var prod in todosInv)
                                    {
                                        <option value="@prod.IdProducto" data-stock="@prod.StockActual" data-unidad="@prod.UnidadMedida">@prod.NombreProducto (Stock actual: @prod.StockActual)</option>
                                    }
                                }
                            </select>
                        </div>

                        <!-- 3. Stock actual (Informativo) -->
                        <div class="grid grid-cols-2 gap-4">
                            <div>
                                <label class="block text-sm font-medium text-on-surface-variant mb-1">Stock Actual</label>
                                <div id="stockActualInfo" class="p-2.5 rounded-lg bg-surface-variant/40 border border-outline-variant/30 text-sm text-primary font-semibold flex items-center gap-2">
                                    <span class="w-2 h-2 rounded-full bg-error animate-pulse"></span> <span id="stockActualTexto">Seleccione un producto</span>
                                </div>
                            </div>

                            <!-- 4. Cantidad a solicitar y Unidad de medida -->
                            <div>
                                <label class="block text-sm font-medium text-on-surface-variant mb-1">Cantidad a Solicitar</label>
                                <div class="flex gap-2">
                                    <input type="number" name="Cantidad" placeholder="Ej. 50" min="1" class="w-full rounded-lg border border-outline-variant/40 p-2.5 bg-surface text-primary text-sm focus:outline-none focus:border-primary" required />
                                    <span class="p-2.5 rounded-lg bg-surface-variant/20 border border-outline-variant/30 text-xs text-on-surface-variant flex items-center">
                                        Unidades
                                    </span>
                                </div>
                            </div>
                        </div>

                        <div class="grid grid-cols-2 gap-4">
                            <!-- 5. Motivo de la solicitud -->
                            <div>
                                <label class="block text-sm font-medium text-on-surface-variant mb-1">Motivo de la Solicitud</label>
                                <select name="Motivo" class="w-full rounded-lg border border-outline-variant/40 p-2.5 bg-surface text-primary text-sm focus:outline-none focus:border-primary">
                                    <option value="Agotado">Producto agotado</option>
                                    <option value="StockBajo">Stock bajo</option>
                                    <option value="PedidoCliente">Pedido de cliente</option>
                                    <option value="AumentoProduccion">Aumento de producción</option>
                                    <option value="Otro">Otro</option>
                                </select>
                            </div>

                            <!-- 6. Prioridad -->
                            <div>
                                <label class="block text-sm font-medium text-on-surface-variant mb-1">Prioridad</label>
                                <select name="Prioridad" class="w-full rounded-lg border border-outline-variant/40 p-2.5 bg-surface text-primary text-sm focus:outline-none focus:border-primary">
                                    <option value="Alta">🔴 Alta</option>
                                    <option value="Normal" selected>🟡 Normal</option>
                                    <option value="Baja">🟢 Baja</option>
                                </select>
                            </div>
                        </div>

                        <div class="grid grid-cols-2 gap-4">
                            <!-- 7. Proveedor sugerido -->
                            <div>
                                <label class="block text-sm font-medium text-on-surface-variant mb-1">Proveedor Sugerido (Opcional)</label>
                                <select name="Proveedor" class="w-full rounded-lg border border-outline-variant/40 p-2.5 bg-surface text-primary text-sm focus:outline-none focus:border-primary">
                                    <option value="">Seleccione proveedor...</option>
                                    <option value="Maderas del Norte">Maderas del Norte S.A.</option>
                                    <option value="Herrajes y Herramientas S.A.S">Herrajes y Herramientas S.A.S</option>
                                    <option value="Químicos Industriales">Químicos Industriales</option>
                                </select>
                            </div>

                            <!-- 8. Fecha requerida -->
                            <div>
                                <label class="block text-sm font-medium text-on-surface-variant mb-1">Fecha Requerida</label>
                                <input type="date" name="FechaRequerida" class="w-full rounded-lg border border-outline-variant/40 p-2.5 bg-surface text-primary text-sm focus:outline-none focus:border-primary" />
                            </div>
                        </div>

                        <!-- 9. Observaciones -->
                        <div>
                            <label class="block text-sm font-medium text-on-surface-variant mb-1">Observaciones / Notas</label>
                            <textarea name="Observaciones" rows="2" placeholder="Ej. Se necesita este material para continuar con la fabricación de los pedidos pendientes..." class="w-full rounded-lg border border-outline-variant/40 p-2.5 bg-surface text-primary text-sm focus:outline-none focus:border-primary"></textarea>
                        </div>

                        <!-- Botones de Acción -->
                        <div class="flex justify-end gap-3 pt-4 border-t border-outline-variant/20">
                            <button type="button" onclick="cerrarModal()" class="px-4 py-2 rounded-lg border border-outline-variant/40 text-on-surface-variant hover:bg-surface-container-high transition-colors text-sm font-medium">
                                Cancelar
                            </button>
                            <!-- INICIO: Botón Enviar Solicitud en color beige (#D2B48C) con letra en negro -->
                            <button type="submit" class="px-4 py-2 rounded-lg bg-[#D2B48C] hover:brightness-95 text-black font-bold transition-all text-sm shadow-sm" style="background-color: #D2B48C; color: #000000;">
                                Enviar Solicitud
                            </button>
                            <!-- FIN: Botón Enviar Solicitud en color beige (#D2B48C) con letra en negro -->
                        </div>
                    </form>
                </div>
            </dialog>

    <!-- Script para controlar la ventana -->
    <script>
            const modal = document.getElementById('modalReposicion');

            function abrirModal() {
                modal.showModal();
            }

            function cerrarModal() {
                modal.close();
            }

            // Actualizar stock actual en el modal cuando se selecciona un producto
            function actualizarStockModal(selectElem) {
                var option = selectElem.options[selectElem.selectedIndex];
                var stock = option.getAttribute('data-stock') || '0';
                var unidad = option.getAttribute('data-unidad') || 'unidades';
                var textoElem = document.getElementById('stockActualTexto');
                var stockNum = parseInt(stock);

                if (selectElem.value === '') {
                    textoElem.textContent = 'Seleccione un producto';
                } else if (stockNum === 0) {
                    textoElem.textContent = '0 ' + unidad + ' (Agotado)';
                } else if (stockNum <= 10) {
                    textoElem.textContent = stock + ' ' + unidad + ' (Stock Bajo)';
                } else {
                    textoElem.textContent = stock + ' ' + unidad + ' (Disponible)';
                }
            }

            // Simple micro-interaction for rows
            document.querySelectorAll('.zebra-row').forEach(row => {
                row.addEventListener('click', () => {
                    row.classList.toggle('bg-primary-fixed/10');
                });
            });

            // Auto-ocultar notificaciones después de 5 segundos
            setTimeout(function() {
                var notifs = document.querySelectorAll('[class*="bg-green-100"], [class*="bg-red-100"]');
                notifs.forEach(function(el) {
                    el.style.transition = 'opacity 0.5s';
                    el.style.opacity = '0';
                    setTimeout(function() { el.remove(); }, 500);
                });
            }, 5000);
    </script>














</body></html>