@model IEnumerable<CARPINTEC_App.Models.Inventario>
<!DOCTYPE html>
<html class="light" lang="es" style="">
<head>
    <meta charset="utf-8">
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <title>Inventario - CARPINTEC</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;700;800&amp;family=Hanken+Grotesk:wght@400;600&amp;display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet">
    <script id="tailwind-config">
            tailwind.config = {
                darkMode: "class",
                theme: {
                    extend: {
                        "colors": {
                            "secondary-container": "#e1e1c9",
                            "on-secondary-fixed-variant": "#474836",
                            "tertiary-container": "#334b49",
                            "on-surface-variant": "#504441",
                            "tertiary-fixed": "#cde8e5",
                            "surface": "#fcf9f8",
                            "outline-variant": "#d4c3be",
                            "on-surface": "#1b1c1c",
                            "surface-container-high": "#eae7e7",
                            "error-container": "#ffdad6",
                            "primary-container": "#5d4037",
                            "primary-fixed": "#ffdbd0",
                            "surface-container": "#f0eded",
                            "error": "#ba1a1a",
                            "on-error-container": "#93000a",
                            "inverse-surface": "#303030",
                            "on-tertiary-container": "#a0bab7",
                            "surface-variant": "#e5e2e1",
                            "secondary": "#5e604d",
                            "surface-bright": "#fcf9f8",
                            "surface-container-highest": "#e5e2e1",
                            "primary": "#442a22",
                            "on-secondary-fixed": "#1b1d0e",
                            "on-tertiary-fixed": "#061f1e",
                            "on-error": "#ffffff",
                            "primary-fixed-dim": "#e7bdb1",
                            "on-secondary-container": "#636451",
                            "surface-tint": "#77574d",
                            "tertiary": "#1c3433",
                            "on-primary-fixed-variant": "#5d4037",
                            "on-primary-container": "#d4ada1",
                            "surface-container-lowest": "#ffffff",
                            "surface-dim": "#dcd9d9",
                            "outline": "#827470",
                            "inverse-primary": "#e7bdb1",
                            "background": "#fcf9f8",
                            "inverse-on-surface": "#f3f0ef",
                            "secondary-fixed": "#e4e4cc",
                            "secondary-fixed-dim": "#c8c8b0",
                            "on-secondary": "#ffffff",
                            "tertiary-fixed-dim": "#b1ccc9",
                            "on-tertiary": "#ffffff",
                            "surface-container-low": "#f6f3f2",
                            "on-primary-fixed": "#2c160e",
                            "on-primary": "#ffffff",
                            "on-background": "#1b1c1c",
                            "on-tertiary-fixed-variant": "#334b49"
                        },
                        "borderRadius": {
                            "DEFAULT": "0.25rem",
                            "lg": "0.5rem",
                            "xl": "0.75rem",
                            "full": "9999px"
                        },
                        "spacing": {
                            "md": "24px",
                            "sm": "12px",
                            "base": "8px",
                            "lg": "40px",
                            "gutter": "24px",
                            "xl": "64px",
                            "xs": "4px",
                            "margin": "32px"
                        },
                        "fontFamily": {
                            "body-md": ["Hanken Grotesk"],
                            "headline-lg-mobile": ["Manrope"],
                            "body-lg": ["Hanken Grotesk"],
                            "body-sm": ["Hanken Grotesk"],
                            "headline-xl": ["Manrope"],
                            "headline-md": ["Manrope"],
                            "headline-lg": ["Manrope"],
                            "label-md": ["Hanken Grotesk"]
                        },
                        "fontSize": {
                            "body-md": ["16px", { "lineHeight": "24px", "fontWeight": "400" }],
                            "headline-lg-mobile": ["28px", { "lineHeight": "36px", "fontWeight": "600" }],
                            "body-lg": ["18px", { "lineHeight": "28px", "fontWeight": "400" }],
                            "body-sm": ["14px", { "lineHeight": "20px", "fontWeight": "400" }],
                            "headline-xl": ["40px", { "lineHeight": "48px", "letterSpacing": "-0.02em", "fontWeight": "700" }],
                            "headline-md": ["24px", { "lineHeight": "32px", "fontWeight": "600" }],
                            "headline-lg": ["32px", { "lineHeight": "40px", "letterSpacing": "-0.01em", "fontWeight": "600" }],
                            "label-md": ["14px", { "lineHeight": "16px", "letterSpacing": "0.05em", "fontWeight": "600" }]
                        }
                    },
                },
            }
    </script>
    <style>
            body {
                font-family: 'Hanken Grotesk', sans-serif;
                background-color: #FAFAFA;
                color: #1b1c1c;
            }

            .material-symbols-outlined {
                font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
                vertical-align: middle;
            }

            .glass-card {
                background: rgba(255, 255, 255, 0.9);
                backdrop-filter: blur(8px);
                border: 1px solid rgba(245, 245, 220, 0.5);
            }

            .wood-shadow {
                box-shadow: 0 4px 12px rgba(68, 42, 34, 0.08);
            }

            .zebra-row:nth-child(even) {
                background-color: rgba(245, 245, 220, 0.3);
            }

            .swatch-glow {
                transition: all 0.3s ease;
            }

                .swatch-glow:hover {
                    transform: translateY(-2px);
                    box-shadow: 0 8px 16px rgba(68, 42, 34, 0.12);
                }

            .sidebar-item-active {
                background-color: rgba(255, 219, 208, 0.15);
                color: #ffdbd0;
                border-left: 4px solid #ffdbd0;
            }
    </style>
    <style>
            body {
                min-height: max(884px, 100dvh);
            }
    </style>
</head>
<body class="bg-surface selection:bg-primary-fixed selection:text-on-primary-fixed">
    <!-- Sidebar Navigation Drawer -->
    <button onclick="history.back()"
            class="flex items-center gap-2 text-primary hover:underline mb-4">
        <span class="material-symbols-outlined">arrow_back</span>
        Volver
    </button>

    <!-- Main Content Canvas -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-6">

        <!-- Tarjeta 1: Productos Totales -->
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 space-y-2">
            <div class="flex items-center justify-between text-gray-500">
                <span class="text-xs font-bold uppercase tracking-wider">Productos Totales</span>
                <span class="material-symbols-outlined text-blue-600">inventory_2</span>
            </div>
            <h3 class="text-3xl font-bold text-gray-900">@ViewBag.TotalProductos</h3>
            <p class="text-xs text-gray-400">Total en catálogo actual</p>
        </div>

        <!-- Tarjeta 2: Stock Bajo -->
        <div class="bg-red-50/40 rounded-2xl shadow-sm border border-red-100 p-6 space-y-2">
            <div class="flex items-center justify-between text-red-600">
                <span class="text-xs font-bold uppercase tracking-wider">Stock Bajo</span>
                <span class="material-symbols-outlined">warning</span>
            </div>
            <h3 class="text-3xl font-bold text-red-600">@ViewBag.TotalStockBajo</h3>
            <p class="text-xs text-red-500 font-medium">Requieren atención inmediata</p>
        </div>

        <!-- Tarjeta 3: Valor Inventario -->
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 space-y-2">
            <div class="flex items-center justify-between text-gray-500">
                <span class="text-xs font-bold uppercase tracking-wider">Valor Inventario</span>
                <span class="material-symbols-outlined text-blue-600">payments</span>
            </div>
            <h3 class="text-3xl font-bold text-gray-900">$@string.Format("{0:N0}", ViewBag.ValorInventario)</h3>
            <p class="text-xs text-gray-400">Basado en precio de compra</p>
        </div>

        <!-- Tarjeta 4: Movimientos -->
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 space-y-2">
            <div class="flex items-center justify-between text-gray-500">
                <span class="text-xs font-bold uppercase tracking-wider">Movimientos</span>
                <span class="material-symbols-outlined text-blue-600">swap_vert</span>
            </div>
            <h3 class="text-3xl font-bold text-gray-900">@ViewBag.TotalMovimientos</h3>
            <p class="text-xs text-gray-400">Últimos 30 días</p>
        </div>

    </div>
            <!-- Main Actions & Filters -->
            <div class="flex flex-col sm:flex-row justify-between items-center gap-4">
                <div class="flex bg-surface-container-high p-1 rounded-lg">
                    <button class="px-6 py-2 rounded-md text-label-md font-label-md transition-all" style="background-color: rgb(210, 180, 140); color: rgb(0, 0, 0);">Madera</button>
                    <button class="px-6 py-2 hover:bg-surface-container-highest text-on-surface-variant rounded-md text-label-md font-label-md transition-all">Herrajes</button>
                    <button class="px-6 py-2 hover:bg-surface-container-highest text-on-surface-variant rounded-md text-label-md font-label-md transition-all">Herramientas</button>
                    <button class="px-6 py-2 hover:bg-surface-container-highest text-on-surface-variant rounded-md text-label-md font-label-md transition-all">Químicos</button>
                </div>
                <a asp-controller="GestionFacturas"
                   asp-action="Index"
                   class="bg-primary px-6 py-3 rounded-full flex items-center gap-2 font-bold shadow-md hover:opacity-90 active:scale-95 transition-all text-on-background"
                   style="background-color: rgb(210, 180, 140); text-decoration: none;">
                    Facturas PDF
                </a>
            </div>
            <!-- Inventory List Table Card -->
            <div class="bg-surface-container-lowest rounded-xl wood-shadow overflow-hidden border border-outline-variant/20">
                <div class="p-6 border-b border-outline-variant/30 bg-surface-container-low/50 flex justify-between items-center">
                    <h3 class="text-headline-md font-headline-md text-primary">Catálogo de Materiales</h3>
                    <div class="flex gap-2">
                        <span class="text-body-sm text-on-surface-variant">Filtro: Todo el stock</span>
                        <span class="material-symbols-outlined text-on-surface-variant cursor-pointer">filter_list</span>
                    </div>
                </div>
                <div class="overflow-x-auto">
                    <table class="w-full text-left">
                        <thead>
                            <tr class="bg-surface-container text-on-surface-variant text-label-md border-b border-outline-variant/30">
                                <th class="px-6 py-4 font-semibold">PRODUCTO</th>
                                <th class="px-6 py-4 font-semibold">CATEGORÍA</th>
                                <th class="px-6 py-4 font-semibold text-center">STOCK</th>
                                <th class="px-6 py-4 font-semibold">UNIDAD</th>
                                <th class="px-6 py-4 font-semibold">PRECIO UNIT.</th>
                                <th class="px-6 py-4 font-semibold">ESTADO</th>
                                <th class="px-6 py-4 font-semibold text-right">ACCIONES</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-outline-variant/20">
                            <!-- Low Stock Alert Row -->
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    // Lógica para alternar el estilo si el stock es bajo (ejemplo menor o igual a 15)
                                    bool esStockBajo = item.StockActual <= 15;
                                    string claseFila = esStockBajo ? "zebra-row hover:bg-surface-container-low transition-colors group bg-primary-fixed/10" : "zebra-row hover:bg-surface-container-low transition-colors group";

                                    <tr class="@claseFila">
                                        <td class="px-6 py-4">
                                            <div class="flex items-center gap-4">
                                                <div class="w-12 h-12 rounded-lg bg-surface-variant flex items-center justify-center overflow-hidden border border-outline-variant/30">
                                                    @if (!string.IsNullOrEmpty(item.NombreProducto) && item.NombreProducto.Contains("Tornillo"))
                                                    {
                                                        <span class="material-symbols-outlined text-primary text-3xl">build</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="material-symbols-outlined text-primary text-3xl">inventory_2</span>
                                                    }
                                                </div>
                                                <div>
                                                    <p class="text-body-md font-bold text-primary">@item.NombreProducto</p>
                                                    <p class="text-body-sm text-on-surface-variant">Ref: @item.IdInventario</p>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="px-6 py-4 text-body-sm">General</td>
                                        <td class="px-6 py-4 text-center">
                                            @if (esStockBajo)
                                            {
                                                <span class="px-3 py-1 rounded-full bg-error-container text-error text-label-md font-bold">@item.StockActual</span>
                                            }
                                            else
                                            {
                                                <span class="text-body-md font-bold text-primary">@item.StockActual</span>
                                            }
                                        </td>
                                        <td class="px-6 py-4 text-body-sm">@item.UnidadMedida</td>
                                        <td class="px-6 py-4 text-body-md font-semibold text-primary">$@item.PrecioCompra.ToString("N0")</td>
                                        <td class="px-6 py-4">
                                            @if (esStockBajo)
                                            {
                                                <span class="flex items-center gap-1 text-error text-label-md font-bold uppercase tracking-wider">
                                                    <span class="w-2 h-2 rounded-full bg-error animate-pulse"></span> Stock Bajo
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="flex items-center gap-1 text-tertiary text-label-md font-bold uppercase tracking-wider">
                                                    <span class="w-2 h-2 rounded-full bg-tertiary"></span> Disponible
                                                </span>
                                            }
                                        </td>
                                        <td class="px-6 py-4 text-right">
                                            <a asp-action="Edit" asp-route-id="@item.IdInventario" class="p-2 text-on-surface-variant hover:text-primary transition-colors inline-block"><span class="material-symbols-outlined">edit</span></a>
                                            <button class="p-2 text-on-surface-variant hover:text-primary transition-colors"><span class="material-symbols-outlined">more_vert</span></button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                            <div class="p-6 border-t border-outline-variant/30 bg-surface-container-low/30 flex flex-col sm:flex-row items-center justify-between gap-4">
                                @{
                                    int paginaActual = ViewBag.PaginaActual ?? 1;
                                    int totalPaginas = ViewBag.TotalPaginas ?? 1;
                                    int totalRegistros = ViewBag.TotalRegistros ?? 0;
                                    int registrosPorPagina = ViewBag.RegistrosPorPagina ?? 5;

                                    int inicio = totalRegistros == 0 ? 0 : ((paginaActual - 1) * registrosPorPagina) + 1;
                                    int fin = Math.Min(paginaActual * registrosPorPagina, totalRegistros);
                                }

                                <!-- Texto de conteo dinámico -->
                                <p class="text-body-sm text-on-surface-variant">
                                    Mostrando @inicio - @fin de @totalRegistros productos
                                </p>

                                <!-- Botones de paginación funcionales -->
                                <div class="flex gap-2 items-center">
                                    @if (paginaActual > 1)
                                    {
                                        <a asp-action="Index" asp-route-pagina="@(paginaActual - 1)"
                                           class="px-3 h-10 rounded-lg flex items-center justify-center border border-outline-variant/30 text-on-surface-variant hover:bg-primary hover:text-on-primary transition-all text-body-sm font-medium">
                                            Anterior
                                        </a>
                                    }

                                    @for (int i = 1; i <= totalPaginas; i++)
                                    {
                                        if (i == paginaActual)
                                        {
                                            <span class="w-10 h-10 rounded-lg flex items-center justify-center bg-primary text-on-primary font-bold shadow-sm">
                                                @i
                                            </span>
                                        }
                                        else
                                        {
                                            <a asp-action="Index" asp-route-pagina="@i"
                                               class="w-10 h-10 rounded-lg flex items-center justify-center border border-outline-variant/30 text-on-surface-variant hover:bg-primary hover:text-on-primary transition-all font-medium">
                                                @i
                                            </a>
                                        }
                                    }

                                    @if (paginaActual < totalPaginas)
                                    {
                                        <a asp-action="Index" asp-route-pagina="@(paginaActual + 1)"
                                           class="px-3 h-10 rounded-lg flex items-center justify-center border border-outline-variant/30 text-on-surface-variant hover:bg-primary hover:text-on-primary transition-all text-body-sm font-medium">
                                            Siguiente
                                        </a>
                                    }
                                </div>
                            </div>
                    </table>
                    </div>
                </div>
            
            <!-- Recent Stock History / Entries & Exits -->
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                <!-- Columna Izquierda: Historial de Movimientos (Ocupa 2 espacios) -->
                <div class="lg:col-span-2 bg-white rounded-2xl shadow-sm border border-gray-100 p-6 space-y-4">
                    <div class="flex items-center justify-between border-b border-gray-100 pb-4">
                        <div>
                            <h3 class="text-xl font-bold text-gray-900">Historial de Movimientos</h3>
                            <p class="text-xs text-gray-500">Registro en Tiempo Real</p>
                        </div>
                        <div class="flex items-center gap-1.5 px-3 py-1 bg-green-50 text-green-700 rounded-full text-xs font-semibold">
                            <span class="w-2 h-2 rounded-full bg-green-500 animate-pulse"></span>
                            LIVE
                        </div>
                    </div>

                    <div class="space-y-3">
                        @{
                            var movimientos = ViewBag.HistorialMovimientos as List<CARPINTEC_App.Models.MovimientoInventario>;
                        }
                        @if (movimientos != null && movimientos.Any())
                        {
                            @foreach (var mov in movimientos)
                            {
                                <div class="flex items-center justify-between p-4 rounded-xl bg-gray-50/50 border border-gray-100">
                                    <div class="flex items-center gap-3">
                                        <div class="p-2 rounded-full @(mov.Tipo == "Entrada" ? "bg-green-100 text-green-700" : "bg-red-100 text-red-700")">
                                            <span class="material-symbols-outlined text-base">
                                                @(mov.Tipo == "Entrada" ? "arrow_downward" : "arrow_upward")
                                            </span>
                                        </div>
                                        <div>
                                            <h4 class="text-sm font-bold text-gray-800">@mov.Tipo: @mov.NombreProducto</h4>
                                            <p class="text-xs text-gray-500">@mov.ReferenciaOProyecto</p>
                                        </div>
                                    </div>
                                    <div class="text-right">
                                        <span class="text-sm font-bold @(mov.Tipo == "Entrada" ? "text-green-600" : "text-red-600")">
                                            @(mov.Tipo == "Entrada" ? "+" : "-")@mov.Cantidad @mov.UnidadMedida
                                        </span>
                                        <p class="text-xs text-gray-500">@mov.FechaMovimiento.ToString("dd MMM, hh:mm tt")</p>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="p-6 text-center text-gray-400 text-sm italic bg-gray-50 rounded-xl border border-gray-100">
                                No hay movimientos registrados recientemente.
                            </div>
                        }
                    </div>
                </div>
        </div>

                <!-- Columna Derecha: Stock Bajo (Ocupa 1 espacio) -->
                <div class="lg:col-span-1 p-5 rounded-2xl bg-blue-600 text-white shadow-md space-y-4">
                    <div>
                        <h3 class="text-lg font-bold">Stock Bajo</h3>
                        <p class="text-xs text-blue-100">Materiales con existencias críticas (1 a 10 unidades)</p>
                    </div>

                    <div class="space-y-2">
                        @{
                            var productosBajos = ViewBag.ProductosBajos as List<CARPINTEC_App.Models.Inventario>;
                        }
                        @if (productosBajos != null && productosBajos.Any())
                        {
                            @foreach (var prod in productosBajos)
                            {
                                <div class="flex items-center justify-between p-3 rounded-xl bg-white/10 border border-white/15">
                                    <div class="flex items-center gap-2">
                                        <span class="material-symbols-outlined text-yellow-300 text-base">warning</span>
                                        <div>
                                            <h4 class="text-xs font-bold text-white">@prod.NombreProducto</h4>
                                            <p class="text-[11px] text-blue-100">Quedan: @prod.StockActual Unidades</p>
                                        </div>
                                    </div>
                                    <span class="text-[10px] font-bold px-2 py-0.5 rounded bg-red-500/30 text-red-200 border border-red-400/30">BAJO</span>
                                </div>
                            }
                        }
                        else
                        {
                            <p class="text-xs italic text-blue-100 text-center py-2">No hay productos con stock crítico.</p>
                        }
                    </div>


                    <!-- Botón que activa la ventana emergente -->
                    <button type="button" onclick="abrirModal()" class="mt-6 w-full py-3 rounded-lg bg-primary-fixed text-on-primary-fixed font-bold hover:bg-white transition-all flex items-center justify-center gap-2 cursor-pointer shadow-sm">
                        <span class="material-symbols-outlined">add_shopping_cart</span>
                        Solicitar Reposición
                    </button>
                </div>
    
    <!-- Bottom Navigation Bar (Mobile only) -->
    <nav class="fixed bottom-0 w-full lg:hidden z-50 rounded-t-xl bg-surface dark:bg-surface-container-highest border-t border-outline-variant/30 shadow-[0_-4px_12px_rgba(68,42,34,0.08)]">
        <div class="flex justify-around items-center h-16 pb-safe">
            <a class="flex flex-col items-center justify-center text-on-surface-variant hover:bg-surface-variant/50 transition-all p-2 rounded-lg" href="#">
                <span class="material-symbols-outlined">home</span>
                <span class="text-label-md font-label-md">Home</span>
            </a>
            <a class="flex flex-col items-center justify-center text-on-surface-variant hover:bg-surface-variant/50 transition-all p-2 rounded-lg" href="#">
                <span class="material-symbols-outlined">groups</span>
                <span class="text-label-md font-label-md">Clientes</span>
            </a>
            <a class="flex flex-col items-center justify-center text-on-surface-variant bg-primary-fixed/30 rounded-full px-4 py-1" href="#">
                <span class="material-symbols-outlined" style="font-variation-settings: &quot;FILL:&quot; 1;">add_circle</span>
                <span class="text-label-md font-label-md font-bold text-primary">Cotizar</span>
            </a>
            <a class="flex flex-col items-center justify-center text-primary dark:text-primary-fixed font-bold" href="#">
                <span class="material-symbols-outlined" style="font-variation-settings: &quot;FILL&quot; 1;">inventory_2</span>
                <span class="text-label-md font-label-md">Inv.</span>
            </a>
            <a class="flex flex-col items-center justify-center text-on-surface-variant hover:bg-surface-variant/50 transition-all p-2 rounded-lg" href="#">
                <span class="material-symbols-outlined">more_horiz</span>
                <span class="text-label-md font-label-md">Más</span>
            </a>
        </div>
    </nav>
            <!-- VENTANA EMERGENTE (MODAL) DE SOLICITUD DE REPOSICIÓN -->
            <dialog id="modalReposicion" class="rounded-2xl p-0 shadow-2xl backdrop:bg-black/50 w-full max-w-xl border border-outline-variant/30">
                <div class="bg-surface-container p-6 max-h-[90vh] overflow-y-auto">
                    <!-- Cabecera del Modal -->
                    <div class="flex justify-between items-center mb-4 border-b border-outline-variant/20 pb-3">
                        <div>
                            <h3 class="text-lg font-bold text-primary flex items-center gap-2">
                                <span class="material-symbols-outlined text-error">local_shipping</span>
                                Solicitar reposición de inventario
                            </h3>
                            <p class="text-xs text-on-surface-variant">Registra una solicitud para reabastecer un producto agotado o con existencias bajas.</p>
                        </div>
                        <button type="button" onclick="cerrarModal()" class="text-on-surface-variant hover:text-primary transition-colors">
                            <span class="material-symbols-outlined">close</span>
                        </button>
                    </div>

                    <!-- Formulario completo -->
                    <form asp-controller="Inventario" asp-action="CrearReposicion" method="post" class="space-y-4">

                        <!-- 1. Producto -->
                        <div>
                            <label class="block text-sm font-medium text-on-surface-variant mb-1">Producto</label>
                            <select name="ProductoId" class="w-full rounded-lg border border-outline-variant/40 p-2.5 bg-surface text-primary text-sm focus:outline-none focus:border-primary" required>
                                <option value="">Seleccione el producto...</option>
                                @if (Model != null)
                                {
                                    @foreach (var prod in Model)
                                    {
                                        <option value="@prod.IdInventario">@prod.NombreProducto (Stock actual: @prod.StockActual)</option>
                                    }
                                }
                            </select>
                        </div>

                        <!-- 3. Stock actual (Informativo) -->
                        <div class="grid grid-cols-2 gap-4">
                            <div>
                                <label class="block text-sm font-medium text-on-surface-variant mb-1">Stock Actual</label>
                                <div class="p-2.5 rounded-lg bg-surface-variant/40 border border-outline-variant/30 text-sm text-primary font-semibold flex items-center gap-2">
                                    <span class="w-2 h-2 rounded-full bg-error animate-pulse"></span> 0 unidades (Agotado)
                                </div>
                            </div>

                            <!-- 4. Cantidad a solicitar y Unidad de medida -->
                            <div>
                                <label class="block text-sm font-medium text-on-surface-variant mb-1">Cantidad a Solicitar</label>
                                <div class="flex gap-2">
                                    <input type="number" name="Cantidad" placeholder="Ej. 50" min="1" class="w-full rounded-lg border border-outline-variant/40 p-2.5 bg-surface text-primary text-sm focus:outline-none focus:border-primary" required />
                                    <span class="p-2.5 rounded-lg bg-surface-variant/20 border border-outline-variant/30 text-xs text-on-surface-variant flex items-center">
                                        Unidades
                                    </span>
                                </div>
                            </div>
                        </div>

                        <div class="grid grid-cols-2 gap-4">
                            <!-- 5. Motivo de la solicitud -->
                            <div>
                                <label class="block text-sm font-medium text-on-surface-variant mb-1">Motivo de la Solicitud</label>
                                <select name="Motivo" class="w-full rounded-lg border border-outline-variant/40 p-2.5 bg-surface text-primary text-sm focus:outline-none focus:border-primary">
                                    <option value="Agotado">Producto agotado</option>
                                    <option value="StockBajo">Stock bajo</option>
                                    <option value="PedidoCliente">Pedido de cliente</option>
                                    <option value="AumentoProduccion">Aumento de producción</option>
                                    <option value="Otro">Otro</option>
                                </select>
                            </div>

                            <!-- 6. Prioridad -->
                            <div>
                                <label class="block text-sm font-medium text-on-surface-variant mb-1">Prioridad</label>
                                <select name="Prioridad" class="w-full rounded-lg border border-outline-variant/40 p-2.5 bg-surface text-primary text-sm focus:outline-none focus:border-primary">
                                    <option value="Alta">🔴 Alta</option>
                                    <option value="Normal" selected>🟡 Normal</option>
                                    <option value="Baja">🟢 Baja</option>
                                </select>
                            </div>
                        </div>

                        <div class="grid grid-cols-2 gap-4">
                            <!-- 7. Proveedor sugerido -->
                            <div>
                                <label class="block text-sm font-medium text-on-surface-variant mb-1">Proveedor Sugerido (Opcional)</label>
                                <select name="Proveedor" class="w-full rounded-lg border border-outline-variant/40 p-2.5 bg-surface text-primary text-sm focus:outline-none focus:border-primary">
                                    <option value="">Seleccione proveedor...</option>
                                    <option value="Maderas del Norte">Maderas del Norte S.A.</option>
                                    <option value="Herrajes y Herramientas S.A.S">Herrajes y Herramientas S.A.S</option>
                                    <option value="Químicos Industriales">Químicos Industriales</option>
                                </select>
                            </div>

                            <!-- 8. Fecha requerida -->
                            <div>
                                <label class="block text-sm font-medium text-on-surface-variant mb-1">Fecha Requerida</label>
                                <input type="date" name="FechaRequerida" class="w-full rounded-lg border border-outline-variant/40 p-2.5 bg-surface text-primary text-sm focus:outline-none focus:border-primary" />
                            </div>
                        </div>

                        <!-- 9. Observaciones -->
                        <div>
                            <label class="block text-sm font-medium text-on-surface-variant mb-1">Observaciones / Notas</label>
                            <textarea name="Observaciones" rows="2" placeholder="Ej. Se necesita este material para continuar con la fabricación de los pedidos pendientes..." class="w-full rounded-lg border border-outline-variant/40 p-2.5 bg-surface text-primary text-sm focus:outline-none focus:border-primary"></textarea>
                        </div>

                        <!-- Botones de Acción -->
                        <div class="flex justify-end gap-3 pt-4 border-t border-outline-variant/20">
                            <button type="button" onclick="cerrarModal()" class="px-4 py-2 rounded-lg border border-outline-variant/40 text-on-surface-variant hover:bg-surface-container-high transition-colors text-sm font-medium">
                                Cancelar
                            </button>
                            <button type="submit" class="px-4 py-2 rounded-lg bg-primary text-on-primary hover:opacity-90 transition-opacity text-sm font-medium shadow-sm">
                                Enviar Solicitud
                            </button>
                        </div>
                    </form>
                </div>
            </dialog>

    <!-- Script para controlar la ventana -->
    <script>
            const modal = document.getElementById('modalReposicion');

            function abrirModal() {
                modal.showModal(); // Abre la ventana emergente con efecto oscuro atrás
            }

            function cerrarModal() {
                modal.close(); // Cierra la ventana
            }
  
    
            // Simple micro-interaction for rows
            document.querySelectorAll('.zebra-row').forEach(row => {
                row.addEventListener('click', () => {
                    row.classList.toggle('bg-primary-fixed/10');
                });
            });
    </script>














</body></html>